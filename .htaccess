# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/abongsha/bongshai-node-app-prod"
PassengerBaseURI "/"
PassengerNodejs "/home/abongsha/nodevenv/bongshai-node-app-prod/22/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Redirect HTTP to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 3. Redirect index.html to the root directory
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ https://bongshaihousing.com/ [R=301,L]



# 4. Redirect specific old or broken URLs to homepage
RewriteRule ^u8-2/?$ https://bongshaihousing.com/ [R=301,L]

# 4b. Category pages renamed — redirect old URLs to the new pages
RewriteRule ^two-story-building\.html$ https://bongshaihousing.com/apartment-building.html [R=301,L]
RewriteRule ^duplex-villa\.html$ https://bongshaihousing.com/duplex-steel-building.html [R=301,L]
# 4b-2. Container House model prefix rename (BH-CH-5xx -> BH-CT-5xx)

RewriteRule ^bh-ch-501\.html/?$ https://bongshaihousing.com/bh-ct-501.html [R=301,L]
RewriteRule ^bh-ch-502\.html/?$ https://bongshaihousing.com/bh-ct-502.html [R=301,L]
RewriteRule ^bh-ch-503\.html/?$ https://bongshaihousing.com/bh-ct-503.html [R=301,L]
RewriteRule ^bh-ch-504\.html/?$ https://bongshaihousing.com/bh-ct-504.html [R=301,L]
RewriteRule ^bh-ch-505\.html/?$ https://bongshaihousing.com/bh-ct-505.html [R=301,L]
RewriteRule ^bh-ch-506\.html/?$ https://bongshaihousing.com/bh-ct-506.html [R=301,L]
RewriteRule ^bh-ch-507\.html/?$ https://bongshaihousing.com/bh-ct-507.html [R=301,L]
RewriteRule ^bh-ch-508\.html/?$ https://bongshaihousing.com/bh-ct-508.html [R=301,L]
RewriteRule ^bh-ch-509\.html/?$ https://bongshaihousing.com/bh-ct-509.html [R=301,L]
RewriteRule ^bh-ch-510\.html/?$ https://bongshaihousing.com/bh-ct-510.html [R=301,L]
RewriteRule ^bh-ch-511\.html/?$ https://bongshaihousing.com/bh-ct-511.html [R=301,L]
RewriteRule ^bh-ch-512\.html/?$ https://bongshaihousing.com/bh-ct-512.html [R=301,L]
# 4c. Google Search Console 404 Fixes (2026-08-08)
# WordPress leftovers
RewriteRule ^wp-(content|includes|login\.php|admin)(.*)$ https://bongshaihousing.com/ [R=301,L]
RewriteRule ^createpackages/(.*)$ https://bongshaihousing.com/ [R=301,L]
RewriteRule ^properties/(.*)$ https://bongshaihousing.com/ [R=301,L]

# Old URLs & Categories
RewriteRule ^container-house/?$ https://bongshaihousing.com/container-house.html [R=301,L]
RewriteRule ^low-cost-villa/?$ https://bongshaihousing.com/luxury-villa.html [R=301,L]
RewriteRule ^career/?$ https://bongshaihousing.com/career.html [R=301,L]
RewriteRule ^two-story-building/?$ https://bongshaihousing.com/apartment-building.html [R=301,L]
RewriteRule ^our-mission-vission/?$ https://bongshaihousing.com/about.html [R=301,L]
RewriteRule ^contact-bn\.html$ https://bongshaihousing.com/contact.html [R=301,L]
RewriteRule ^model-no-bh-lv-02/?$ https://bongshaihousing.com/luxury-villa.html [R=301,L]

# Typos in model names from external links
RewriteRule ^bh-tb-101\.html$ https://bongshaihousing.com/bh-tsb-101.html [R=301,L]
RewriteRule ^bh-tb-102\.html$ https://bongshaihousing.com/bh-tsb-102.html [R=301,L]
RewriteRule ^bh-tb-104\.html$ https://bongshaihousing.com/bh-tsb-104.html [R=301,L]
RewriteRule ^bh-tb-105\.html$ https://bongshaihousing.com/bh-tsb-105.html [R=301,L]
RewriteRule ^bh-dv-105\.html$ https://bongshaihousing.com/bh-dv-205.html [R=301,L]
RewriteRule ^bh-dv-106\.html$ https://bongshaihousing.com/bh-dv-206.html [R=301,L]

# 4d. GSC "Page with redirect" — slug-style URLs missing rules (2026-08-08)

RewriteRule ^career-apply-now/?$ https://bongshaihousing.com/career.html [R=301,L]
RewriteRule ^login/?$ https://bongshaihousing.com/ [R=301,L]
RewriteRule ^logout/?$ https://bongshaihousing.com/ [R=301,L]
RewriteRule ^user/?$ https://bongshaihousing.com/ [R=301,L]
RewriteRule ^low-cost-cottage/?$ https://bongshaihousing.com/cottage-house.html [R=301,L]
RewriteRule ^apartments/?$ https://bongshaihousing.com/apartment-building.html [R=301,L]
RewriteRule ^terms-and-conditions/?$ https://bongshaihousing.com/terms.html [R=301,L]
RewriteRule ^gallery/?$ https://bongshaihousing.com/gallery.html [R=301,L]
RewriteRule ^bn/?$ https://bongshaihousing.com/ [R=301,L]
RewriteRule ^en/?$ https://bongshaihousing.com/ [R=301,L]
RewriteRule ^agents/?$ https://test.bongshaihousing.com/agent/signup.html [R=302,L]
RewriteRule ^bh-m-01/?$ https://bongshaihousing.com/products-and-solutions.html [R=301,L]
RewriteRule ^about-us/?$ https://bongshaihousing.com/about.html [R=301,L]
RewriteRule ^contact-us/?$ https://bongshaihousing.com/contact.html [R=301,L]
RewriteRule ^luxury-villa/?$ https://bongshaihousing.com/luxury-villa.html [R=301,L]

# 4e. GSC "Crawled - currently not indexed" — old WordPress slugs (2026-08-08)
RewriteRule ^architect/?$ https://bongshaihousing.com/career.html [R=301,L]
RewriteRule ^deputy-general-managerdgm/?$ https://bongshaihousing.com/career.html [R=301,L]
RewriteRule ^project-manager/?$ https://bongshaihousing.com/career.html [R=301,L]
RewriteRule ^foreman-civil-construction/?$ https://bongshaihousing.com/career.html [R=301,L]
RewriteRule ^project/?$ https://bongshaihousing.com/projects.html [R=301,L]
RewriteRule ^model-no-bh-tb-07/?$ https://bongshaihousing.com/bh-tsb-107.html [R=301,L]
RewriteRule ^2-bedroom-luxury-building/?$ https://bongshaihousing.com/apartment-building.html [R=301,L]
RewriteRule ^home-1/?$ https://bongshaihousing.com/ [R=301,L]
RewriteRule ^model-no-lc-01/?$ https://bongshaihousing.com/products-and-solutions.html [R=301,L]
RewriteRule ^luxury-single-villa-2/?$ https://bongshaihousing.com/luxury-villa.html [R=301,L]
RewriteRule ^about-us-2/?$ https://bongshaihousing.com/about.html [R=301,L]

# 4f. GSC "Alternate canonical" — missing pages (2026-08-08)
RewriteRule ^portable-toilets-and-showers\.html$ https://bongshaihousing.com/products-and-solutions.html [R=301,L]
RewriteRule ^security-huts\.html$ https://bongshaihousing.com/products-and-solutions.html [R=301,L]
RewriteRule ^modular-kiosks\.html$ https://bongshaihousing.com/products-and-solutions.html [R=301,L]
RewriteRule ^site-offices\.html$ https://bongshaihousing.com/products-and-solutions.html [R=301,L]

</IfModule>

# Broken/missing URLs get a real 404 response with the actual 404 page,
# instead of a 301 to the homepage (which Google flags as a soft-404 and
# which hides real errors from visitors).
ErrorDocument 404 /404.html

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Compress text-based assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Browser cache lifetimes
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
