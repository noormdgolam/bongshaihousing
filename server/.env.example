# Copy this file to server/.env (or repo-root .env) and fill in real values.
# Never commit the real .env - it's already covered by .gitignore.

PORT=3000
NODE_ENV=development

# SMTP transport for Nodemailer (see the plan's Phase 0 note: confirm the
# host allows outbound SMTP from application code, not just PHP's mail()).
# A cPanel mailbox (e.g. no-reply@bongshaihousing.com) usually works as both
# the SMTP host and credential.
SMTP_HOST=mail.bongshaihousing.com
SMTP_PORT=587
SMTP_USER=no-reply@bongshaihousing.com
SMTP_PASS=

MAIL_FROM=no-reply@bongshaihousing.com
MAIL_TO_SALES=sales@bongshai.com
MAIL_TO_JOBS=jobs@bongshai.com
