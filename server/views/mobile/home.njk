{% import "partials/icons.njk" as icons %}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<!-- viewport-fit=cover is what lets the bottom bar sit above the iOS home
     indicator via env(safe-area-inset-*) below. -->
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#1E40AF" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0B1220" media="(prefers-color-scheme: dark)">
<title>Bongshai Housing — Prefab Steel Homes in Bangladesh</title>
<meta name="description" content="Pre-engineered steel homes built across Bangladesh. Browse models, estimate your cost, and talk to us.">
<link rel="manifest" href="/manifest.json">
<!-- Deliberately NOT linking css/style.min.css. This shell is self-styled, and
     the site sheet both collides on generic class names (.hero, .app) and sets
     body{opacity:0} for a fade-in this page never triggers. Skipping it also
     spares a mobile-data visitor a large desktop stylesheet they never use. -->
<style>
  /* The site's own tokens, mirrored here so the app shell can never drift from
     the theme the admin sets. Dark is a real palette, not an inversion. */
  :root{
    --m-primary:{{ theme.primary or '#1E40AF' }};
    --m-primary-dark:{{ theme.primary_dark or '#1E3A8A' }};
    --m-primary-light:{{ theme.primary_light or '#3B82F6' }};
    --m-accent:{{ theme.accent or '#EAB308' }};
    --m-accent-dark:{{ theme.accent_dark or '#CA8A04' }};

    --m-bg:{{ theme.bg_color or '#ffffff' }};
    --m-surface:{{ theme.surface_color or '#f8fafc' }};
    --m-card:#ffffff;
    --m-text:{{ theme.text_color or '#0f172a' }};
    --m-muted:{{ theme.text_muted or '#64748b' }};
    --m-line:#e2e8f0;
    --m-shadow:0 1px 2px rgba(15,23,42,.06), 0 8px 24px rgba(15,23,42,.06);

    --m-radius:{{ theme.radius_lg or '12px' }};
    --m-radius-xl:{{ theme.radius_xl or '16px' }};
    --nav-h:60px;
  }
  /* System preference, unless the reader has explicitly chosen light. */
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --m-bg:#0B1220;
      --m-surface:#121C2B;
      --m-card:#16212F;
      --m-text:#E8EEF6;
      --m-muted:#93A4B8;
      --m-line:#24334A;
      --m-primary-light:#60A5FA;
      --m-shadow:0 1px 2px rgba(0,0,0,.4), 0 8px 24px rgba(0,0,0,.35);
    }
  }
  /* Explicit choice wins in both directions. */
  :root[data-theme="dark"]{
    --m-bg:#0B1220; --m-surface:#121C2B; --m-card:#16212F;
    --m-text:#E8EEF6; --m-muted:#93A4B8; --m-line:#24334A;
    --m-primary-light:#60A5FA;
    --m-shadow:0 1px 2px rgba(0,0,0,.4), 0 8px 24px rgba(0,0,0,.35);
  }

  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--m-bg); color:var(--m-text);
    font-family:{{ (theme.font_body or "'Inter', system-ui, sans-serif") | safe }}, system-ui, sans-serif;
    -webkit-font-smoothing:antialiased; overflow-x:hidden;
    /* The three things that most make a web page feel like a web page on a
       phone: the blue tap flash, the 300ms click delay, and the whole shell
       rubber-banding on an overscroll. */
    -webkit-tap-highlight-color:transparent;
    touch-action:manipulation;
    overscroll-behavior-y:none;
  }
  @media (prefers-reduced-motion: reduce){
    *,*::before,*::after{ animation-duration:.001ms !important; transition-duration:.001ms !important; scroll-behavior:auto !important; }
  }
  .app{
    max-width:480px; margin:0 auto; min-height:100vh; position:relative;
    padding-bottom:calc(var(--nav-h) + env(safe-area-inset-bottom, 0px) + 16px);
  }
  h1,h2,h3{ font-family:{{ (theme.font_heading or "'Inter', sans-serif") | safe }}, system-ui, sans-serif; margin:0; letter-spacing:-.01em; }
  a{ color:inherit; text-decoration:none; }
  :focus-visible{ outline:3px solid var(--m-primary-light); outline-offset:2px; border-radius:6px; }

  .skip{ position:absolute; left:-9999px; }
  .skip:focus{ left:12px; top:12px; z-index:99; background:var(--m-primary); color:#fff; padding:10px 14px; border-radius:8px; }

  /* top bar */
  .topbar{
    position:sticky; top:0; z-index:30; height:56px;
    display:flex; align-items:center; justify-content:space-between; padding:0 16px;
    background:color-mix(in srgb, var(--m-bg) 88%, transparent);
    backdrop-filter:blur(10px); border-bottom:1px solid var(--m-line);
    padding-top:env(safe-area-inset-top, 0px);
  }
  .brand{ display:flex; align-items:center; gap:9px; }
  .brand .mark{
    width:28px;height:28px;border-radius:7px; background:var(--m-primary);
    display:grid;place-items:center; color:#fff; font-weight:800; font-size:12px;
  }
  .brand b{ font-size:15px; font-weight:700; }
  .brand b i{ color:var(--m-primary); font-style:normal; }
  :root[data-theme="dark"] .brand b i{ color:var(--m-primary-light); }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]) .brand b i{ color:var(--m-primary-light); }
  }
  .bar-actions{ display:flex; gap:8px; }
  .ibtn{
    width:36px;height:36px;border-radius:9px; display:grid;place-items:center;
    background:var(--m-surface); border:1px solid var(--m-line); color:var(--m-text);
    font-size:15px; cursor:pointer;
  }

  /* facts strip - every number here is read from the database */
  .facts{ display:flex; overflow-x:auto; border-bottom:1px solid var(--m-line); scrollbar-width:none; }
  .facts::-webkit-scrollbar{display:none;}
  .fact{ flex:0 0 auto; padding:10px 16px; border-right:1px solid var(--m-line); font-size:11.5px; color:var(--m-muted); white-space:nowrap; }
  .fact b{ color:var(--m-text); font-weight:700; font-variant-numeric:tabular-nums; }

  /* hero */
  .hero-wrap{ padding:14px 14px 2px; }
  .hero-scroll{ display:flex; gap:10px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; }
  .hero-scroll::-webkit-scrollbar{display:none;}
  .hero{
    position:relative; flex:0 0 88%; scroll-snap-align:start; height:220px;
    border-radius:var(--m-radius-xl); overflow:hidden; border:1px solid var(--m-line);
    background:var(--m-surface);
  }
  .hero img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .hero::after{ content:""; position:absolute; inset:0; background:linear-gradient(180deg,rgba(8,13,23,0) 35%,rgba(8,13,23,.88) 100%); }
  .hero-tag{
    position:absolute; top:12px; left:12px; z-index:2; font-size:11px; font-weight:700;
    background:var(--m-accent); color:#1a1400; padding:4px 10px; border-radius:100px;
  }
  .hero-body{ position:absolute; left:14px; right:14px; bottom:12px; z-index:2; color:#fff; }
  .hero-body h2{ font-size:18px; font-weight:700; }
  .hero-body p{ margin:4px 0 0; font-size:12px; opacity:.85; }
  .dots{ display:flex; gap:5px; justify-content:center; margin-top:10px; }
  .dot{ width:6px;height:6px;border-radius:50%; background:var(--m-line); transition:width .2s,background .2s; }
  .dot.on{ background:var(--m-primary); width:16px; border-radius:3px; }

  /* tab views */
  .view[hidden]{ display:none; }
  .view-head{ padding:18px 16px 4px; }
  .view-head h2{ font-size:20px; font-weight:700; }
  .view-head p{ margin:5px 0 0; font-size:12.5px; color:var(--m-muted); }
  .view-foot{ padding:18px 16px 4px; margin:0; }
  .view-foot a{ font-size:12.5px; font-weight:600; color:var(--m-primary); }
  :root[data-theme="dark"] .view-foot a{ color:var(--m-primary-light); }
  .lnk{ background:none; border:none; font-family:inherit; cursor:pointer; font-size:12.5px; font-weight:600; color:var(--m-primary); padding:0; }
  :root[data-theme="dark"] .lnk{ color:var(--m-primary-light); }
  .empty{ padding:28px 16px; text-align:center; color:var(--m-muted); font-size:13px; }

  /* category filter chips */
  .chips{ display:flex; gap:7px; overflow-x:auto; scrollbar-width:none; padding:12px 16px 4px; position:sticky; top:56px; z-index:20; background:var(--m-bg); }
  .chips::-webkit-scrollbar{display:none;}
  .chip{
    flex:0 0 auto; background:var(--m-surface); border:1px solid var(--m-line);
    color:var(--m-text); font-family:inherit; font-size:12px; font-weight:600;
    padding:7px 13px; border-radius:100px; cursor:pointer; white-space:nowrap;
    transition:background .15s, color .15s, transform .12s;
  }
  .chip i{ font-style:normal; opacity:.55; font-variant-numeric:tabular-nums; }
  .chip.on{ background:var(--m-primary); border-color:var(--m-primary); color:#fff; }
  .chip.on i{ opacity:.75; }
  .chip:active{ transform:scale(.95); }

  /* model grid */
  .grid{ display:grid; grid-template-columns:repeat(2, 1fr); gap:10px; padding:12px 16px 0; }
  .card{ background:var(--m-card); border:1px solid var(--m-line); border-radius:var(--m-radius); overflow:hidden; box-shadow:var(--m-shadow); transition:transform .12s; }
  .card[hidden]{ display:none; }
  .card:active{ transform:scale(.97); }
  .card img{ width:100%; height:104px; object-fit:cover; display:block; background:var(--m-surface); }
  .card-ph{ display:grid; place-items:center; height:104px; background:var(--m-surface); color:var(--m-muted); }
  .card .in{ padding:9px 10px 11px; }
  .card .cat{ font-size:10px; color:var(--m-muted); }
  .card .mdl{ font-size:12.5px; font-weight:700; margin-top:2px; }
  .card .specs{ font-size:10.5px; color:var(--m-muted); margin-top:4px; }
  .card .price{ margin-top:6px; font-size:12.5px; font-weight:800; color:var(--m-primary); font-variant-numeric:tabular-nums; }
  .card .price span{ font-size:10px; font-weight:600; color:var(--m-muted); }
  .card .price.muted{ color:var(--m-muted); font-weight:700; }
  :root[data-theme="dark"] .card .price{ color:var(--m-primary-light); }

  /* project rows without a usable photo get a tile, not an empty box */
  .proj-ph{ width:58px;height:58px;border-radius:10px; background:var(--m-surface); color:var(--m-muted); display:grid; place-items:center; flex:0 0 auto; }

  /* sections */
  .sec{ padding:20px 16px 0; }
  .sec-head{ display:flex; align-items:baseline; justify-content:space-between; margin-bottom:12px; }
  .sec-head h3{ font-size:16px; font-weight:700; }
  .sec-head a{ font-size:12.5px; color:var(--m-primary); font-weight:600; }
  :root[data-theme="dark"] .sec-head a{ color:var(--m-primary-light); }

  .pkgs{ display:flex; gap:10px; overflow-x:auto; scrollbar-width:none; padding-bottom:2px; }
  .pkgs::-webkit-scrollbar{display:none;}
  .pkg{ flex:0 0 170px; background:var(--m-card); border:1px solid var(--m-line); border-radius:var(--m-radius); overflow:hidden; box-shadow:var(--m-shadow); }
  .pkg img{ width:100%; height:100px; object-fit:cover; display:block; background:var(--m-surface); }
  .pkg .in{ padding:10px 11px 12px; }
  .pkg .cat{ font-size:10.5px; color:var(--m-muted); }
  .pkg .mdl{ font-size:13px; font-weight:700; margin-top:2px; }
  .pkg .specs{ font-size:11px; color:var(--m-muted); margin-top:5px; }
  .pkg .price{ margin-top:7px; font-size:13.5px; font-weight:800; color:var(--m-primary); font-variant-numeric:tabular-nums; }
  :root[data-theme="dark"] .pkg .price{ color:var(--m-primary-light); }
  .pkg .price small{ font-weight:500; font-size:10.5px; color:var(--m-muted); }

  /* calculator */
  .calc{ margin:20px 16px 0; background:var(--m-card); border:1px solid var(--m-line); border-radius:var(--m-radius-xl); padding:16px; box-shadow:var(--m-shadow); }
  .calc h3{ font-size:15px; font-weight:700; }
  .calc p.sub{ margin:2px 0 0; font-size:11.5px; color:var(--m-muted); }
  .row{ display:flex; gap:10px; margin-top:12px; }
  .fld{ flex:1; }
  .fld label{ font-size:11px; color:var(--m-muted); display:block; margin-bottom:5px; }
  .fld select, .fld input{
    width:100%; background:var(--m-bg); border:1px solid var(--m-line); border-radius:9px;
    padding:10px; font-size:13.5px; color:var(--m-text); font-family:inherit;
  }
  .calc-out{
    margin-top:14px; background:var(--m-surface); border:1px solid var(--m-line);
    border-radius:var(--m-radius); padding:12px 13px;
  }
  .calc-out .lbl{ font-size:11px; color:var(--m-muted); }
  .calc-out .amt{ font-size:19px; font-weight:800; color:var(--m-primary); margin-top:2px; font-variant-numeric:tabular-nums; }
  :root[data-theme="dark"] .calc-out .amt{ color:var(--m-primary-light); }
  .calc-out .note{ font-size:10.5px; color:var(--m-muted); margin-top:6px; line-height:1.45; }

  /* projects */
  .proj{ display:flex; gap:11px; align-items:center; padding:11px 0; border-bottom:1px solid var(--m-line); }
  .proj:last-child{ border-bottom:none; }
  .proj img{ width:58px;height:58px;border-radius:10px;object-fit:cover; background:var(--m-surface); flex:0 0 auto; }
  .proj .t{ font-size:13.5px; font-weight:600; }
  .proj .s{ font-size:11.5px; color:var(--m-muted); margin-top:2px; }
  .tag{ margin-left:auto; font-size:10px; font-weight:600; color:var(--m-primary); border:1px solid var(--m-line); background:var(--m-surface); padding:3px 9px; border-radius:100px; white-space:nowrap; }

  /* trust */
  .trust{ display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .tc{ background:var(--m-card); border:1px solid var(--m-line); border-radius:var(--m-radius); padding:12px; box-shadow:var(--m-shadow); }
  .tc .n{ font-size:17px; font-weight:800; color:var(--m-primary); }
  :root[data-theme="dark"] .tc .n{ color:var(--m-primary-light); }
  .tc .l{ font-size:11px; color:var(--m-muted); margin-top:3px; line-height:1.35; }

  /* bottom nav */
  .bnav{
    position:fixed; left:0; right:0; bottom:0; z-index:40; max-width:480px; margin:0 auto;
    background:color-mix(in srgb, var(--m-bg) 92%, transparent); backdrop-filter:blur(12px);
    border-top:1px solid var(--m-line);
    height:calc(var(--nav-h) + env(safe-area-inset-bottom, 0px));
    padding-bottom:env(safe-area-inset-bottom, 0px);
    display:flex; align-items:center; justify-content:space-around;
  }
  .bnav button{
    display:flex; flex-direction:column; align-items:center; gap:3px;
    background:none; border:none; font-family:inherit; cursor:pointer;
    color:var(--m-muted); font-size:10px; font-weight:600; padding:6px 10px;
    transition:color .15s, transform .12s;
  }
  .bnav button .ic{ display:flex; align-items:center; justify-content:center; height:20px; }
  .bnav button.on{ color:var(--m-primary); }
  .bnav button:active{ transform:scale(.92); }
  :root[data-theme="dark"] .bnav button.on{ color:var(--m-primary-light); }

  .call-fab{
    position:fixed; z-index:45; right:16px;
    bottom:calc(var(--nav-h) + env(safe-area-inset-bottom, 0px) + 14px);
    background:#25D366; color:#08240f; display:flex; align-items:center; gap:7px;
    padding:9px 13px; border-radius:100px; font-weight:700; font-size:12px;
    box-shadow:0 6px 16px rgba(37,211,102,.32);
  }
  @media (min-width:480px){ .call-fab{ right:calc(50% - 224px); } }


  .hero-cta{
    display:inline-block; margin-top:9px; background:var(--m-accent); color:#1a1400;
    font-weight:700; font-size:12.5px; padding:8px 13px; border-radius:9px;
  }
  .calc-go{
    width:100%; margin-top:12px; padding:12px; border:none; border-radius:10px;
    background:var(--m-primary); color:#fff; font-weight:700; font-size:14px;
    font-family:inherit; cursor:pointer;
  }
  .calc-go:active{ transform:translateY(1px); }
  .calc-derived{ font-size:11.5px; color:var(--m-muted); margin-top:8px; }

  /* Support sheet */
  .sheet-backdrop{
    position:fixed; inset:0; background:rgba(6,9,13,.55); z-index:60;
    opacity:0; pointer-events:none; transition:opacity .2s ease;
  }
  .sheet-backdrop.open{ opacity:1; pointer-events:auto; }
  .sheet{
    position:fixed; left:0; right:0; bottom:0; z-index:61; max-width:480px; margin:0 auto;
    background:var(--m-card); border-top:1px solid var(--m-line);
    border-radius:20px 20px 0 0; transform:translateY(100%);
    transition:transform .28s cubic-bezier(.32,.72,0,1);
    max-height:82vh; display:flex; flex-direction:column;
    padding-bottom:env(safe-area-inset-bottom, 0px);
  }
  .sheet.open{ transform:translateY(0); }
  .sheet-grip{ width:36px; height:4px; background:var(--m-line); border-radius:3px; margin:10px auto 0; }
  .sheet-head{ display:flex; align-items:center; gap:10px; padding:12px 16px; border-bottom:1px solid var(--m-line); }
  .sheet-head .t1{ font-size:14px; font-weight:700; }
  .sheet-head .t2{ font-size:11.5px; color:#16a34a; display:flex; align-items:center; gap:5px; }
  .sheet-head .t2::before{ content:""; width:6px; height:6px; border-radius:50%; background:#16a34a; }
  .sheet-x{ margin-left:auto; background:none; border:none; font-size:19px; color:var(--m-muted); cursor:pointer; }
  .sheet-body{ padding:14px 16px; overflow-y:auto; }
  .sheet-body p{ margin:0 0 10px; font-size:13.5px; line-height:1.55; }
  .sheet-form{ display:flex; flex-direction:column; gap:8px; }
  .sheet-form input{
    padding:11px 13px; border:1px solid var(--m-line); border-radius:10px;
    background:var(--m-bg); color:var(--m-text); font:inherit; font-size:15px;
  }
  .sheet-form button{
    padding:12px; border:none; border-radius:10px; background:var(--m-primary);
    color:#fff; font-weight:700; font-size:14px; font-family:inherit; cursor:pointer;
  }
  .sheet-err{ font-size:12.5px; color:#b91c1c; margin:0; }
  .sheet-ok{ font-size:13.5px; color:#166534; font-weight:600; line-height:1.5; }

  @media (prefers-reduced-motion: reduce){ *{ transition:none !important; scroll-behavior:auto !important; } }
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="app">

  <header class="topbar">
    <div class="brand">
      <div class="mark" aria-hidden="true">BH</div>
      <b>Bongshai <i>Housing</i></b>
    </div>
    <div class="bar-actions">
      <a class="ibtn" href="/products-and-solutions.html" aria-label="Search models">⌕</a>
      <button class="ibtn" id="themeBtn" type="button" aria-label="Switch between light and dark theme">◐</button>
      <a class="ibtn" href="tel:{{ (theme.hotline_phone or '+8801781636613') | replace(' ', '') | replace('-', '') }}" aria-label="Call Bongshai Housing">✆</a>
    </div>
  </header>

  <main id="main">

  {# One row definition for both the Home teaser and the Projects tab.
     17 of the 18 project rows store the same string in title and location, so
     the second line is printed only when it actually says something new. #}
  {% macro projectRow(pr) %}
  <a class="proj" href="/{{ pr.slug }}">
    {% if pr.image and 'unavailable' not in pr.image %}
      <img src="/{{ pr.image }}" alt="" loading="lazy" decoding="async">
    {% else %}
      <span class="proj-ph" aria-hidden="true">{{ icons.icon('map-pin', 18) }}</span>
    {% endif %}
    <div>
      <div class="t">{{ pr.title }}</div>
      {% if pr.location and pr.location | trim != pr.title | trim %}
        <div class="s">{{ pr.location }}</div>
      {% endif %}
    </div>
    {% if pr.status_label %}<span class="tag">{{ pr.status_label }}</span>{% endif %}
  </a>
  {% endmacro %}

  {# Three sibling views in one document. The bottom bar swaps them without a
     navigation, so a tab change costs nothing and the shell never unloads -
     which is both what makes this read as an app and what Capacitor needs. #}
  <section class="view active" id="view-home">

  <section class="facts" aria-label="Key figures">
    {% if rateRange %}<div class="fact">Rate <b>{{ rateRange.min }}–{{ rateRange.max }}</b> ৳/sqft</div>{% endif %}
    <div class="fact">Build time <b>45–60</b> days</div>
    <div class="fact">Frame <b>Grade 50</b> steel, BNBC 2020</div>
    {% if modelCount %}<div class="fact">Models <b>{{ modelCount }}</b></div>{% endif %}
    <div class="fact">Since <b>2008</b></div>
  </section>

  <div class="hero-wrap">
    <div class="hero-scroll" id="heroScroll">
      {% for c in categories %}{% if loop.index0 < 4 %}
      <a class="hero" href="/{{ c.landing_page_slug }}">
        {% if c.hero_image %}<img src="/{{ c.hero_image }}" alt="" loading="{{ 'eager' if loop.first else 'lazy' }}" decoding="async">{% endif %}
        <span class="hero-tag">{{ c.name }}</span>
        <div class="hero-body">
          <h2>{{ c.name }}</h2>
          <p>Browse models, sizes and package prices.</p>
          <span class="hero-cta">Explore {{ c.name }} →</span>
        </div>
      </a>
      {% endif %}{% endfor %}
    </div>
    <div class="dots" id="dots" aria-hidden="true"></div>
  </div>

  <section class="sec">
    <div class="sec-head"><h3>Popular models</h3><a href="/products-and-solutions.html">View all</a></div>
    <div class="pkgs">
      {% for p in featured %}
      <a class="pkg" href="/{{ p.slug }}">
        <img src="/{{ p.image }}" alt="{{ p.alt }}" loading="lazy" decoding="async" width="170" height="100">
        <div class="in">
          <div class="cat">{{ p.category }}</div>
          <div class="mdl">{{ p.model }}</div>
          <div class="specs">
            {% if p.area %}{{ p.area }} sqft{% endif %}
            {%- if p.beds %} · {{ p.beds }} bed{% endif %}
            {%- if p.baths %} · {{ p.baths }} bath{% endif %}
          </div>
          {% if p.rate %}<div class="price">৳{{ p.rate }} <small>/sqft from</small></div>
          {% elif p.price %}<div class="price">৳{{ p.price }} <small>package</small></div>{% endif %}
        </div>
      </a>
      {% endfor %}
    </div>
  </section>

  <section class="calc" aria-labelledby="calcTitle">
    <h3 id="calcTitle">Estimate your cost</h3>
    <p class="sub">Uses the real per-sqft range of our built models.</p>
    <div class="row">
      <div class="fld">
        <label for="calcKatha">জমি / Land (katha)</label>
        <input id="calcKatha" type="number" inputmode="decimal" min="0.5" max="100" step="0.5" value="3">
      </div>
      <div class="fld">
        <label for="calcFloors">তলা / Floors</label>
        <select id="calcFloors">
          <option value="1">1</option>
          <option value="2" selected>2</option>
          <option value="3">3</option>
          <option value="4">4</option>
          <option value="5">5</option>
          <option value="6">6</option>
        </select>
      </div>
    </div>
    <div class="row">
      <div class="fld">
        <label for="calcFinish">ফিনিশিং / Finishing</label>
        <select id="calcFinish">
          <option value="0.9">Basic</option>
          <option value="1" selected>Standard</option>
          <option value="1.18">Premium</option>
        </select>
      </div>
      <div class="fld">
        <label for="calcType">ধরন / Building type</label>
        <select id="calcType">
          {% for r in calcRates %}<option value="{{ r.min }}|{{ r.max }}">{{ r.name }}</option>{% endfor %}
        </select>
      </div>
    </div>
    <button type="button" class="calc-go" id="calcGo">Calculate Estimate</button>
    <div class="calc-out" aria-live="polite">
      <div class="lbl">Estimated package range</div>
      <div class="amt" id="calcOut">—</div>
      <p class="note"><span id="calcBasis"></span>An indicative range from published model rates, not a quotation. Final cost depends on site conditions, finish level and structural design.</p>
    </div>
  </section>

  {% if projects.length %}
  <section class="sec">
    <div class="sec-head"><h3>Delivered projects</h3><button class="lnk" type="button" data-goto="projects">See all</button></div>
    {% for pr in projects.slice(0, 4) %}
    {{ projectRow(pr) }}
    {% endfor %}
  </section>
  {% endif %}

  <section class="sec">
    <div class="sec-head"><h3>Why Bongshai</h3></div>
    <div class="trust">
      <div class="tc"><div class="n">up to 3×</div><div class="l">faster than traditional brick-and-concrete construction</div></div>
      <div class="tc"><div class="n">Grade 50</div><div class="l">high-tensile structural steel, engineered to BNBC 2020 seismic</div></div>
      <div class="tc"><div class="n">2008</div><div class="l">building across Bangladesh since</div></div>
      <div class="tc"><div class="n">45–60</div><div class="l">days to a completed earthquake-resistant home</div></div>
    </div>
  </section>

  </section>{# /view-home #}

  <section class="view" id="view-models" hidden>
    <div class="view-head">
      <h2>Models</h2>
      <p>{{ modelCount }} models across {{ filters.length }} categories. Prices are package prices.</p>
    </div>

    <div class="chips" id="chips" role="tablist" aria-label="Filter by category">
      <button class="chip on" type="button" data-cat="all" role="tab" aria-selected="true">All <i>{{ catalogue.length }}</i></button>
      {% for f in filters %}
      <button class="chip" type="button" data-cat="{{ f.id }}" role="tab" aria-selected="false">{{ f.name }} <i>{{ f.n }}</i></button>
      {% endfor %}
    </div>

    <div class="grid" id="modelGrid">
      {% for p in catalogue %}
      <a class="card" href="/{{ p.slug }}" data-cat="{{ p.categoryId }}">
        {% if p.image %}
          <img src="/{{ p.image }}" alt="{{ p.alt }}" loading="lazy" decoding="async" width="168" height="104">
        {% else %}
          <span class="card-ph" aria-hidden="true">{{ icons.icon('home', 20) }}</span>
        {% endif %}
        <div class="in">
          <div class="cat">{{ p.category }}</div>
          <div class="mdl">{{ p.model }}</div>
          <div class="specs">
            {%- if p.area %}{{ p.area }} sqft{% endif -%}
            {%- if p.beds %} · {{ p.beds }} bed{% endif -%}
            {%- if p.baths %} · {{ p.baths }} bath{% endif -%}
          </div>
          {% if p.rate %}<div class="price">{{ p.rate }} <span>/sqft from</span></div>
          {% elif p.price %}<div class="price">{{ p.price }}</div>
          {% else %}<div class="price muted">Contact Sales</div>{% endif %}
        </div>
      </a>
      {% endfor %}
    </div>
    <p class="empty" id="modelEmpty" hidden>No models in this category.</p>

    {# Real link, so the full catalogue stays reachable without JS. #}
    <p class="view-foot"><a href="/products-and-solutions.html">Open the full catalogue →</a></p>
  </section>

  <section class="view" id="view-projects" hidden>
    <div class="view-head">
      <h2>Projects</h2>
      <p>{{ projectCount }} delivered across Bangladesh.</p>
    </div>
    <section class="sec">
      {% for pr in projects %}
      {{ projectRow(pr) }}
      {% endfor %}
    </section>
    <p class="view-foot"><a href="/projects.html">Open the full project list →</a></p>
  </section>

  </main>
  <div style="height:10px"></div>
</div>

{# The floating WhatsApp pill is gone here too: it bypassed Customer Support,
   so the enquiry was never recorded. Support is in the bar below, and
   WhatsApp is offered from inside a conversation when it actually helps. #}


{# The floating support pill is gone: Support is a tab now, and the pill sat
   on top of the estimator's own inputs. #}

<div class="sheet-backdrop" id="sheetBackdrop"></div>
<div class="sheet" id="supportSheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle">
  <div class="sheet-grip"></div>
  <div class="sheet-head">
    <div>
      <div class="t1" id="sheetTitle">Customer Support</div>
      <div class="t2">Online</div>
    </div>
    <button class="sheet-x" id="sheetClose" type="button" aria-label="Close">✕</button>
  </div>
  <div class="sheet-body">
    <p>আপনার নাম ও মোবাইল নম্বর দিন — আমাদের টিম সরাসরি যোগাযোগ করবে।<br>
      <span style="font-size:12px;opacity:.75">Leave your name and number and our team will get back to you.</span></p>
    <form class="sheet-form" id="sheetForm" novalidate>
      <input type="text" id="sheetName" placeholder="আপনার নাম / Your name" autocomplete="name" maxlength="60" required>
      <input type="tel" id="sheetPhone" placeholder="০১৭xxxxxxxx" autocomplete="tel" inputmode="tel" maxlength="20" required>
      <p class="sheet-err" id="sheetErr" hidden role="alert"></p>
      <button type="submit" id="sheetSubmit">পাঠান / Send</button>
    </form>
    <p class="sheet-ok" id="sheetOk" hidden>ধন্যবাদ! আমাদের টিম শীঘ্রই যোগাযোগ করবে।<br>
      <span style="font-size:12px;font-weight:400">Thank you — our team will contact you shortly.</span></p>
  </div>
</div>

{# Buttons, not links: every tab acts inside the shell. Models and Projects
   used to load the full desktop pages, and Support pointed at #support, an id
   that was never in the document. #}
<nav class="bnav" aria-label="Primary">
  <button type="button" data-view="home" class="on" aria-current="page"><span class="ic">{{ icons.icon('home', 20) }}</span>Home</button>
  <button type="button" data-view="models"><span class="ic">{{ icons.icon('folder', 20) }}</span>Models</button>
  <button type="button" data-act="calc"><span class="ic">{{ icons.icon('calculator', 20) }}</span>Calculator</button>
  <button type="button" data-view="projects"><span class="ic">{{ icons.icon('map-pin', 20) }}</span>Projects</button>
  <button type="button" data-act="support"><span class="ic">{{ icons.icon('chat', 20) }}</span>Support</button>
</nav>

<script>
(function(){
  // ---- theme toggle: remembers the reader's choice, defaults to the OS ----
  var root = document.documentElement;
  try {
    var saved = localStorage.getItem('bh-m-theme');
    if (saved) root.setAttribute('data-theme', saved);
  } catch (e) { /* private mode - fall through to the OS preference */ }

  document.getElementById('themeBtn').addEventListener('click', function(){
    var isDark = root.getAttribute('data-theme') === 'dark'
      || (!root.getAttribute('data-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches);
    var next = isDark ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('bh-m-theme', next); } catch (e) { /* not fatal */ }
  });

  // ---- hero dots: derived from real scroll position, not a magic multiplier ----
  var scroller = document.getElementById('heroScroll');
  var dotWrap = document.getElementById('dots');
  var slides = scroller ? scroller.children.length : 0;
  if (scroller && slides > 1) {
    for (var i = 0; i < slides; i++) {
      var d = document.createElement('span');
      d.className = 'dot' + (i === 0 ? ' on' : '');
      dotWrap.appendChild(d);
    }
    var dots = dotWrap.children;
    scroller.addEventListener('scroll', function(){
      // Measure the actual slide pitch rather than assuming it equals the
      // viewport width - the cards are 88% wide with a gap.
      var first = scroller.children[0];
      var pitch = first ? first.getBoundingClientRect().width + 10 : scroller.clientWidth;
      var idx = Math.max(0, Math.min(slides - 1, Math.round(scroller.scrollLeft / pitch)));
      for (var j = 0; j < dots.length; j++) dots[j].classList.toggle('on', j === idx);
    }, { passive: true });
  }

  // ---- estimator ----------------------------------------------------------
  // Bangladeshi customers describe a plot in katha and storeys, not square
  // feet, so that is what the form asks for and the derived area is shown back
  // to them rather than hidden inside the sum.
  var SQFT_PER_KATHA = 720;   // standard conversion
  var COVERAGE = 0.62;        // typical built footprint after setbacks

  var katha = document.getElementById('calcKatha');
  var floors = document.getElementById('calcFloors');
  var finish = document.getElementById('calcFinish');
  var type = document.getElementById('calcType');
  var out = document.getElementById('calcOut');
  var basis = document.getElementById('calcBasis');
  var go = document.getElementById('calcGo');

  function taka(n){
    var s = Math.round(n).toString();
    if (s.length <= 3) return s;
    return s.slice(0, -3).replace(/\B(?=(\d{2})+(?!\d))/g, ',') + ',' + s.slice(-3);
  }

  function recalc(){
    if (!type || !type.value) { out.textContent = 'Rates unavailable'; return; }
    var k = parseFloat(katha.value);
    var f = parseInt(floors.value, 10);
    var mult = parseFloat(finish.value) || 1;
    if (!isFinite(k) || k <= 0 || !isFinite(f) || f <= 0) { out.textContent = '—'; return; }

    var sqft = Math.round(k * SQFT_PER_KATHA * COVERAGE * f);
    var parts = type.value.split('|');
    var lo = parseFloat(parts[0]) * sqft * mult;
    var hi = parseFloat(parts[1]) * sqft * mult;

    out.textContent = lo === hi ? '৳' + taka(lo) : '৳' + taka(lo) + ' – ৳' + taka(hi);
    if (basis) {
      basis.textContent = '≈ ' + taka(sqft) + ' sqft (' + k + ' katha, ' + f + ' floor'
        + (f === 1 ? '' : 's') + ', ~' + Math.round(COVERAGE * 100) + '% coverage) at '
        + taka(parseFloat(parts[0])) + '–' + taka(parseFloat(parts[1])) + ' ৳/sqft. ';
    }
  }

  if (go) go.addEventListener('click', recalc);
  [katha, floors, finish, type].forEach(function(el){
    if (el) el.addEventListener('change', recalc);
  });
  if (katha) katha.addEventListener('input', recalc);
  recalc();

  // ---- support sheet ------------------------------------------------------
  var sheet = document.getElementById('supportSheet');
  var backdrop = document.getElementById('sheetBackdrop');

  function openSheet(){
    sheet.classList.add('open'); backdrop.classList.add('open');
    setTimeout(function(){ var n = document.getElementById('sheetName'); if (n) n.focus(); }, 150);
  }
  function closeSheet(){ sheet.classList.remove('open'); backdrop.classList.remove('open'); }

  if (backdrop) backdrop.addEventListener('click', closeSheet);
  var sx = document.getElementById('sheetClose');
  if (sx) sx.addEventListener('click', closeSheet);
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && sheet && sheet.classList.contains('open')) closeSheet();
  });

  // ---- tab views ----------------------------------------------------------
  // Switching is local: no request, no reload, and each tab keeps its own
  // scroll position the way a native tab bar does.
  var views = {}, tabs = [].slice.call(document.querySelectorAll('.bnav button'));
  [].forEach.call(document.querySelectorAll('.view'), function(v){
    views[v.id.replace('view-', '')] = v;
  });
  var current = 'home';
  var scrollMemory = { home: 0, models: 0, projects: 0 };

  function showView(name, push){
    if (!views[name] || name === current) return;
    scrollMemory[current] = window.scrollY;
    views[current].hidden = true;
    views[current].classList.remove('active');
    views[name].hidden = false;
    views[name].classList.add('active');
    current = name;

    tabs.forEach(function(t){
      var on = t.getAttribute('data-view') === name;
      t.classList.toggle('on', on);
      if (on) t.setAttribute('aria-current', 'page'); else t.removeAttribute('aria-current');
    });

    window.scrollTo(0, scrollMemory[name] || 0);
    // The hash is what Android's back button walks, so a tab change is a
    // history entry rather than an exit from the app.
    if (push) history.pushState({ view: name }, '', name === 'home' ? '#' : '#' + name);
  }

  tabs.forEach(function(t){
    t.addEventListener('click', function(){
      var v = t.getAttribute('data-view');
      var a = t.getAttribute('data-act');
      if (v) { showView(v, true); return; }
      if (a === 'support') { openSheet(); return; }
      if (a === 'calc') {
        showView('home', true);
        var c = document.getElementById('calcTitle');
        if (c) c.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  // "See all" on the home teaser jumps to the Projects tab, not away.
  [].forEach.call(document.querySelectorAll('[data-goto]'), function(b){
    b.addEventListener('click', function(){ showView(b.getAttribute('data-goto'), true); });
  });

  window.addEventListener('popstate', function(e){
    showView((e.state && e.state.view) || (location.hash || '#').slice(1) || 'home', false);
  });
  // Deep link: /m#models opens on that tab.
  var initial = (location.hash || '').slice(1);
  if (views[initial]) showView(initial, false);

  // ---- model category filter ---------------------------------------------
  var chips = [].slice.call(document.querySelectorAll('.chip'));
  var cards = [].slice.call(document.querySelectorAll('#modelGrid .card'));
  var empty = document.getElementById('modelEmpty');
  chips.forEach(function(ch){
    ch.addEventListener('click', function(){
      var want = ch.getAttribute('data-cat');
      chips.forEach(function(c){
        var on = c === ch;
        c.classList.toggle('on', on);
        c.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      var shown = 0;
      cards.forEach(function(card){
        var hit = want === 'all' || card.getAttribute('data-cat') === want;
        card.hidden = !hit;
        if (hit) shown++;
      });
      if (empty) empty.hidden = shown > 0;
      window.scrollTo(0, 0);
    });
  });

  // Same number rule as lib/leads.js, so a wrong one is caught before a round trip.
  function normalisePhone(raw){
    var d = String(raw || '').replace(/\D/g, '');
    if (d.indexOf('880') === 0) d = '0' + d.slice(3);
    else if (d.length === 10 && d.charAt(0) !== '0') d = '0' + d;
    return /^01[3-9]\d{8}$/.test(d) ? d : null;
  }

  var sform = document.getElementById('sheetForm');
  if (sform) {
    sform.addEventListener('submit', async function(e){
      e.preventDefault();
      var name = (document.getElementById('sheetName').value || '').trim();
      var phone = (document.getElementById('sheetPhone').value || '').trim();
      var err = document.getElementById('sheetErr');
      var fail = function(m){ err.textContent = m; err.hidden = false; };
      if (name.length < 2) return fail('আপনার নাম লিখুন / Please enter your name.');
      if (!normalisePhone(phone)) return fail('সঠিক মোবাইল নম্বর দিন / Enter a valid mobile number.');
      err.hidden = true;
      var btn = document.getElementById('sheetSubmit');
      btn.disabled = true; btn.textContent = 'পাঠানো হচ্ছে… / Sending…';
      try {
        await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: name, phone: phone, source: 'mobile_support', site: location.hostname.replace(/^www\./, '') })
        });
      } catch (e2) { /* the server keeps a fallback log; do not alarm the customer */ }
      sform.hidden = true;
      document.getElementById('sheetOk').hidden = false;
      setTimeout(closeSheet, 2600);
    });
  }
})();
</script>
</body>
</html>
