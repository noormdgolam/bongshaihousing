}

.bh-ai-cta-btn:hover {
  background: #059669;
}

.bh-ai-time {
  font-size: 10px;
  color: #9CA3AF;
  margin-top: 3px;
  padding: 0 4px;
}
.bh-ai-msg-user .bh-ai-time {
  align-self: flex-end;
}

/* Typing Indicator */
.bh-ai-typing {
  padding: 8px 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  background: #F9FAFB;
  border-top: 1px solid #F3F4F6;
}

.bh-ai-dots {
  display: flex;
  gap: 4px;
}
.bh-ai-dots span {
  width: 6px;
  height: 6px;
  background: #6B7280;
  border-radius: 50%;
  animation: bhAiDotPulse 1.2s infinite ease-in-out;
}
.bh-ai-dots span:nth-child(2) { animation-delay: 0.2s; }
.bh-ai-dots span:nth-child(3) { animation-delay: 0.4s; }

@keyframes bhAiDotPulse {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

.bh-ai-typing-text {
  font-size: 11px;
  color: #6B7280;
  font-style: italic;
}

/* Input Form */
.bh-ai-form {
  padding: 10px 12px;
  background: #ffffff;
  border-top: 1px solid #E5E7EB;
  display: flex;
  gap: 8px;
  align-items: center;
}

.bh-ai-input {
  flex: 1;
  border: 1px solid #D1D5DB;
  border-radius: 24px;
  padding: 8px 14px;
  font-size: 13.5px;
  outline: none;
  transition: border-color 0.15s, box-shadow 0.15s;
}

.bh-ai-input:focus {
  border-color: #2563EB;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
}

.bh-ai-send-btn {
  width: 36px;
  height: 36px;
  background: #1E40AF;
  color: #ffffff;
  border: none;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s, transform 0.1s;
  flex-shrink: 0;
}

.bh-ai-send-btn:hover {
  background: #1D4ED8;
  transform: scale(1.05);
}

.bh-ai-send-btn:disabled {
  background: #9CA3AF;
  cursor: not-allowed;
  transform: none;
}

/* Mobile responsive optimization */
@media (max-width: 600px) {
  .bh-ai-widget {
    bottom: 80px;
    right: 16px;
  }
  .bh-ai-chat-box {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100vw;
    height: 80vh;
    max-width: 100vw;
    max-height: 85vh;
    border-radius: 16px 16px 0 0;
  }
  .bh-ai-badge {
    display: none;
  }
  .bh-ai-toggle-btn {
    padding: 12px;
    border-radius: 50%;
    width: 48px;
    height: 48px;
    justify-content: center;
  }
}
</style>

<script>
(function() {
  const toggleBtn = document.getElementById('bhAiChatToggle');
  const chatBox = document.getElementById('bhAiChatBox');
  const closeBtn = document.getElementById('bhAiCloseBtn');
  const resetBtn = document.getElementById('bhAiResetBtn');
  const form = document.getElementById('bhAiForm');
  const input = document.getElementById('bhAiInput');
  const sendBtn = document.getElementById('bhAiSendBtn');
  const messagesContainer = document.getElementById('bhAiMessages');
  const typingIndicator = document.getElementById('bhAiTyping');
  const quickPrompts = document.getElementById('bhAiQuickPrompts');

  const STORAGE_KEY = 'bh_ai_chat_history_v1';

  let conversation = [];

  // Load from session storage
  try {
    const saved = sessionStorage.getItem(STORAGE_KEY);
    if (saved) {
      conversation = JSON.parse(saved);
      conversation.forEach(msg => appendMessage(msg.role, msg.content, false));
    }
  } catch (e) {
    conversation = [];
  }

  function saveHistory() {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(conversation));
    } catch (e) {}
  }

  function toggleChat(forceOpen) {
    const isHidden = chatBox.hasAttribute('hidden');
    const shouldOpen = forceOpen !== undefined ? forceOpen : isHidden;

    if (shouldOpen) {
      chatBox.removeAttribute('hidden');
      toggleBtn.setAttribute('aria-expanded', 'true');
      input.focus();
      scrollBottom();
    } else {
      chatBox.setAttribute('hidden', '');
      toggleBtn.setAttribute('aria-expanded', 'false');
    }
  }

  toggleBtn.addEventListener('click', () => toggleChat());
  closeBtn.addEventListener('click', () => toggleChat(false));

  resetBtn.addEventListener('click', () => {
    if (confirm('Clear chat history? / চ্যাট হিস্টোরি মুছতে চান?')) {
      conversation = [];
      sessionStorage.removeItem(STORAGE_KEY);
      messagesContainer.innerHTML = `
        <div class="bh-ai-msg bh-ai-msg-bot">
          <div class="bh-ai-bubble">
            <p><strong>স্বাগতম বঙ্গশাই হাউজিং-এ!</strong> 👋</p>
            <p>আমি আপনার এআই সহকারী। বাড়ি নির্মাণ বা ইস্পাত কাঠামো সংক্রান্ত যেকোনো প্রশ্ন করুন।</p>
          </div>
          <span class="bh-ai-time">Just now</span>
        </div>
      `;
    }
  });

  // Quick prompts
  if (quickPrompts) {
    quickPrompts.addEventListener('click', (e) => {
      const btn = e.target.closest('.bh-ai-chip');
      if (!btn) return;
      const prompt = btn.getAttribute('data-prompt');
      if (prompt) {
        input.value = prompt;
        sendMessage();
      }
    });
  }

  function formatText(text) {
    // Simple sanitizing & markdown-like parsing for bold and links
    let safe = text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    // Bold **text**
    safe = safe.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

    // Phone / WhatsApp links
    safe = safe.replace(/(\+?880\s?1[3-9]\d{2}-?\d{6})/g, '<a href="https://wa.me/8801711200241" target="_blank" rel="noopener noreferrer">📞 $1</a>');

    // URLs
    safe = safe.replace(/(https?:\/\/[^\s]+)/g, '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>');

    // Convert newlines to paragraphs/breaks
    return safe.replace(/\n\n/g, '</p><p>').replace(/\n/g, '<br>');
  }

  function appendMessage(role, text, save = true) {
    const msgDiv = document.createElement('div');
    msgDiv.className = `bh-ai-msg bh-ai-msg-${role === 'user' ? 'user' : 'bot'}`;

    const formatted = formatText(text);
    msgDiv.innerHTML = `
      <div class="bh-ai-bubble">
        <p>${formatted}</p>
      </div>
      <span class="bh-ai-time">${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
    `;

    messagesContainer.appendChild(msgDiv);
    scrollBottom();

    if (save) {
      conversation.push({ role, content: text });
      saveHistory();
    }
  }

  function scrollBottom() {
    setTimeout(() => {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }, 50);
  }

  async function sendMessage() {
    const text = input.value.trim();
    if (!text) return;

    input.value = '';
    appendMessage('user', text);

    // Disable input while generating
    input.disabled = true;
    sendBtn.disabled = true;
    typingIndicator.removeAttribute('hidden');
    scrollBottom();

    try {
      const res = await fetch('/api/ai-chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          messages: conversation,
          context: {
            pageUrl: window.location.pathname,
            pageTitle: document.title
          }
        })
      });

      const data = await res.json();
      typingIndicator.setAttribute('hidden', '');

      if (data && data.message) {
        appendMessage('assistant', data.message);
      } else {
        appendMessage('assistant', 'আমাদের সার্ভারের সাথে সংযোগে সাময়িক ত্রুটি হয়েছে। অনুগ্রহ করে সরাসরি আমাদের হোয়াটসঅ্যাপে নক দিন: +880 1711-200241.');
      }
    } catch (err) {
      typingIndicator.setAttribute('hidden', '');
      appendMessage('assistant', 'সংযোগ বিচ্ছিন্ন হয়েছে। আমাদের হটলাইন +8801711200241-এ যোগাযোগ করুন।');
    } finally {
      input.disabled = false;
      sendBtn.disabled = false;
      input.focus();
      scrollBottom();
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    sendMessage();
  });
})();
</script>
