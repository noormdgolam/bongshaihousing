    <span class="bh-ai-pulse" aria-hidden="true"></span>
    <span class="bh-ai-icon">🤖</span>
    <span class="bh-ai-badge">AI Assistant</span>
  </button>

  <!-- Chat Dialog Window -->
  <div id="bhAiChatBox" class="bh-ai-chat-box" role="dialog" aria-modal="true" aria-labelledby="bhAiTitle" hidden>
    <!-- Header -->
    <div class="bh-ai-header">
      <div class="bh-ai-header-info">
        <div class="bh-ai-avatar">🏗️</div>
        <div>
          <h3 id="bhAiTitle" class="bh-ai-title">Bongshai AI Advisor</h3>
          <span class="bh-ai-status"><span class="bh-ai-status-dot"></span> Online | Steel &amp; Prefab Expert</span>
        </div>
      </div>
      <div class="bh-ai-header-actions">
        <button id="bhAiResetBtn" class="bh-ai-icon-btn" title="Clear chat" aria-label="Clear chat">🔄</button>
        <button id="bhAiCloseBtn" class="bh-ai-icon-btn" title="Close chat" aria-label="Close chat">✕</button>
      </div>
    </div>

    <!-- Quick Prompts Pill Row -->
    <div class="bh-ai-quick-prompts" id="bhAiQuickPrompts">
      <button class="bh-ai-chip bh-ai-chip-estimate" data-flow="estimate">🧮 তাৎক্ষণিক খরচ হিসাব করুন</button>
      <button class="bh-ai-chip" data-prompt="স্টিল বিল্ডিং তৈরি করতে কত দিন সময় লাগে?">⚡ কত দিনে তৈরি হয়?</button>
      <button class="bh-ai-chip" data-prompt="ফ্যাক্টরি বা ইন্ডাস্ট্রিয়াল শেডের রেট কত?">🏭 ফ্যাক্টরি শেড রেট</button>
      <button class="bh-ai-chip" data-prompt="BH-SB-302 মডেল সম্পর্কে বিস্তারিত জানান">📐 BH-SB-302 মডেল</button>
    </div>

    <!-- Messages Container -->
    <div class="bh-ai-messages" id="bhAiMessages" role="log" aria-live="polite">
      <!-- Default Welcome Message -->
      <div class="bh-ai-msg bh-ai-msg-bot">
        <div class="bh-ai-bubble">
          <p><strong>স্বাগতম বঙ্গশাই হাউজিং-এ!</strong> 👋</p>
          <p>আমি আপনার এআই সেলস ও ইঞ্জিনিয়ারিং সহকারী। আপনার জমির সাইজ, ডুপ্লেক্স/সিমপ্লেক্স বাড়ির খরচ, কনটেইনার হোম বা ইন্ডাস্ট্রিয়াল ফ্যাক্টরি শেড নিয়ে যেকোনো প্রশ্ন করতে পারেন।</p>
          <div class="bh-ai-bubble-actions">
            <a href="https://wa.me/8801781636613?text=Hello%20Bongshai%20Housing%2C%20I%20want%20a%20quote" target="_blank" rel="noopener noreferrer" class="bh-ai-cta-btn">
