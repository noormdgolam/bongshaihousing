  border-radius: 20px;
  padding: 4px 10px;
  font-size: 11.5px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s;
  flex-shrink: 0;
}

.bh-ai-chip:hover {
  background: #DBEAFE;
  border-color: #93C5FD;
}

/* Messages Area */
.bh-ai-messages {
  flex: 1;
  padding: 14px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: #FDFDFD;
  scroll-behavior: smooth;
}

.bh-ai-msg {
  display: flex;
  flex-direction: column;
  max-width: 86%;
}

.bh-ai-msg-bot {
  align-self: flex-start;
}

.bh-ai-msg-user {
  align-self: flex-end;
}

.bh-ai-bubble {
  padding: 10px 14px;
  border-radius: 14px;
  font-size: 13.5px;
  line-height: 1.45;
  word-break: break-word;
}

.bh-ai-msg-bot .bh-ai-bubble {
  background: #F3F4F6;
  color: #1F2937;
  border-bottom-left-radius: 2px;
  border: 1px solid #E5E7EB;
}

.bh-ai-msg-user .bh-ai-bubble {
  background: #1E40AF;
  color: #ffffff;
  border-bottom-right-radius: 2px;
}

.bh-ai-bubble p {
  margin: 0 0 6px 0;
}
.bh-ai-bubble p:last-child {
  margin-bottom: 0;
}

.bh-ai-bubble a {
  color: #2563EB;
  text-decoration: underline;
}
.bh-ai-msg-user .bh-ai-bubble a {
  color: #93C5FD;
}

.bh-ai-bubble-actions {
  margin-top: 8px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.bh-ai-cta-btn {
  display: inline-block;
  background: #10B981;
  color: #ffffff !important;
  font-size: 12px;
  font-weight: 600;
  padding: 5px 10px;
  border-radius: 6px;
  text-decoration: none !important;
