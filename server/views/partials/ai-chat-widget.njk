<!-- AI Sales Assistant Chat Widget for Bongshai Housing -->
<div id="bhAiChatWidget" class="bh-ai-widget" data-mcp-action="ai-consultation">
  <!-- Trigger Button -->
  <button id="bhAiChatToggle" class="bh-ai-toggle-btn" type="button" aria-label="Open AI Sales Assistant" aria-expanded="false" aria-controls="bhAiChatBox">
    <span class="bh-ai-pulse" aria-hidden="true"></span>
    <span class="bh-ai-icon">🤖</span>
    <span class="bh-ai-badge">AI Assistant</span>
  </button>

  <!-- Chat Dialog Window -->
  <div id="bhAiChatBox" class="bh-ai-chat-box" role="dialog" aria-modal="true" aria-labelledby="bhAiTitle" hidden>
    <!-- Header -->
    <div class="bh-ai-header">
      <div class="bh-ai-header-info">
        <div class="bh-ai-avatar">🏗️</div>
        <div>
          <h3 id="bhAiTitle" class="bh-ai-title">Bongshai AI Advisor</h3>
          <span class="bh-ai-status"><span class="bh-ai-status-dot"></span> Online | Steel &amp; Prefab Expert</span>
        </div>
      </div>
      <div class="bh-ai-header-actions">
        <button id="bhAiResetBtn" class="bh-ai-icon-btn" title="Clear chat" aria-label="Clear chat">🔄</button>
        <button id="bhAiCloseBtn" class="bh-ai-icon-btn" title="Close chat" aria-label="Close chat">✕</button>
      </div>
    </div>

    <!-- Quick Prompts Pill Row -->
    <div class="bh-ai-quick-prompts" id="bhAiQuickPrompts">
      <button class="bh-ai-chip" data-prompt="ডুপ্লেক্স স্টিল বাড়ির খরচ কেমন পড়বে?">🏠 ডুপ্লেক্স বাড়ির খরচ</button>
      <button class="bh-ai-chip" data-prompt="স্টিল বিল্ডিং তৈরি করতে কত দিন সময় লাগে?">⚡ কত দিনে তৈরি হয়?</button>
      <button class="bh-ai-chip" data-prompt="ফ্যাক্টরি বা ইন্ডাস্ট্রিয়াল শেডের রেট কত?">🏭 ফ্যাক্টরি শেড রেট</button>
      <button class="bh-ai-chip" data-prompt="BH-SB-302 মডেল সম্পর্কে বিস্তারিত জানান">📐 BH-SB-302 মডেল</button>
    </div>

    <!-- Messages Container -->
    <div class="bh-ai-messages" id="bhAiMessages" role="log" aria-live="polite">
      <!-- Default Welcome Message -->
      <div class="bh-ai-msg bh-ai-msg-bot">
        <div class="bh-ai-bubble">
          <p><strong>স্বাগতম বঙ্গশাই হাউজিং-এ!</strong> 👋</p>
          <p>আমি আপনার এআই সেলস ও ইঞ্জিনিয়ারিং সহকারী। আপনার জমির সাইজ, ডুপ্লেক্স/সিমপ্লেক্স বাড়ির খরচ, কনটেইনার হোম বা ইন্ডাস্ট্রিয়াল ফ্যাক্টরি শেড নিয়ে যেকোনো প্রশ্ন করতে পারেন।</p>
          <div class="bh-ai-bubble-actions">
            <a href="https://wa.me/8801711200241?text=Hello%20Bongshai%20Housing%2C%20I%20want%20a%20quote" target="_blank" rel="noopener noreferrer" class="bh-ai-cta-btn">
              💬 WhatsApp-এ কথা বলুন
            </a>
          </div>
        </div>
        <span class="bh-ai-time">Just now</span>
      </div>
    </div>

    <!-- Typing Indicator -->
    <div id="bhAiTyping" class="bh-ai-typing" hidden aria-hidden="true">
      <div class="bh-ai-dots">
        <span></span><span></span><span></span>
      </div>
      <span class="bh-ai-typing-text">AI is typing...</span>
    </div>

    <!-- Input Form -->
    <form id="bhAiForm" class="bh-ai-form" onsubmit="return false;">
      <input 
        type="text" 
        id="bhAiInput" 
        class="bh-ai-input" 
        placeholder="আপনার প্রশ্ন লিখুন (e.g. ২ তলা বাড়ির খরচ)..." 
        autocomplete="off" 
        maxlength="500"
        aria-label="Type your message"
      >
      <button type="submit" id="bhAiSendBtn" class="bh-ai-send-btn" aria-label="Send message">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
  </div>
</div>

<style>
/* ── AI Chat Assistant Styles ── */
.bh-ai-widget {
  position: fixed;
  bottom: 90px;
  right: 24px;
  z-index: 9999;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

.bh-ai-toggle-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 50px;
  padding: 10px 18px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(30, 64, 175, 0.35);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.bh-ai-toggle-btn:hover {
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 12px 30px rgba(30, 64, 175, 0.45);
  background: linear-gradient(135deg, #1D4ED8 0%, #2563EB 100%);
}

.bh-ai-icon {
  font-size: 18px;
  display: inline-block;
  animation: bhAiBounce 2s infinite ease-in-out;
}

.bh-ai-pulse {
  position: absolute;
  top: 6px;
  left: 6px;
  width: 10px;
  height: 10px;
  background: #10B981;
  border-radius: 50%;
  box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
  animation: bhAiPulse 2s infinite;
}

@keyframes bhAiPulse {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
  70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

@keyframes bhAiBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-3px); }
}

/* Chat Box */
.bh-ai-chat-box {
  position: absolute;
  bottom: 60px;
  right: 0;
  width: 380px;
  height: 540px;
  max-width: calc(100vw - 32px);
  max-height: calc(100vh - 120px);
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 16px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2), 0 0 0 1px rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: bhAiSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.bh-ai-chat-box[hidden] {
  display: none !important;
}

@keyframes bhAiSlideUp {
  from { opacity: 0; transform: translateY(16px) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

/* Header */
.bh-ai-header {
  background: linear-gradient(135deg, #1E3A8A 0%, #1E40AF 100%);
  color: #ffffff;
  padding: 14px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.bh-ai-header-info {
  display: flex;
  align-items: center;
  gap: 10px;
}

.bh-ai-avatar {
  width: 36px;
  height: 36px;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  backdrop-filter: blur(4px);
}

.bh-ai-title {
  margin: 0;
  font-size: 15px;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.2px;
}

.bh-ai-status {
  font-size: 11px;
  color: #D1D5DB;
  display: flex;
  align-items: center;
  gap: 5px;
  margin-top: 2px;
}

.bh-ai-status-dot {
  width: 7px;
  height: 7px;
  background: #10B981;
  border-radius: 50%;
  display: inline-block;
}

.bh-ai-header-actions {
  display: flex;
  gap: 6px;
}

.bh-ai-icon-btn {
  background: rgba(255, 255, 255, 0.12);
  border: none;
  color: #ffffff;
  width: 28px;
  height: 28px;
  border-radius: 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  transition: background 0.15s;
}

.bh-ai-icon-btn:hover {
  background: rgba(255, 255, 255, 0.25);
}

/* Quick Prompts */
.bh-ai-quick-prompts {
  display: flex;
  gap: 6px;
  padding: 8px 12px;
  background: #F9FAFB;
  border-bottom: 1px solid #E5E7EB;
  overflow-x: auto;
  white-space: nowrap;
  scrollbar-width: thin;
}

.bh-ai-quick-prompts::-webkit-scrollbar {
  height: 4px;
}
.bh-ai-quick-prompts::-webkit-scrollbar-thumb {
