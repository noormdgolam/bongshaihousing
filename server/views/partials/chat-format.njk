{# Shared chat formatter.

   One copy, included by both the website widget and the mobile app. They each
   had their own before, and that is how the raw-HTML bug lived in one and not
   the other: formatInline kept a naive linkifier long after formatText was
   fixed, so a phone number inside a table cell still nested one link inside
   another.

   Exposes window.BHChatFormat.{formatText, formatInline}. Nothing here touches
   the DOM - it takes the model's text and returns HTML. #}
<script>
(function () {
function outsideAnchors(str, fn) {
  return String(str).split(/(<a\s[^>]*>[\s\S]*?<\/a>)/g)
    .map((part) => (part.startsWith('<a') ? part : fn(part)))
    .join('');
}

// Trailing punctuation is sentence, not address. A quote especially, which
// used to be swallowed into the href and break the tag.
function linkUrls(t) {
  return t.replace(/(https?:\/\/[^\s<>"']+)/g, (m) => {
    const url = m.replace(/[.,;:!?)\]]+$/, '');
    return `<a href="${url}" target="_blank" rel="noopener noreferrer">${url}</a>${m.slice(url.length)}`;
  });
}

// Link whichever number actually appears in the text, never a hardcoded one:
// a wrong number here would silently send a customer to the wrong contact.
function linkPhones(t) {
  return t.replace(/(\+?880\s?1[3-9]\d{2}-?\d{6})/g, (match) => {
    const digits = match.replace(/[^0-9]/g, '');
    return `<a href="https://wa.me/${digits}" target="_blank" rel="noopener noreferrer" style="font-weight:600; color:#10B981;">${match}</a>`;
  });
}

function formatInline(str) {
  str = str.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
  str = outsideAnchors(str, linkUrls);
  str = outsideAnchors(str, linkPhones);
  return str;
}

function splitTableRow(row) {
  let r = row.trim();
  if (r.startsWith('|')) r = r.slice(1);
  if (r.endsWith('|')) r = r.slice(0, -1);
  return r.split('|').map((c) => c.trim());
}

// Pulls GFM-style markdown tables (header | header \n --- | --- \n cell | cell)
// out of the text and replaces each with a placeholder token, so the later
// bold/link/newline regexes (which run on the whole string) can't mangle
// table markup. Returns { text, tables } - placeholders get swapped back
// in as the final step of formatText().
function extractMarkdownTables(text) {
  const lines = text.split('\n');
  const tables = [];
  const out = [];
  let i = 0;
  const separatorRe = /^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)+\|?\s*$/;

  while (i < lines.length) {
    const line = lines[i];
    const next = lines[i + 1];
    if (line && line.includes('|') && next && separatorRe.test(next)) {
      const headerCells = splitTableRow(line);
      i += 2;
      const rows = [];
      while (i < lines.length && lines[i].includes('|') && lines[i].trim() !== '') {
        rows.push(splitTableRow(lines[i]));
        i++;
      }
      let html = '<div class="bh-ai-table-wrap"><table class="bh-ai-table"><thead><tr>';
      headerCells.forEach((c) => (html += `<th>${formatInline(c)}</th>`));
      html += '</tr></thead><tbody>';
      rows.forEach((r) => {
        html += '<tr>';
        r.forEach((c) => (html += `<td>${formatInline(c)}</td>`));
        html += '</tr>';
      });
      html += '</tbody></table></div>';
      const token = ` TBL${tables.length} `;
      tables.push(html);
      out.push(token);
    } else {
      out.push(line);
      i++;
    }
  }
  return { text: out.join('\n'), tables };
}

function formatText(text) {
  // The model sometimes writes an HTML anchor instead of a plain URL. Escaping
  // alone left the customer reading an escaped tag around a link box, so
  // reduce any anchor the model emits to its bare URL first and let the rules
  // below turn that into a proper box. Then drop any other stray tag.
  text = String(text == null ? '' : text)
    .replace(/<a\s[^>]*href="([^"]+)"[^>]*>[\s\S]*?<\/a>/gi, ' $1 ')
    .replace(/<\/?[a-z][a-z0-9]*[^>]*>/gi, '');

  // Simple sanitizing & markdown-like parsing for bold, links and tables
  let safe = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');

  const { text: withoutTables, tables } = extractMarkdownTables(safe);
  safe = withoutTables;

  // Bold **text**
  safe = safe.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

  // Support writes the handover as a bare "wa.me/8801781636613" with no
  // scheme, so the URL rule below never matched it and it rendered as dead
  // text. Give it one first.
  safe = safe.replace(/(^|[\s(])wa\.me\/(\d{8,15})/g, '$1https://wa.me/$2');

  // A bare product page ("/bh-ch-401.html" or "bh-ch-401.html") is a link the
  // customer should be able to tap, not a filename to read out.
  safe = safe.replace(/(^|[\s(])\/?((?:bh|dv)-[a-z]+-\d+\.html)/gi, '$1/$2');

  safe = outsideAnchors(safe, linkUrls);

  // Internal product pages, same treatment.
  safe = outsideAnchors(safe, (t) => t.replace(
    /(^|[\s(>])(\/(?:bh|dv)-[a-z]+-\d+\.html)/gi,
    '$1<a class="bh-ai-link-box bh-ai-link-model" href="$2">$2</a>'
  ));

  safe = outsideAnchors(safe, linkPhones);

  // Every link reads as an action box rather than raw underlined text.
  safe = safe.replace(
    /<a href="https:\/\/wa\.me\/(\d{8,15})"[^>]*>(?:(?!<\/a>).)*<\/a>/g,
    '<a class="bh-ai-link-box bh-ai-link-wa" href="https://wa.me/$1" target="_blank" rel="noopener noreferrer">'
    + '<span class="bh-ai-link-ic" aria-hidden="true">\u{1F4AC}</span>'
    + '<span class="bh-ai-link-tx"><b>WhatsApp — কথা বলুন / Chat with our team</b>'
    + '<small>+$1</small></span></a>'
  );
  safe = safe.replace(
    /<a class="bh-ai-link-box bh-ai-link-model" href="([^"]+)">([^<]+)<\/a>/g,
    '<a class="bh-ai-link-box bh-ai-link-model" href="$1">'
    + '<span class="bh-ai-link-ic" aria-hidden="true">\u{1F3E0}</span>'
    + '<span class="bh-ai-link-tx"><b>$2</b><small>মডেল দেখুন / View this model</small></span></a>'
  );
  // The handover usually writes the number twice - once as wa.me/NNN and
  // once as (+880 ...) - which produced two identical boxes with an orphaned
  // "(" and ")" left between them. Keep the first, drop the repeats.
  const waBox = /<a class="bh-ai-link-box bh-ai-link-wa"[\s\S]*?<\/a>/g;
  const seenWa = new Set();
  safe = safe.replace(waBox, (m) => {
    const key = (m.match(/wa\.me\/(\d+)/) || [])[1] || m;
    if (seenWa.has(key)) return '';
    seenWa.add(key);
    return m;
  });
  // Brackets emptied by that removal are just punctuation debris now.
  safe = safe.replace(/\(\s*\)/g, '').replace(/[ 	]{2,}/g, ' ');

  // Anything still a plain anchor becomes a neutral box.
  safe = safe.replace(
    /<a (?![^>]*bh-ai-link-box)href="([^"]+)"([^>]*)>((?:(?!<\/a>).)*)<\/a>/g,
    '<a class="bh-ai-link-box" href="$1"$2><span class="bh-ai-link-tx">$3</span></a>'
  );

  // Convert newlines to paragraphs/breaks
  safe = safe.replace(/\n\n/g, '</p><p>').replace(/\n/g, '<br>');

  // Restore table placeholders with their pre-rendered HTML
  tables.forEach((html, idx) => {
    safe = safe.replace(` TBL${idx} `, html);
  });

  return safe;
}

  window.BHChatFormat = { formatText: formatText, formatInline: formatInline };
})();
</script>
