{% set tSpecs = techSpecs if (techSpecs and techSpecs.length) else (specs | filterSpecs('technical')) %}
{% set mSpecs = materialSpecs if (materialSpecs and materialSpecs.length) else (buildingSpecs if (buildingSpecs and buildingSpecs.length) else (specs | filterSpecs('building'))) %}

{% if tSpecs.length %}
<div class="reveal-up" style="background: var(--white); padding: var(--space-6); border-radius: 16px; box-shadow: var(--shadow-sm); border: 1px solid var(--grey-100); margin-bottom: var(--space-8);">
<h3 style="font-family: var(--font-heading); font-size: 1.4rem; color: var(--primary-dark); margin-bottom: 24px; border-bottom: 2px solid var(--off-white); padding-bottom: 12px;">Technical Specification</h3>
<div style="overflow-x: auto;">
  <table class="modern-table">
    <thead>
      <tr>
        <th>Item</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody style="color: var(--grey-800);">
      {% for s in tSpecs %}
      <tr style="{% if not loop.last %}border-bottom: 1px solid var(--grey-100); {% endif %}{% if loop.index0 % 2 == 1 %}background: var(--off-white);{% endif %}">
        <td style="padding: 12px 16px; font-weight: 600; color: var(--primary-dark); width: 30%;{% if loop.last %} border-bottom-left-radius: 8px;{% endif %}">{{ s.spec_key }}</td>
        <td style="padding: 12px 16px;{% if loop.last %} border-bottom-right-radius: 8px;{% endif %}">{{ s.spec_value }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
</div>
{% endif %}

{% if mSpecs.length %}
<div class="reveal-up" style="background: var(--white); padding: var(--space-6); border-radius: 16px; box-shadow: var(--shadow-sm); border: 1px solid var(--grey-100); margin-bottom: var(--space-8);">
<h3 style="font-family: var(--font-heading); font-size: 1.4rem; color: var(--primary-dark); margin-bottom: 24px; border-bottom: 2px solid var(--off-white); padding-bottom: 12px;">Material Specification</h3>
<div style="overflow-x: auto;">
  <table class="modern-table">
    <thead>
      <tr>
        <th>Item</th>
        <th>Materials</th>
      </tr>
    </thead>
    <tbody style="color: var(--grey-800);">
      {% for s in mSpecs %}
      <tr style="{% if not loop.last %}border-bottom: 1px solid var(--grey-100); {% endif %}{% if loop.index0 % 2 == 1 %}background: var(--off-white);{% endif %}">
        <td style="padding: 12px 16px; font-weight: 600; color: var(--primary-dark); width: 30%;{% if loop.last %} border-bottom-left-radius: 8px;{% endif %}">{{ s.spec_key }}</td>
        <td style="padding: 12px 16px;{% if loop.last %} border-bottom-right-radius: 8px;{% endif %}">{{ s.spec_value }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
</div>
{% endif %}
