{#
  "Overview (Area Details)" section for a product detail page - floor-by-floor
  room tables with auto-summed subtotals and a building total, all from the DB
  (product_variants[0] + its product_rooms, decorated by lib/roomLayout.js
  decorateVariants() so `variants[0].roomGroups` and `roomGroupsBuildingTotal`
  are ready). Renders nothing when there's no room data, so a template can
  safely `{% if variants and variants[0] and variants[0].roomGroups.length %}
  {% include "partials/product-floor-plan.njk" %}{% else %}<old hardcoded>
  {% endif %}` during migration, then drop the fallback once backfilled.

  Replaces the block that was hand-authored (and non-recalculating) in ~128
  dedicated bh-*.njk templates. Structure matches those templates so a
  converted page renders visually the same.

  Inputs: `product` (for model_number + total_floor_area), `variants`.
#}
{% if floorPlanSection == 'chips' %}
{% include "partials/product-quick-specs.njk" %}
{% else %}
{% set v0 = variants[0] if (variants and variants.length) else none %}
{% if v0 and v0.roomGroups and v0.roomGroups.length %}
<div class="reveal-up" style="margin-bottom: var(--space-8);">
  <div style="margin-bottom: var(--space-4);">
    <h3 style="font-family: var(--font-heading); font-size: 1.8rem; color: var(--primary); margin-bottom: 6px;">Overview (Area Details)</h3>
    <p style="color: var(--grey-600); font-size: 0.95rem; margin: 0;">Official floor-wise layout dimensions and area specifications for Model No-{{ product.model_number }}.</p>
  </div>

  <div style="display: flex; flex-direction: column; gap: var(--space-5);">
    {% for g in v0.roomGroups %}
    <div class="card reveal" style="background: white; border-radius: 16px; padding: var(--space-6); box-shadow: var(--shadow-sm); border: 1px solid var(--grey-100);">
      {% if g.label %}
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--grey-100); padding-bottom: 12px; margin-bottom: 16px;">
        <h4 style="font-family: var(--font-heading); font-size: 1.3rem; color: var(--primary); margin: 0; display: flex; align-items: center; gap: 8px;">
          <span>🏢</span> {{ g.label }}
        </h4>
        {% if g.total %}
        <span style="background: #eef4ff; color: var(--primary); font-weight: 700; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem;">{{ g.total }} sqft</span>
        {% endif %}
      </div>
      {% endif %}
      <div style="overflow-x: auto; width: 100%; -webkit-overflow-scrolling: touch;">
        <table class="modern-table" style="width: 100%; border-collapse: separate; border-spacing: 0;">
          <thead>
            <tr style="background: var(--off-white);">
              <th scope="col" style="padding: 12px 16px; font-weight: 700; color: var(--grey-900); border-bottom: 2px solid var(--grey-200); text-align: left;">Section</th>
              <th scope="col" style="padding: 12px 16px; font-weight: 700; color: var(--grey-900); border-bottom: 2px solid var(--grey-200); text-align: center;">Area (sqft)</th>
              <th scope="col" style="padding: 12px 16px; font-weight: 700; color: var(--grey-900); border-bottom: 2px solid var(--grey-200); text-align: center;">Dimensions</th>
            </tr>
          </thead>
          <tbody>
            {% for r in g.rows %}
            <tr style="border-bottom: 1px solid var(--grey-100);">
              <td style="padding: 12px 16px; font-weight: 500; color: var(--grey-700);">{% if r.icon %}<span style="margin-right: 6px;">{{ r.icon }}</span>{% endif %}{{ r.section }}</td>
              <td style="padding: 12px 16px; font-weight: 600; color: var(--grey-900); text-align: center;">{{ r.area_sqft or '—' }}</td>
              <td style="padding: 12px 16px; font-weight: 500; color: var(--grey-600); text-align: center;">{% if r.length_ft and r.width_ft %}{{ r.length_ft }}' × {{ r.width_ft }}'{% else %}—{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
          {% if g.total %}
          <tfoot>
            <tr style="background: #f8fafc; font-weight: 700;">
              <td style="padding: 12px 16px; color: var(--grey-900);">{{ (g.label | replace(" Layout", "")) if g.label else 'Floor' }} Subtotal</td>
              <td style="padding: 12px 16px; color: var(--primary); text-align: center;">{{ g.total }} sqft</td>
              <td></td>
            </tr>
          </tfoot>
          {% endif %}
        </table>
      </div>
    </div>
    {% endfor %}

    <div class="card reveal" style="background: linear-gradient(135deg, #21409a 0%, #172c68 100%); color: white; border-radius: 16px; padding: 18px var(--space-6); display: flex; justify-content: space-between; align-items: center; box-shadow: var(--shadow-md);">
      <div>
        <div style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.85;">Total Covered Area</div>
        <div style="font-size: 1.1rem; font-weight: 600;">Full Building Structure ({{ v0.roomGroups.length }} Floor{{ 's' if v0.roomGroups.length != 1 else '' }})</div>
      </div>
      <div style="font-size: 1.8rem; font-weight: 800; color: #fde68a;">
        {{ product.total_floor_area or v0.roomGroupsBuildingTotal or v0.totalArea or v0.area_sqft }} sqft
      </div>
    </div>
  </div>
</div>
{% endif %}
{% endif %}
