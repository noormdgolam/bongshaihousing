<!-- ======================================================
       NAVIGATION — rendered from nav_items / categories (server/lib/nav.js),
       admin-editable at /admin/nav-menu. A 'category_grid' item's dropdown
       renders navCategories instead of its own children (no nav_items rows
       duplicate what the categories table already has).
  ====================================================== -->
<nav aria-label="Main navigation" class="navbar" id="mainNav" role="navigation">
<div class="navbar-inner">
<!-- Brand -->
<a class="navbar-brand" href="index.html">
<div class="brand-logo-wrap">
<svg aria-hidden="true" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"></path>
</svg>
</div>
<div class="brand-text">
<span class="brand-name">BongshaiHousing</span>
<span class="brand-tagline">Real Estate &amp; Developer</span>
</div>
</a>
<!-- Desktop Menu -->
<ul class="nav-menu" role="menubar">
{% for item in navItems %}
<li class="nav-item" role="none">
{% if item.item_type == 'category_grid' %}
<a class="nav-link" href="{{ item.url }}" role="menuitem">
            {{ item.label }}
            <svg aria-hidden="true" class="arrow-icon" fill="none" stroke="currentColor" stroke-width="2.5" viewbox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
</a>
<div class="dropdown image-mega-dropdown" role="menu">
  <div class="mega-image-grid">
    {% for cat in navCategories %}
    <a href="{{ cat.landing_page_slug or (cat.slug + '.html') }}" class="mega-card">
      <img src="{{ cat.hero_effective or cat.hero_image or 'images/products/coming-soon-placeholder.png' }}"{% if cat.hero_srcset %} srcset="{{ cat.hero_srcset }}"{% endif %} sizes="(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 500px" alt="{{ cat.name }}" loading="lazy"{% if cat.hero_dims %} width="{{ cat.hero_dims.width }}" height="{{ cat.hero_dims.height }}"{% endif %}>
      <div class="mega-card-overlay">
        <span class="mega-card-title">{{ cat.name }}</span>
      </div>
    </a>
    {% endfor %}
  </div>
</div>
{% elif item.children.length %}
<a class="nav-link" href="{{ item.url }}" role="menuitem">
            {{ item.label }}
            <svg aria-hidden="true" class="arrow-icon" fill="none" stroke="currentColor" stroke-width="2.5" viewbox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
</a>
<div class="dropdown" role="menu">
{% for child in item.children %}
<a class="dropdown-item" href="{{ child.url }}" role="menuitem"{% if child.target == '_blank' %} target="_blank" rel="noopener"{% endif %}>
<div class="dropdown-icon">{{ child.icon or '' }}</div>
<div><strong style="display:block;font-size:0.8rem;color:var(--primary)">{{ child.label }}</strong></div>
</a>
{% endfor %}
</div>
{% else %}
<a class="nav-link" href="{{ item.url }}" role="menuitem"{% if item.target == '_blank' %} target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a>
{% endif %}
</li>
{% endfor %}
</ul>
<!-- Desktop CTA -->
<div class="nav-cta">
<button aria-label="Search" class="icon-btn" id="searchBtn" style="background:none;border:none;font-size:1.2rem;cursor:pointer;margin-right:15px;color:inherit;">🔍</button>
<button aria-label="Toggle Dark Mode" class="icon-btn" id="darkModeBtn" style="background:none;border:none;font-size:1.2rem;cursor:pointer;margin-right:15px;color:inherit;">🌙</button>
<a aria-label="Call Bongshai Housing" class="nav-phone" href="tel:+8801781636613" itemprop="telephone">
          📞 +880 1781-636613
        </a>
<a class="btn btn-primary btn-sm" href="contact.html" id="nav-get-sales inquiry-btn">Contact Sales</a>
</div>
<!-- Hamburger (Mobile) -->
<button aria-controls="mobileDrawer" aria-expanded="false" aria-label="Toggle menu" class="hamburger" id="hamburgerBtn">
<span></span><span></span><span></span>
</button>
</div>
</nav>

  <!-- Mobile Drawer -->
<div aria-label="Mobile navigation" class="mobile-drawer" id="mobileDrawer" role="dialog">
<div>
{% for item in navItems %}
{% if item.item_type == 'category_grid' %}
      <div>
        <button class="mobile-nav-link" style="width:100%;background:none;border:none;cursor:pointer;text-align:left;font-size:var(--fs-base);font-weight:500;color:var(--grey-800);display:flex;justify-content:space-between;padding:var(--space-4) 0;border-bottom:1px solid var(--grey-100);" onclick="this.nextElementSibling.classList.toggle('open')">{{ item.label }} <span>▾</span>
        </button>
        <div class="mobile-sub-links">
          <div style="padding:var(--space-2) 0 0;font-size:0.7rem;font-weight:700;color:var(--grey-500);text-transform:uppercase;">Residential</div>
{% for cat in navCategories %}
<a class="mobile-sub-link" href="{{ cat.landing_page_slug or (cat.slug + '.html') }}">{{ cat.name }}</a>
{% endfor %}
          {% if showQuoteShortcut %}<div style="padding:var(--space-2) 0 0;font-size:0.7rem;font-weight:700;color:var(--grey-500);text-transform:uppercase;">Interactive Tools</div>
          <a href="solutions.html" class="mobile-sub-link">Contact Sales</a>{% endif %}
        </div>
      </div>
{% elif item.children.length %}
<div>
<button class="mobile-nav-link" onclick="this.nextElementSibling.classList.toggle('open')" style="width:100%;background:none;border:none;cursor:pointer;text-align:left;font-size:var(--fs-base);font-weight:500;color:var(--grey-800);display:flex;justify-content:space-between;padding:var(--space-4) 0;border-bottom:1px solid var(--grey-100);">{{ item.label }} <span>▾</span>
</button>
<div class="mobile-sub-links">
{% for child in item.children %}
<a class="mobile-sub-link" href="{{ child.url }}">{{ child.icon }}{% if child.icon %} {% endif %}{{ child.label }}</a>
{% endfor %}
</div>
</div>
{% else %}
<a class="mobile-nav-link" href="{{ item.url }}">{{ item.label }}</a>
{% endif %}
{% endfor %}
    </div>

    <div style="margin-top:var(--space-8);display:flex;flex-direction:column;gap:var(--space-3);">
      <a href="tel:+8801781636613" itemprop="telephone" class="btn btn-secondary" style="justify-content:center;">📞 +880 1781-636613</a>
      <a href="contact.html" class="btn btn-primary" style="justify-content:center;" id="mobile-sales inquiry-btn">Contact Sales</a>
    </div>
  </div>
