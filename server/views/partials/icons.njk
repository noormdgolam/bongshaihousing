{#- Shared inline SVG icon set (Heroicons-outline style, MIT-licensed shapes,
    redrawn inline so nothing depends on an external icon font/CDN - this
    site runs for mobile-data-constrained users, so every icon ships as
    ~200 bytes of inline markup instead of a font/JS library request).
    Usage: {% import "partials/icons.njk" as icons %} then {{ icons.icon('lock', 20) }} -#}

