{% extends "customer-layout.njk" %}
{% import "partials/icons.njk" as icons %}
{% block title %}My Dashboard{% endblock %}
{% block body %}
<div class="customer-hero">
  <div class="customer-hero-top">
    <div class="customer-hero-brand">{{ icons.icon('crane', 20) }} Bongshai Housing</div>
    <form method="post" action="/my-project/logout">
      <button type="submit" class="btn btn-ghost">Log out</button>
    </form>
  </div>
  <div class="customer-hero-profile">
    <div>
      <div class="customer-hero-name">{{ order.customer_name or customer.name }}</div>
      <div class="customer-hero-meta">
        {% if order %}
          {% if order.model_number %}🏠 {{ order.model_number }}{% endif %}
          {% if order.floor_area %}&nbsp;·&nbsp;{{ order.floor_area }} sqft{% endif %}
          {% if order.customer_district %}&nbsp;·&nbsp;📍 {{ order.customer_district }}{% endif %}
        {% else %}
          📞 {{ customer.phone }}
        {% endif %}
      </div>
    </div>
  </div>
</div>

<div class="customer-content">
  {% if pwSuccess %}
  <div class="card" style="border-color: rgba(22,163,74,0.4); background: rgba(240,253,244,0.85);">
    <p style="margin:0; color:var(--success); font-weight:700; display:flex; align-items:center; gap:8px;">{{ icons.icon('check-circle', 18) }} Password saved. Use your phone number and this password to log back in anytime.</p>
  </div>
  {% endif %}

  {% if not hasPassword %}
  <div class="card">
    <h2 style="margin-top:0; font-size:1.05rem; display:flex; align-items:center; gap:8px;">{{ icons.icon('lock', 19) }} Secure Your Account</h2>
    <p style="margin:0 0 14px; font-size:0.85rem; color:var(--grey-500);">You're signed in because you just sent an inquiry. Set a password now so you can check back on this dashboard from any device later.</p>
    {% if pwError %}<div class="error-box">{{ pwError }}</div>{% endif %}
    <form method="post" action="/my-project/set-password">
      <div class="form-row">
        <label for="password">New Password</label>
        <input type="password" id="password" name="password" placeholder="At least 6 characters" required minlength="6">
      </div>
      <div class="form-row" style="margin-bottom:20px;">
        <label for="confirm_password">Confirm Password</label>
        <input type="password" id="confirm_password" name="confirm_password" placeholder="••••••••" required minlength="6">
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%; padding:10px; font-weight:700;">Set Password</button>
    </form>
  </div>
  {% endif %}

  {% if order %}
  <div class="card">
    <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:10px;">
      <h2 style="margin:0; font-size:1.05rem;">Construction Progress</h2>
      <span style="font-weight:800; font-size:1.1rem; color:var(--primary);">{{ progress }}%</span>
    </div>
    <div class="progress-track">
      <div class="progress-fill" style="width:{{ progress }}%;"></div>
    </div>
    {% if order.status == 'completed' %}
    <p style="margin:12px 0 0; font-size:0.85rem; color:var(--success); font-weight:700;">✓ Project completed and handed over.</p>
    {% elif order.status == 'cancelled' %}
    <p style="margin:12px 0 0; font-size:0.85rem; color:var(--danger); font-weight:700;">This order has been cancelled. Contact your representative for details.</p>
    {% endif %}
  </div>

  <div class="card">
    <h2 style="margin-top:0; font-size:1.05rem; display:flex; align-items:center; gap:8px;">{{ icons.icon('clipboard-list', 19) }} Build Timeline</h2>
    <div class="milestone-list">
      {% for m in milestones %}
      <div class="milestone-item {{ m.status }}">
        <div class="milestone-dot">
          {% if m.status == 'done' %}✓{% elif m.status == 'in_progress' %}⚡{% else %}{{ loop.index }}{% endif %}
        </div>
        <div>
          <div class="milestone-title">{{ m.title }}</div>
          {% if m.note %}<div class="milestone-note">{{ m.note }}</div>{% endif %}
          {% if m.status == 'done' and m.completed_at %}<div class="milestone-date">Completed {{ m.completed_at | date }}</div>{% endif %}
          {% if m.status == 'in_progress' %}<div class="milestone-date" style="color:#b45309; font-weight:600;">In progress</div>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>

  {% if documents.length %}
  <div class="card">
    <h2 style="margin-top:0; font-size:1.05rem; display:flex; align-items:center; gap:8px;">{{ icons.icon('document-text', 19) }} Design Documents</h2>
    <div style="display:flex; flex-direction:column; gap:8px;">
      {% for d in documents %}
      <a href="/my-project/documents/{{ d.id }}" target="_blank" style="display:flex; align-items:center; gap:10px; padding:10px 14px; background:rgba(255,255,255,0.5); border-radius:10px; border:1px solid rgba(255,255,255,0.4); font-weight:600; font-size:0.9rem;">
        {{ icons.icon('document-text', 17) }} {{ d.title }}
      </a>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  {% endif %}

  <div class="card">
    <h2 style="margin-top:0; font-size:1.05rem; display:flex; align-items:center; gap:8px;">{{ icons.icon('inbox', 19) }} Your Inquiries</h2>
    {% if leads.length %}
    <div style="display:flex; flex-direction:column; gap:10px;">
      {% for lead in leads %}
      <div style="padding:12px 14px; background:rgba(255,255,255,0.5); border-radius:10px; border:1px solid rgba(255,255,255,0.4);">
        <div style="display:flex; justify-content:space-between; align-items:baseline; gap:8px; flex-wrap:wrap;">
          <span style="font-weight:700; font-size:0.92rem;">{{ lead.model or 'General Inquiry' }}</span>
          <span style="font-size:0.72rem; font-weight:700; padding:2px 9px; border-radius:20px; background:rgba(30,64,175,0.1); color:var(--primary);">{{ lead.status_label }}</span>
        </div>
        <div style="font-size:0.78rem; color:var(--grey-500); margin-top:4px;">Sent {{ lead.created_at | date }}{% if lead.district %} · {{ lead.district }}{% endif %}</div>
        {% if lead.message %}<div style="font-size:0.85rem; color:var(--grey-700); margin-top:6px;">{{ lead.message }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% else %}
    <p style="margin:0; font-size:0.85rem; color:var(--grey-500);">No inquiries on file yet.</p>
    {% endif %}
  </div>

  <p style="text-align:center; font-size:0.8rem; color:rgba(255,255,255,0.75);">
    Questions? <a href="https://wa.me/8801781636613" target="_blank" rel="noopener noreferrer" style="color:white; text-decoration:underline;">Message us on WhatsApp</a> or contact your Bongshai representative directly.
  </p>
</div>
{% endblock %}
