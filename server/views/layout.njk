    }
  </style>
  <style id="bh-theme-adaptive-styles">
    {% if theme.is_dark %}
    .navbar {
      background: rgba(11, 15, 25, 0.88) !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
    }
    .navbar .nav-link {
      color: #E2E8F0 !important;
    }
    .navbar .nav-phone {
      color: #F1F5F9 !important;
      border-color: rgba(255, 255, 255, 0.2) !important;
    }
    .dropdown, .mobile-drawer {
      background: var(--surface-color, #131C2E) !important;
      border-color: rgba(255, 255, 255, 0.12) !important;
      color: #F1F5F9 !important;
    }
    .dropdown-item, .mobile-nav-link {
      color: #CBD5E1 !important;
    }
    .dropdown-item:hover, .mobile-nav-link:hover {
      background: rgba(255, 255, 255, 0.06) !important;
      color: var(--primary) !important;
    }
    .card, .why-card, .contact-form-wrap, .glass-card {
      background: var(--surface-color, #131C2E) !important;
      border-color: rgba(255, 255, 255, 0.08) !important;
    }
    .form-control {
      background: rgba(255, 255, 255, 0.05) !important;
      border-color: rgba(255, 255, 255, 0.15) !important;
      color: #F8FAFC !important;
    }
    .form-label {
      color: #CBD5E1 !important;
    }
    .property-card {
      background: rgba(19, 28, 46, 0.8) !important;
      border-color: rgba(255, 255, 255, 0.1) !important;
    }
    .property-card:hover {
      background: rgba(19, 28, 46, 0.95) !important;
    }
    .step-num {
      background: var(--surface-color, #131C2E) !important;
      border-color: rgba(255, 255, 255, 0.15) !important;
      color: #94A3B8 !important;
    }
    .features-strip {
      background: var(--surface-color, #131C2E) !important;
      border-bottom-color: rgba(255, 255, 255, 0.08) !important;
    }
    .compare-table th {
      background: var(--primary-dark) !important;
    }
    .compare-table tbody tr:nth-child(2n) td {
      background: rgba(255, 255, 255, 0.03) !important;
    }
    .compare-table td {
      border-bottom-color: rgba(255, 255, 255, 0.08) !important;
    }
    {% endif %}

    /* ─── 6 ThemeForest Structural Archetypes ─────────────────── */
    /* 1. Broken-Grid Editorial Asymmetry */
    body[data-archetype="broken-grid"] .property-grid {
      align-items: flex-start;
    }
    body[data-archetype="broken-grid"] .property-card:nth-child(even) {
      transform: translateY(20px);
      margin-bottom: 20px;
    }
    body[data-archetype="broken-grid"] .hero-content {
      backdrop-filter: blur(12px);
      background: rgba(0, 0, 0, 0.35);
      padding: 32px;
      border-radius: var(--radius-lg);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }

    /* 2. Trust-First Corporate Assurance */
    body[data-archetype="trust-first"] .features-strip {
      border-bottom: 3px solid var(--accent);
    }
    body[data-archetype="trust-first"] .why-card {
      border-top: 3px solid var(--primary);
      box-shadow: 0 8px 24px rgba(0,0,0,0.06);
    }

    /* 3. Story & Craft Process Timeline */
    body[data-archetype="story-process"] .step-item {
      position: relative;
      transition: all 0.3s ease;
    }
    body[data-archetype="story-process"] .step-num {
      box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2);
    }

    /* 4. Heavy Metallurgy Stats-Led */
    body[data-archetype="stats-minimal"] .hero-badge {
      border-radius: var(--radius-sm);
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 800;
    }
    body[data-archetype="stats-minimal"] .property-card {
      border-radius: var(--radius-sm);
    }
    body[data-archetype="stats-minimal"] .btn {
      border-radius: var(--radius-sm);
    }

    /* 5. Mobile-Priority Touch Architecture */
    body[data-archetype="mobile-priority"] .category-tabs {
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      display: flex;
      gap: 8px;
    }
  </style>
  <style id="bh-theme-announcement-styles">
    .bh-top-announcement {
      font-size: 0.82rem;
      padding: 7px 16px;
      text-align: center;
      font-weight: 600;
      position: relative;
      z-index: 1000;
      letter-spacing: 0.1px;
      transition: all 0.2s ease;
    }
    .bh-announcement-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .bh-announcement-cta {
      text-decoration: underline !important;
      font-weight: 700;
      margin-left: 6px;
    }
    .bh-announcement-cta:hover {
      opacity: 0.9;
    }
  </style>
  {% if theme.custom_css %}
