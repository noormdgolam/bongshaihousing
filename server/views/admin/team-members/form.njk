{% extends "admin-layout.njk" %}
{% block title %}{% if member.id %}Edit {{ member.name }}{% else %}New Team Member{% endif %}{% endblock %}
{% block header %}<h1 style="font-size:1.15rem; font-weight:700; margin:0;">{% if member.id %}Edit Team Member: {{ member.name }}{% else %}Add New Team Member{% endif %}</h1>{% endblock %}

{% block content %}
{% if error %}<div class="error-box">{{ error }}</div>{% endif %}

<div class="card" style="max-width:800px;">
  <form method="post" action="{% if member.id %}/admin/team-members/{{ member.id }}{% else %}/admin/team-members{% endif %}" enctype="multipart/form-data">
    <div class="admin-grid-2col" style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
      <div class="form-row">
        <label for="name">Full Name <span style="color:var(--danger);">*</span></label>
        <input type="text" id="name" name="name" value="{{ member.name or '' }}" placeholder="e.g. SMA AWAL" required>
      </div>

      <div class="form-row">
        <label for="role">Role / Designation <span style="color:var(--danger);">*</span></label>
        <input type="text" id="role" name="role" value="{{ member.role or '' }}" placeholder="e.g. Chief Engineer & Project Director" required>
      </div>
    </div>

    <div class="admin-grid-2col" style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:8px;">
      <div class="form-row">
        <label for="department">Department <span style="color:var(--danger);">*</span></label>
        <select id="department" name="department" required>
          {% for d in departments %}
          <option value="{{ d.slug }}" {% if (member.department or 'senior-management') == d.slug %}selected{% endif %}>{{ d.label }} ({{ d.page }})</option>
          {% endfor %}
        </select>
      </div>

      <div class="form-row">
        <label for="sort_order">Display Sort Order</label>
        <input type="number" id="sort_order" name="sort_order" value="{{ member.sort_order if member.sort_order is defined else 0 }}" min="0">
        <div style="font-size:0.8rem; color:var(--grey-500); margin-top:4px;">Lower numbers appear first within department.</div>
      </div>
    </div>

    <div class="form-row" style="margin-top:8px;">
      <label for="bio">Professional Bio &amp; Qualifications</label>
      <textarea id="bio" name="bio" rows="3" placeholder="Brief summary of professional experience, credentials, and project leadership.">{{ member.bio or '' }}</textarea>
    </div>

    <!-- Photo Upload with Preview -->
    <div class="form-row" style="margin-top:14px; background:var(--grey-50); padding:16px; border-radius:8px; border:1px solid var(--grey-200);">
      <label style="font-weight:700; color:var(--grey-900); margin-bottom:8px; display:block;">Profile Photo</label>
      <div style="display:flex; gap:16px; align-items:center; flex-wrap:wrap;">
        <div style="width:72px; height:72px; border-radius:10px; overflow:hidden; background:var(--grey-200); border:1px solid var(--grey-300); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
          <img id="photo_preview" src="/{{ member.photo }}" alt="Preview" style="width:100%; height:100%; object-fit:cover; {% if not member.photo %}display:none;{% endif %}" onerror="this.style.display='none'; document.getElementById('photo_preview_placeholder').style.display='block';">
          <span id="photo_preview_placeholder" style="font-size:1.6rem; {% if member.photo %}display:none;{% endif %}" aria-hidden="true">👤</span>
        </div>
        <div style="flex:1; min-width:240px;">
          <input type="file" name="photo_file" accept="image/*" onchange="const f=this.files[0];if(f){const r=new FileReader();r.onload=e=>{const img=document.getElementById('photo_preview');img.src=e.target.result;img.style.display='block';document.getElementById('photo_preview_placeholder').style.display='none';};r.readAsDataURL(f);}">
          <div style="font-size:0.8rem; color:var(--grey-500); margin-top:6px;">Upload a real photo of this person (JPG, PNG, WebP). No photo yet? Leave blank - the site shows their initials instead of a stock image.</div>
          <input type="text" id="photo" name="photo" value="{{ member.photo or '' }}" placeholder="e.g. images/team/jane-doe.webp" style="margin-top:6px; font-size:0.85rem;" oninput="const img=document.getElementById('photo_preview'); const path='/' + this.value.replace(/^\/+/,''); if (this.value) { img.src=path; img.style.display='block'; document.getElementById('photo_preview_placeholder').style.display='none'; } else { img.style.display='none'; document.getElementById('photo_preview_placeholder').style.display='block'; }">
        </div>
      </div>
    </div>

    <div class="form-row" style="margin-top:14px; background:var(--grey-50); padding:12px 16px; border-radius:6px; border:1px solid var(--grey-200);">
      <label style="display:flex; align-items:center; cursor:pointer; margin:0;">
        <input type="checkbox" id="published" name="published" {% if member.published or not member.id %}checked{% endif %} style="width:auto; margin-right:10px;">
        <span style="font-weight:700; color:var(--grey-900);">Published Live on Department Page &amp; Schema.org Structured Data</span>
      </label>
    </div>

    <div class="form-actions" style="margin-top:24px;">
      <button type="submit" class="btn btn-primary">{% if member.id %}Save Member{% else %}Add Member{% endif %}</button>
      <a href="/admin/team-members" class="btn">Cancel</a>
    </div>
  </form>
</div>

{% if member.id %}
<div class="card" style="max-width:800px; border-top:3px solid var(--danger); margin-top:20px;">
  <h3 style="font-size:0.9rem; font-weight:700; color:var(--danger); margin-top:0;">Delete Team Member</h3>
  <p style="font-size:0.8rem; color:var(--grey-500); margin-bottom:12px;">Permanently remove this team member from website rosters and structured data.</p>
  <form method="post" action="/admin/team-members/{{ member.id }}/delete" onsubmit="return confirm('Are you sure you want to delete this team member?');">
    <button type="submit" class="btn btn-danger">Delete Member</button>
  </form>
</div>

{% set entityType = "team_member" %}
{% set entityId = member.id %}
{% include "admin/partials/history-panel.njk" %}
{% endif %}
{% endblock %}
