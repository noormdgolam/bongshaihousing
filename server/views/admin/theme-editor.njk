<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Theme Studio Pro — Elementor-Grade Visual Builder</title>
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@500;700;800&family=Poppins:wght@400;600;700&family=Roboto:wght@400;500;700&family=Montserrat:wght@400;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-dark: #0B1120;
    --sidebar-bg: #131C2E;
    --sidebar-border: #1E293B;
    --card-bg: #1A263D;
    --text-main: #F8FAFC;
    --text-muted: #94A3B8;
    --primary-blue: #3B82F6;
    --accent-gold: #F59E0B;
    --success: #10B981;
    --danger: #EF4444;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg-dark);
    color: var(--text-main);
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* ─── Topbar Header ─────────────────────────────────────────── */
  .te-topbar {
    height: 52px;
    background: #0B1120;
    border-bottom: 1px solid var(--sidebar-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    flex-shrink: 0;
    z-index: 100;
    gap: 12px;
  }
  .te-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 0.95rem;
    color: #ffffff;
    white-space: nowrap;
  }
  .te-brand span { color: var(--primary-blue); }
  .te-nav-link {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-decoration: none;
    padding: 5px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.08);
    transition: all 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .te-nav-link:hover { color: white; background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.2); }

  /* Device Switcher in Topbar */
  .te-device-bar {
    display: flex;
    align-items: center;
    background: var(--sidebar-bg);
    border: 1px solid var(--sidebar-border);
    border-radius: 8px;
    padding: 3px;
    gap: 3px;
  }
  .te-device-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    padding: 5px 10px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: all 0.15s;
  }
  .te-device-btn:hover { color: white; background: rgba(255,255,255,0.04); }
  .te-device-btn.active {
    background: var(--primary-blue);
    color: white;
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.4);
  }

  /* Page Selector */
  .te-page-select {
    background: var(--sidebar-bg);
    color: white;
    border: 1px solid var(--sidebar-border);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 0.8rem;
    outline: none;
    cursor: pointer;
  }

  /* Top Tools & Actions */
  .te-tools {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .btn {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.15s;
    text-decoration: none;
  }
  .btn-primary { background: var(--primary-blue); color: white; }
  .btn-primary:hover { background: #2563EB; }
  .btn-success { background: var(--success); color: white; }
  .btn-success:hover { background: #059669; }
  .btn-outline { background: transparent; border-color: var(--sidebar-border); color: var(--text-muted); }
  .btn-outline:hover { color: white; border-color: #64748B; background: rgba(255,255,255,0.05); }
  .btn-tool {
    background: var(--sidebar-bg);
    border: 1px solid var(--sidebar-border);
    color: var(--text-muted);
    padding: 5px 9px;
    border-radius: 6px;
  }
  .btn-tool:hover { color: white; background: rgba(255,255,255,0.06); }
  .btn-tool.active {
    background: rgba(59, 130, 246, 0.2);
    border-color: var(--primary-blue);
    color: #60A5FA;
  }

  /* ─── Main Workspace: Split View ─────────────────────────────── */
  .te-workspace {
    flex: 1;
    display: flex;
    min-height: 0;
    position: relative;
  }

  /* Left Sidebar Controls */
  .te-sidebar {
    width: 420px;
    background: var(--sidebar-bg);
    border-right: 1px solid var(--sidebar-border);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    overflow: hidden;
    z-index: 10;
  }

  /* Elementor Pro Tab Strip */
  .te-tab-strip {
    display: flex;
    background: #0E1626;
    border-bottom: 1px solid var(--sidebar-border);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .te-tab-strip::-webkit-scrollbar { display: none; }
  .te-tab-btn {
    padding: 10px 12px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-muted);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.15s;
  }
  .te-tab-btn:hover { color: white; background: rgba(255,255,255,0.02); }
  .te-tab-btn.active {
    color: #60A5FA;
    border-bottom-color: var(--primary-blue);
    background: rgba(59, 130, 246, 0.08);
  }

  /* Sidebar Scroll Area */
  .te-tab-content {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: none;
  }
  .te-tab-content.active {
    display: block;
  }

  /* Accordions / Control Sections */
  .te-section {
    background: var(--card-bg);
    border: 1px solid var(--sidebar-border);
    border-radius: 8px;
    margin-bottom: 14px;
    overflow: hidden;
  }
  .te-section-header {
    padding: 10px 14px;
    background: rgba(255,255,255,0.02);
    border-bottom: 1px solid transparent;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
    font-size: 0.85rem;
    font-weight: 700;
    color: #ffffff;
  }
  .te-section-header:hover { background: rgba(255,255,255,0.05); }
  .te-section-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .te-section[data-collapsed="true"] .te-section-body { display: none; }
  .te-section[data-collapsed="true"] .te-section-header { border-bottom: none; }

  /* Control Form Rows */
  .te-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .te-label {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .te-input, .te-select, .te-textarea {
    background: #0F172A;
    border: 1px solid var(--sidebar-border);
    border-radius: 6px;
    color: white;
    font-size: 0.82rem;
    padding: 7px 10px;
    outline: none;
    font-family: inherit;
    width: 100%;
  }
  .te-input:focus, .te-select:focus, .te-textarea:focus {
    border-color: var(--primary-blue);
    box-shadow: 0 0 0 2px rgba(59,130,246,0.25);
  }
  .te-color-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .te-color-picker {
    -webkit-appearance: none;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    cursor: pointer;
    background: transparent;
    padding: 0;
    flex-shrink: 0;
  }
  .te-color-picker::-webkit-color-swatch-wrapper { padding: 0; }
  .te-color-picker::-webkit-color-swatch { border-radius: 6px; border: 1px solid var(--sidebar-border); }

  /* Range Sliders */
  .te-slider-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .te-range {
    flex: 1;
    accent-color: var(--primary-blue);
    cursor: pointer;
  }
  .te-range-val {
    font-size: 0.75rem;
    color: #60A5FA;
    font-weight: 700;
    min-width: 45px;
    text-align: right;
  }

  /* Preset Cards Grid inside Presets Tab */
  .te-presets-filter {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .te-preset-tab {
    padding: 4px 8px;
    font-size: 0.72rem;
    border-radius: 4px;
    background: #0F172A;
    border: 1px solid var(--sidebar-border);
    color: var(--text-muted);
    cursor: pointer;
    font-weight: 600;
  }
  .te-preset-tab.active {
    background: var(--primary-blue);
    color: white;
    border-color: var(--primary-blue);
  }
  .te-preset-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .te-preset-card {
    background: #0F172A;
    border: 1px solid var(--sidebar-border);
    border-radius: 6px;
    padding: 8px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: all 0.15s;
    position: relative;
  }
  .te-preset-card:hover {
    border-color: var(--primary-blue);
    transform: translateY(-2px);
  }
  .te-preset-card.active {
    border-color: var(--primary-blue);
    background: rgba(59, 130, 246, 0.1);
    box-shadow: 0 0 0 1px var(--primary-blue);
  }

  /* Right Canvas Preview Area */
  .te-canvas {
    flex: 1;
    background: #090D16;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    overflow: hidden;
    position: relative;
  }
  .te-frame-wrapper {
    width: 100%;
    height: 100%;
    background: white;
    border-radius: 8px;
    box-shadow: 0 12px 36px rgba(0,0,0,0.6);
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }
  .te-frame-wrapper.mode-desktop { width: 100%; height: 100%; border-radius: 0; }
  .te-frame-wrapper.mode-laptop { width: 1024px; height: 95%; }
  .te-frame-wrapper.mode-tablet { width: 768px; height: 95%; }
  .te-frame-wrapper.mode-mobile { width: 375px; height: 720px; border-radius: 24px; border: 4px solid #1E293B; }
  .te-frame-wrapper.mode-mobile.landscape { width: 720px; height: 375px; border-radius: 16px; }

  iframe {
    width: 100%;
    height: 100%;
    border: none;
    background: white;
  }

  /* Toast Notification */
  .te-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: #10B981;
    color: white;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    z-index: 1000;
    display: none;
    animation: toastSlide 0.25s ease-out;
  }
  @keyframes toastSlide { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
</style>
</head>
<body>

<!-- ─── 1. TOPBAR HEADER ─────────────────────────────────────────── -->
<header class="te-topbar">
  <div style="display:flex; align-items:center; gap:12px;">
    <div class="te-brand">
      <span>⚡</span> Bongshai Studio <small style="font-size:0.65rem; background:rgba(59,130,246,0.2); color:#60A5FA; padding:2px 6px; border-radius:4px; margin-left:4px;">PRO</small>
    </div>
    <a href="/admin/themes" class="te-nav-link">🎭 Themes Directory</a>
    <a href="/admin" class="te-nav-link">← Dashboard</a>
  </div>

  <!-- Device Viewport Switcher -->
  <div class="te-device-bar">
    <button type="button" class="te-device-btn active" data-mode="desktop" title="Desktop View (100%)">🖥️ Desktop</button>
    <button type="button" class="te-device-btn" data-mode="laptop" title="Laptop View (1024px)">💻 Laptop</button>
    <button type="button" class="te-device-btn" data-mode="tablet" title="Tablet View (768px)">📱 Tablet</button>
    <button type="button" class="te-device-btn" data-mode="mobile" title="Mobile View (375px)">📲 Mobile</button>
    <button type="button" class="te-device-btn" id="rotateBtn" title="Rotate Orientation">🔄</button>
  </div>

  <!-- Page Selector -->
  <select class="te-page-select" id="pageSelector">
    <option value="/">🏠 Home (Landing Page)</option>
    <option value="/about.html">ℹ️ About Us</option>
    <option value="/simplex-steel-building.html">🏡 Simplex Steel Buildings</option>
    <option value="/duplex-steel-building.html">🏰 Duplex Steel Villas</option>
    <option value="/container-home.html">📦 Luxury Container Homes</option>
    <option value="/industrial-steel-shed.html">🏭 Industrial PEB Factory Sheds</option>
    <option value="/projects.html">🏗️ Completed Projects</option>
    <option value="/faq.html">❓ FAQs &amp; Rich Snippets</option>
    <option value="/team-senior-management.html">👥 Senior Management Team</option>
    <option value="/service-areas.html">📍 64 Districts Coverage</option>
    <option value="/contact.html">📞 Contact &amp; Quote Calculator</option>
  </select>

  <!-- Top Tools & Publish Actions -->
  <div class="te-tools">
    <button type="button" class="btn btn-tool" id="inspectorBtn" title="Elementor Inspector: Click any element on canvas to edit">🎯 Inspector</button>
    <button type="button" class="btn btn-tool" id="undoBtn" title="Undo (Ctrl+Z)">↩️</button>
    <button type="button" class="btn btn-tool" id="redoBtn" title="Redo (Ctrl+Y)">↪️</button>
    <a href="/admin/theme-editor/export" class="btn btn-outline" title="Export Theme JSON">📤 Export</a>
    <button type="button" class="btn btn-outline" id="resetBtn" title="Reset Defaults">🔄 Reset</button>
    <button type="button" class="btn btn-success" id="saveBtn" style="font-weight:700;">💾 Save &amp; Publish</button>
  </div>
</header>

<!-- ─── 2. MAIN WORKSPACE ────────────────────────────────────────── -->
<div class="te-workspace">

  <!-- Left Sidebar Panel (Elementor Pro Multi-Tab System) -->
  <aside class="te-sidebar">
    
    <!-- Tab Navigation Strip -->
    <div class="te-tab-strip">
      <button type="button" class="te-tab-btn active" data-tab="style">🎨 Style</button>
      <button type="button" class="te-tab-btn" data-tab="typography">🔤 Typography</button>
      <button type="button" class="te-tab-btn" data-tab="layout">📐 Layout</button>
      <button type="button" class="te-tab-btn" data-tab="components">🧩 Components</button>
      <button type="button" class="te-tab-btn" data-tab="motion">⚡ Motion</button>
      <button type="button" class="te-tab-btn" data-tab="presets">✨ Presets (24)</button>
      <button type="button" class="te-tab-btn" data-tab="code">💻 CSS/JS</button>
      <button type="button" class="te-tab-btn" data-tab="navigator">📑 Navigator</button>
    </div>

    <!-- ─── TAB 1: GLOBAL STYLE & COLORS ────────────────────────── -->
    <div class="te-tab-content active" id="tab-style">
      
      <!-- Brand Primary Colors -->
      <div class="te-section" data-collapsed="false">
        <div class="te-section-header">
          <span>🔵 Brand Primary Colors</span>
          <span>▾</span>
        </div>
        <div class="te-section-body">
          <div class="te-field">
            <label class="te-label">Primary Brand Accent</label>
            <div class="te-color-row">
              <input type="color" id="primaryColor" class="te-color-picker" value="{{ theme.primary or '#1E40AF' }}">
              <input type="text" id="primaryColorText" class="te-input" value="{{ theme.primary or '#1E40AF' }}">
            </div>
          </div>
          <div class="te-field">
            <label class="te-label">Primary Dark (Hover &amp; Headers)</label>
            <div class="te-color-row">
              <input type="color" id="primaryDarkColor" class="te-color-picker" value="{{ theme.primary_dark or '#1E3A8A' }}">
              <input type="text" id="primaryDarkColorText" class="te-input" value="{{ theme.primary_dark or '#1E3A8A' }}">
            </div>
          </div>
          <div class="te-field">
            <label class="te-label">Primary Light (Badges &amp; Highlights)</label>
            <div class="te-color-row">
              <input type="color" id="primaryLightColor" class="te-color-picker" value="{{ theme.primary_light or '#3B82F6' }}">
              <input type="text" id="primaryLightColorText" class="te-input" value="{{ theme.primary_light or '#3B82F6' }}">
            </div>
          </div>
        </div>
      </div>

      <!-- Accent Gold / Secondary Colors -->
      <div class="te-section" data-collapsed="false">
        <div class="te-section-header">
          <span>🟡 Accent &amp; Conversion Colors</span>
          <span>▾</span>
        </div>
        <div class="te-section-body">
          <div class="te-field">
            <label class="te-label">Accent Highlight (Gold / Amber / Coral)</label>
            <div class="te-color-row">
              <input type="color" id="accentColor" class="te-color-picker" value="{{ theme.accent or '#EAB308' }}">
              <input type="text" id="accentColorText" class="te-input" value="{{ theme.accent or '#EAB308' }}">
            </div>
          </div>
          <div class="te-field">
            <label class="te-label">Accent Light (Badges)</label>
            <div class="te-color-row">
              <input type="color" id="accentLightColor" class="te-color-picker" value="{{ theme.accent_light or '#FDE047' }}">
              <input type="text" id="accentLightColorText" class="te-input" value="{{ theme.accent_light or '#FDE047' }}">
            </div>
          </div>
        </div>
      </div>

      <!-- Canvas Foundations (Light & Dark) -->
      <div class="te-section" data-collapsed="false">
        <div class="te-section-header">
          <span>🌓 Canvas &amp; Surface Foundations</span>
          <span>▾</span>
        </div>
        <div class="te-section-body">
          <div class="te-field">
            <label class="te-label">Page Background Color</label>
            <div class="te-color-row">
              <input type="color" id="bgColor" class="te-color-picker" value="{{ theme.bg_color or '#ffffff' }}">
              <input type="text" id="bgColorText" class="te-input" value="{{ theme.bg_color or '#ffffff' }}">
            </div>
          </div>
          <div class="te-field">
            <label class="te-label">Surface / Card Color</label>
            <div class="te-color-row">
              <input type="color" id="surfaceColor" class="te-color-picker" value="{{ theme.surface_color or '#f8fafc' }}">
              <input type="text" id="surfaceColorText" class="te-input" value="{{ theme.surface_color or '#f8fafc' }}">
            </div>
          </div>
          <div class="te-field">
            <label class="te-label">Primary Text Color</label>
            <div class="te-color-row">
              <input type="color" id="textColor" class="te-color-picker" value="{{ theme.text_color or '#0f172a' }}">
              <input type="text" id="textColorText" class="te-input" value="{{ theme.text_color or '#0f172a' }}">
            </div>
          </div>
          <div class="te-field">
            <label class="te-label">Muted / Subtitle Text Color</label>
            <div class="te-color-row">
              <input type="color" id="textMutedColor" class="te-color-picker" value="{{ theme.text_muted or '#64748b' }}">
              <input type="text" id="textMutedColorText" class="te-input" value="{{ theme.text_muted or '#64748b' }}">
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- ─── TAB 2: TYPOGRAPHY ────────────────────────────────────── -->
    <div class="te-tab-content" id="tab-typography">
      <div class="te-section" data-collapsed="false">
        <div class="te-section-header">
          <span>🔤 Font Families &amp; Hierarchy</span>
          <span>▾</span>
        </div>
        <div class="te-section-body">
          <div class="te-field">
            <label class="te-label">Heading Font Family</label>
            <select id="fontHeading" class="te-select">
              <option value="'Inter', sans-serif" {% if theme.font_heading == "'Inter', sans-serif" %}selected{% endif %}>Inter (Modern Clean)</option>
              <option value="'Outfit', sans-serif" {% if theme.font_heading == "'Outfit', sans-serif" %}selected{% endif %}>Outfit (Architectural Bold)</option>
              <option value="'Plus Jakarta Sans', sans-serif" {% if theme.font_heading == "'Plus Jakarta Sans', sans-serif" %}selected{% endif %}>Plus Jakarta Sans (High-Tech)</option>
              <option value="'Poppins', sans-serif" {% if theme.font_heading == "'Poppins', sans-serif" %}selected{% endif %}>Poppins (Geometric Friendly)</option>
              <option value="'Montserrat', sans-serif" {% if theme.font_heading == "'Montserrat', sans-serif" %}selected{% endif %}>Montserrat (Corporate Bold)</option>
              <option value="'Playfair Display', serif" {% if theme.font_heading == "'Playfair Display', serif" %}selected{% endif %}>Playfair Display (Luxury Serif)</option>
              <option value="'Roboto', sans-serif" {% if theme.font_heading == "'Roboto', sans-serif" %}selected{% endif %}>Roboto (Standard Neutral)</option>
            </select>
          </div>
          <div class="te-field">
            <label class="te-label">Body Font Family</label>
            <select id="fontBody" class="te-select">
              <option value="'Inter', sans-serif" {% if theme.font_body == "'Inter', sans-serif" %}selected{% endif %}>Inter (Optimal Readability)</option>
              <option value="'Roboto', sans-serif" {% if theme.font_body == "'Roboto', sans-serif" %}selected{% endif %}>Roboto</option>
              <option value="'Plus Jakarta Sans', sans-serif" {% if theme.font_body == "'Plus Jakarta Sans', sans-serif" %}selected{% endif %}>Plus Jakarta Sans</option>
              <option value="system-ui, -apple-system, sans-serif" {% if theme.font_body == "system-ui, -apple-system, sans-serif" %}selected{% endif %}>System Native OS</option>
            </select>
          </div>
          <div class="te-field">
            <label class="te-label">Base Font Size</label>
            <div class="te-slider-row">
              <input type="range" id="fontSizeBase" class="te-range" min="14" max="20" value="{{ theme.font_size_base | replace('px', '') or '16' }}">
              <span class="te-range-val" id="fontSizeBaseVal">{{ theme.font_size_base or '16px' }}</span>
