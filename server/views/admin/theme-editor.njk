      <iframe id="previewIframe" src="/" title="Website Live Preview Canvas"></iframe>
    </div>
  </main>

</div>

<!-- ─── 4. TOAST NOTIFICATION ────────────────────────────────────── -->
<div class="te-toast" id="toastMessage">✅ Theme Published Live!</div>

<script>
const presetsData = {{ presets | dump | safe }};

(function() {
  const iframe = document.getElementById('previewIframe');
  const frameWrapper = document.getElementById('frameWrapper');
  const pageSelector = document.getElementById('pageSelector');
  const deviceButtons = document.querySelectorAll('.te-device-btn[data-mode]');
  const rotateBtn = document.getElementById('rotateBtn');
  const inspectorBtn = document.getElementById('inspectorBtn');
  const saveBtn = document.getElementById('saveBtn');
  const resetBtn = document.getElementById('resetBtn');
  const undoBtn = document.getElementById('undoBtn');
  const redoBtn = document.getElementById('redoBtn');
  const toast = document.getElementById('toastMessage');

  // Tab Switching
  const tabBtns = document.querySelectorAll('.te-tab-btn');
  const tabContents = document.querySelectorAll('.te-tab-content');

  function openTab(tabId) {
    tabBtns.forEach(b => b.classList.remove('active'));
    tabContents.forEach(c => c.classList.remove('active'));
    const btn = document.querySelector(`.te-tab-btn[data-tab="${tabId}"]`);
    const content = document.getElementById(`tab-${tabId}`);
    if (btn && content) {
      btn.classList.add('active');
      content.classList.add('active');
    }
  }

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      openTab(btn.getAttribute('data-tab'));
    });
  });

  // State & History Stack (Undo / Redo)
  const historyStack = [];
  let historyIndex = -1;
  const MAX_HISTORY = 30;

  function syncPair(picker, text) {
    if (!picker || !text) return;
    picker.addEventListener('input', () => {
      text.value = picker.value;
      sendLiveUpdate();
    });
    text.addEventListener('input', () => {
      if (/^#[0-9A-Fa-f]{6}$/.test(text.value)) {
        picker.value = text.value;
        sendLiveUpdate();
      }
    });
  }

  // Inputs
  const primaryColor = document.getElementById('primaryColor');
  const primaryColorText = document.getElementById('primaryColorText');
  const primaryDarkColor = document.getElementById('primaryDarkColor');
  const primaryDarkColorText = document.getElementById('primaryDarkColorText');
  const primaryLightColor = document.getElementById('primaryLightColor');
  const primaryLightColorText = document.getElementById('primaryLightColorText');
  const accentColor = document.getElementById('accentColor');
  const accentColorText = document.getElementById('accentColorText');
  const accentLightColor = document.getElementById('accentLightColor');
  const accentLightColorText = document.getElementById('accentLightColorText');

  const bgColor = document.getElementById('bgColor');
  const bgColorText = document.getElementById('bgColorText');
  const surfaceColor = document.getElementById('surfaceColor');
  const surfaceColorText = document.getElementById('surfaceColorText');
  const textColor = document.getElementById('textColor');
  const textColorText = document.getElementById('textColorText');
  const textMutedColor = document.getElementById('textMutedColor');
  const textMutedColorText = document.getElementById('textMutedColorText');

  const fontHeading = document.getElementById('fontHeading');
  const fontBody = document.getElementById('fontBody');
  const fontSizeBase = document.getElementById('fontSizeBase');
  const fontSizeBaseVal = document.getElementById('fontSizeBaseVal');

  const containerWidth = document.getElementById('containerWidth');
  const sectionSpacing = document.getElementById('sectionSpacing');
  const radiusRange = document.getElementById('radiusRange');
  const radiusVal = document.getElementById('radiusVal');
  const shadowPreset = document.getElementById('shadowPreset');
  const buttonStyle = document.getElementById('buttonStyle');

  const showAnnouncement = document.getElementById('showAnnouncement');
  const announcementText = document.getElementById('announcementText');
  const announcementBg = document.getElementById('announcementBg');
  const announcementBgText = document.getElementById('announcementBgText');
  const announcementColor = document.getElementById('announcementColor');
  const announcementColorText = document.getElementById('announcementColorText');

  const navbarSticky = document.getElementById('navbarSticky');
  const hotlinePhone = document.getElementById('hotlinePhone');
  const aiWidgetPrimary = document.getElementById('aiWidgetPrimary');
  const aiWidgetPrimaryText = document.getElementById('aiWidgetPrimaryText');
  const aiWidgetPosition = document.getElementById('aiWidgetPosition');
  const transitionSpeed = document.getElementById('transitionSpeed');
  const customCss = document.getElementById('customCss');

  syncPair(primaryColor, primaryColorText);
  syncPair(primaryDarkColor, primaryDarkColorText);
  syncPair(primaryLightColor, primaryLightColorText);
  syncPair(accentColor, accentColorText);
  syncPair(accentLightColor, accentLightColorText);
  syncPair(bgColor, bgColorText);
  syncPair(surfaceColor, surfaceColorText);
  syncPair(textColor, textColorText);
  syncPair(textMutedColor, textMutedColorText);
  syncPair(announcementBg, announcementBgText);
  syncPair(announcementColor, announcementColorText);
  syncPair(aiWidgetPrimary, aiWidgetPrimaryText);

  if (fontSizeBase) {
    fontSizeBase.addEventListener('input', () => {
      fontSizeBaseVal.textContent = fontSizeBase.value + 'px';
      sendLiveUpdate();
    });
  }

  const themeArchetype = document.getElementById('themeArchetype');

  document.querySelectorAll('.te-archetype-card').forEach(card => {
    card.addEventListener('click', () => {
      document.querySelectorAll('.te-archetype-card').forEach(c => {
        c.classList.remove('active');
        c.style.borderColor = 'var(--sidebar-border)';
      });
      card.classList.add('active');
      card.style.borderColor = 'var(--primary-blue)';
      const arch = card.getAttribute('data-archetype');
      if (themeArchetype) themeArchetype.value = arch;
      sendLiveUpdate();
    });
  });

  if (radiusRange) {
    radiusRange.addEventListener('input', () => {
      radiusVal.textContent = radiusRange.value + 'px';
      sendLiveUpdate();
    });
  }

  [fontHeading, fontBody, containerWidth, sectionSpacing, shadowPreset, buttonStyle, showAnnouncement, announcementText, navbarSticky, hotlinePhone, aiWidgetPosition, transitionSpeed, customCss].forEach(el => {
    if (el) el.addEventListener('input', () => sendLiveUpdate());
  });

  function getCurrentThemeData() {
    const r = parseInt(radiusRange ? radiusRange.value : 8, 10);
    return {
      archetype: themeArchetype ? themeArchetype.value : 'catalog-first',
      primary: primaryColor.value,
      primary_dark: primaryDarkColor.value,
      primary_light: primaryLightColor.value,
      accent: accentColor.value,
      accent_light: accentLightColor.value,
      bg_color: bgColor.value,
      surface_color: surfaceColor.value,
      text_color: textColor.value,
      text_muted: textMutedColor.value,
      font_heading: fontHeading.value,
      font_body: fontBody.value,
      font_size_base: (fontSizeBase ? fontSizeBase.value : '16') + 'px',
      container_width: containerWidth ? containerWidth.value : '1280px',
      section_spacing: sectionSpacing ? sectionSpacing.value : 'normal',
      radius_sm: Math.max(2, Math.round(r * 0.5)) + 'px',
      radius_md: r + 'px',
      radius_lg: Math.round(r * 1.5) + 'px',
      radius_xl: Math.round(r * 2) + 'px',
      show_announcement: showAnnouncement.checked,
      announcement_text: announcementText.value,
      announcement_bg: announcementBg.value,
      announcement_color: announcementColor.value,
      navbar_sticky: navbarSticky ? navbarSticky.checked : true,
      hotline_phone: hotlinePhone ? hotlinePhone.value : '+880 1711-200241',
      ai_widget_primary: aiWidgetPrimary.value,
      ai_widget_position: aiWidgetPosition ? aiWidgetPosition.value : 'right',
      transition_speed: transitionSpeed ? transitionSpeed.value : '0.25s',
      custom_css: customCss ? customCss.value : '',
    };
  }

  function applyThemeData(theme) {
    if (!theme) return;
    if (theme.archetype && themeArchetype) {
      themeArchetype.value = theme.archetype;
      document.querySelectorAll('.te-archetype-card').forEach(c => {
        const isMatch = c.getAttribute('data-archetype') === theme.archetype;
        c.classList.toggle('active', isMatch);
        c.style.borderColor = isMatch ? 'var(--primary-blue)' : 'var(--sidebar-border)';
      });
    }
    if (theme.primary) { primaryColor.value = theme.primary; primaryColorText.value = theme.primary; }
    if (theme.primary_dark) { primaryDarkColor.value = theme.primary_dark; primaryDarkColorText.value = theme.primary_dark; }
    if (theme.primary_light) { primaryLightColor.value = theme.primary_light; primaryLightColorText.value = theme.primary_light; }
    if (theme.accent) { accentColor.value = theme.accent; accentColorText.value = theme.accent; }
    if (theme.accent_light) { accentLightColor.value = theme.accent_light; accentLightColorText.value = theme.accent_light; }
    if (theme.bg_color) { bgColor.value = theme.bg_color; bgColorText.value = theme.bg_color; }
    if (theme.surface_color) { surfaceColor.value = theme.surface_color; surfaceColorText.value = theme.surface_color; }
    if (theme.text_color) { textColor.value = theme.text_color; textColorText.value = theme.text_color; }
    if (theme.text_muted) { textMutedColor.value = theme.text_muted; textMutedColorText.value = theme.text_muted; }
    if (theme.font_heading) { fontHeading.value = theme.font_heading; }
    if (theme.font_body) { fontBody.value = theme.font_body; }
    if (theme.announcement_bg) { announcementBg.value = theme.announcement_bg; announcementBgText.value = theme.announcement_bg; }
    if (theme.announcement_color) { announcementColor.value = theme.announcement_color; announcementColorText.value = theme.announcement_color; }
    if (theme.custom_css !== undefined && customCss) { customCss.value = theme.custom_css; }
    sendLiveUpdate(false);
  }

  function pushHistory() {
    const snap = getCurrentThemeData();
    historyStack.splice(historyIndex + 1);
    historyStack.push(snap);
    if (historyStack.length > MAX_HISTORY) historyStack.shift();
    historyIndex = historyStack.length - 1;
  }

  pushHistory();

  let updateTimeout = null;
  function sendLiveUpdate(record = true) {
    const theme = getCurrentThemeData();
    if (iframe.contentWindow) {
      iframe.contentWindow.postMessage({ type: 'BH_THEME_UPDATE', theme: theme }, '*');
    }
    if (record) {
      clearTimeout(updateTimeout);
      updateTimeout = setTimeout(pushHistory, 400);
    }
  }

  // Undo / Redo
  undoBtn.addEventListener('click', () => {
    if (historyIndex > 0) {
      historyIndex--;
      applyThemeData(historyStack[historyIndex]);
    }
  });

  redoBtn.addEventListener('click', () => {
    if (historyIndex < historyStack.length - 1) {
      historyIndex++;
      applyThemeData(historyStack[historyIndex]);
    }
  });

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'z') {
      e.preventDefault();
      undoBtn.click();
    } else if ((e.ctrlKey || e.metaKey) && (e.key === 'y' || (e.shiftKey && e.key === 'Z'))) {
      e.preventDefault();
      redoBtn.click();
    }
  });

  // Inspector Mode
  let inspectorActive = false;
  inspectorBtn.addEventListener('click', () => {
    inspectorActive = !inspectorActive;
    inspectorBtn.classList.toggle('active', inspectorActive);
    if (iframe.contentWindow) {
      iframe.contentWindow.postMessage({ type: 'BH_SET_INSPECTOR_MODE', active: inspectorActive }, '*');
    }
  });

  window.addEventListener('message', (event) => {
    if (!event.data) return;
    if (event.data.type === 'BH_INSPECTOR_SELECT') {
      const key = event.data.sectionKey;
      if (key === 'announcement' || key === 'navbar' || key === 'widgets') {
        openTab('components');
      } else if (key === 'typography') {
        openTab('typography');
      } else if (key === 'layout') {
        openTab('layout');
      } else {
        openTab('style');
      }
    }
  });

  // Device & Page Selectors
  deviceButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      deviceButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const mode = btn.getAttribute('data-mode');
      frameWrapper.className = `te-frame-wrapper mode-${mode}`;
    });
  });

  rotateBtn.addEventListener('click', () => {
    frameWrapper.classList.toggle('landscape');
  });

  pageSelector.addEventListener('change', () => {
    iframe.src = pageSelector.value;
  });

  iframe.addEventListener('load', () => {
    sendLiveUpdate(false);
    if (inspectorActive && iframe.contentWindow) {
      iframe.contentWindow.postMessage({ type: 'BH_SET_INSPECTOR_MODE', active: true }, '*');
    }
  });

  // DOM Navigator Nodes
  document.querySelectorAll('.nav-tree-node').forEach(node => {
    node.addEventListener('click', () => {
      const target = node.getAttribute('data-target');
      if (iframe.contentWindow) {
        iframe.contentWindow.postMessage({ type: 'BH_THEME_HIGHLIGHT', target: target, label: node.textContent }, '*');
      }
    });
  });

  // Presets 1-Click Apply
  const presetCards = document.querySelectorAll('.te-preset-card');
  presetCards.forEach(card => {
    card.addEventListener('click', () => {
      presetCards.forEach(c => c.classList.remove('active'));
      card.classList.add('active');
      const slug = card.getAttribute('data-preset');
      const p = presetsData[slug];
      if (p) {
        applyThemeData(p);
      }
    });
  });

  // Accordion Toggle
  document.querySelectorAll('.te-section-header').forEach(header => {
    header.addEventListener('click', () => {
      const sec = header.parentElement;
      sec.setAttribute('data-collapsed', sec.getAttribute('data-collapsed') === 'true' ? 'false' : 'true');
    });
  });

  // Save & Publish
  saveBtn.addEventListener('click', async () => {
    saveBtn.disabled = true;
    saveBtn.textContent = '⏳ Saving...';
    const theme = getCurrentThemeData();
    const csrfMeta = document.querySelector('meta[name="csrf-token"]');
    if (csrfMeta) theme._csrf = csrfMeta.content;
    try {
      const res = await fetch('/admin/theme-editor', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(theme)
      });
      const data = await res.json();
      if (data && data.success) {
        toast.textContent = '✅ Theme Saved & Published Live!';
        toast.style.display = 'block';
        setTimeout(() => toast.style.display = 'none', 3500);
      } else {
        alert('Save error: ' + (data?.error || 'Unknown error'));
      }
    } catch (err) {
      alert('Save failed: ' + err.message);
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = '💾 Save & Publish';
    }
  });

  // Reset Defaults
  resetBtn.addEventListener('click', async () => {
    if (!confirm('Reset all theme settings to Bongshai Housing defaults?')) return;
    try {
      const csrfMeta = document.querySelector('meta[name="csrf-token"]');
      await fetch('/admin/theme-editor/reset', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ _csrf: csrfMeta ? csrfMeta.content : '' }),
      });
      window.location.reload();
    } catch (err) {
      alert('Reset failed: ' + err.message);
    }
  });
})();
</script>
</body>
</html>
