              <option value="1280px" {% if not theme.container_width or theme.container_width == '1280px' %}selected{% endif %}>Wide Modern (1280px)</option>
              <option value="1400px" {% if theme.container_width == '1400px' %}selected{% endif %}>Ultra-Wide (1400px)</option>
            </select>
          </div>
          <div class="te-field">
            <label class="te-label">Section Vertical Spacing</label>
            <select id="sectionSpacing" class="te-select">
              <option value="compact" {% if theme.section_spacing == 'compact' %}selected{% endif %}>Compact (3.5rem)</option>
              <option value="normal" {% if not theme.section_spacing or theme.section_spacing == 'normal' %}selected{% endif %}>Normal (6rem)</option>
              <option value="spacious" {% if theme.section_spacing == 'spacious' %}selected{% endif %}>Spacious (8rem)</option>
