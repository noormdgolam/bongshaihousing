        </div>
        <div class="te-section-body">
          <div class="te-field">
            <label class="te-label">Active Structural Framework</label>
            <div class="te-archetype-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
              
              <div class="te-archetype-card {% if not theme.archetype or theme.archetype == 'catalog-first' %}active{% endif %}" data-archetype="catalog-first" style="cursor:pointer; border:1px solid {% if not theme.archetype or theme.archetype == 'catalog-first' %}var(--primary-blue){% else %}var(--sidebar-border){% endif %}; background:#0B0F19; border-radius:6px; padding:8px; transition:all 0.15s ease;">
                <div style="font-size:0.75rem; font-weight:800; color:white; display:flex; align-items:center; gap:4px;">📦 Catalog-First</div>
                <div style="font-size:0.62rem; color:var(--text-muted); margin-top:2px;">Models &amp; floor calculator above fold</div>
              </div>

              <div class="te-archetype-card {% if theme.archetype == 'trust-first' %}active{% endif %}" data-archetype="trust-first" style="cursor:pointer; border:1px solid {% if theme.archetype == 'trust-first' %}var(--primary-blue){% else %}var(--sidebar-border){% endif %}; background:#0B0F19; border-radius:6px; padding:8px; transition:all 0.15s ease;">
                <div style="font-size:0.75rem; font-weight:800; color:white; display:flex; align-items:center; gap:4px;">🛡️ Trust-First</div>
                <div style="font-size:0.62rem; color:var(--text-muted); margin-top:2px;">ISO, BNBC 2020 &amp; verified reviews lead</div>
              </div>

              <div class="te-archetype-card {% if theme.archetype == 'story-process' %}active{% endif %}" data-archetype="story-process" style="cursor:pointer; border:1px solid {% if theme.archetype == 'story-process' %}var(--primary-blue){% else %}var(--sidebar-border){% endif %}; background:#0B0F19; border-radius:6px; padding:8px; transition:all 0.15s ease;">
                <div style="font-size:0.75rem; font-weight:800; color:white; display:flex; align-items:center; gap:4px;">🔨 Story-Process</div>
