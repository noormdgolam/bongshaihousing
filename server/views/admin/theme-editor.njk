              </div>

              <div class="te-archetype-card {% if theme.archetype == 'mobile-priority' %}active{% endif %}" data-archetype="mobile-priority" style="cursor:pointer; border:1px solid {% if theme.archetype == 'mobile-priority' %}var(--primary-blue){% else %}var(--sidebar-border){% endif %}; background:#0B0F19; border-radius:6px; padding:8px; transition:all 0.15s ease;">
                <div style="font-size:0.75rem; font-weight:800; color:white; display:flex; align-items:center; gap:4px;">📱 Mobile-Priority</div>
