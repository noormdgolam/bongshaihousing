              </div>

              <div class="te-archetype-card {% if theme.archetype == 'broken-grid' %}active{% endif %}" data-archetype="broken-grid" style="cursor:pointer; border:1px solid {% if theme.archetype == 'broken-grid' %}var(--primary-blue){% else %}var(--sidebar-border){% endif %}; background:#0B0F19; border-radius:6px; padding:8px; transition:all 0.15s ease;">
