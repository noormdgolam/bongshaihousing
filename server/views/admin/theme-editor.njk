          </div>
        </div>
      </div>

      <!-- Container, Spacing & Corner Radii -->
      <div class="te-section" data-collapsed="false">
        <div class="te-section-header">
          <span>📐 Container, Spacing &amp; Shadows</span>
          <span>▾</span>
