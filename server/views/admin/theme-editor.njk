              <option value="0.15s" {% if theme.transition_speed == '0.15s' %}selected{% endif %}>Fast (0.15s)</option>
              <option value="0.25s" {% if not theme.transition_speed or theme.transition_speed == '0.25s' %}selected{% endif %}>Balanced (0.25s)</option>
              <option value="0.4s" {% if theme.transition_speed == '0.4s' %}selected{% endif %}>Smooth (0.40s)</option>
