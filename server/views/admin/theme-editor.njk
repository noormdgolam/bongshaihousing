    <!-- ─── TAB 8: DOM NAVIGATOR TREE ───────────────────────────── -->
    <div class="te-tab-content" id="tab-navigator">
      <div style="font-size:0.8rem; font-weight:700; color:white; margin-bottom:10px;">📑 Page Sections Tree</div>
      <div style="display:flex; flex-direction:column; gap:6px;">
        <button type="button" class="btn btn-outline nav-tree-node" data-target="announcement" style="justify-content:flex-start;">📢 Announcement Bar</button>
        <button type="button" class="btn btn-outline nav-tree-node" data-target="navbar" style="justify-content:flex-start;">🧭 Navigation Header</button>
        <button type="button" class="btn btn-outline nav-tree-node" data-target="hero" style="justify-content:flex-start;">🖼️ Page Hero Banner</button>
        <button type="button" class="btn btn-outline nav-tree-node" data-target="features" style="justify-content:flex-start;">⚡ Features Strip</button>
        <button type="button" class="btn btn-outline nav-tree-node" data-target="catalog" style="justify-content:flex-start;">📦 Product Catalog</button>
        <button type="button" class="btn btn-outline nav-tree-node" data-target="why" style="justify-content:flex-start;">⭐ Why Choose Bongshai</button>
        <button type="button" class="btn btn-outline nav-tree-node" data-target="steps" style="justify-content:flex-start;">🔄 Construction Process Steps</button>
        <button type="button" class="btn btn-outline nav-tree-node" data-target="footer" style="justify-content:flex-start;">🦶 Site Footer</button>
