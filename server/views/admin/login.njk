{% extends "admin-layout.njk" %}
{% block content_bare %}
<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; background: linear-gradient(135deg, #0F172A 0%, #1E3A8A 100%); padding:20px;">
  <div class="card" style="width: 100%; max-width: 380px; padding:32px 28px; border-radius:12px; box-shadow: 0 20px 40px rgba(0,0,0,0.3);">
    <div style="text-align:center; margin-bottom:24px;">
      <div style="font-size:2rem; margin-bottom:4px;">🏗️</div>
      <h1 style="font-size:1.4rem; font-weight:800; margin:0; color:var(--grey-900);">Bongshai CMS</h1>
      <p style="color: var(--grey-500); font-size: 0.85rem; margin-top:4px;">Sign in to access admin dashboard &amp; leads.</p>
    </div>

    {% if error %}
    <div class="error-box" style="margin-bottom:16px;">{{ error }}</div>
    {% endif %}

    <form method="post" action="/admin/login">
      <div class="form-row">
        <label for="email">Admin Email Address</label>
        <input type="email" id="email" name="email" placeholder="admin@bongshaihousing.com" required autofocus style="padding:10px 12px;">
      </div>
      <div class="form-row" style="margin-bottom:20px;">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="••••••••" required style="padding:10px 12px;">
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%; padding:10px; font-weight:700; font-size:0.95rem;">Sign In to Dashboard →</button>
    </form>

    <div style="margin-top:20px; text-align:center;">
      <a href="/" style="font-size:0.8rem; color:var(--grey-500);">← Return to Public Website</a>
    </div>
  </div>
</div>
{% endblock %}

