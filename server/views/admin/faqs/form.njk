{% extends "admin-layout.njk" %}
{% block title %}{% if faq.id %}Edit FAQ #{{ faq.id }}{% else %}New FAQ Item{% endif %}{% endblock %}
{% block header %}<h1 style="font-size:1.15rem; font-weight:700; margin:0;">{% if faq.id %}Edit FAQ Item{% else %}Create New Frequently Asked Question{% endif %}</h1>{% endblock %}

{% block content %}
{% if error %}<div class="error-box">{{ error }}</div>{% endif %}

<div class="card" style="max-width:800px;">
  <form method="post" action="{% if faq.id %}/admin/faqs/{{ faq.id }}{% else %}/admin/faqs{% endif %}">
    <div class="form-row">
      <label for="question">Question (Natural Language Query) <span style="color:var(--danger);">*</span></label>
      <input type="text" id="question" name="question" value="{{ faq.question or '' }}" placeholder="e.g. How much does a prefab steel building cost in Bangladesh?" required style="font-size:1rem; font-weight:600;">
      <div style="font-size:0.8rem; color:var(--grey-500); margin-top:4px;">Tip: Frame as a question visitors or AI engines frequently ask (AEO friendly).</div>
    </div>

    <div class="form-row">
      <label for="answer">Answer (Direct &amp; Concise Response) <span style="color:var(--danger);">*</span></label>
      <textarea id="answer" name="answer" rows="5" placeholder="Enter clear, informative answer. HTML tags like <a> links are supported." required style="font-size:0.95rem; line-height:1.5;">{{ faq.answer or '' }}</textarea>
      <div style="font-size:0.8rem; color:var(--grey-500); margin-top:4px;">Direct answers under 45 words perform best for Google snippets and AI search citations.</div>
    </div>

    <div class="admin-grid-2col" style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:8px;">
      <div class="form-row">
        <label for="category_select">Category</label>
        <select id="category_select" onchange="if(this.value==='__custom__'){document.getElementById('custom_category_wrap').style.display='block';document.getElementById('category').value='';}else{document.getElementById('custom_category_wrap').style.display='none';document.getElementById('category').value=this.value;}">
          {% for cat in categories %}
          <option value="{{ cat }}" {% if (faq.category or 'General') == cat %}selected{% endif %}>{{ cat }}</option>
          {% endfor %}
          <option value="__custom__">+ Add New Category...</option>
        </select>
        <div id="custom_category_wrap" style="display:none; margin-top:8px;">
          <input type="text" id="category" name="category" value="{{ faq.category or 'General' }}" placeholder="Enter new category name">
        </div>
      </div>

      <div class="form-row">
        <label for="sort_order">Display Sort Order</label>
        <input type="number" id="sort_order" name="sort_order" value="{{ faq.sort_order if faq.sort_order is defined else 0 }}" min="0">
        <div style="font-size:0.8rem; color:var(--grey-500); margin-top:4px;">Lower numbers appear first within category.</div>
      </div>
    </div>

    <div class="form-row" style="margin-top:14px; background:var(--grey-50); padding:12px 16px; border-radius:6px; border:1px solid var(--grey-200);">
      <label style="display:flex; align-items:center; cursor:pointer; margin:0;">
        <input type="checkbox" id="published" name="published" {% if faq.published or not faq.id %}checked{% endif %} style="width:auto; margin-right:10px;">
        <span style="font-weight:700; color:var(--grey-900);">Published Live on Website &amp; Schema.org JSON-LD</span>
      </label>
    </div>

    <div class="form-actions" style="margin-top:24px;">
      <button type="submit" class="btn btn-primary">{% if faq.id %}Save Changes{% else %}Create FAQ{% endif %}</button>
      <a href="/admin/faqs" class="btn">Cancel</a>
    </div>
  </form>
</div>

{% if faq.id %}
<div class="card" style="max-width:800px; border-top:3px solid var(--danger); margin-top:20px;">
  <h3 style="font-size:0.9rem; font-weight:700; color:var(--danger); margin-top:0;">Delete FAQ</h3>
  <p style="font-size:0.8rem; color:var(--grey-500); margin-bottom:12px;">Permanently remove this question from the website and schema markup.</p>
  <form method="post" action="/admin/faqs/{{ faq.id }}/delete" onsubmit="return confirm('Are you sure you want to delete this FAQ?');">
    <button type="submit" class="btn btn-danger">Delete FAQ</button>
  </form>
</div>

{% set entityType = "faq" %}
{% set entityId = faq.id %}
{% include "admin/partials/history-panel.njk" %}
{% endif %}
{% endblock %}
