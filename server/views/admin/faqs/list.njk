{% extends "admin-layout.njk" %}
{% block title %}FAQs Management{% endblock %}
{% block header %}<h1 style="font-size:1.15rem; font-weight:700; margin:0;">Frequently Asked Questions (FAQ) Management</h1>{% endblock %}

{% block content %}
<!-- Quick Stats Cards -->
<div class="stat-grid" style="margin-bottom:20px;">
  <div class="stat-card" style="border-left: 4px solid var(--primary);">
    <div class="num">{{ totalCount }}</div>
    <div class="label">Total Questions</div>
  </div>
  <div class="stat-card" style="border-left: 4px solid #10B981;">
    <div class="num">{{ publishedCount }}</div>
    <div class="label">Published Live</div>
  </div>
  <div class="stat-card" style="border-left: 4px solid #F59E0B;">
    <div class="num">{{ categories.length }}</div>
    <div class="label">Categories</div>
  </div>
</div>

<div class="card">
  <!-- Filter & Search Toolbar -->
  <form method="get" action="/admin/faqs" class="toolbar">
    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
      <input 
        type="text" 
        name="q" 
        value="{{ search }}" 
        placeholder="Search questions or answers..." 
        style="padding:8px 12px; border:1px solid var(--grey-200); border-radius:6px; font-size:0.9rem; min-width:240px;"
      />
      <select name="category" onchange="this.form.submit()" style="padding:8px 12px; border:1px solid var(--grey-200); border-radius:6px; font-size:0.9rem;">
        <option value="all" {% if categoryFilter == 'all' or not categoryFilter %}selected{% endif %}>All Categories</option>
        {% for cat in categories %}
        <option value="{{ cat }}" {% if categoryFilter == cat %}selected{% endif %}>{{ cat }}</option>
        {% endfor %}
      </select>
      <select name="status" onchange="this.form.submit()" style="padding:8px 12px; border:1px solid var(--grey-200); border-radius:6px; font-size:0.9rem;">
        <option value="all" {% if statusFilter == 'all' or not statusFilter %}selected{% endif %}>All Status</option>
        <option value="published" {% if statusFilter == 'published' %}selected{% endif %}>Published Only</option>
        <option value="draft" {% if statusFilter == 'draft' %}selected{% endif %}>Draft / Hidden Only</option>
      </select>
      <button type="submit" class="btn btn-primary">Filter</button>
      {% if search or (categoryFilter and categoryFilter != 'all') or (statusFilter and statusFilter != 'all') %}
      <a href="/admin/faqs" class="btn">Clear</a>
      {% endif %}
    </div>
    <div style="display:flex; gap:8px;">
      <a href="/admin/faqs/new" class="btn btn-primary">➕ Add New FAQ</a>
      <a href="/faq.html" target="_blank" class="btn" title="View Public Page">🌐 Public FAQ Page ↗</a>
    </div>
  </form>

  <!-- FAQs Table -->
  <div style="overflow-x:auto;">
    <table>
      <thead>
        <tr>
          <th style="width:60px;">Order</th>
          <th>Question</th>
          <th style="width:160px;">Category</th>
          <th style="width:110px;">Status</th>
          <th style="width:100px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for f in faqs %}
        <tr>
          <td>
            <span style="font-family:monospace; color:var(--grey-500); font-weight:600;">#{{ f.sort_order }}</span>
          </td>
          <td>
            <strong style="color:var(--grey-900); font-size:0.95rem; display:block; margin-bottom:4px;">{{ f.question }}</strong>
            <div style="font-size:0.82rem; color:var(--grey-500); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
              {{ f.answer | striptags }}
            </div>
          </td>
          <td>
            <span class="pill pill-muted" style="font-weight:600; font-size:0.8rem;">{{ f.category or 'General' }}</span>
          </td>
          <td>
            {% if f.published %}
            <span class="pill pill-success" style="font-size:0.75rem;">🟢 Live</span>
            {% else %}
            <span class="pill pill-danger" style="font-size:0.75rem;">⚪ Hidden</span>
            {% endif %}
          </td>
          <td style="white-space:nowrap;">
            <a href="/admin/faqs/{{ f.id }}/edit" class="btn" style="padding:4px 10px; font-size:0.8rem;">Edit</a>
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="5" style="text-align:center; padding:30px; color:var(--grey-500);">
            No FAQs found matching your criteria. Click "Add New FAQ" to create one.
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
