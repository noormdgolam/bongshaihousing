{% extends "admin-layout.njk" %}
{% block title %}Media Library{% endblock %}
{% block header %}<h1 style="font-size:1.1rem; margin:0;">Media Library</h1>{% endblock %}
{% block content %}
<p style="color:var(--grey-500); font-size:0.85rem; margin-top:0;">
  {{ files.length }} uploaded file(s){% if unusedCount %} — <strong style="color:var(--danger);">{{ unusedCount }} unused</strong>, safe to delete{% endif %}.
</p>
<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(160px, 1fr)); gap:14px;">
  {% for f in files %}
  <div class="card" style="padding:10px; margin-bottom:0;">
    <div style="width:100%; aspect-ratio:4/3; border-radius:6px; overflow:hidden; background:var(--grey-100); margin-bottom:8px;">
      <img src="/{{ f.path }}" alt="{{ f.filename }}" style="width:100%; height:100%; object-fit:cover;" loading="lazy">
    </div>
    <div style="font-size:0.75rem; word-break:break-all; color:var(--grey-700); margin-bottom:4px;">{{ f.filename }}</div>
    <div style="font-size:0.7rem; color:var(--grey-500); margin-bottom:8px;">
      {{ (f.size / 1024) | round(0) }} KB
      {% if f.inUse %}<span class="pill pill-success" style="margin-left:4px;">In use</span>{% else %}<span class="pill pill-muted" style="margin-left:4px;">Unused</span>{% endif %}
    </div>
    {% if not f.inUse %}
    <form method="post" action="/admin/media/{{ f.filename }}/delete" onsubmit="return confirm('Delete {{ f.filename }}? This cannot be undone.');">
      <button type="submit" class="btn btn-danger" style="width:100%; padding:4px; font-size:0.75rem;">Delete</button>
    </form>
    {% endif %}
  </div>
  {% else %}
  <p style="color:var(--grey-500);">No uploads yet. Files uploaded from product/category/project forms will appear here.</p>
  {% endfor %}
</div>
{% endblock %}
