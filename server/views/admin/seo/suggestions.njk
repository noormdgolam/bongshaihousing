{% extends "admin-layout.njk" %}
{% block title %}SEO Suggestions{% endblock %}
{% block header %}<h1 style="margin:0; font-size:1.2rem;">✨ AI SEO Suggestions</h1>{% endblock %}
{% block content %}
<div class="toolbar">
  <a href="/admin/seo" class="btn">← Back to SEO Dashboard</a>
  <div style="display:flex; gap:6px;">
    <a href="/admin/seo/suggestions?status=pending" class="btn {% if statusFilter == 'pending' %}btn-primary{% endif %}">Pending</a>
    <a href="/admin/seo/suggestions?status=approved" class="btn {% if statusFilter == 'approved' %}btn-primary{% endif %}">Approved</a>
    <a href="/admin/seo/suggestions?status=rejected" class="btn {% if statusFilter == 'rejected' %}btn-primary{% endif %}">Rejected</a>
    <a href="/admin/seo/suggestions?status=all" class="btn {% if statusFilter == 'all' %}btn-primary{% endif %}">All</a>
    <a href="/admin/seo/suggestions/export/csv?status={{ statusFilter }}" class="btn">Export CSV</a>
  </div>
</div>

{% if suggestions.length %}
{% for s in suggestions %}
<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px; flex-wrap:wrap; gap:8px;">
    <div>
      <strong style="font-size:0.95rem;">{{ s.target_label }}</strong>
      <span class="pill pill-muted" style="margin-left:6px;">{{ s.suggestion_type | replace('_', ' ') }}</span>
    </div>
    <span class="pill {% if s.status == 'approved' %}pill-success{% elif s.status == 'rejected' %}pill-muted{% endif %}">{{ s.status }}</span>
  </div>

  <div class="admin-grid-2col" style="gap:14px;">
    <div>
      <span style="font-size:0.75rem; color:var(--grey-500); text-transform:uppercase; font-weight:700;">Current</span>
      <p style="font-size:0.88rem; background:var(--grey-50); border-radius:6px; padding:8px 10px; margin-top:4px; white-space:pre-wrap;">{{ s.current_value or '(empty)' }}</p>
    </div>
    <div>
      <span style="font-size:0.75rem; color:var(--success); text-transform:uppercase; font-weight:700;">Suggested</span>
      <p style="font-size:0.88rem; background:#f0fdf4; border-radius:6px; padding:8px 10px; margin-top:4px; white-space:pre-wrap;">{{ s.suggested_value }}</p>
    </div>
  </div>

  {% if s.reasoning %}
  <p style="font-size:0.8rem; color:var(--grey-500); margin-top:10px; margin-bottom:0;">💡 {{ s.reasoning }}</p>
  {% endif %}

  {% if s.status == 'pending' %}
  <div style="display:flex; gap:8px; margin-top:14px;">
    <form method="post" action="/admin/seo/suggestions/{{ s.id }}/approve" style="flex:1; margin:0;">
      <button type="submit" class="btn btn-primary" style="width:100%; background:var(--success); border-color:var(--success);">✓ Approve &amp; Publish</button>
    </form>
    <form method="post" action="/admin/seo/suggestions/{{ s.id }}/reject" style="flex:1; margin:0;">
      <button type="submit" class="btn btn-danger" style="width:100%;">✕ Reject</button>
    </form>
  </div>
  {% endif %}
</div>
{% endfor %}
{% else %}
<div class="card"><p style="color:var(--grey-500); margin:0;">No {{ statusFilter }} suggestions. Generate some from the SEO dashboard.</p></div>
{% endif %}
{% endblock %}
