{% extends "admin-layout.njk" %}
{% block title %}Customer Inquiries / Leads{% endblock %}
{% block header %}<h1 style="font-size:1.15rem; font-weight:700; margin:0;">Customer Inquiries &amp; Quote Requests</h1>{% endblock %}

{% block content %}
<div class="card">
  <!-- Search & Filter Toolbar -->
  <form method="get" action="/admin/leads" class="toolbar">
    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
      <input 
        type="text" 
        name="q" 
        value="{{ search }}" 
        placeholder="Search by name, phone, email, district..." 
        style="padding:8px 12px; border:1px solid var(--grey-200); border-radius:6px; font-size:0.9rem; min-width:260px;"
      />
      <select name="status" style="padding:8px 12px; border:1px solid var(--grey-200); border-radius:6px; font-size:0.9rem;">
        <option value="all" {% if status == 'all' or not status %}selected{% endif %}>All Statuses</option>
        <option value="new" {% if status == 'new' %}selected{% endif %}>New Only</option>
        <option value="contacted" {% if status == 'contacted' %}selected{% endif %}>Contacted</option>
        <option value="in_negotiation" {% if status == 'in_negotiation' %}selected{% endif %}>In Negotiation</option>
        <option value="closed" {% if status == 'closed' %}selected{% endif %}>Closed / Won</option>
      </select>
      <button type="submit" class="btn btn-primary">Filter</button>
      {% if search or (status and status != 'all') %}
      <a href="/admin/leads" class="btn">Clear</a>
      {% endif %}
    </div>
    <div>
      <a href="/admin/leads/export/csv{% if status and status != 'all' %}?status={{ status }}{% endif %}{% if search %}&q={{ search | urlencode }}{% endif %}" class="btn" style="font-weight:600;">📥 Export CSV</a>
    </div>
  </form>

  <!-- Leads Table -->
  {% if leads and leads.length %}
  <div style="overflow-x:auto;">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Received Date</th>
          <th>Customer Name</th>
          <th>Contact Info</th>
          <th>Location</th>
          <th>Requested Model / Specs</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {% for lead in leads %}
        <tr>
          <td style="color:var(--grey-500); font-weight:700;">#{{ lead.id }}</td>
          <td style="color:var(--grey-500); font-size:0.85rem; white-space:nowrap;">
            {{ lead.created_at | string | truncate(16, true, '') }}
          </td>
          <td>
            <strong>{{ lead.name }}</strong>
          </td>
          <td>
            <div><a href="tel:{{ lead.phone }}" style="font-weight:600;">📞 {{ lead.phone }}</a></div>
            <div style="font-size:0.8rem; margin-top:2px;">
              <a href="mailto:{{ lead.email }}" style="color:var(--grey-500);">✉️ {{ lead.email }}</a>
            </div>
            <div style="margin-top:4px;">
              <a href="https://wa.me/{{ lead.phone | replace('+', '') | replace('-', '') | replace(' ', '') }}?text=Hello%20{{ lead.name | urlencode }}%2C%20thank%20you%20for%20contacting%20Bongshai%20Housing." target="_blank" class="btn" style="padding:2px 8px; font-size:0.75rem; background:#10B981; color:white; border-color:#10B981;">
                💬 WhatsApp Chat
              </a>
            </div>
          </td>
          <td>
            {{ lead.upazila or '' }} {{ lead.district or 'N/A' }}
          </td>
          <td>
            {% if lead.model %}<span class="pill pill-muted" style="font-weight:700;">{{ lead.model }}</span>{% endif %}
            {% if lead.floor_area %}<div style="font-size:0.8rem; color:var(--grey-700); margin-top:2px;">Area: {{ lead.floor_area }} Sq.Ft</div>{% endif %}
            {% if lead.bedrooms %}<div style="font-size:0.8rem; color:var(--grey-500);">Bedrooms: {{ lead.bedrooms }}</div>{% endif %}
          </td>
          <td>
            {% if lead.status == 'new' %}
            <span class="pill pill-success">New</span>
            {% elif lead.status == 'contacted' %}
            <span class="pill" style="background:#dbeafe; color:#1e40af;">Contacted</span>
            {% elif lead.status == 'in_negotiation' %}
            <span class="pill" style="background:#fef3c7; color:#92400e;">In Negotiation</span>
            {% elif lead.status == 'closed' %}
            <span class="pill" style="background:#f3f4f6; color:#374151;">Closed</span>
            {% else %}
            <span class="pill pill-muted">{{ lead.status }}</span>
            {% endif %}
          </td>
          <td>
            <a href="/admin/leads/{{ lead.id }}" class="btn" style="padding:6px 12px; font-size:0.85rem;">View / Notes</a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <div style="text-align:center; padding:40px 20px; color:var(--grey-500);">
    <div style="font-size:2rem; margin-bottom:8px;">📥</div>
    <div style="font-weight:600; font-size:1rem; color:var(--grey-700);">No Inquiries Found</div>
    <p style="font-size:0.85rem; margin-top:4px;">When customers submit quote forms or inquiries on the website, they will appear here.</p>
  </div>
  {% endif %}
</div>
{% endblock %}
