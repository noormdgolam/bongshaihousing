{% extends "admin-layout.njk" %}
{% block title %}Agent Leads{% endblock %}
{% block header %}<h1 style="margin:0; font-size:1.2rem;">📥 Agent-Submitted Leads</h1>{% endblock %}
{% block content %}
<div class="toolbar">
  <a href="/admin/agents" class="btn">← Back to Agents</a>
</div>

<div class="card" style="padding:12px 16px;">
  <form method="get" action="/admin/agent-leads" style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
    <input type="text" name="q" value="{{ search }}" placeholder="Search by customer name, phone, district..." style="padding:8px 12px; border:1px solid var(--grey-200); border-radius:6px; font-size:0.9rem; min-width:240px; flex:1;">
    <select name="agent_id" style="padding:8px 12px; border:1px solid var(--grey-200); border-radius:6px; font-size:0.9rem;">
      <option value="">All Agents</option>
      {% for a in agentsForFilter %}
      <option value="{{ a.id }}" {% if agentFilter == a.id|string %}selected{% endif %}>{{ a.business_name or a.name }}</option>
      {% endfor %}
    </select>
    <select name="status" style="padding:8px 12px; border:1px solid var(--grey-200); border-radius:6px; font-size:0.9rem;">
      <option value="all" {% if statusFilter == 'all' %}selected{% endif %}>All Statuses</option>
      <option value="new" {% if statusFilter == 'new' %}selected{% endif %}>New</option>
      <option value="contacted" {% if statusFilter == 'contacted' %}selected{% endif %}>Contacted</option>
      <option value="quoted" {% if statusFilter == 'quoted' %}selected{% endif %}>Quoted</option>
      <option value="won" {% if statusFilter == 'won' %}selected{% endif %}>Won</option>
      <option value="lost" {% if statusFilter == 'lost' %}selected{% endif %}>Lost</option>
    </select>
    <button type="submit" class="btn btn-primary">Filter</button>
    {% if search or agentFilter or (statusFilter and statusFilter != 'all') %}<a href="/admin/agent-leads" class="btn">Clear</a>{% endif %}
  </form>
</div>

{% if leads.length %}
<table>
  <thead>
    <tr><th>Customer</th><th>Phone</th><th>District</th><th>Interest</th><th>Status</th><th>Agent</th><th>Submitted</th></tr>
  </thead>
  <tbody>
    {% for lead in leads %}
    <tr>
      <td>{{ lead.customer_name }}</td>
      <td>{{ lead.customer_phone }}</td>
      <td>{{ lead.customer_district or '—' }}</td>
      <td>{{ lead.product_interest or '—' }}</td>
      <td>
        <form method="post" action="/admin/agent-leads/{{ lead.id }}/status" style="margin:0;">
          <select name="status" onchange="this.form.submit()" style="font-size:0.75rem; padding:3px 6px; border-radius:12px; border:1px solid var(--grey-200); font-weight:700; cursor:pointer; background:{% if lead.status == 'new' %}#dbeafe; color:#1e40af;{% elif lead.status == 'contacted' %}#fef3c7; color:#92400e;{% elif lead.status == 'quoted' %}#e0e7ff; color:#4338ca;{% elif lead.status == 'won' %}#dcfce7; color:#16a34a;{% else %}#f1f5f9; color:#64748b;{% endif %}">
            <option value="new" {% if lead.status == 'new' %}selected{% endif %}>New</option>
            <option value="contacted" {% if lead.status == 'contacted' %}selected{% endif %}>Contacted</option>
            <option value="quoted" {% if lead.status == 'quoted' %}selected{% endif %}>Quoted</option>
            <option value="won" {% if lead.status == 'won' %}selected{% endif %}>Won</option>
            <option value="lost" {% if lead.status == 'lost' %}selected{% endif %}>Lost</option>
          </select>
        </form>
      </td>
      <td><a href="/admin/agents/{{ lead.agent_id }}">{{ lead.agent_business_name or lead.agent_name }}</a> <span style="color:var(--grey-500); font-size:0.8rem;">({{ lead.agent_phone }})</span></td>
      <td>{{ lead.created_at | date }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<div class="card"><p style="color:var(--grey-500); margin:0;">No agent leads match this filter.</p></div>
{% endif %}
{% endblock %}
