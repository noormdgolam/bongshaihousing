{% extends "admin-layout.njk" %}
{% block title %}Projects Management{% endblock %}
{% block header %}<h1 style="font-size:1.15rem; font-weight:700; margin:0;">Projects Portfolio Management</h1>{% endblock %}

{% block content %}
<div class="card">
  <div class="toolbar">
    <div></div>
    <a href="/admin/projects/new" class="btn btn-primary">➕ New Project</a>
  </div>
  
  <div style="overflow-x:auto;">
    <table>
      <thead>
        <tr>
          <th>Preview</th>
          <th>Title / Slug</th>
          <th>Location</th>
          <th>Status Badge</th>
          <th>Published</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for p in projects %}
        <tr>
          <td style="width:50px; padding:6px 10px;">
            {% if p.image %}
            <img src="{{ p.image }}" alt="{{ p.title }}" style="width:44px; height:32px; object-fit:cover; border-radius:4px; border:1px solid var(--grey-200);">
            {% else %}
            <div style="width:44px; height:32px; background:var(--grey-100); border-radius:4px; display:flex; align-items:center; justify-content:center; font-size:0.75rem; color:var(--grey-500);">🏗️</div>
            {% endif %}
          </td>
          <td>
            <strong style="color:var(--grey-900);">{{ p.title }}</strong>
            <div style="font-size:0.8rem; color:var(--grey-500);">/{{ p.slug }}</div>
          </td>
          <td>{{ p.location or '—' }}</td>
          <td><span class="pill pill-muted">{{ p.status_label }}</span></td>
          <td>
            {% if p.published %}
            <span class="pill pill-success">Yes</span>
            {% else %}
            <span class="pill pill-muted">No</span>
            {% endif %}
          </td>
          <td style="white-space:nowrap;">
            <a href="/admin/projects/{{ p.id }}/edit" class="btn" style="padding:4px 10px; font-size:0.8rem;">Edit</a>
            <a href="/{{ p.slug }}" target="_blank" class="btn" style="padding:4px 8px; font-size:0.8rem;" title="View Live Page">↗</a>
          </td>
        </tr>
        {% else %}
        <tr><td colspan="6" style="text-align:center; padding:30px; color:var(--grey-500);">No projects found in database.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
