{% extends "admin-layout.njk" %}
{% block title %}{% if category.id %}Edit Category{% else %}New Category{% endif %}{% endblock %}
{% block header %}<h1 style="font-size:1.1rem; margin:0;">{% if category.id %}Edit {{ category.name }}{% else %}New Category{% endif %}</h1>{% endblock %}
{% block content %}
{% if error %}<div class="error-box">{{ error }}</div>{% endif %}
<div class="card">
<form method="post" enctype="multipart/form-data" action="{% if category.id %}/admin/categories/{{ category.id }}{% else %}/admin/categories{% endif %}">
  <div class="form-row"><label for="name">Name</label><input type="text" id="name" name="name" value="{{ category.name or '' }}" required></div>
  <div class="form-row"><label for="slug">Slug</label><input type="text" id="slug" name="slug" value="{{ category.slug or '' }}" required></div>
  <div class="form-row"><label for="landing_page_slug">Landing Page (filename)</label><input type="text" id="landing_page_slug" name="landing_page_slug" value="{{ category.landing_page_slug or '' }}" placeholder="e.g. apartment-building.html"></div>
  <div class="form-row"><label for="description">Description (Banner / Hero intro)</label><textarea id="description" name="description" rows="3">{{ category.description or '' }}</textarea></div>
  
  <div class="form-row">
    <label>Category Hero / Banner Image</label>
    <div style="display:flex; gap:16px; align-items:start; flex-wrap:wrap; background:var(--off-white, #f8fafc); padding:14px; border-radius:8px; border:1px solid var(--grey-200, #e2e8f0);">
      <div id="heroPreviewContainer" style="width:140px; height:95px; border-radius:6px; border:1px solid var(--grey-300, #cbd5e1); background:#ffffff; display:flex; align-items:center; justify-content:center; overflow:hidden; position:relative; flex-shrink:0;">
        {% if category.hero_image %}
          <img id="heroPreviewImg" src="/{{ category.hero_image | replace('^/', '') }}" alt="Preview" style="width:100%; height:100%; object-fit:cover;">
          <span id="heroPreviewPlaceholder" style="display:none; font-size:0.75rem; color:var(--grey-400, #94a3b8);">No image</span>
        {% else %}
          <img id="heroPreviewImg" src="" alt="Preview" style="display:none; width:100%; height:100%; object-fit:cover;">
          <span id="heroPreviewPlaceholder" style="font-size:0.75rem; color:var(--grey-400, #94a3b8);">No image</span>
        {% endif %}
      </div>
      <div style="flex:1; min-width:260px;">
        <div style="margin-bottom:10px;">
          <label for="hero_image_file" style="font-size:0.8rem; font-weight:600; color:var(--grey-700, #334155); margin-bottom:4px; display:block;">📁 Upload Hero Banner</label>
          <input type="file" id="hero_image_file" name="hero_image_file" accept="image/*" style="font-size:0.85rem;" onchange="previewCategoryFile(this)">
          <span style="font-size:0.72rem; color:var(--grey-500, #64748b); display:block; margin-top:2px;">PNG, JPG, WebP, SVG up to 10MB (saved to images/uploads/)</span>
        </div>
        <div>
          <label for="hero_image" style="font-size:0.75rem; color:var(--grey-500, #64748b); margin-bottom:2px; display:block;">Or Manual Path / URL (Fallback)</label>
          <input type="text" id="hero_image" name="hero_image" value="{{ category.hero_image or '' }}" placeholder="e.g. images/hero-bg.webp" style="font-size:0.85rem;" oninput="previewCategoryUrl(this.value)">
        </div>
      </div>
    </div>
  </div>

  <div class="form-row"><label for="sort_order">Sort Order</label><input type="number" id="sort_order" name="sort_order" value="{{ category.sort_order or 0 }}"></div>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary">{% if category.id %}Save Changes{% else %}Create Category{% endif %}</button>
    <a href="/admin/categories" class="btn">Cancel</a>
  </div>
</form>
</div>
{% if category.id %}
{% macro specSection(title, type, rows, placeholderKey, placeholderValue, categoryId) %}
<div class="card">
  <h2 style="font-size:1rem;">{{ title }} ({{ (rows or []).length }})</h2>

  <details style="margin-bottom:16px;">
    <summary style="cursor:pointer; font-size:0.85rem; font-weight:600; color:var(--grey-700, #334155); padding:6px 0;">✏️ Bulk edit (paste a whole list at once)</summary>
    <form method="post" action="/admin/categories/{{ categoryId }}/specs/bulk" style="margin-top:8px;">
      <input type="hidden" name="spec_type" value="{{ type }}">
      <textarea name="bulk_text" rows="8" style="width:100%; font-family:monospace; font-size:0.85rem; border:1px solid var(--grey-200); border-radius:6px; padding:10px;" placeholder="One per line, Key: Value&#10;e.g.&#10;{{ placeholderKey }}: {{ placeholderValue }}">{% for s in (rows or []) %}{{ s.spec_key }}: {{ s.spec_value }}
{% endfor %}</textarea>
      <p style="font-size:0.75rem; color:var(--grey-500, #64748b); margin:6px 0 10px;">Saving here <strong>replaces the whole {{ title | lower }} list</strong> with exactly what's typed above, in that order. One row per line, "Key: Value" or "Key | Value".</p>
      <button type="submit" class="btn btn-primary" style="padding:6px 14px; font-size:0.85rem;">Save All {{ title }}</button>
    </form>
  </details>

  <table>
    <thead><tr><th>Item</th><th>Details</th><th></th></tr></thead>
    <tbody>
      {% for s in (rows or []) %}
      <tr>
        <form method="post" action="/admin/categories/{{ categoryId }}/specs/{{ s.id }}" style="display:contents;">
          <td><input type="text" name="spec_key" value="{{ s.spec_key }}" style="width:100%; border:1px solid var(--grey-200); border-radius:4px; padding:4px 6px;"></td>
          <td><input type="text" name="spec_value" value="{{ s.spec_value }}" style="width:100%; border:1px solid var(--grey-200); border-radius:4px; padding:4px 6px;"></td>
          <td style="white-space:nowrap;">
            <button type="submit" class="btn" style="padding:4px 10px; font-size:0.8rem;">Save</button>
            <button type="submit" formaction="/admin/categories/{{ categoryId }}/specs/{{ s.id }}/delete" formnovalidate class="btn btn-danger" style="padding:4px 10px; font-size:0.8rem;" onclick="return confirm('Delete this spec row?');">Del</button>
          </td>
        </form>
      </tr>
      {% endfor %}
      <tr>
        <form method="post" action="/admin/categories/{{ categoryId }}/specs" style="display:contents;">
          <input type="hidden" name="spec_type" value="{{ type }}">
          <td><input type="text" name="spec_key" placeholder="e.g. {{ placeholderKey }}" style="width:100%; border:1px solid var(--grey-200); border-radius:4px; padding:4px 6px;"></td>
          <td><input type="text" name="spec_value" placeholder="e.g. {{ placeholderValue }}" style="width:100%; border:1px solid var(--grey-200); border-radius:4px; padding:4px 6px;"></td>
          <td><button type="submit" class="btn btn-primary" style="padding:4px 10px; font-size:0.8rem;">+ Add</button></td>
        </form>
      </tr>
    </tbody>
  </table>
</div>
{% endmacro %}

{{ specSection('Building Specifications', 'building', buildingSpecs, 'WALL', "2.5'' RC precast concrete panel", category.id) }}
{{ specSection('Technical Specifications', 'technical', technicalSpecs, 'Steel Grade', 'ASTM A572 Grade 50', category.id) }}

<form method="post" action="/admin/categories/{{ category.id }}/delete" onsubmit="return confirm('Delete this category?');">
  <button type="submit" class="btn btn-danger">Delete Category</button>
</form>
{% endif %}

<script>
function previewCategoryFile(input) {
  const file = input.files && input.files[0];
  const img = document.getElementById('heroPreviewImg');
  const placeholder = document.getElementById('heroPreviewPlaceholder');
  if (file) {
    const reader = new FileReader();
    reader.onload = function(e) {
      if (img) {
        img.src = e.target.result;
        img.style.display = 'block';
      }
      if (placeholder) placeholder.style.display = 'none';
    };
    reader.readAsDataURL(file);
  }
}
function previewCategoryUrl(val) {
  const img = document.getElementById('heroPreviewImg');
  const placeholder = document.getElementById('heroPreviewPlaceholder');
  if (val && val.trim()) {
    const clean = val.trim().startsWith('http') || val.trim().startsWith('/') ? val.trim() : '/' + val.trim();
    if (img) {
      img.src = clean;
      img.style.display = 'block';
    }
    if (placeholder) placeholder.style.display = 'none';
  }
}
</script>
{% endblock %}
