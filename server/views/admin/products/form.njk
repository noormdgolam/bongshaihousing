{% set entityType = "product" %}
{% set entityId = product.id %}
{% include "admin/partials/history-panel.njk" %}
{% endif %}


<script>
let dynamicCounter = Date.now();

function updateVariantTotals(card) {
  if (!card) return;
  const rows = card.querySelectorAll('.rooms-tbody tr');
  const floorTotals = new Map();
  let grandTotal = 0;

  rows.forEach(tr => {
    const floorInput = tr.querySelector('input[name*="[floor_label]"]');
    const areaInput = tr.querySelector('input[name*="[area_sqft]"]');
    const floor = (floorInput && floorInput.value.trim()) || 'Ground Floor Layout';
    const area = (areaInput && parseInt(areaInput.value, 10)) || 0;
    if (!floorTotals.has(floor)) floorTotals.set(floor, 0);
    floorTotals.set(floor, floorTotals.get(floor) + area);
    grandTotal += area;
  });

  const subtotalsText = [...floorTotals.entries()].map(([f, tot]) => `${f.replace(/\s+Layout$/i, '')}: ${tot.toLocaleString()} sqft`).join(' | ');
  const subEl = card.querySelector('.subtotals-text');
  const bldgEl = card.querySelector('.building-total-text');
  if (subEl) subEl.textContent = subtotalsText ? `Subtotals: ${subtotalsText}` : '';
  if (bldgEl) bldgEl.textContent = grandTotal ? `Total: ${grandTotal.toLocaleString()} sqft` : '';
}

function addSpecRow(tbodyId, type, defaultKey, defaultValue) {
  const tbody = document.getElementById(tbodyId);
  const idx = dynamicCounter++;
  const tr = document.createElement('tr');
  tr.innerHTML = `
    <input type="hidden" name="specs[${idx}][spec_type]" value="${type}">
    <td><input type="text" name="specs[${idx}][spec_key]" placeholder="e.g. ${defaultKey || 'Item'}" required style="width:100%; border:1px solid var(--grey-200); border-radius:4px; padding:4px 6px;"></td>
    <td><input type="text" name="specs[${idx}][spec_value]" placeholder="e.g. ${defaultValue || 'Description'}" required style="width:100%; border:1px solid var(--grey-200); border-radius:4px; padding:4px 6px;"></td>
    <td style="text-align:center;"><button type="button" class="btn btn-danger" style="padding:4px 8px; font-size:0.8rem;" onclick="this.closest('tr').remove();">Del</button></td>
  `;
  tbody.appendChild(tr);
}

function addRoomRow(btn, variantIdx) {
  const card = btn.closest('.variant-card');
  const tbody = card.querySelector('.rooms-tbody');
  const vIdx = variantIdx !== undefined ? variantIdx : (card.dataset.vidx || dynamicCounter++);
  const rIdx = dynamicCounter++;

  // Seed floor_label from previous row
  const lastRow = tbody.querySelector('tr:last-child');
  let prevFloor = 'Ground Floor Layout';
  if (lastRow) {
    const input = lastRow.querySelector('input[name*="[floor_label]"]');
    if (input && input.value.trim()) prevFloor = input.value.trim();
  }

  const tr = document.createElement('tr');
  tr.innerHTML = `
    <td><input type="text" name="variants[${vIdx}][rooms][${rIdx}][floor_label]" value="${prevFloor}" placeholder="e.g. Ground Floor Layout" style="width:100%; padding:3px 5px;" oninput="updateVariantTotals(this.closest('.variant-card'))"></td>
    <td><input type="text" name="variants[${vIdx}][rooms][${rIdx}][section]" placeholder="e.g. Bed room" required style="width:100%; padding:3px 5px;"></td>
    <td><input type="number" name="variants[${vIdx}][rooms][${rIdx}][area_sqft]" style="width:100%; padding:3px 5px;" oninput="updateVariantTotals(this.closest('.variant-card'))"></td>
    <td><input type="text" name="variants[${vIdx}][rooms][${rIdx}][length_ft]" style="width:100%; padding:3px 5px;"></td>
    <td><input type="text" name="variants[${vIdx}][rooms][${rIdx}][width_ft]" style="width:100%; padding:3px 5px;"></td>
    <td style="text-align:center;"><button type="button" class="btn btn-danger" style="padding:2px 6px; font-size:0.75rem;" onclick="const c = this.closest('.variant-card'); this.closest('tr').remove(); updateVariantTotals(c);">Del</button></td>
  `;
  tbody.appendChild(tr);
  updateVariantTotals(card);
}

function addVariantCard() {
  const container = document.getElementById('variants-container');
  const vIdx = dynamicCounter++;
  const div = document.createElement('div');
  div.className = 'variant-card';
  div.dataset.vidx = vIdx;
  div.style = 'border:1px solid var(--grey-200); border-radius:8px; padding:14px; margin-bottom:16px; background:#fafafa;';
  div.innerHTML = `
    <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:end; margin-bottom:12px;">
      <div><label style="font-size:0.75rem; display:block; font-weight:600;">Area (sqft)</label><input type="number" name="variants[${vIdx}][area_sqft]" required style="width:85px; padding:4px 6px;"></div>
      <div><label style="font-size:0.75rem; display:block; font-weight:600;">Label</label><input type="text" name="variants[${vIdx}][area_label]" placeholder="e.g. Standard" style="width:110px; padding:4px 6px;"></div>
      <div><label style="font-size:0.75rem; display:block; font-weight:600;">Bed</label><input type="number" value="${document.querySelector('input[name=bedrooms]') ? document.querySelector('input[name=bedrooms]').value : ''}" style="width:60px; padding:4px 6px; background:#eee;" disabled title="Set via the Bedrooms field above"></div>
      <div><label style="font-size:0.75rem; display:block; font-weight:600;">Bath</label><input type="number" name="variants[${vIdx}][bath]" style="width:60px; padding:4px 6px;"></div>
      <div><label style="font-size:0.75rem; display:block; font-weight:600;">Kitchen</label><input type="number" name="variants[${vIdx}][kitchen]" style="width:60px; padding:4px 6px;"></div>
      <div><label style="font-size:0.75rem; display:block; font-weight:600;">Living</label><input type="number" name="variants[${vIdx}][living]" style="width:60px; padding:4px 6px;"></div>
      <button type="button" class="btn btn-danger" style="padding:5px 12px; font-size:0.8rem; margin-left:auto;" onclick="if(confirm('Delete this variant?')) this.closest('.variant-card').remove();">Delete Variant</button>
    </div>
    <div style="background:white; border:1px solid var(--grey-200); border-radius:6px; padding:10px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <span style="font-size:0.85rem; font-weight:700; color:var(--grey-700);">Room Layout Breakdown</span>
        <button type="button" class="btn" style="padding:3px 10px; font-size:0.75rem; background:var(--grey-100);" onclick="addRoomRow(this, ${vIdx})">+ Add Room</button>
      </div>
      <table style="width:100%; margin:0;">
        <thead><tr><th>Floor Label</th><th>Section / Room</th><th>Area (sqft)</th><th>Length (ft)</th><th>Width (ft)</th><th style="width:50px;"></th></tr></thead>
        <tbody class="rooms-tbody"></tbody>
      </table>
      <div class="variant-totals-summary" style="margin-top:10px; padding:8px 12px; background:var(--off-white); border-radius:6px; font-size:0.85rem; color:var(--grey-800); display:flex; gap:16px; flex-wrap:wrap;">
        <span class="subtotals-text"></span>
        <span class="building-total-text" style="font-weight:700; color:var(--primary); margin-left:auto;"></span>
      </div>
    </div>
  `;
  container.appendChild(div);
}

document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.variant-card').forEach(card => updateVariantTotals(card));
});

function previewFile(input, imgId, placeholderId) {
  const file = input.files && input.files[0];
  const img = document.getElementById(imgId);
  const placeholder = document.getElementById(placeholderId);
  if (file) {
    const reader = new FileReader();
    reader.onload = function(e) {
      if (img) {
        img.src = e.target.result;
        img.style.display = 'block';
      }
      if (placeholder) placeholder.style.display = 'none';
    };
    reader.readAsDataURL(file);
  }
}
function previewUrl(val, imgId, placeholderId) {
  const img = document.getElementById(imgId);
  const placeholder = document.getElementById(placeholderId);
  if (val && val.trim()) {
    const clean = val.trim().startsWith('http') || val.trim().startsWith('/') ? val.trim() : '/' + val.trim();
    if (img) {
      img.src = clean;
      img.style.display = 'block';
    }
    if (placeholder) placeholder.style.display = 'none';
  }
}
function toggleNewCategoryForm() {
  const select = document.getElementById('category_id');
  const panel = document.getElementById('inline-category-form');
  if (select.value === '__new__') {
    panel.style.display = 'block';
    document.getElementById('new_category_name').focus();
  } else {
    panel.style.display = 'none';
  }
}
function cancelNewCategory() {
  const select = document.getElementById('category_id');
  const panel = document.getElementById('inline-category-form');
  panel.style.display = 'none';
  document.getElementById('new_category_name').value = '';
  document.getElementById('new_category_slug').value = '';
  document.getElementById('inline-category-error').style.display = 'none';
  // Reset select to first available non-__new__ option
  for (let i = 0; i < select.options.length; i++) {
    if (select.options[i].value !== '__new__') {
      select.selectedIndex = i;
      break;
    }
  }
}
async function submitNewCategory() {
  const name = document.getElementById('new_category_name').value;
  const slug = document.getElementById('new_category_slug').value;
  const errorDiv = document.getElementById('inline-category-error');
  
  if (!name || !slug) {
    errorDiv.textContent = 'Name and slug are required.';
    errorDiv.style.display = 'block';
    return;
  }
  
  errorDiv.style.display = 'none';
  
  const csrfMeta = document.querySelector('meta[name="csrf-token"]');
  const csrfToken = csrfMeta ? csrfMeta.content : '';
  
  try {
    const formData = new FormData();
    formData.append('name', name);
    formData.append('slug', slug);
    if (csrfToken) formData.append('_csrf', csrfToken);
    
    const res = await fetch('/admin/categories', {
      method: 'POST',
      headers: { 'Accept': 'application/json' },
      body: formData
    });
    
    const data = await res.json();
    if (!res.ok) {
      throw new Error(data.error || 'Failed to create category');
    }
    
    // Add to select and choose it
    const select = document.getElementById('category_id');
    const option = document.createElement('option');
    option.value = data.id;
    option.textContent = data.name;
    // Insert before the "+ Add New Category" option
    select.insertBefore(option, select.options[select.options.length - 1]);
    select.value = data.id;
    
    // Cleanup
    document.getElementById('inline-category-form').style.display = 'none';
    document.getElementById('new_category_name').value = '';
    document.getElementById('new_category_slug').value = '';
    
  } catch (err) {
    errorDiv.textContent = err.message;
    errorDiv.style.display = 'block';
  }
}

function formatClientTaka(num) {
  if (!num || isNaN(num)) return '৳0';
  let s = Math.round(num).toString();
  const last3 = s.slice(-3);
  let rest = s.slice(0, -3);
  if (rest !== '') {
    rest = rest.replace(/\B(?=(\d{2})+(?!\d))/g, ',');
    s = rest + ',' + last3;
  } else {
    s = last3;
  }
  return '৳' + s;
}

</script>
