{% block content %}
<section class="page-hero" style="background: linear-gradient(135deg, #d35400, #e67e22);" aria-labelledby="page-title">
      <div class="container page-hero-content">
        <div style="font-size:4rem; margin-bottom:10px;">🛡️</div>
        <h1 class="page-hero-title" data-aos="fade-up" id="page-title">Site Safety Practices</h1>
        <p class="page-hero-text">Prioritizing the Safety of Our People and Your Project</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <a href="certifications.html">Certifications &amp; Quality</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Site Safety Practices</span>
        </nav>
      </div>
    </section>

    <section class="section" aria-labelledby="content-title">
      <div class="container">
        
            <div class="about-grid">
              <div class="reveal-left" style="display:flex; flex-direction:column; gap:20px;">
                <div style="width:100%; height:400px; border-radius:12px; box-shadow:var(--shadow-xl); background:linear-gradient(135deg, #d35400, #f39c12); display:flex; align-items:center; justify-content:center; flex-direction:column;">
                  <span style="font-size:6rem; margin-bottom:20px;">👷‍♂️</span>
                  <div style="color:white; font-size:1.8rem; font-weight:700;">Site Safety First</div>
                </div>
              </div>
              <div class="about-content reveal-right">
                <h2 id="content-title">Occupational Health &amp; Safety</h2>
                <p style="margin-bottom:var(--space-4)">Construction is inherently hazardous, so at Bongshai Housing we prioritize safety at every site. We apply structured safety practices across all our industrial, commercial, and residential sites.</p>
                <p style="margin-bottom:var(--space-4)">Every worker undergoes mandatory safety inductions. We deploy daily site risk assessments, strictly enforce PPE (Personal Protective Equipment), and maintain full-time safety officers on every major project.</p>
                
                <h3 style="font-size:1.5rem; color:var(--primary); margin-top:var(--space-6); margin-bottom:var(--space-3)">Direct Benefits to Our Clients:</h3>
                <ul style="list-style-type: disc; margin-left:var(--space-4); color:var(--grey-800); font-size:1.05rem; line-height:1.8; margin-bottom:var(--space-6);">
                    <li><strong>Zero Project Delays:</strong> A safe site is an efficient site. By preventing accidents, we prevent regulatory shutdowns and delays.</li>
                    <li><strong>Liability Protection:</strong> Our safety practices help protect clients from legal and ethical liabilities.</li>
                    <li><strong>Corporate Responsibility:</strong> Partnering with us aligns your project with the highest standards of human rights and labor protection.</li>
                </ul>

                <a href="contact.html" class="btn btn-primary">Learn About Our Safety Protocols</a>
              </div>
            </div>
        
      </div>
    </section>
{% endblock %}

