<!-- Styles Specific to Catalog -->
<style>
.category-card {
  display: flex;
  flex-direction: column;
  background: white;
  padding: 28px 24px;
  border-radius: 18px;
  border: 1px solid var(--grey-200);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
  transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
  text-decoration: none;
  color: inherit;
  position: relative;
  overflow: hidden;
}
.category-card::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; height: 4px;
  background: linear-gradient(90deg, var(--primary-light), var(--primary));
  opacity: 0;
  transition: opacity 0.3s ease;
}
.category-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 36px rgba(30, 64, 175, 0.12);
  border-color: rgba(30, 64, 175, 0.3);
}
.category-card:hover::before {
  opacity: 1;
}
.cat-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}
.cat-icon {
  width: 50px;
  height: 50px;
  background: rgba(30, 64, 175, 0.08);
  color: var(--primary);
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
}
.category-card:hover .cat-icon {
  background: var(--primary);
  color: white;
  transform: scale(1.1) rotate(-4deg);
}
.cat-badge {
  background: var(--off-white);
  color: var(--grey-700);
  font-size: 0.76rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 12px;
  border: 1px solid var(--grey-200);
}
.cat-badge-soon {
  background: rgba(30, 64, 175, 0.08);
  color: var(--primary);
  border-color: rgba(30, 64, 175, 0.2);
}
.cat-title {
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--primary-dark);
  margin: 0 0 10px;
  line-height: 1.3;
  transition: color 0.2s ease;
}
.category-card:hover .cat-title {
  color: var(--primary);
}
.cat-desc {
  font-size: 0.92rem;
  color: var(--grey-600);
  line-height: 1.5;
  margin: 0 0 20px;
  flex-grow: 1;
}
.cat-footer {
  margin-top: auto;
  border-top: 1px solid var(--grey-100);
  padding-top: 14px;
}
.cat-link-text {
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--primary);
  display: inline-flex;
  align-items: center;
  gap: 4px;
  transition: transform 0.2s ease;
}
.category-card:hover .cat-link-text {
  transform: translateX(4px);
}
details.faq-card summary::-webkit-details-marker {
  display: none;
}
@media (max-width: 768px) {
  .category-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .filter-bar {
    flex-direction: column;
    align-items: stretch;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('catalogSearch');
  const cards = document.querySelectorAll('.category-card');
  const noMatchMsg = document.getElementById('noMatchMsg');
  const clearBtn = document.getElementById('clearSearchBtn');

  function filterCards() {
    const q = (searchInput.value || '').trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach(card => {
      const dataText = (card.getAttribute('data-title') || '') + ' ' + card.innerText;
      if (!q || dataText.toLowerCase().includes(q)) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noMatchMsg) {
      noMatchMsg.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', filterCards);
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', function(e) {
      e.preventDefault();
      if (searchInput) {
        searchInput.value = '';
        filterCards();
        searchInput.focus();
      }
    });
  }
});
</script>
{% endblock %}
