    let currentSellerType = "individual";

    // Number Converter to Bengali Digits
    function toBengaliDigits(num) {
      const bn = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
      return String(num).replace(/[0-9]/g, d => bn[+d]);
    }

    // Format BDT with Bangladeshi Comma Grouping
    function formatBDT(amount) {
      const n = Math.round(amount);
      const str = n.toString();
      if (str.length <= 3) return '৳ ' + toBengaliDigits(str);
      const lastThree = str.substring(str.length - 3);
      const remaining = str.substring(0, str.length - 3);
      const formatted = remaining.replace(/\B(?=(\d{2})+(?!\d))/g, ",") + "," + lastThree;
      return '৳ ' + toBengaliDigits(formatted);
    }

    // Format Lakhs
    function formatLakhs(amount) {
      const lakh = (amount / 100000).toFixed(2);
      return toBengaliDigits(lakh) + ' লাখ টাকা';
    }

    // Recalculate Registration Fees
    function recalculate() {
      const val = Math.max(50000, parseFloat(currentDeedValue) || 0);
      const area = REG_RATES[currentAreaType];
      const isDeveloper = (currentSellerType === "developer");

      // 1. Registration Fee: 1%
      const regFee = Math.round(val * area.regFee);

      // 2. Stamp Duty: a range (1.5%-3%), not one fixed figure
      const stampDutyMinVal = Math.round(val * area.stampDutyMin);
      const stampDutyMaxVal = Math.round(val * area.stampDutyMax);
      const stampDutyAvgVal = Math.round((stampDutyMinVal + stampDutyMaxVal) / 2);

      // 3. Local Government Tax
      const localTaxMinVal = Math.round(val * area.localTaxMin);
      const localTaxMaxVal = Math.round(val * area.localTaxMax);
      const localTaxAvgVal = Math.round(val * area.localTaxAvg);

      // 4. Source Tax (Sec 53FF)
      const sourceTaxMinVal = Math.round(val * area.sourceTaxMin);
      const sourceTaxMaxVal = Math.round(val * area.sourceTaxMax);
      const sourceTaxAvgVal = Math.round(val * area.sourceTaxAvg);

      // 5. VAT (0% for individual, 2% for developer)
      const vatRate = isDeveloper ? 0.02 : 0;
      const vatVal = Math.round(val * vatRate);

      // Totals
      const totalMin = regFee + stampDutyMinVal + localTaxMinVal + sourceTaxMinVal + vatVal + FIXED_FEES;
      const totalMax = regFee + stampDutyMaxVal + localTaxMaxVal + sourceTaxMaxVal + vatVal + FIXED_FEES;
      const totalAvg = regFee + stampDutyAvgVal + localTaxAvgVal + sourceTaxAvgVal + vatVal + FIXED_FEES;

      const minPercent = ((totalMin / val) * 100).toFixed(1);
      const maxPercent = ((totalMax / val) * 100).toFixed(1);
      const avgPercent = ((totalAvg / val) * 100).toFixed(1);

      // Update Showcase Header
      document.getElementById('dispTotalCost').textContent = formatBDT(totalAvg);
      document.getElementById('dispTotalLakh').textContent = formatLakhs(totalAvg);
      document.getElementById('dispTotalPercent').textContent = 'দলিল মূল্যের প্রায় ' + toBengaliDigits(avgPercent) + '%';
      
      if (totalMin !== totalMax) {
        document.getElementById('dispCostRange').textContent = 
          '(সম্ভাব্য রেঞ্জ: ' + formatBDT(totalMin) + ' – ' + formatBDT(totalMax) + ' | ' + 
          toBengaliDigits(minPercent) + '% – ' + toBengaliDigits(maxPercent) + '%)';
      } else {
        document.getElementById('dispCostRange').textContent = 
          '(নির্ধারিত সরকারি মোট হার: ' + toBengaliDigits(avgPercent) + '%)';
      }

      // Update Breakdown Table Rows
      document.getElementById('rowRegFee').textContent = formatBDT(regFee);
      document.getElementById('rowStampDuty').textContent =
        formatBDT(stampDutyMinVal) + ' – ' + formatBDT(stampDutyMaxVal).replace('৳ ', '');
      const sdRateEl = document.getElementById('rowStampDutyRate');
      if (sdRateEl) sdRateEl.textContent =
        toBengaliDigits((area.stampDutyMin * 100).toFixed(1)) + '% – ' + toBengaliDigits((area.stampDutyMax * 100).toFixed(1)) + '%';

      // Local Tax Row
      document.getElementById('rowLocalTaxDesc').textContent = area.localDesc;
      if (area.localTaxMin !== area.localTaxMax) {
        document.getElementById('rowLocalTaxRate').textContent = 
          toBengaliDigits((area.localTaxMin * 100).toFixed(1)) + '% – ' + toBengaliDigits((area.localTaxMax * 100).toFixed(1)) + '%';
        document.getElementById('rowLocalTax').textContent = formatBDT(localTaxMinVal) + ' – ' + formatBDT(localTaxMaxVal).replace('৳ ', '');
      } else {
        document.getElementById('rowLocalTaxRate').textContent = toBengaliDigits((area.localTaxMin * 100).toFixed(1)) + '%';
        document.getElementById('rowLocalTax').textContent = formatBDT(localTaxAvgVal);
      }

      // Source Tax Row
      if (area.sourceTaxMin !== area.sourceTaxMax) {
        document.getElementById('rowSourceTaxRate').textContent = 
          toBengaliDigits((area.sourceTaxMin * 100).toFixed(1)) + '% – ' + toBengaliDigits((area.sourceTaxMax * 100).toFixed(1)) + '%';
        document.getElementById('rowSourceTax').textContent = formatBDT(sourceTaxMinVal) + ' – ' + formatBDT(sourceTaxMaxVal).replace('৳ ', '');
      } else {
        document.getElementById('rowSourceTaxRate').textContent = toBengaliDigits((area.sourceTaxMin * 100).toFixed(1)) + '%';
        document.getElementById('rowSourceTax').textContent = formatBDT(sourceTaxAvgVal);
      }

      // VAT Row
      if (isDeveloper) {
        document.getElementById('rowVatDesc').textContent = "ডেভেলপার / হাউজিং কোম্পানির প্লট (২% মূসক)";
        document.getElementById('rowVatRate').textContent = "২.০%";
        document.getElementById('rowVat').textContent = formatBDT(vatVal);
      } else {
        document.getElementById('rowVatDesc').textContent = "ব্যক্তি মালিকানাধীন সাধারণ জমিতে ভ্যাট নেই";
        document.getElementById('rowVatRate').textContent = "০.০%";
        document.getElementById('rowVat').textContent = "৳ ০";
      }
    }

    // Lead Form WhatsApp Submission

    // Also file the lead through the site's real intake endpoint so it lands
    // in the leads table + Telegram alert + sales email, exactly like the
    // main contact form - WhatsApp alone leaves no record if the visitor
    // never actually sends the pre-filled message.
    function postLeadToCrm(payload) {
      try {
        return fetch('/send_email.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        }).catch(function () { /* never block the WhatsApp handoff on this */ });
      } catch (e) { /* no-op */ }
    }

    function handleLeadSubmit(event) {
      event.preventDefault();
      const name = document.getElementById('leadName').value.trim();
      const phone = document.getElementById('leadPhone').value.trim();
      const district = document.getElementById('districtSelect').value;
      const upazila = document.getElementById('upazilaSelect').value;
      const notes = document.getElementById('leadNotes').value.trim();

      const areaInfo = REG_RATES[currentAreaType];
      const lakhText = (currentDeedValue / 100000).toFixed(2) + ' লাখ টাকা';
      const avgCostText = document.getElementById('dispTotalCost').textContent;
      const percentText = document.getElementById('dispTotalPercent').textContent;

      let message = `*জমি রেজিস্ট্রি খরচ সংক্রান্ত অনুসন্ধান*\n` +
        `------------------------------------\n` +
        `👤 নাম: ${name}\n` +
        `📱 ফোন: ${phone}\n` +
        `📍 অবস্থান: ${upazila}, ${district}\n` +
        `💰 ঘোষিত দলিল মূল্য: ৳ ${Number(currentDeedValue).toLocaleString('en-US')} (${lakhText})\n` +
        `🏢 এলাকার ধরন: ${areaInfo.name}\n` +
        `🏷️ বিক্রেতার ধরন: ${currentSellerType === 'developer' ? 'হাউজিং কোম্পানি' : 'ব্যক্তি মালিকানা'}\n` +
        `📊 আনুমানিক রেজিস্ট্রি খরচ: ${avgCostText} (${percentText})\n`;

      if (notes) {
        message += `📝 মন্তব্য/জমির বিবরণ: ${notes}\n`;
      }
      message += `------------------------------------\n` +
        `আমি দলিল যাচাই, মৌজা মূল্য ও সঠিক রেজিস্ট্রি খরচের আইনি সহায়তা পেতে চাই।`;

      postLeadToCrm({
        name: name,
        phone: phone,
        country_code: '+880',
        district: district,
        upazila: upazila,
        model: 'জমি রেজিস্ট্রি ক্যালকুলেটর',
        floor_area: '',
        message: message,
        source: (window.BHUtm ? window.BHUtm.source() : null) || 'calculator'
      });

      const waUrl = `https://wa.me/8801781636613?text=${encodeURIComponent(message)}`;
      window.open(waUrl, '_blank');
    }

    // Event Listeners on DOM Load
    document.addEventListener('DOMContentLoaded', function() {
      const deedInput = document.getElementById('deedValueInput');
      const valueChips = document.querySelectorAll('#valueChips .preset-chip');
      const areaCards = document.querySelectorAll('#areaSelector .area-card');
      const sellerBtns = document.querySelectorAll('#sellerSelector .seller-type-btn');
      const districtSelect = document.getElementById('districtSelect');
      const upazilaSelect = document.getElementById('upazilaSelect');

      // Populate 64 Districts
      const districtNames = Object.keys(BD_GEO).sort();
      districtNames.forEach(d => {
        const opt = document.createElement('option');
        opt.value = d;
        opt.textContent = d;
        districtSelect.appendChild(opt);
      });

      // District -> Upazila Cascade
      districtSelect.addEventListener('change', function() {
        const selected = this.value;
        const upazilas = BD_GEO[selected] || [];
        upazilaSelect.innerHTML = '<option value="" disabled selected>উপজেলা / সাব-রেজিস্ট্রি অফিস বেছে নিন</option>';
        upazilas.forEach(u => {
          const opt = document.createElement('option');
          opt.value = u;
          opt.textContent = u;
          upazilaSelect.appendChild(opt);
        });
        upazilaSelect.disabled = false;
      });

      // Deed Value Input
      deedInput.addEventListener('input', function() {
        currentDeedValue = parseFloat(this.value) || 0;
        valueChips.forEach(c => c.classList.remove('active'));
        recalculate();
      });

      // Value Preset Chips
      valueChips.forEach(chip => {
        chip.addEventListener('click', function() {
          valueChips.forEach(c => c.classList.remove('active'));
          this.classList.add('active');
          currentDeedValue = parseFloat(this.getAttribute('data-val'));
          deedInput.value = currentDeedValue;
          recalculate();
        });
      });

      // Area Selector Cards
      areaCards.forEach(card => {
        card.addEventListener('click', function() {
          areaCards.forEach(c => c.classList.remove('active'));
          this.classList.add('active');
          currentAreaType = this.getAttribute('data-area');
          recalculate();
        });
      });

      // Seller Type Buttons
      sellerBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          sellerBtns.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          currentSellerType = this.getAttribute('data-seller');
          recalculate();
        });
      });

      // Initial calculation run
      recalculate();
    });
  </script>
{% endblock %}
