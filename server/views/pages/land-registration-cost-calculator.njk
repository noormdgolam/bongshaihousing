      }
      .lead-form-grid {
        grid-template-columns: 1fr;
      }
      .fixed-fees-grid {
        grid-template-columns: 1fr;
      }
      .brand-hotline-btn span {
        display: none;
      }
    }


/* --- Site-layout integration -------------------------------------------- */

/* The standalone page's <main class="main-wrapper"> supplied the container and
   was dropped when the content moved into layout.njk's own <main>, so the
   calculator ran the full width of the viewport. .calc-shell restores it. */
.calc-app {
  background: var(--bg-navy);
  padding-bottom: 56px;   /* top clearance is the hero band's job, see below */
}
.calc-app .calc-shell {
  max-width: 960px;
  margin: 0 auto;
  padding: 0 16px;
}
.calc-app .main-wrapper { padding-top: 0; }

/* Every other interior page opens with a full-bleed navy hero band - gold
   eyebrow, white title - and drops to off-white content below it (.page-hero in
   css/style.css). The calculator's hero-box holds exactly that content, so it
   gets moved out of .calc-shell and dressed as the site's band; without it the
   nav clearance is just a tall empty gap, which is most of what made the page
   look imported. */
.calc-app .hero-box {
  background: linear-gradient(135deg, #1E3A8A 0%, #1E40AF 100%);
  padding: calc(var(--nav-height, 80px) + 44px) 16px 44px;
  margin: 0 0 32px;
  text-align: center;
}
.calc-app .hero-box .hero-title {
  color: #ffffff;
  max-width: 960px;
  margin: 0 auto;
  text-wrap: balance;
}
.calc-app .hero-box .hero-title span { color: #FDE047; }
.calc-app .hero-box .trust-badge {
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(253, 224, 71, 0.45);
  color: #FDE047;
}
@media (max-width: 768px) {
  .calc-app .hero-box { padding: calc(var(--nav-height, 80px) + 26px) 16px 30px; margin-bottom: 24px; }
}

/* On a narrow screen the label and its hint are two competing lines, not a
   left/right pair - stop them colliding. */
@media (max-width: 560px) {
  .calc-app .form-label { flex-direction: column; align-items: flex-start; gap: 2px; }
}

/* Cards read as cards against the off-white ground, matching the site's. */
.calc-app .calc-card,
.calc-app .answer-first-card,
.calc-app .models-block,
.calc-app .lead-block,
.calc-app .faq-block {
  box-shadow: var(--shadow-card);
}

/* The answer block: a light brand-tinted panel, not a dark slab. */
.calc-app .answer-first-card {
  background: var(--brand-soft);
  border: 1px solid #dbe4fb;
  border-left: 4px solid var(--brand);
}

/* The result panel. Keeping it dark was tempting - it's the answer - but on the
   land page it wraps the whole fee table plus the e-fee, warning and sources
   boxes, and those are light, so a dark slab ends up punched full of holes.
   Light card, brand border, gold badge: the emphasis comes from the frame. */
.calc-app .result-showcase {
  background: #ffffff;
  border: 2px solid var(--brand);
  box-shadow: 0 10px 30px rgba(30, 64, 175, 0.10);
}
.calc-app .result-showcase .result-badge {
  background: var(--gold-accent);
  color: var(--on-gold);
}
.calc-app .result-showcase .result-total-taka {
  color: var(--brand);
  text-shadow: none;
}
.calc-app .result-showcase .breakdown-bar-bg,
.calc-app .result-showcase .breakdown-table th {
  background: #f1f5f9;
}
.calc-app .result-showcase .breakdown-table th { color: var(--text-muted); }

/* Selected states: the original relied on a gold glow against near-black, which
   on white washes out to a smudge. A tinted fill plus a solid brand border is
   how the rest of the site marks a chosen option. */
.calc-app .floor-btn.active,
.calc-app .finish-card.active,
.calc-app .tier-tab-btn.active,
.calc-app .seller-type-btn.active {
  background: var(--brand-soft);
  border-color: var(--brand);
  color: var(--brand);
  box-shadow: none;
}
.calc-app .finish-card.active .finish-desc { color: var(--text-muted); }

/* Price panel inside each model card - a brand-tinted plate, not a black box. */
.calc-app .model-price-box {
  background: var(--brand-soft);
  border: 1px solid #dbe4fb;
}

/* The lead-capture block was a dark slab; make it the site's navy CTA instead. */
.calc-app .lead-block {
  --text-white: #ffffff;
  --text-light: #f1f5f9;
  --text-muted: #cbd5e1;
  --brand: #FDE047;
  background: linear-gradient(150deg, #1e3a8a 0%, #1e40af 100%);
  border: 1px solid rgba(255, 255, 255, 0.16);
}
.calc-app .lead-block .lead-input,
.calc-app .lead-block .lead-select {
  background: #ffffff;
  border-color: rgba(255, 255, 255, 0.5);
  color: #0f172a;
}

/* Bengali numerals and Taka figures line up in the breakdown tables. */
.calc-app .breakdown-table td,
.calc-app .b-amt,
.calc-app .result-total-taka { font-variant-numeric: tabular-nums; }
</style>
{% endblock %}

{% block content %}
<div class="calc-app">
<div class="hero-box">
      <div class="trust-badge">
        📜 ২০২৬ সালের সর্বশেষ সরকারি গেজেট ও আইন ভিত্তিক
      </div>
      <h1 class="hero-title">জমি রেজিস্ট্রি খরচ ক্যালকুলেটর <span>২০২৬</span></h1>
    </div>
<div class="calc-shell">

    <!-- Hero / Header -->
    

    <!-- AEO Direct Answer Block (< 45 words) -->
    <section class="answer-first-card" aria-label="সংক্ষিপ্ত উত্তর">
      <p>
        ২০২৬ সালে বাংলাদেশে জমি রেজিস্ট্রির মোট সরকারি খরচ এলাকাভেদে দলিল মূল্যের <strong>৫% থেকে ১১.৫%</strong> পর্যন্ত হয়। এর মধ্যে রেজিস্ট্রেশন ফি ১%, স্ট্যাম্প ডিউটি ১.৫%, স্থানীয় সরকার কর ১-৩% এবং এলাকাভেদে উৎসে কর ১.৫% থেকে ৬% প্রযোজ্য।
      </p>
      <div class="trust-meta">
        <span>⚖️ আইনগত ভিত্তি: রেজিস্ট্রেশন আইন ১৯০৮ ও আয়কর আইন ২০২৩</span>
        <span>📅 বাজেট হার: ২০২৫-২০২৬ অর্থবছর</span>
        <span>📍 এলাকাভিত্তিক পৃথক হার</span>
      </div>
    </section>

    <!-- Main Calculator Form & Logic -->
    <section class="calc-card" data-mcp-action="calculate-land-registration-cost">
      
      <!-- Input 1: Land / Deed Declared Value -->
      <div class="form-group">
        <label class="form-label" for="deedValueInput">
          <span>১. জমির দলিলের ঘোষিত মোট মূল্য (টাকায়)</span>
          <span class="form-label-hint">কমপক্ষে ১,০০,০০০ টাকা</span>
        </label>
        <div class="input-wrapper">
          <input 
            type="number" 
            id="deedValueInput" 
            class="calc-input" 
            value="1000000" 
            min="50000" 
            step="50000"
            data-mcp-param="deedValue"
          >
          <span class="input-unit">৳</span>
        </div>
        <!-- Quick Preset Chips -->
        <div class="preset-chips" id="valueChips">
          <button type="button" class="preset-chip" data-val="500000">৫ লাখ</button>
          <button type="button" class="preset-chip active" data-val="1000000">১০ লাখ</button>
          <button type="button" class="preset-chip" data-val="2500000">২৫ লাখ</button>
          <button type="button" class="preset-chip" data-val="5000000">৫০ লাখ</button>
          <button type="button" class="preset-chip" data-val="10000000">১ কোটি</button>
        </div>
      </div>

      <!-- Input 2: Location / Area Type -->
      <div class="form-group">
        <label class="form-label">
          <span>২. জমির অবস্থান ও এলাকার ধরন</span>
          <span class="form-label-hint">এলাকাভেদে করের হার ভিন্ন</span>
        </label>
        <div class="area-grid" id="areaSelector" data-mcp-param="areaType">
          <!-- Dhaka/Chattogram City Corp -->
          <div class="area-card active" data-area="dhaka_ctg">
            <div>
              <div class="area-card-title">ঢাকা ও চট্টগ্রাম সিটি কর্পোরেশন</div>
              <div class="area-card-desc">ডিএনসিসি, ডিএসসিসি ও সিজিসিসি এবং সংলগ্ন ক্যান্টনমেন্ট অঞ্চল।</div>
            </div>
            <div class="area-rate-pill">মোট সরকারি হার: ~ ৮.৫% – ১১.৫%</div>
          </div>

          <!-- Other City Corporations -->
          <div class="area-card" data-area="other_city">
            <div>
              <div class="area-card-title">অন্যান্য সিটি কর্পোরেশন</div>
              <div class="area-card-desc">গাজীপুর, নারায়ণগঞ্জ, রাজশাহী, খুলনা, সিলেট, বরিশাল ইত্যাদি।</div>
            </div>
            <div class="area-rate-pill">মোট সরকারি হার: ~ ৭.৫% – ৯.৫%</div>
          </div>

          <!-- Pourashava -->
          <div class="area-card" data-area="pourashava">
            <div>
              <div class="area-card-title">জেলা ও উপজেলা পৌরসভা</div>
              <div class="area-card-desc">সারাদেশের সকল জেলা ও উপজেলা ভিত্তিক মিউনিসিপ্যালিটি।</div>
            </div>
            <div class="area-rate-pill">মোট সরকারি হার: ~ ৬.৫% – ৭.৫%</div>
          </div>

          <!-- Union Parishad -->
          <div class="area-card" data-area="union">
            <div>
              <div class="area-card-title">ইউনিয়ন পরিষদ / গ্রামাঞ্চল</div>
              <div class="area-card-desc">পৌরসভার বাইরে অবস্থিত সাধারণ গ্রাম ও ইউনিয়ন ভূমি এলাকা।</div>
            </div>
            <div class="area-rate-pill">মোট সরকারি হার: ~ ৫.০% – ৫.৫%</div>
          </div>
        </div>
      </div>

      <!-- Input 3: Seller Category (Individual vs Developer) -->
      <div class="form-group">
        <label class="form-label">
          <span>৩. জমি বিক্রেতার ধরন</span>
          <span class="form-label-hint">ভ্যাট প্রযোজ্যতার জন্য</span>
        </label>
        <div class="seller-type-box" id="sellerSelector" data-mcp-param="sellerType">
          <button type="button" class="seller-type-btn active" data-seller="individual">
            ব্যক্তি মালিকানাধীন জমি (ভ্যাট ০%)
          </button>
          <button type="button" class="seller-type-btn" data-seller="developer">
            হাউজিং / ডেভেলপার প্রকল্প (ভ্যাট ২%-৩%)
          </button>
        </div>
      </div>

      <!-- Live Calculation Result Showcase -->
      <div class="result-showcase" id="resultContainer">
        <div style="text-align: center;">
          <span class="result-badge">⚖️ জমি রেজিস্ট্রি সরকারি খরচের খতিয়ান</span>
        </div>

        <div class="result-total-box">
          <div class="result-total-label">আনুমানিক মোট সরকারি খরচ (চালান ও ফি)</div>
          <div class="result-total-taka" id="dispTotalCost">৳ ১,০৫,৭১০</div>
          <div class="result-total-lakh" id="dispTotalLakh">১.০৬ লাখ টাকা</div>
          <div>
            <span class="result-total-percent" id="dispTotalPercent">দলিল মূল্যের প্রায় ১০.৫%</span>
          </div>
          <div style="font-size:0.8rem; color:var(--text-muted); margin-top:6px;" id="dispCostRange">
            (সম্ভাব্য রেঞ্জ: ৳ ৮৫,৭১০ – ৳ ১,১৫,৭১০ | ৮.৫% – ১১.৫%)
          </div>
        </div>

        <!-- Itemized Breakdown Table -->
        <div class="breakdown-table-box">
          <div class="breakdown-table-title">
            <span>আইটেমাইজড ফি ও ট্যাক্স তালিকা:</span>
            <span style="font-size:0.75rem; color:var(--text-muted); font-weight:normal;">(শতকরা হার ও টাকা)</span>
          </div>

          <table class="breakdown-table">
            <thead>
              <tr>
                <th>খাতের নাম ও বিবরণ</th>
                <th>হার (%)</th>
                <th>পরিমাণ (টাকা)</th>
              </tr>
            </thead>
            <tbody>
              <!-- Registration Fee -->
              <tr>
                <td>
                  <strong>১. রেজিস্ট্রেশন ফি (Registration Fee)</strong>
                  <span class="fee-subtext">রেজিস্ট্রেশন আইন ১৯০৮ অনুযায়ী নির্ধারিত</span>
                </td>
                <td>১.০%</td>
                <td id="rowRegFee">৳ ১০,০০০</td>
              </tr>

              <!-- Stamp Duty -->
              <tr>
                <td>
                  <strong>২. স্ট্যাম্প ডিউটি (Stamp Duty)</strong>
                  <span class="fee-subtext">১৮৯৯ সালের স্ট্যাম্প আইনের বর্তমান হার</span>
                </td>
                <td>১.৫%</td>
                <td id="rowStampDuty">৳ ১৫,০০০</td>
              </tr>

              <!-- Local Government Tax -->
              <tr>
                <td>
                  <strong>৩. স্থানীয় সরকার কর (Local Govt. Tax)</strong>
                  <span class="fee-subtext" id="rowLocalTaxDesc">সিটি কর্পোরেশন এলাকার জন্য ২% – ৩%</span>
                </td>
                <td id="rowLocalTaxRate">২.০% – ৩.০%</td>
                <td id="rowLocalTax">৳ ২০,০০০ – ৩০,০০০</td>
              </tr>

              <!-- Source Tax / Gain Tax -->
              <tr>
                <td>
                  <strong>৪. উৎসে আয়কর / গেইন ট্যাক্স (Source Tax)</strong>
                  <span class="fee-subtext">আয়কর আইন ২০২৩, ধারা ৫৩এফএফ (আইনত বিক্রেতার প্রদেয়)</span>
                  <span class="range-tag">মৌজাভেদে তারতম্য</span>
                </td>
                <td id="rowSourceTaxRate">৪.০% – ৬.০%</td>
                <td id="rowSourceTax">৳ ৪০,০০০ – ৬০,০০০</td>
              </tr>

              <!-- VAT -->
              <tr>
                <td>
                  <strong>৫. মূল্য সংযোজন কর (মূসক / VAT)</strong>
                  <span class="fee-subtext" id="rowVatDesc">ব্যক্তি মালিকানাধীন সাধারণ জমিতে প্রযোজ্য নয়</span>
                </td>
                <td id="rowVatRate">০.০%</td>
                <td id="rowVat">৳ ০</td>
              </tr>

              <!-- Fixed Ancillary Fees -->
              <tr>
                <td>
                  <strong>৬. অন্যান্য নির্দিষ্ট সরকারি ফি</strong>
                  <span class="fee-subtext">হলফনামা (৩০০৳), ই-ফি (১০০৳), এন-ফি (৩০০৳), কোর্ট ফি (১০৳)</span>
                </td>
                <td>ফিক্সড</td>
                <td>৳ ৭১০</td>
              </tr>
            </tbody>
          </table>

          <!-- Fixed Fees Card -->
          <div class="fixed-fees-card">
            <div class="fixed-fees-title">নির্দিষ্ট আনুষঙ্গিক ফি-র বিস্তারিত:</div>
            <div class="fixed-fees-grid">
              <span>• হলফনামা স্ট্যাম্প: <strong>৩০০ টাকা</strong></span>
              <span>• ই-ফি (E-Fee): <strong>১০০ টাকা</strong></span>
              <span>• এন ও এনএন ফি (নকল ফি): <strong>৩০০ টাকা</strong></span>
              <span>• কোর্ট ফি স্ট্যাম্প: <strong>১০ টাকা</strong></span>
            </div>
          </div>

          <!-- Non-government / Deed writer advisory note -->
          <div style="margin-top:12px; font-size:0.8rem; color:var(--text-muted); border-left: 2px solid var(--blue-accent); padding-left:10px;">
            ℹ️ <strong>দলিল লেখক (মুহুরী) ও আইনি খরচ:</strong> সরকারি ফি ছাড়াও দলিল ড্রাফটিং ও লেখক সমিতির নিয়ম অনুযায়ী দলিল প্রতি আনুমানিক ৫,০০০ থেকে ১৫,০০০ টাকা পর্যন্ত পেশাগত ফি আলোচনা সাপেক্ষে হতে পারে।
          </div>
        </div>

        <!-- Mouza Notice Box -->
        <div class="mouza-notice-box">
          ⚠️ <strong>মৌজা রেইট সংক্রান্ত সতর্কতা:</strong> জমি যে মৌজায় অবস্থিত, সেখানে সরকার নির্ধারিত সর্বনিম্ন গড় বাজারমূল্য রয়েছে। দলিলে লিখিত মূল্য যদি সরকারি মৌজা মূল্যের চেয়ে কম দেখানো হয়, তবে সরকারি মৌজা মূল্যকেই ভিত্তি ধরে কর ও ফি পরিশোধ করতে হয়।
        </div>

        <!-- Sources & accuracy disclaimer -->
        <div style="margin-top:16px; padding:14px 16px; border:1px solid var(--gold-primary,#EAB308); border-radius:8px; background:rgba(234,179,8,0.06); font-size:0.82rem; line-height:1.7;">
          <strong>📌 সূত্র ও সতর্কতা</strong><br>
          এই হিসাব একটি <strong>আনুমানিক ধারণা</strong> — চূড়ান্ত সরকারি বিল নয়। সরকারি ফি ও কর দলিলের ধরন,
          মৌজা মূল্য, এলাকা এবং সরকারি প্রজ্ঞাপন (SRO) অনুযায়ী পরিবর্তিত হয়। এই কারণে প্রতিটি পরিবর্তনশীল খাত
          এখানে একটি <strong>সর্বনিম্ন–সর্বোচ্চ রেঞ্জ</strong> হিসেবে দেখানো হয়েছে, কোনো নির্দিষ্ট একক সংখ্যা হিসেবে নয়।
          উপরের হিসাবটি শুধুমাত্র <strong>সরকারি ফি ও কর</strong> (রেজিস্ট্রেশন ফি, স্ট্যাম্প ডিউটি, স্থানীয় সরকার কর ও উৎসে কর) —
          যা সাধারণত দলিল মূল্যের প্রায় <strong>৮.৫% – ১১%</strong> হয়। এর সাথে দলিল লেখকের ফি, নামজারি ও অন্যান্য
          আনুষঙ্গিক খরচ যোগ করলে সর্বমোট খরচ প্রায় <strong>১০% – ১৪%</strong> পর্যন্ত পৌঁছাতে পারে।<br><br>
          <strong>টাকা পরিশোধের আগে অবশ্যই আপনার স্থানীয় সাব-রেজিস্ট্রি অফিস বা একজন আইনজীবীর কাছ থেকে
          বর্তমান হার যাচাই করে নিন।</strong> বংশাই হাউজিং এই হিসাবের ভিত্তিতে নেওয়া কোনো আর্থিক সিদ্ধান্তের
          দায় বহন করে না।<br><br>
          <span style="color:var(--text-muted);">হার যাচাই করা হয়েছে: সেপ্টেম্বর ২০২৬ · রেজিস্ট্রেশন আইন ১৯০৮, স্ট্যাম্প আইন ১৮৯৯ ও আয়কর আইন ২০২৩ (ধারা ৫৩এফএফ) ভিত্তিক প্রচলিত হার।</span>
