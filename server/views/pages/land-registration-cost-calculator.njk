{% block head_extra %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "২০২৬ সালে বাংলাদেশে জমি রেজিস্ট্রি করতে মোট কত শতাংশ খরচ হয়?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "২০২৬ সালে বাংলাদেশে জমি রেজিস্ট্রির মোট সরকারি খরচ এলাকাভেদে সাধারণত দলিল মূল্যের ৫% থেকে ১১.৫% পর্যন্ত হয়। যেমন: ইউনিয়ন পরিষদে ৫%-৫.৫%, পৌরসভায় ৬.৫%-৭.৫% এবং সিটি কর্পোরেশনে ৮.৫%-১১.৫% পর্যন্ত সরকারি ফি ও কর প্রযোজ্য।"
        }
      },
      {
        "@type": "Question",
        "name": "জমি রেজিস্ট্রিতে কোন কোন খাতে সরকারি ফি দিতে হয়?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "জমি রেজিস্ট্রির প্রধান সরকারি খাতগুলো হলো: রেজিস্ট্রেশন ফি ১%, স্ট্যাম্প ডিউটি ১.৫%, স্থানীয় সরকার কর ১%-৩%, উৎসে আয়কর ১.৫%-৬%, এবং হলফনামা ও ই-ফি বাবদ প্রায় ৭১০ টাকা।"
        }
      },
      {
        "@type": "Question",
        "name": "জমি রেজিস্ট্রির উৎসে কর (Source Tax) কার পরিশোধ করার কথা?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "আয়কর আইন ২০২৩-এর ধারা ৫৩এফএফ অনুযায়ী উৎসে কর বিক্রেতার প্রদেয়। তবে প্রচলিত প্রথা ও ক্রয়-বিক্রয় চুক্তির শর্তানুসারে রেজিস্ট্রেশনের সময় চালানের মাধ্যমে এটি পরিশোধ করে দলিলের সাথে জমা দিতে হয়।"
        }
      }
    ]
  }
  </script>
<style>
/* Calculator styles, scoped to .calc-app so the site nav/footer are untouched */
