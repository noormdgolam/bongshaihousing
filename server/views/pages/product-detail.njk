{% extends "layout.njk" %}
{% block content %}
<section class="page-hero" style="min-height: 22vh; padding: 90px 0 30px;">
<div class="container page-hero-content" style="text-align: center;">
<span class="page-hero-label">{{ category.name }}</span>
<h1 class="page-hero-title" data-aos="fade-up">Model No-{{ product.model_number }}</h1>
<nav class="breadcrumb" style="justify-content: center;">
<a href="index.html">Home</a> <span aria-hidden="true">/</span>
{% if category.landing_page_slug %}<a href="{{ category.landing_page_slug }}">{{ category.name }}</a>{% else %}<a href="products-and-solutions.html">Products</a>{% endif %} <span aria-hidden="true">/</span>
<span aria-current="page">Model No-{{ product.model_number }}</span>
</nav>
</div>
</section>

<div class="container" style="padding: 40px 0;">
<div style="display: flex; flex-wrap: wrap; gap: var(--space-6); align-items: flex-start;">

  <div class="pd-gallery">
    {% if product.main_image %}
    {% set gallery_images = [product.main_image, product.image_2, product.image_3] %}
    <a href="{{ product.main_image }}" class="pd-gallery-link" data-pd-lightbox aria-label="View full-size image of {{ product.title }}">
      <img
        id="pdMainImage"
        src="{{ product.main_image }}"
        srcset="{{ product.main_image | replace('.webp', '-400w.webp') }} 400w, {{ product.main_image | replace('.webp', '-700w.webp') }} 700w, {{ product.main_image }} 1024w"
        sizes="(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 500px"
        alt="{{ product.main_image_alt or product.title }}" width="1024" height="1024" style="width: 100%; height: auto; display: block;" loading="eager" fetchpriority="high">
      <span class="pd-gallery-zoom" aria-hidden="true">🔍 Tap to enlarge</span>
    </a>
    <div class="pd-gallery-thumbs">
      {% for img in gallery_images %}
      {% if img %}
      <button type="button" class="pd-gallery-thumb{% if loop.first %} active{% endif %}" data-full="{{ img }}" aria-label="View image {{ loop.index }} of {{ product.title }}">
        <img src="{{ img }}" alt="" loading="lazy">
      </button>
      {% else %}
      <div class="pd-gallery-thumb pd-gallery-thumb-empty" aria-hidden="true">📷</div>
      {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>

  <div class="pd-lightbox" id="pdLightbox" hidden>
    <button type="button" class="pd-lightbox-close" aria-label="Close">✕</button>
    <img src="" alt="">
  </div>
  <script>
  (function () {
    var trigger = document.querySelector('[data-pd-lightbox]');
    var lightbox = document.getElementById('pdLightbox');
    var mainImg = document.getElementById('pdMainImage');
    var thumbs = document.querySelectorAll('.pd-gallery-thumb:not(.pd-gallery-thumb-empty)');
    if (!lightbox) return;
    var lbImg = lightbox.querySelector('img');
    var closeBtn = lightbox.querySelector('.pd-lightbox-close');

    function openLightbox(src, alt) {
      lbImg.src = src;
      lbImg.alt = alt || '';
      lightbox.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      lightbox.setAttribute('hidden', '');
      document.body.style.overflow = '';
    }
    if (trigger) {
      trigger.addEventListener('click', function (e) {
        e.preventDefault();
        openLightbox(mainImg ? mainImg.src : trigger.getAttribute('href'), mainImg ? mainImg.alt : '');
      });
    }
    // Thumbnails only ever swap which image is shown in the main box - zoom
    // is exclusively a main-box action (the "Tap to enlarge" affordance lives
    // there, not on the thumbnails). mainImg has a srcset with width
    // descriptors, which the browser uses in place of src once present -
    // just setting mainImg.src on click silently does nothing visually since
    // srcset still points at the old image. Clearing srcset (and sizes, its
    // required pair) forces the browser to actually use the new src.
    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        if (thumb.classList.contains('active')) return;
        var full = thumb.getAttribute('data-full');
        thumbs.forEach(function (t) { t.classList.toggle('active', t === thumb); });
        if (mainImg) {
          mainImg.removeAttribute('srcset');
          mainImg.removeAttribute('sizes');
          mainImg.src = full;
        }
        if (trigger) trigger.setAttribute('href', full);
      });
    });
    closeBtn.addEventListener('click', close);
    lightbox.addEventListener('click', function (e) { if (e.target === lightbox) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  })();
  </script>

  <div style="flex: 1 1 400px; background: white; padding: var(--space-6); border-radius: 16px; box-shadow: var(--shadow-sm); border: 1px solid var(--grey-100);">
    <div style="display: inline-block; background: rgba(212, 175, 55, 0.15); color: var(--accent-dark); padding: 4px 12px; border-radius: 20px; font-weight: 700; font-size: 0.8rem; margin-bottom: 16px;">MOST POPULAR</div>
    <h2 style="font-family: var(--font-heading); font-size: 2rem; color: var(--primary); margin-bottom: var(--space-4);">Model No-{{ product.model_number }}</h2>
    <div style="display: flex; align-items: baseline; gap: 10px; margin-bottom: 4px;" aria-live="polite">
      <span style="font-size: 0.8rem; color: var(--grey-500); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">{% if product.fixed_price or (variants.length and variants[0].estimatedPriceFormatted) %}Fixed Price{% else %}Pricing{% endif %}</span>
      <span class="bh-variant-price" style="font-size: 1.6rem; font-weight: 800; color: var(--primary);">{% if product.fixedPriceFormatted %}{{ product.fixedPriceFormatted }}{% elseif variants.length and variants[0].estimatedPriceFormatted %}{{ variants[0].estimatedPriceFormatted }}{% else %}Contact for Quote{% endif %}</span>
    </div>
    <p class="bh-variant-price-note" style="font-size: 0.82rem; color: var(--grey-600); margin: 0 0 var(--space-5); min-height: 1em;" aria-live="polite">{% if product.total_floor_area or (variants.length and variants[0].totalArea) %}Official Designated Floor Area: <strong>{{ product.total_floor_area or variants[0].totalArea }} sq.ft</strong> turnkey design.{% if variants.length > 1 %} Select another size below to recalculate.{% endif %}{% endif %}</p>

    <div class="pd-trust-strip">
      <span>⚡ 45–60 day build</span>
      <span>🛡️ Earthquake resistant</span>
      <span>🌪️ 200+ km/h wind rated</span>
    </div>

    <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--grey-100);">
      <a href="contact.html?model={{ product.model_number }}" class="btn btn-primary btn-lg" style="width: 100%; justify-content: center;">Get a Free Quote</a>
      <a class="btn btn-lg" href="https://wa.me/8801781636613?text=Hello%2C%20I%20am%20interested%20in%20Model%20{{ product.model_number }}%20({{ product.fixedPriceFormatted or 'Pricing' }})." rel="noopener noreferrer" style="width: 100%; justify-content: center; background: #25D366; color: white; border: none; font-weight: 700;" target="_blank">💬 WhatsApp Now</a>
    </div>

    {% if variants.length %}
    <div style="margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--grey-100);">
      {% if variants.length > 1 %}
      <span style="font-size: 0.8rem; color: var(--grey-500); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Select Floor Area</span>
      <div class="bh-variant-picker" style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px;">
        {% for v in variants %}
        <button type="button" class="btn bh-variant-btn{% if loop.first %} active{% endif %}" data-variant-index="{{ loop.index0 }}" style="padding: 6px 14px; font-size: 0.85rem;">{{ v.area_label or v.area_sqft }} Sq.Ft</button>
        {% endfor %}
      </div>
      {% else %}
      <span style="font-size: 0.8rem; color: var(--grey-500); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Floor Plan Specification</span>
      <div style="margin-top: 6px; font-size: 1.1rem; font-weight: 700; color: var(--primary);">{{ variants[0].area_label or variants[0].area_sqft }} Sq.Ft Total Area</div>
      {% endif %}
      <div class="bh-variant-summary" style="display: flex; flex-wrap: wrap; gap: 16px; margin-top: 14px; font-size: 0.88rem; color: var(--grey-700);" aria-live="polite">
        <span>🛏️ <strong class="bh-variant-bed">{{ variants[0].bed }}</strong></span>
        <span>🚿 <strong class="bh-variant-bath">{{ variants[0].bath }}</strong></span>
        <span>🍳 <strong>{{ variants[0].kitchen or '1 Kitchen' }}</strong></span>
      </div>
    </div>
    {% endif %}
  </div>
</div>

{% if variants.length %}
<section class="section" aria-labelledby="variants-title">
  <div class="section-header reveal">
    <h2 class="section-title" id="variants-title">Floor Plan & Room Breakdown</h2>
    <p class="section-subtitle">Official layout dimensions and area specifications for Model No-{{ product.model_number }}.</p>
  </div>
  {% for v in variants %}
  <div class="card bh-variant-panel{% if not loop.first %} bh-variant-hidden{% endif %}" data-variant-index="{{ loop.index0 }}" style="margin-bottom: 24px; background: white; border-radius: 12px; padding: 20px; box-shadow: var(--shadow-sm); border: 1px solid var(--grey-100);">
    <h3 style="margin-top:0; font-size: 1.25rem; color: var(--primary);">{{ v.area_label or v.area_sqft }} sqft Layout Plan{% if v.bed %} — {{ v.bed }}{% endif %}{% if v.bath %}, {{ v.bath }}{% endif %}</h3>
    {% if v.roomGroups.length %}
    <div class="pd-room-breakdown">
      {% for g in v.roomGroups %}
      <div class="pd-room-group">
        {% if g.label %}
        <div class="pd-room-group-header">
          <span>{{ g.label }}</span>
          {% if g.total %}<span class="pd-room-group-total">{{ g.total }} sqft total</span>{% endif %}
        </div>
        {% endif %}
        {% for r in g.rows %}
        <div class="pd-room-row">
          <span class="pd-room-icon" aria-hidden="true">{{ r.icon }}</span>
          <span class="pd-room-name">{{ r.section }}</span>
          <span class="pd-room-bar"><span class="pd-room-bar-fill" style="width: {{ r.barPct }}%;"></span></span>
          <span class="pd-room-area">{{ r.area_sqft or '' }}{% if r.area_sqft %} sqft{% endif %}</span>
          <span class="pd-room-dims">{% if r.length_ft and r.width_ft %}{{ r.length_ft }}' × {{ r.width_ft }}'{% endif %}</span>
        </div>
        {% endfor %}
      </div>
      {% endfor %}
      {% if v.roomGroupsBuildingTotal %}
      <div class="pd-room-building-total">
        <span>Total Building Area</span>
        <span>{{ v.roomGroupsBuildingTotal }} sqft</span>
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>
  {% endfor %}
</section>
<style>.bh-variant-hidden { display: none; } .bh-variant-btn.active { background: var(--primary); color: white; border-color: var(--primary); }</style>
{% if variants.length > 1 %}
<script>
(function () {
  var variantData = {{ variants | dump | safe }};
  var buttons = document.querySelectorAll('.bh-variant-btn');
  var panels = document.querySelectorAll('.bh-variant-panel');
  var bedEl = document.querySelector('.bh-variant-bed');
  var bathEl = document.querySelector('.bh-variant-bath');
  var priceEl = document.querySelector('.bh-variant-price');
  var priceNoteEl = document.querySelector('.bh-variant-price-note');
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var idx = btn.getAttribute('data-variant-index');
      buttons.forEach(function (b) { b.classList.toggle('active', b === btn); });
      panels.forEach(function (p) { p.classList.toggle('bh-variant-hidden', p.getAttribute('data-variant-index') !== idx); });
      var v = variantData[idx];
      if (v && bedEl) bedEl.textContent = v.bed;
      if (v && bathEl) bathEl.textContent = v.bath;
      if (v && priceEl) {
        if (v.estimatedPriceFormatted) {
          priceEl.textContent = v.estimatedPriceFormatted;
          if (priceNoteEl) priceNoteEl.textContent = 'Designated Floor Area: ' + v.totalArea + ' sq.ft.';
        } else {
          priceEl.textContent = 'Contact for Quote';
          if (priceNoteEl) priceNoteEl.textContent = '';
        }
      }
    });
  });
})();
</script>
{% endif %}
{% endif %}

{% if specs.length %}
<section class="section" aria-labelledby="specs-title">
  <div class="section-header reveal">
    <h2 class="section-title" id="specs-title">Building Specifications</h2>
  </div>
  <table class="modern-table">
    <thead><tr><th>Item</th><th>Materials</th></tr></thead>
    <tbody>
      {% for s in specs %}<tr><td>{{ s.spec_key }}</td><td>{{ s.spec_value }}</td></tr>{% endfor %}
    </tbody>
  </table>
</section>
{% endif %}

{% include "partials/steel-advantages.njk" %}

{% include "partials/most-viewed.njk" %}

{% if relatedProducts.length %}
<section class="section" aria-labelledby="related-title">
  <div class="section-header reveal">
    <h2 class="section-title" id="related-title">More in {{ category.name }}</h2>
    <p class="section-subtitle">Other models in the same category you might like.</p>
  </div>
  <div class="stagger product-grid">
    {% for rp in relatedProducts %}
    <div class="property-card reveal" data-tilt="" data-aos="fade-up" style="--i:{{ loop.index0 }}">
      <div class="property-img-wrap">
        {% if rp.main_image %}
        <img
          alt="Bongshai Housing Model No-{{ rp.model_number }}"
          loading="lazy"
          src="{{ rp.main_image }}"
          srcset="{{ rp.main_image | replace('.webp', '-400w.webp') }} 400w, {{ rp.main_image | replace('.webp', '-700w.webp') }} 700w, {{ rp.main_image }} 1024w"
          sizes="(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 500px"
          title="Bongshai Housing Model No-{{ rp.model_number }}" width="1024" height="1024">
        {% endif %}
      </div>
      <div class="property-card-body" data-aos="fade-up">
        <span class="property-type">{{ category.name }}</span>
        <h2 class="property-name">Model No-{{ rp.model_number }}</h2>
        <div class="property-price"><span class="property-price-label">{% if rp.fromPriceFormatted %}From{% else %}Pricing{% endif %}</span><span class="property-price-value" style="font-size:0.95rem;">{{ rp.fromPriceFormatted or 'Contact for Quote' }}</span></div>
        <a class="btn btn-primary" href="{{ rp.slug }}" style="width:100%;justify-content:center;">View Details</a>
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

</div>

<div class="pd-sticky-cta" aria-hidden="false">
  <a href="contact.html?model={{ product.model_number }}" class="btn btn-primary">Get a Free Quote</a>
  <a href="https://wa.me/8801781636613?text=Hello%2C%20I%20am%20interested%20in%20Model%20{{ product.model_number }}." class="btn" style="background:#25D366; color:#fff; border:none;" target="_blank" rel="noopener noreferrer">💬 WhatsApp</a>
</div>
{% endblock %}
