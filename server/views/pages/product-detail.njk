{% extends "layout.njk" %}
{% block content %}
<section class="page-hero" style="min-height: 30vh; padding: 100px 0 50px;">
<div class="container page-hero-content" style="text-align: center;">
<span class="page-hero-label">{{ category.name }}</span>
<h1 class="page-hero-title" data-aos="fade-up">{{ product.model_number }}</h1>
{% if product.description %}<p class="page-hero-text" style="max-width: 800px; margin: 0 auto 24px;">{{ product.description }}</p>{% endif %}
</div>
</section>

<div class="container" style="padding: 40px 0;">
<div style="display: flex; flex-wrap: wrap; gap: var(--space-6); align-items: flex-start;">

  <div style="flex: 1 1 500px; background: white; border-radius: 16px; overflow: hidden; box-shadow: var(--shadow-md); border: 1px solid var(--grey-100);">
    {% if product.main_image %}
    <img src="{{ product.main_image }}" alt="{{ product.title }}" style="width: 100%; height: auto; display: block;" loading="eager">
    {% endif %}
  </div>

  <div style="flex: 1 1 400px; background: white; padding: var(--space-6); border-radius: 16px; box-shadow: var(--shadow-sm); border: 1px solid var(--grey-100);">
    <span class="property-type" style="display: inline-block; background: rgba(212, 175, 55, 0.15); color: var(--accent-dark); padding: 4px 12px; border-radius: 20px; font-weight: 700; font-size: 0.8rem; margin-bottom: 16px;">{{ category.name }}</span>
    <h2 style="font-family: var(--font-heading); font-size: 2rem; color: var(--primary); margin-bottom: var(--space-4);">{{ product.model_number }}</h2>
    <div style="display: flex; align-items: baseline; gap: 10px; margin-bottom: var(--space-5);">
      <span style="font-size: 0.8rem; color: var(--grey-500); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Pricing</span>
      <span style="font-size: 1.4rem; font-weight: 800; color: var(--primary);">
        {% if product.price_per_sqft %}৳{{ product.price_per_sqft }} / sqft{% else %}Contact for Quote{% endif %}
      </span>
    </div>
    <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--grey-100);">
      <a href="contact.html?model={{ product.model_number }}" class="btn btn-primary btn-lg" style="width: 100%; justify-content: center;">Get a Free Quote</a>
      <a class="btn btn-lg" href="https://wa.me/8801781636613?text=Hello%2C%20I%20am%20interested%20in%20Model%20{{ product.model_number }}." rel="noopener noreferrer" style="width: 100%; justify-content: center; background: #25D366; color: white; border: none; font-weight: 700;" target="_blank">💬 WhatsApp Now</a>
    </div>
  </div>
</div>

{% if variants.length %}
<section class="section" aria-labelledby="variants-title">
  <div class="section-header reveal">
    <h2 class="section-title" id="variants-title">Available Sizes</h2>
    <p class="section-subtitle">Room breakdown for each floor-area option.</p>
  </div>
  {% for v in variants %}
  <div class="card" style="margin-bottom: 24px; background: white; border-radius: 12px; padding: 20px; box-shadow: var(--shadow-sm); border: 1px solid var(--grey-100);">
    <h3 style="margin-top:0;">{{ v.area_label or v.area_sqft }} sqft{% if v.bed %} — {{ v.bed }} Bed{% endif %}{% if v.bath %}, {{ v.bath }} Bath{% endif %}</h3>
    {% if v.rooms.length %}
    <table class="modern-table">
      <thead><tr><th>Section</th><th>Area (sq.ft)</th><th>Length (ft)</th><th>Width (ft)</th></tr></thead>
      <tbody>
        {% for r in v.rooms %}
        <tr {% if r.is_total_row %}style="font-weight:700;"{% endif %}>
          <td>{% if r.floor_label %}{{ r.floor_label }}: {% endif %}{{ r.section }}</td>
          <td>{{ r.area_sqft or '' }}</td>
          <td>{{ r.length_ft or '' }}</td>
          <td>{{ r.width_ft or '' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}

{% if specs.length %}
<section class="section" aria-labelledby="specs-title">
  <div class="section-header reveal">
    <h2 class="section-title" id="specs-title">Building Specifications</h2>
  </div>
  <table class="modern-table">
    <thead><tr><th>Item</th><th>Materials</th></tr></thead>
    <tbody>
      {% for s in specs %}<tr><td>{{ s.spec_key }}</td><td>{{ s.spec_value }}</td></tr>{% endfor %}
    </tbody>
  </table>
</section>
{% endif %}

</div>
{% endblock %}
