{% block content %}
<section class="page-hero" aria-labelledby="page-title">
      <div class="container page-hero-content">
        <span class="page-hero-label">Our Team</span>
        <h1 class="page-hero-title" data-aos="fade-up" id="page-title">Engineering Team</h1>
        <p class="page-hero-text">Highly trained Site Engineers, QC Engineers, and Tender Executives.</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <a href="about.html">About Us</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Engineering Team</span>
        </nav>
      </div>
    </section>

    <section class="section" aria-labelledby="team-detail-title">
      <div class="container">
        <div class="about-grid" style="grid-template-columns: 1fr;">
          <div class="about-content reveal visible">
            <div class="section-label">⚙️ Expertise</div>
            <h2 id="team-detail-title">Engineering Team Details</h2>
            <p style="margin-bottom:var(--space-4)">Our Engineering Team is the backbone of our construction projects, bringing technical expertise and innovative solutions to every challenge.</p>
            <p style="margin-bottom:var(--space-4)">Comprising highly qualified Site Engineers, Quality Control (QC) Engineers, and Tender Executives, they specialize in civil, structural, and architectural engineering disciplines.</p>
            <p style="margin-bottom:var(--space-4)">From preparing precise project estimates to overseeing on-site execution, our engineers ensure that every building is structurally sound, cost-effective, and built to exact specifications.</p>

            <div style="margin-top:var(--space-8)">
              <a href="about.html" class="btn btn-outline">← Back to About Us</a>
              <a href="contact.html" class="btn btn-primary" style="margin-left:var(--space-3)">Contact Sales</a>
            </div>
          </div>
        </div>
      </div>
    </section>
{% endblock %}

