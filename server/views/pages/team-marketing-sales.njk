{% block content %}
<section class="page-hero" aria-labelledby="page-title">
      <div class="container page-hero-content">
        <span class="page-hero-label">Our Team</span>
        <h1 class="page-hero-title" data-aos="fade-up" id="page-title">Marketing &amp; Sales</h1>
        <p class="page-hero-text">Ensuring seamless client communication, transparent pricing, and lasting relationships.</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <a href="about.html">About Us</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Marketing &amp; Sales</span>
        </nav>
      </div>
    </section>

    <section class="section" aria-labelledby="team-detail-title">
      <div class="container">
        <div class="about-grid" style="grid-template-columns: 1fr;">
          <div class="about-content reveal visible">
            <div class="section-label">📊 Expertise</div>
            <h2 id="team-detail-title">Marketing &amp; Sales Details</h2>
            <p style="margin-bottom:var(--space-4)">Our Marketing &amp; Sales Executives are dedicated to helping clients navigate the complex process of purchasing and building property.</p>
            <p style="margin-bottom:var(--space-4)">We believe in complete transparency. Our team ensures that you receive accurate pricing, detailed project scope information, and regular updates.</p>
            <p style="margin-bottom:var(--space-4)">Their goal is to build lasting relationships with our clients by understanding their unique needs and matching them with the perfect housing or commercial solutions.</p>

            <div style="margin-top:var(--space-8)">
              <a href="about.html" class="btn btn-outline">← Back to About Us</a>
              <a href="contact.html" class="btn btn-primary" style="margin-left:var(--space-3)">Get a Quote</a>
            </div>
          </div>
        </div>
      </div>
    </section>
{% endblock %}
