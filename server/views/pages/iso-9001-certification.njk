}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "dateModified": "2026-09-03",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Does Bongshai Housing hold ISO 9001:2015 certification?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Bongshai Housing does not hold ISO 9001:2015 certification. Steel building design, material procurement, fabrication, and construction follow BNBC 2020 and AISC structural design codes, with quality-control checks applied throughout the process."
      }
    },
    {
      "@type": "Question",
      "name": "What quality-control process does my steel building project go through?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bongshai Housing applies quality-control checks across the construction process: material sourcing, structural design, fabrication, on-site erection, and final inspection, following BNBC 2020 and AISC structural design codes."
      }
    }
  ]
}
