{% block content %}
<section class="page-hero" style="background: linear-gradient(135deg, #004d7a, #008793);" aria-labelledby="page-title">
      <div class="container page-hero-content">
        <div style="font-size:4rem; margin-bottom:10px;">🏆</div>
        <h1 class="page-hero-title" data-aos="fade-up" id="page-title">ISO 9001:2015 Quality Management</h1>
        <p class="page-hero-text">Uncompromising Quality and International Compliance</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <a href="certifications.html">Certifications &amp; Quality</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">ISO 9001:2015 Quality Management</span>
        </nav>
      </div>
    </section>

    <section class="section" aria-labelledby="content-title">
      <div class="container">
        
            <div class="about-grid">
              <div class="reveal-left" style="display:flex; flex-direction:column; gap:20px;">
                <div style="width:100%; height:400px; border-radius:12px; box-shadow:var(--shadow-xl); background:linear-gradient(135deg, #1e3c72, #2a5298); display:flex; align-items:center; justify-content:center; flex-direction:column;">
                  <span style="font-size:6rem; margin-bottom:20px;">🎖️</span>
                  <div style="color:white; font-size:1.8rem; font-weight:700;">ISO 9001:2015</div>
                </div>
              </div>
              <div class="about-content reveal-right">
                <h2 id="content-title">Our ISO 9001 Framework</h2>
                <p style="margin-bottom:var(--space-4)">At Bongshai Housing, quality isn't just a promise; it's a rigorously documented and globally certified process. Our ISO 9001:2015 certification ensures that every aspect of our project delivery - from initial design and engineering to final construction and handover - meets exact international standards.</p>
                <p style="margin-bottom:var(--space-4)">We employ a <strong>Zero-Defect Policy</strong>. This means our Quality Control teams audit every manufacturing phase. We trace every steel beam and every concrete mix back to its source, ensuring 100% accountability.</p>
                
                <h3 style="font-size:1.5rem; color:var(--primary); margin-top:var(--space-6); margin-bottom:var(--space-3)">Direct Benefits to Our Clients:</h3>
                <ul style="list-style-type: disc; margin-left:var(--space-4); color:var(--grey-800); font-size:1.05rem; line-height:1.8; margin-bottom:var(--space-6);">
                    <li><strong>Consistent Delivery:</strong> Projects are completed exactly as planned, with no unpleasant surprises.</li>
                    <li><strong>Long-Term Durability:</strong> Strict compliance means your building will withstand the test of time and weather.</li>
                    <li><strong>Transparent Reporting:</strong> Clients receive detailed quality audit reports at every major construction milestone.</li>
                </ul>

                <a href="contact.html" class="btn btn-primary">Speak to Our Engineers</a>
              </div>
            </div>
        
      </div>
    </section>
{% endblock %}
