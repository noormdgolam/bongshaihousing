{% block content %}
<section class="page-hero" aria-labelledby="page-title">
      <div class="container page-hero-content">
        <span class="page-hero-label">Our Team</span>
        <h1 class="page-hero-title" data-aos="fade-up" id="page-title">Quality Control</h1>
        <p class="page-hero-text">Exceeding international standards for materials, workmanship, and safety.</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <a href="about.html">About Us</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Quality Control</span>
        </nav>
      </div>
    </section>

    <section class="section" aria-labelledby="team-detail-title">
      <div class="container">
        <div class="about-grid" style="grid-template-columns: 1fr;">
          <div class="about-content reveal visible">
            <div class="section-label">🛡️ Expertise</div>
            <h2 id="team-detail-title">Quality Control Details</h2>
            <p style="margin-bottom:var(--space-4)">Quality is at the heart of everything we do at Bongshai Housing. Our dedicated Quality Control (QC) team rigorously inspects every phase of construction.</p>
            <p style="margin-bottom:var(--space-4)">From the sourcing of premium raw materials to the final finishing touches, they enforce strict compliance with international engineering and safety standards.</p>
            <p style="margin-bottom:var(--space-4)">We guarantee that our pre-engineered steel buildings, industrial sheds, and luxury villas are not only beautiful but durable, safe, and built to last.</p>

            <div style="margin-top:var(--space-8)">
              <a href="about.html" class="btn btn-outline">← Back to About Us</a>
              <a href="contact.html" class="btn btn-primary" style="margin-left:var(--space-3)">Contact Sales</a>
            </div>
          </div>
        </div>
      </div>
    </section>
