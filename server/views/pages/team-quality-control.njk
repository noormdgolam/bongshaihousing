{% block content %}
<section class="page-hero" aria-labelledby="page-title">
      <div class="container page-hero-content">
        <span class="page-hero-label">Our Team</span>
        <h1 class="page-hero-title" data-aos="fade-up" id="page-title">Quality Control</h1>
        <p class="page-hero-text">Exceeding international standards for materials, workmanship, and safety.</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <a href="about.html">About Us</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Quality Control</span>
        </nav>
      </div>
    </section>

    <section class="section" aria-labelledby="team-detail-title">
      <div class="container">
        <div class="about-grid" style="grid-template-columns: 1fr;">
          <div class="about-content reveal visible">
            <div class="section-label">🛡️ Expertise</div>
            <h2 id="team-detail-title">Quality Control Details</h2>
            <p style="margin-bottom:var(--space-4)">Quality is at the heart of everything we do at Bongshai Housing. Our dedicated Quality Control (QC) team rigorously inspects every phase of construction.</p>
            <p style="margin-bottom:var(--space-4)">From the sourcing of premium raw materials to the final finishing touches, they enforce strict compliance with international engineering and safety standards.</p>
            <p style="margin-bottom:var(--space-4)">We guarantee that our pre-engineered steel buildings, industrial sheds, and luxury villas are not only beautiful but durable, safe, and built to last.</p>

            {# DB-driven roster: /admin/team-members rows whose department matches
               this page. Renders nothing when the table has none, so the prose
               above still stands on its own. #}
            {% if dbTeamMembers and dbTeamMembers.length %}
            <div class="stagger product-grid" style="margin-top:var(--space-8)">
              {% for m in dbTeamMembers %}
              <div class="why-card reveal glass-card" data-aos="fade-up" style="--i:{{ loop.index0 }};text-align:left">
                <div style="display:flex;align-items:center;gap:var(--space-4);margin-bottom:var(--space-4)">
                  {% if m.photo %}
                  <img src="{{ m.photo }}" alt="{{ m.name }}" loading="lazy" width="64" height="64" style="width:64px;height:64px;border-radius:50%;object-fit:cover;flex-shrink:0">
                  {% else %}
                  <div aria-hidden="true" style="width:64px;height:64px;border-radius:50%;flex-shrink:0;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-family:var(--font-heading);font-size:1.1rem">{{ m.initials }}</div>
                  {% endif %}
                  <div style="min-width:0">
                    <h3 class="why-title" style="margin:0 0 2px">{{ m.name }}</h3>
                    {% if m.role %}<p style="color:var(--primary);font-weight:700;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.04em;margin:0">{{ m.role }}</p>{% endif %}
                  </div>
                </div>
                {% if m.bio %}<p class="why-text" style="margin:0">{{ m.bio }}</p>{% endif %}
              </div>
              {% endfor %}
            </div>
            {% endif %}

            <div style="margin-top:var(--space-8)">
              <a href="about.html" class="btn btn-outline">← Back to About Us</a>
              <a href="contact.html" class="btn btn-primary" style="margin-left:var(--space-3)">Contact Sales</a>
            </div>
          </div>
        </div>
      </div>
    </section>
{% endblock %}

{% block scripts_extra %}
{% endblock %}
