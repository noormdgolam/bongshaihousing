{% block content %}
<section class="page-hero" style="background: linear-gradient(rgba(15,23,42,0.8), rgba(15,23,42,0.9)), url('images/products/industrial-hero.jpg') center/cover no-repeat; min-height: 40vh; padding: 120px 0 60px;">
  <div class="container page-hero-content" style="text-align: center;">
    <span class="page-hero-label" style="background: var(--accent); color: var(--dark); padding: 4px 12px; border-radius: 20px; font-weight: 700; font-size: 0.85rem; margin-bottom: 16px; display: inline-block;">Locations</span>
    <h1 class="page-hero-title" data-aos="fade-up" style="font-size: clamp(2.5rem, 5vw, 4rem); color: white;">Areas We Serve</h1>
    <p class="page-hero-text" style="max-width: 800px; margin: 0 auto 24px; color: var(--grey-200);">Bongshai Housing proudly operates across all 64 districts and thanas in Bangladesh, delivering premium steel buildings and real estate solutions nationwide.</p>
  </div>
</section>

<!-- AEO: Answer-First Opening & Explicit Trust Signal -->
<section class="section" style="padding: 2rem 0; background: var(--off-white);">
  <div class="container">
    <p><strong>Bongshai Housing provides prefab steel building construction and EPC services across all 64 districts of Bangladesh. We deliver turnkey structural solutions for residential, commercial, and industrial sectors nationwide.</strong></p>
    <div class="trust-signals" style="font-size: 0.9rem; color: var(--grey-600); margin-top: 1rem;">
      By <strong>Bongshai Housing Logistics Team</strong> | Expert EPC Contractors | Last Updated: <time datetime="2026-08-08">August 8, 2026</time>
    </div>
  </div>
</section>

<section style="padding: 80px 0; background: var(--grey-50);">
  <div class="container">
    <div style="max-width: 600px; margin: 0 auto 40px;">
      <input type="text" id="districtSearch" placeholder="Search for your district or thana..." style="width: 100%; padding: 15px 20px; font-size: 1.1rem; border: 2px solid var(--grey-200); border-radius: 8px; outline: none; transition: border-color 0.3s;" onfocus="this.style.borderColor='var(--primary)'" onblur="this.style.borderColor='var(--grey-200)'">
    </div>
    
    <div id="districtsGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
      <!-- Districts will be injected here via JavaScript -->
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const grid = document.getElementById('districtsGrid');
    const searchInput = document.getElementById('districtSearch');
    
    // DB Service Areas passed from server
    const serverAreas = {% if dbServiceAreas and dbServiceAreas.length %}{{ dbServiceAreas | dump | safe }}{% else %}null{% endif %};
    
    // Build lookup map from DB
    const dbPageMap = {};
    if (serverAreas && Array.isArray(serverAreas)) {
        serverAreas.forEach(function(a) {
            if (a.has_dedicated_page && a.page_slug) {
                dbPageMap[a.district.toLowerCase()] = a.page_slug;
            }
        });
    }

    const defaultDistrictPages = {
        "dhaka": "steel-building-dhaka.html",
        "chattogram": "steel-building-chotrogram.html",
        "gazipur": "steel-building-gazipur.html",
        "comilla": "prefab-housing-cumilla.html",
        "cumilla": "prefab-housing-cumilla.html",
        "bogura": "prefab-cottage-bogra-rangpur.html",
        "bogra": "prefab-cottage-bogra-rangpur.html",
        "rangpur": "prefab-cottage-bogra-rangpur.html",
        "faridpur": "steel-building-faridpur.html",
        "sylhet": "steel-building-sylhet.html",
        "khulna": "steel-building-khulna.html",
        "rajshahi": "steel-building-rajshahi.html",
        "barisal": "steel-building-barisal.html",
        "barishal": "steel-building-barisal.html",
        "mymensingh": "steel-building-mymensingh.html",
        "narayanganj": "steel-building-narayanganj.html",
        "coxsbazar": "steel-building-coxsbazar.html",
        "cox's bazar": "steel-building-coxsbazar.html",
        "jashore": "steel-building-jashore.html",
        "narsingdi": "steel-building-narsingdi.html",
        "tangail": "steel-building-tangail.html",
        "manikganj": "steel-building-manikganj.html"
    };

    function getDistrictPage(districtName) {
        if (!districtName) return null;
        const key = districtName.toLowerCase();
        if (serverAreas && Array.isArray(serverAreas)) {
            return dbPageMap[key] || null;
        }
        return defaultDistrictPages[key] || null;
    }
    
    function renderDistricts(data) {
        grid.innerHTML = '';
        if(data.length === 0) {
            grid.innerHTML = '<p style="text-align:center; grid-column: 1/-1; color: var(--grey-500);">No locations found.</p>';
            return;
        }

        data.forEach(function(d) {
            const card = document.createElement('div');
            card.style.background = '#fff';
            card.style.borderRadius = '8px';
            card.style.padding = '20px';
            card.style.boxShadow = '0 4px 6px rgba(0,0,0,0.05)';
            card.style.border = '1px solid var(--grey-100)';

            let upazilasHtml = '';
            if(d.upazillas && d.upazillas.length > 0) {
                upazilasHtml = '<div style="margin-top: 15px; display: flex; flex-wrap: wrap; gap: 6px;">' +
                    d.upazillas.map(function(u) { return `<span style="background: var(--grey-50); padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; color: var(--grey-600); border: 1px solid var(--grey-200);">${u}</span>`; }).join('') +
                    '</div>';
            }

            const page = getDistrictPage(d.district);
            const linkHtml = page ? `<a href="/${page.replace(/^\//, '')}" style="font-size: 0.8rem; font-weight: 700; color: var(--primary); text-decoration: none;">View details →</a>` : '';

            card.innerHTML = `
                <h2 style="margin-bottom: 5px; font-size: 1.1rem; color: var(--primary); display: flex; align-items: center; justify-content: space-between;">
                    Do we serve ${d.district}?
                </h2>
                <p style="font-size: 0.85rem; color: var(--grey-400); margin: 0;">📍 ${d.coordinates || 'Bangladesh'}</p>
                ${upazilasHtml}
                ${linkHtml ? `<div style="margin-top: 12px;">${linkHtml}</div>` : ''}
            `;
            grid.appendChild(card);
        });
    }

    // Initial render
    if(typeof bdGeoData !== 'undefined') {
        bdGeoData.sort(function(a, b) { return a.district.localeCompare(b.district); });
        renderDistricts(bdGeoData);
    }
    
    // Search functionality
    searchInput.addEventListener('input', function(e) {
        const term = e.target.value.toLowerCase();
        if(typeof bdGeoData !== 'undefined') {
            const filtered = bdGeoData.filter(function(d) {
                return d.district.toLowerCase().includes(term) ||
                       (d.upazillas && d.upazillas.some(function(u) { return u.toLowerCase().includes(term); }));
            });
            renderDistricts(filtered);
        }
    });
});
</script>
{% endblock %}
