{% extends "layout.njk" %}
{% block head_extra %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "২০২৬ সালে বাংলাদেশে বাড়ি তৈরিতে প্রতি স্কয়ার ফিটে কত খরচ হয়?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "২০২৬ সালের বর্তমান বাজারদর অনুযায়ী সাধারণ ফিনিশিংয়ে বাড়ি তৈরিতে প্রতি স্কয়ার ফিটে প্রায় ১,৯০০ থেকে ২,২০০ টাকা, মানসম্মত স্ট্যান্ডার্ড ফিনিশিংয়ে ২,৪০০ থেকে ২,৮৫০ টাকা এবং উন্নত লাক্সারি ফিনিশিংয়ে ৩,২০০ থেকে ৪,২০০ টাকা পর্যন্ত খরচ হয়।"
        }
      },
      {
        "@type": "Question",
        "name": "বাড়ি তৈরির খরচের প্রধান খাতগুলো কীভাবে ভাগ করা থাকে?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "সাধারণত মোট ব্যয়ের প্রায় ৬০% খরচ হয় রড, সিমেন্ট, ইট, বালু ও ফাউন্ডেশনের কাঠামো (গ্রে স্ট্রাকচার) তৈরিতে, প্রায় ২৮% খরচ হয় ফিনিশিং কাজে (টাইলস, প্লাস্টার, রং, দরজা-জানালা) এবং প্রায় ১২% খরচ হয় ইলেকট্রিক্যাল ও স্যানিটারি ফিটিংসে।"
        }
      },
      {
        "@type": "Question",
        "name": "ঐতিহ্যবাহী বাড়ি নির্মাণ বনাম বংশাই হাউজিং-এর নির্দিষ্ট প্যাকেজের সুবিধা কী?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "সনাতন পদ্ধতিতে বাড়ি তৈরিতে সময় ও বাজেট অনেক ক্ষেত্রে ২০% থেকে ৪০% বৃদ্ধি পায়। বংশাই হাউজিং-এর রেডিমেড মডেলে নির্দিষ্ট চুক্তিমূল্যে মাত্র ৩০ থেকে ৬০ দিনের মধ্যে সম্পূর্ণ বাড়ি প্রস্তুত পাওয়া যায়।"
        }
      }
    ]
  }
  </script>
<style>
/* Calculator styles, scoped to .calc-app so the site nav/footer are untouched */
