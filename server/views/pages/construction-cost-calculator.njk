    }
@media (max-width: 640px) {
.calc-app .main-wrapper {
        padding: 16px 12px 50px;
      }
.calc-app .hero-title {
        font-size: 1.55rem;
      }
.calc-app .calc-card, .calc-app .comparison-section {
        padding: 18px 14px;
      }
.calc-app .finish-grid {
        grid-template-columns: 1fr;
        gap: 8px;
      }
.calc-app .models-grid {
        grid-template-columns: 1fr;
        gap: 12px;
      }
.calc-app .lead-form-grid {
        grid-template-columns: 1fr;
      }
.calc-app .floor-grid {
        gap: 6px;
      }
.calc-app .floor-btn {
        padding: 10px 4px;
        font-size: 0.85rem;
      }
.calc-app .result-grid-summary {
        grid-template-columns: 1fr;
        gap: 8px;
      }
.calc-app .brand-hotline-btn span {
        display: none;
      }
.calc-app .area-tier-tabs {
        gap: 6px;
      }
.calc-app .tier-tab-btn {
        padding: 5px 11px;
        font-size: 0.78rem;
      }
}


/* --- Site-layout integration -------------------------------------------- */

/* The standalone page's <main class="main-wrapper"> supplied the container and
   was dropped when the content moved into layout.njk's own <main>, so the
   calculator ran the full width of the viewport. .calc-shell restores it. */
.calc-app {
  background: var(--bg-navy);
  padding-bottom: 56px;   /* top clearance is the hero band's job, see below */
}
.calc-app .calc-shell {
  max-width: 960px;
  margin: 0 auto;
  padding: 0 16px;
}
.calc-app .main-wrapper { padding-top: 0; }

/* Every other interior page opens with a full-bleed navy hero band - gold
   eyebrow, white title - and drops to off-white content below it (.page-hero in
   css/style.css). The calculator's hero-box holds exactly that content, so it
   gets moved out of .calc-shell and dressed as the site's band; without it the
   nav clearance is just a tall empty gap, which is most of what made the page
   look imported. */
.calc-app .hero-box {
  background: linear-gradient(135deg, #1E3A8A 0%, #1E40AF 100%);
  padding: calc(var(--nav-height, 80px) + 44px) 16px 44px;
  margin: 0 0 32px;
  text-align: center;
}
.calc-app .hero-box .hero-title {
  color: #ffffff;
  max-width: 960px;
  margin: 0 auto;
  text-wrap: balance;
}
.calc-app .hero-box .hero-title span { color: #FDE047; }
.calc-app .hero-box .trust-badge {
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(253, 224, 71, 0.45);
  color: #FDE047;
}
@media (max-width: 768px) {
  .calc-app .hero-box { padding: calc(var(--nav-height, 80px) + 26px) 16px 30px; margin-bottom: 24px; }
}

/* On a narrow screen the label and its hint are two competing lines, not a
   left/right pair - stop them colliding. */
@media (max-width: 560px) {
  .calc-app .form-label { flex-direction: column; align-items: flex-start; gap: 2px; }
}

/* Cards read as cards against the off-white ground, matching the site's. */
.calc-app .calc-card,
.calc-app .answer-first-card,
.calc-app .models-block,
.calc-app .lead-block,
.calc-app .faq-block {
  box-shadow: var(--shadow-card);
}

/* The answer block: a light brand-tinted panel, not a dark slab. */
.calc-app .answer-first-card {
  background: var(--brand-soft);
  border: 1px solid #dbe4fb;
  border-left: 4px solid var(--brand);
}

/* The result panel. Keeping it dark was tempting - it's the answer - but on the
   land page it wraps the whole fee table plus the e-fee, warning and sources
   boxes, and those are light, so a dark slab ends up punched full of holes.
   Light card, brand border, gold badge: the emphasis comes from the frame. */
.calc-app .result-showcase {
  background: #ffffff;
  border: 2px solid var(--brand);
  box-shadow: 0 10px 30px rgba(30, 64, 175, 0.10);
}
.calc-app .result-showcase .result-badge {
  background: var(--gold-accent);
  color: var(--on-gold);
}
.calc-app .result-showcase .result-total-taka {
  color: var(--brand);
  text-shadow: none;
}
.calc-app .result-showcase .breakdown-bar-bg,
.calc-app .result-showcase .breakdown-table th {
  background: #f1f5f9;
}
.calc-app .result-showcase .breakdown-table th { color: var(--text-muted); }

/* Selected states: the original relied on a gold glow against near-black, which
   on white washes out to a smudge. A tinted fill plus a solid brand border is
   how the rest of the site marks a chosen option. */
.calc-app .floor-btn.active,
.calc-app .finish-card.active,
.calc-app .tier-tab-btn.active,
.calc-app .seller-type-btn.active {
  background: var(--brand-soft);
  border-color: var(--brand);
  color: var(--brand);
  box-shadow: none;
}
.calc-app .finish-card.active .finish-desc { color: var(--text-muted); }

/* Price panel inside each model card - a brand-tinted plate, not a black box. */
.calc-app .model-price-box {
  background: var(--brand-soft);
  border: 1px solid #dbe4fb;
}

/* The lead-capture block was a dark slab; make it the site's navy CTA instead. */
.calc-app .lead-block {
  --text-white: #ffffff;
  --text-light: #f1f5f9;
  --text-muted: #cbd5e1;
  --brand: #FDE047;
  background: linear-gradient(150deg, #1e3a8a 0%, #1e40af 100%);
  border: 1px solid rgba(255, 255, 255, 0.16);
}
.calc-app .lead-block .lead-input,
.calc-app .lead-block .lead-select {
  background: #ffffff;
  border-color: rgba(255, 255, 255, 0.5);
  color: #0f172a;
}

/* Bengali numerals and Taka figures line up in the breakdown tables. */
.calc-app .breakdown-table td,
.calc-app .b-amt,
.calc-app .result-total-taka { font-variant-numeric: tabular-nums; }
</style>
{% endblock %}

{% block content %}
<div class="calc-app">
<div class="hero-box">
      <div class="trust-badge">
        🏗️ ২০২৬ সালের বর্তমান বাজারদর ভিত্তিক এস্টিমেশন
      </div>
      <h1 class="hero-title">বাড়ি নির্মাণ খরচ ক্যালকুলেটর <span>২০২৬</span></h1>
    </div>
<div class="calc-shell">

    <!-- Hero / Header -->
    

    <!-- AEO Direct Answer Block (< 45 words) -->
    <section class="answer-first-card" aria-label="সংক্ষিপ্ত উত্তর">
      <p>
        ২০২৬ সালে বাংলাদেশে সাধারণ ফিনিশিংয়ে বাড়ি তৈরিতে প্রতি স্কয়ার ফিটে গড়ে <strong>১,৯০০ থেকে ২,২০০ টাকা</strong>, স্ট্যান্ডার্ড মানে <strong>২,৪০০ থেকে ২,৮৫০ টাকা</strong> এবং আধুনিক প্রিমিয়াম ফিনিশিংয়ে <strong>৩,২০০ থেকে ৪,২০০ টাকা</strong> পর্যন্ত খরচ হয়।
      </p>
      <div class="trust-meta">
        <span>✍️ প্রস্তুতকারক: বংশাই হাউজিং স্ট্রাকচারাল টিম</span>
        <span>📅 তথ্যসূত্র: পিডব্লিউডি রেট ও ২০২৬ বাজারদর</span>
        <span>📍 কভারেজ: ৬৪ জেলা</span>
      </div>
    </section>

    <!-- Main Calculator Form & Logic -->
    <section class="calc-card" data-mcp-action="calculate-construction-cost">
      
      <!-- Input 1: Floor Area -->
      <div class="form-group">
        <label class="form-label" for="floorAreaInput">
          <span>১. প্রতি তলার আয়তন (স্কয়ার ফিট)</span>
          <span class="form-label-hint">কমপক্ষে ২০০ স্কয়ার ফিট</span>
        </label>
        <div class="input-wrapper">
          <input 
            type="number" 
            id="floorAreaInput" 
            class="calc-input" 
            value="1000" 
            min="200" 
            max="15000" 
            step="50"
            data-mcp-param="floorArea"
          >
          <span class="input-unit">Sq. Ft.</span>
        </div>
        <!-- Quick Preset Chips -->
        <div class="preset-chips" id="areaChips">
          <button type="button" class="preset-chip" data-val="400">৪০০ sft</button>
          <button type="button" class="preset-chip" data-val="600">৬০০ sft</button>
          <button type="button" class="preset-chip" data-val="800">৮০০ sft</button>
          <button type="button" class="preset-chip active" data-val="1000">১,০০০ sft</button>
          <button type="button" class="preset-chip" data-val="1200">১,২০০ sft</button>
          <button type="button" class="preset-chip" data-val="1600">১,৬০০ sft</button>
          <button type="button" class="preset-chip" data-val="2000">২,০০০ sft</button>
        </div>
      </div>

      <!-- Input 2: Number of Floors -->
      <div class="form-group">
        <label class="form-label">
          <span>২. ভবনের তলা সংখ্যা</span>
          <span class="form-label-hint" id="totalBuiltAreaHint">মোট এরিয়া: ২,০০০ sft</span>
        </label>
        <div class="floor-grid" id="floorsSelector" data-mcp-param="floors">
          <button type="button" class="floor-btn" data-floors="1">১ তলা</button>
          <button type="button" class="floor-btn active" data-floors="2">২ তলা</button>
          <button type="button" class="floor-btn" data-floors="3">৩ তলা</button>
          <button type="button" class="floor-btn" data-floors="4">৪ তলা</button>
          <button type="button" class="floor-btn" data-floors="5">৫ তলা</button>
        </div>
      </div>

      <!-- Input 3: Finish Quality -->
      <div class="form-group">
        <label class="form-label">
          <span>৩. ফিনিশিংয়ের মান ও ক্যাটাগরি</span>
          <span class="form-label-hint">উপাদান ও ফিটিংস নির্বাচন</span>
        </label>
        <div class="finish-grid" id="finishSelector" data-mcp-param="finishLevel">
          <!-- Economy -->
          <div class="finish-card" data-finish="economy">
            <div>
              <div class="finish-title">সাধারণ (Economy)</div>
              <div class="finish-desc">বাজেট-বান্ধব ফিনিশিং, দেশি ফিটিংস ও লোকাল সিরামিক টাইলস।</div>
            </div>
            <div class="finish-rate-tag" id="rateTagEconomy">~ ৳ ২,১০০ / sft</div>
          </div>
          <!-- Standard -->
          <div class="finish-card active" data-finish="standard">
            <span class="finish-badge-rec">জনপ্রিয়</span>
            <div>
              <div class="finish-title">স্ট্যান্ডার্ড (Standard)</div>
              <div class="finish-desc">ব্র্যান্ডেড রড-সিমেন্ট, আধুনিক টাইলস, মানসম্মত স্যানিটারি ও ওয়্যারিং।</div>
            </div>
            <div class="finish-rate-tag" id="rateTagStandard">~ ৳ ২,৬৫০ / sft</div>
          </div>
          <!-- Premium -->
          <div class="finish-card" data-finish="premium">
            <div>
              <div class="finish-title">প্রিমিয়াম (Premium)</div>
              <div class="finish-desc">সর্বোচ্চ ব্র্যান্ড রড-সিমেন্ট, ইম্পোর্টেড ফিটিংস, বড় টাইলস ও ফলস সিলিং।</div>
            </div>
            <div class="finish-rate-tag" id="rateTagPremium">~ ৳ ৩,৬০০ / sft</div>
          </div>
        </div>
      </div>

      <!-- Live Calculation Result Showcase -->
      <div class="result-showcase" id="resultContainer">
        <div style="text-align: center;">
          <span class="result-badge">📊 সনাতন নির্মাণ আনুমানিক খরচ রিপোর্ট</span>
        </div>

        <div class="result-grid-summary">
          <div class="result-summary-item">
            <div class="label">মোট নির্মিত আয়তন:</div>
            <div class="value" id="dispTotalArea">২,০০০ স্কয়ার ফিট</div>
          </div>
          <div class="result-summary-item">
            <div class="label">প্রতি স্কয়ার ফিট গড় খরচ:</div>
            <div class="value" id="dispRatePerSqft">৳ ২,৬৫০ / sft</div>
          </div>
        </div>

        <div class="result-total-box">
          <div class="result-total-label">সম্ভাব্য মোট সনাতন নির্মাণ বাজেট</div>
          <div class="result-total-taka" id="dispTotalCost">৳ ৫৩,০০,০০০</div>
          <div class="result-total-lakh" id="dispTotalLakh">৫৩.০০ লাখ টাকা</div>
          <div class="result-total-range" id="dispTotalRange">(সম্ভাব্য রেঞ্জ: ৳ ৫০,০০,০০০ – ৳ ৫৬,০০,০০০)</div>
        </div>

        <!-- Breakdown Section -->
        <div class="breakdown-section">
          <div class="breakdown-title">খরচের প্রধান ৩টি খাতের আনুমানিক বণ্টন:</div>
          
          <div class="breakdown-item">
            <div class="breakdown-meta">
              <span class="b-name">১. গ্রে স্ট্রাকচার (রড, সিমেন্ট, ইট, বালু, ঢালাই - ৬০%)</span>
              <span class="b-amt" id="dispStructCost">৳ ৩১,৮০,০০০</span>
            </div>
            <div class="breakdown-bar-bg">
              <div class="breakdown-bar-fill fill-struct" style="width: 60%;"></div>
            </div>
          </div>

