    // State Variables
    let currentFloorArea = 1000;
    let currentFloors = 2;
    let currentFinish = "standard";
    let activeAreaTier = "matched";
    let activeCategoryFilter = "all";
    let activeSearchQuery = "";
    let isExpandedView = false;

    // Number Converter to Bengali Digits
    function toBengaliDigits(num) {
      const bn = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
      return String(num).replace(/[0-9]/g, d => bn[+d]);
    }

    // Format BDT in Bangladeshi Number Grouping (e.g., 53,00,000)
    function formatBDT(amount) {
      const n = Math.round(amount);
      const str = n.toString();
      if (str.length <= 3) return '৳ ' + toBengaliDigits(str);
      const lastThree = str.substring(str.length - 3);
      const remaining = str.substring(0, str.length - 3);
      const formatted = remaining.replace(/\B(?=(\d{2})+(?!\d))/g, ",") + "," + lastThree;
      return '৳ ' + toBengaliDigits(formatted);
    }

    // Format Lakhs (e.g., ৫৩.০০ লাখ টাকা)
    function formatLakhs(amount) {
      const lakh = (amount / 100000).toFixed(2);
      return toBengaliDigits(lakh) + ' লাখ টাকা';
    }

    // Core Calculation Logic
    function recalculate() {
      const area = Math.max(200, parseInt(currentFloorArea) || 0);
      const floors = parseInt(currentFloors) || 1;
      const totalBuiltArea = area * floors;

      const ratePerSqft = RATES_TABLE[floors][currentFinish];
      const totalCost = totalBuiltArea * ratePerSqft;

      const lowRange = Math.round(totalCost * 0.94);
      const highRange = Math.round(totalCost * 1.07);

      // Cost Components Breakdown (60% Structure, 28% Finishing, 12% MEP)
      const structCost = Math.round(totalCost * 0.60);
      const finishCost = Math.round(totalCost * 0.28);
      const mepCost = Math.round(totalCost * 0.12);

      // Update UI Elements
      document.getElementById('totalBuiltAreaHint').textContent = 'মোট এরিয়া: ' + toBengaliDigits(totalBuiltArea.toLocaleString('en-US')) + ' sft';
      document.getElementById('dispTotalArea').textContent = toBengaliDigits(totalBuiltArea.toLocaleString('en-US')) + ' স্কয়ার ফিট';
      document.getElementById('dispRatePerSqft').textContent = '৳ ' + toBengaliDigits(ratePerSqft.toLocaleString('en-US')) + ' / sft';
      
      document.getElementById('dispTotalCost').textContent = formatBDT(totalCost);
      document.getElementById('dispTotalLakh').textContent = formatLakhs(totalCost);
      document.getElementById('dispTotalRange').textContent = 
        '(সম্ভাব্য রেঞ্জ: ' + formatBDT(lowRange) + ' – ' + formatBDT(highRange) + ')';

      document.getElementById('dispStructCost').textContent = formatBDT(structCost);
      document.getElementById('dispFinishCost').textContent = formatBDT(finishCost);
      document.getElementById('dispMepCost').textContent = formatBDT(mepCost);

      // Update Rate Tags on Finish Cards
      document.getElementById('rateTagEconomy').textContent = '~ ৳ ' + toBengaliDigits(RATES_TABLE[floors].economy.toLocaleString('en-US')) + ' / sft';
      document.getElementById('rateTagStandard').textContent = '~ ৳ ' + toBengaliDigits(RATES_TABLE[floors].standard.toLocaleString('en-US')) + ' / sft';
      document.getElementById('rateTagPremium').textContent = '~ ৳ ' + toBengaliDigits(RATES_TABLE[floors].premium.toLocaleString('en-US')) + ' / sft';

      // Update Bongshai Models Comparison dynamically based on area
      renderBongshaiModels();
    }

    // Render Bongshai Housing Models Based On Area & Filters
    function renderBongshaiModels() {
      const container = document.getElementById('modelsGridContainer');
      const bannerArea = document.getElementById('bannerSelectedArea');
      const bannerCount = document.getElementById('bannerMatchCount');
      const showMoreWrap = document.getElementById('showMoreWrap');
      const showMoreBtn = document.getElementById('showMoreBtn');

      bannerArea.textContent = toBengaliDigits(currentFloorArea.toLocaleString('en-US')) + ' sft';

      // 1. Filter by Area Tier
      let filtered = BONGSHAI_MODELS;

      if (activeAreaTier === "matched") {
        // Find models within +/- 200 sqft or sorted by closest area
        filtered = BONGSHAI_MODELS.filter(m => Math.abs(m.a - currentFloorArea) <= 200);
        if (filtered.length < 3) {
          // Fallback to closest 6 models if strict range has few results
          filtered = [...BONGSHAI_MODELS].sort((x, y) => Math.abs(x.a - currentFloorArea) - Math.abs(y.a - currentFloorArea)).slice(0, 8);
        }
      } else if (activeAreaTier === "240-550") {
        filtered = BONGSHAI_MODELS.filter(m => m.a >= 240 && m.a <= 550);
      } else if (activeAreaTier === "600-900") {
        filtered = BONGSHAI_MODELS.filter(m => m.a >= 600 && m.a <= 900);
      } else if (activeAreaTier === "1050-1400") {
        filtered = BONGSHAI_MODELS.filter(m => m.a >= 1050 && m.a <= 1400);
      } else if (activeAreaTier === "1600-1800") {
        filtered = BONGSHAI_MODELS.filter(m => m.a >= 1600 && m.a <= 1800);
      } else if (activeAreaTier === "2100-2500") {
        filtered = BONGSHAI_MODELS.filter(m => m.a >= 2100);
      }

      // 2. Filter by Category Dropdown
      if (activeCategoryFilter !== "all") {
        filtered = filtered.filter(m => m.c === activeCategoryFilter);
      }

      // 3. Filter by Search Query
      if (activeSearchQuery) {
        const q = activeSearchQuery.toLowerCase();
        filtered = filtered.filter(m => m.m.toLowerCase().includes(q) || m.c.toLowerCase().includes(q));
      }

      // Update Count
      bannerCount.textContent = 'মডেল সংখ্যা: ' + toBengaliDigits(filtered.length) + ' টি';

      if (filtered.length === 0) {
        container.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; padding: 30px; color: var(--text-muted);">' +
          'নির্বাচিত ফিল্টারে কোনো মডেল পাওয়া যায়নি। দয়া করে ক্যাটাগরি পরিবর্তন করুন বা "সকল মডেল" বেছে নিন।</div>';
        showMoreWrap.style.display = 'none';
        return;
      }

      // Pagination Limit (default 6 unless expanded)
      const limit = isExpandedView ? filtered.length : 6;
      const visibleModels = filtered.slice(0, limit);

      const ratePerSqft = RATES_TABLE[currentFloors][currentFinish];

      // Build Cards HTML
      container.innerHTML = visibleModels.map(m => {
        const catBn = CAT_NAMES_BN[m.c] || m.c;
        const areaBn = toBengaliDigits(m.a.toLocaleString('en-US'));
        const priceBn = formatBDT(m.p);
        const lakhBn = formatLakhs(m.p);
        const rateBn = toBengaliDigits(m.r.toLocaleString('en-US'));

        // Traditional cost estimate for the same area
        const tradCostForThisModel = m.a * ratePerSqft;
        const diff = tradCostForThisModel - m.p;

        let savingsHtml = '';
        if (diff > 50000) {
          const diffLakh = (diff / 100000).toFixed(1);
          savingsHtml = '<div class="model-savings-badge">💰 সনাতন নির্মাণের চেয়ে ~৳ ' + toBengaliDigits(diffLakh) + ' লাখ সাশ্রয়ী</div>';
        } else {
          savingsHtml = '<div class="model-savings-badge" style="color:var(--blue-accent); background:rgba(56,189,248,0.12); border-color:rgba(56,189,248,0.25);">🛡️ নির্দিষ্ট ফিক্সড বাজেট (জিরো ওভাররান)</div>';
        }

        const isExactMatch = (m.a === currentFloorArea);
        const matchedClass = isExactMatch ? 'matched' : '';

        return '<div class="model-card ' + matchedClass + '">' +
          '<div>' +
            '<div class="model-top">' +
              '<div class="model-number">' + m.m + '</div>' +
              '<div class="model-category-tag">' + catBn + '</div>' +
            '</div>' +
            '<div class="model-area-line">আয়তন: ' + areaBn + ' স্কয়ার ফিট</div>' +
            '<div class="model-rooms">🛏️ ' + m.b + ' • 🚿 ' + m.ba + '</div>' +
            '<div class="model-price-box">' +
              '<div class="model-price-label">নির্ধারিত প্যাকেজ মূল্য (ফিক্সড)</div>' +
              '<div class="model-price-val">' + priceBn + '</div>' +
              '<div class="model-rate-info">(' + lakhBn + ' • প্রতি sft মাত্র ৳' + rateBn + ')</div>' +
            '</div>' +
            savingsHtml +
            '<div class="model-delivery">⏱️ ডেলিভারি ও হ্যান্ডওভার: ' + m.d + '</div>' +
          '</div>' +
          '<button type="button" class="model-select-btn" onclick="selectModel(\'' + m.m + '\', ' + m.a + ', \'' + catBn + '\', \'' + priceBn + '\')">এই মডেল নির্বাচন করুন ➔</button>' +
        '</div>';
      }).join('');

      // Show/Hide Show More Button
      if (filtered.length > 6) {
        showMoreWrap.style.display = 'block';
        showMoreBtn.textContent = isExpandedView ? 
          'সংক্ষিপ্ত আকারে দেখুন ▴' : 
          'আরও মডেল দেখুন (বাকি ' + toBengaliDigits(filtered.length - 6) + ' টি) ▾';
      } else {
        showMoreWrap.style.display = 'none';
      }
    }

    // Select Model & Pre-fill Lead Form
    function selectModel(modelNo, area, cat, price) {
      const notesInput = document.getElementById('leadNotes');
      notesInput.value = 'আমি ' + modelNo + ' (' + cat + ', ' + area + ' sft, মূল্য: ' + price + ') মডেলটি সম্পর্কে বিস্তারিত ড্রয়িং ও অফার জানতে আগ্রহী।';
      
      const leadBlock = document.getElementById('leadCapture');
      leadBlock.scrollIntoView({ behavior: 'smooth' });
      
      // Flash the lead card to draw user focus
      leadBlock.style.borderColor = 'var(--gold-accent)';
      leadBlock.style.boxShadow = '0 0 28px var(--gold-glow)';
      setTimeout(() => {
        leadBlock.style.borderColor = 'rgba(253, 224, 71, 0.35)';
        leadBlock.style.boxShadow = '0 10px 32px rgba(0,0,0,0.4)';
      }, 1500);

      document.getElementById('leadName').focus();
    }

    // Form Submission & WhatsApp Link Generator

    // Also file the lead through the site's real intake endpoint so it lands
    // in the leads table + Telegram alert + sales email, exactly like the
    // main contact form - WhatsApp alone leaves no record if the visitor
    // never actually sends the pre-filled message.
    function postLeadToCrm(payload) {
      try {
        return fetch('/send_email.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        }).catch(function () { /* never block the WhatsApp handoff on this */ });
      } catch (e) { /* no-op */ }
    }

    function handleLeadSubmit(event) {
      event.preventDefault();
      const name = document.getElementById('leadName').value.trim();
      const phone = document.getElementById('leadPhone').value.trim();
      const district = document.getElementById('districtSelect').value;
      const upazila = document.getElementById('upazilaSelect').value;
      const notes = document.getElementById('leadNotes').value.trim();

      const totalArea = currentFloorArea * currentFloors;
      const rate = RATES_TABLE[currentFloors][currentFinish];
      const totalCost = totalArea * rate;
      const lakhText = (totalCost / 100000).toFixed(2) + ' লাখ টাকা';

      const finishNames = {
        economy: 'সাধারণ (Economy)',
        standard: 'স্ট্যান্ডার্ড (Standard)',
        premium: 'প্রিমিয়াম (Premium)'
      };

      let message = `*বাড়ি নির্মাণ খরচের হিসাব সংক্রান্ত অনুসন্ধান*\n` +
        `------------------------------------\n` +
        `👤 নাম: ${name}\n` +
        `📱 ফোন: ${phone}\n` +
        `📍 অবস্থান: ${upazila}, ${district}\n` +
        `📐 প্রতি তলার আয়তন: ${currentFloorArea} স্কয়ার ফিট\n` +
        `🏢 তলা সংখ্যা: ${currentFloors} তলা (মোট ${totalArea} sft)\n` +
        `✨ ফিনিশিং মান: ${finishNames[currentFinish]}\n` +
        `💰 আনুমানিক সনাতন খরচ: ৳ ${totalCost.toLocaleString('en-US')} (${lakhText})\n`;

      if (notes) {
        message += `🏠 নির্বাচিত মডেল / মন্তব্য: ${notes}\n`;
      }
      message += `------------------------------------\n` +
        `আমি বিস্তারিত ড্রয়িং ও বংশাই হাউজিং-এর ফিক্সড বাজেটের সমাধান পেতে চাই।`;

      // Redirect to WhatsApp with prefilled text
      postLeadToCrm({
        name: name,
        phone: phone,
        country_code: '+880',
        district: district,
        upazila: upazila,
        model: 'নির্মাণ খরচ ক্যালকুলেটর',
        floor_area: String(currentFloorArea * currentFloors),
        message: message,
        source: 'calculator'
      });

      const waUrl = `https://wa.me/8801781636613?text=${encodeURIComponent(message)}`;
      window.open(waUrl, '_blank');
    }

    // DOM Ready & Event Listeners
    document.addEventListener('DOMContentLoaded', function() {
      const areaInput = document.getElementById('floorAreaInput');
      const areaChips = document.querySelectorAll('#areaChips .preset-chip');
      const floorBtns = document.querySelectorAll('#floorsSelector .floor-btn');
      const finishCards = document.querySelectorAll('#finishSelector .finish-card');
      const districtSelect = document.getElementById('districtSelect');
      const upazilaSelect = document.getElementById('upazilaSelect');
      const tierTabBtns = document.querySelectorAll('#areaTierTabs .tier-tab-btn');
      const categoryFilter = document.getElementById('modelCategoryFilter');
      const searchInput = document.getElementById('modelSearchInput');
      const showMoreBtn = document.getElementById('showMoreBtn');

      // Populate 64 Districts
      const districtNames = Object.keys(BD_GEO).sort();
      districtNames.forEach(d => {
        const opt = document.createElement('option');
        opt.value = d;
        opt.textContent = d;
        districtSelect.appendChild(opt);
      });

      // District -> Upazila Cascade
      districtSelect.addEventListener('change', function() {
        const selected = this.value;
        const upazilas = BD_GEO[selected] || [];
        upazilaSelect.innerHTML = '<option value="" disabled selected>উপজেলা বেছে নিন</option>';
        upazilas.forEach(u => {
          const opt = document.createElement('option');
          opt.value = u;
          opt.textContent = u;
          upazilaSelect.appendChild(opt);
        });
        upazilaSelect.disabled = false;
      });

      // Area Input Handler
      areaInput.addEventListener('input', function() {
        currentFloorArea = parseInt(this.value) || 0;
        areaChips.forEach(c => c.classList.remove('active'));
        recalculate();
      });

      // Area Preset Chips
      areaChips.forEach(chip => {
        chip.addEventListener('click', function() {
          areaChips.forEach(c => c.classList.remove('active'));
          this.classList.add('active');
          currentFloorArea = parseInt(this.getAttribute('data-val'));
          areaInput.value = currentFloorArea;
          recalculate();
        });
      });

      // Floor Buttons
      floorBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          floorBtns.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          currentFloors = parseInt(this.getAttribute('data-floors'));
          recalculate();
        });
      });

      // Finish Quality Cards
      finishCards.forEach(card => {
        card.addEventListener('click', function() {
          finishCards.forEach(c => c.classList.remove('active'));
          this.classList.add('active');
          currentFinish = this.getAttribute('data-finish');
          recalculate();
        });
      });

      // Area Tier Filter Tabs
      tierTabBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          tierTabBtns.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          activeAreaTier = this.getAttribute('data-tier');
          isExpandedView = false;
          renderBongshaiModels();
        });
      });

      // Category Dropdown Filter
      categoryFilter.addEventListener('change', function() {
        activeCategoryFilter = this.value;
        isExpandedView = false;
        renderBongshaiModels();
      });

      // Model Search Input
      searchInput.addEventListener('input', function() {
        activeSearchQuery = this.value.trim();
        isExpandedView = false;
        renderBongshaiModels();
      });

      // Show More Button Toggle
      showMoreBtn.addEventListener('click', function() {
        isExpandedView = !isExpandedView;
        renderBongshaiModels();
      });

      // Initial calculation run
      recalculate();
    });
  </script>
{% endblock %}
