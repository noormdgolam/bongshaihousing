{% block content %}
    <section class="page-hero" aria-labelledby="career-page-title">
      <div class="container page-hero-content">
        <span class="page-hero-label">Join Our Team</span>
        <h1 class="page-hero-title" data-aos="fade-up" id="career-page-title">Build Your Career at<br>Bongshai Housing</h1>
        <p class="page-hero-text">Join Bangladesh's premier housing company and be part of a team that builds dreams. We offer exciting opportunities for skilled professionals across construction, engineering, and management.</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a><span>/</span><span aria-current="page">Career</span>
        </nav>
      </div>
    </section>

    <section class="section" style="padding: 2rem 0; background: var(--off-white);">
      <div class="container">
        <p><strong>Bongshai Housing is currently hiring skilled professionals for engineering, project management, and construction roles in Bangladesh. Join our fast-growing EPC team to build world-class prefab and steel buildings with industry-leading compensation.</strong></p>
        <div class="trust-signals" style="font-size: 0.9rem; color: var(--grey-600); margin-top: 1rem;">
          By <strong>Bongshai Housing HR Department</strong> | Expert EPC Contractors | Last Updated: <time datetime="2026-08-08">August 8, 2026</time>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="why-join-title">
      <div class="container">
        <div class="section-header reveal">
          <div class="section-label">Why Join Us</div>
          <h2 class="section-title" data-aos="fade-up" id="why-join-title">Why Be Part of Something Extraordinary?</h2>
          <p class="section-subtitle">At Bongshai Housing, we invest in our people — because our team is the foundation of our success.</p>
        </div>
        <div class="why-grid stagger">
          <div class="why-card reveal" style="--i:0"><div class="why-icon" aria-hidden="true">📈</div><h3 class="why-title">What is our Career Growth path?</h3><p class="why-text">Clear career progression paths with regular performance reviews, training programs, and promotion opportunities.</p></div>
          <div class="why-card reveal" style="--i:1"><div class="why-icon" aria-hidden="true">🎓</div><h3 class="why-title">How do we support Learning &amp; Development?</h3><p class="why-text">Access to training programs, workshops, and professional development resources to keep your skills cutting-edge.</p></div>
          <div class="why-card reveal" style="--i:2"><div class="why-icon" aria-hidden="true">🌍</div><h3 class="why-title">How do we maintain International Standards?</h3><p class="why-text">Work on projects that meet international quality and safety standards — gaining globally recognized experience.</p></div>
          <div class="why-card reveal" style="--i:3"><div class="why-icon" aria-hidden="true">💼</div><h3 class="why-title">What is our Competitive Compensation?</h3><p class="why-text">Market-competitive salaries, performance bonuses, and benefits packages that reward your hard work and talent.</p></div>
          <div class="why-card reveal" style="--i:4"><div class="why-icon" aria-hidden="true">🤝</div><h3 class="why-title">What is our Collaborative Culture?</h3><p class="why-text">A team-first environment where your ideas are valued, your contributions recognized, and your wellbeing prioritized.</p></div>
          <div class="why-card reveal" style="--i:5"><div class="why-icon" aria-hidden="true">🏗️</div><h3 class="why-title">How do we ensure Meaningful Work?</h3><p class="why-text">Help build homes and futures for families across Bangladesh — work that makes a real, lasting difference in people's lives.</p></div>
        </div>
      </div>
    </section>

    <section class="section" style="background:var(--off-white)" aria-labelledby="jobs-title">
      <div class="container">
        <div class="section-header reveal">
          <div class="section-label">Open Positions</div>
          <h2 class="section-title" data-aos="fade-up" id="jobs-title">What are our Current Job Openings?</h2>
          <p class="section-subtitle">We're always looking for talented, passionate individuals to join our growing team. See below for current vacancies.</p>
        </div>

        <div class="career-grid">
          <div class="job-list reveal-left stagger" role="list">
            <div class="job-item" style="--i:0" role="listitem">
              <div><div class="job-title">Deputy General Manager (DGM)</div><span class="job-dept">Senior Management</span></div>
              <a href="#apply" class="job-arrow" aria-label="Apply for DGM position">→</a>
            </div>
            <div class="job-item" style="--i:1" role="listitem">
              <div><div class="job-title">Project Manager</div><span class="job-dept">Project Management</span></div>
              <a href="#apply" class="job-arrow" aria-label="Apply for Project Manager position">→</a>
            </div>
            <div class="job-item" style="--i:2" role="listitem">
              <div><div class="job-title">Architect</div><span class="job-dept">Design &amp; Architecture</span></div>
              <a href="#apply" class="job-arrow" aria-label="Apply for Architect position">→</a>
            </div>
            <div class="job-item" style="--i:3" role="listitem">
              <div><div class="job-title">Executive – Marketing &amp; Sales</div><span class="job-dept">Marketing &amp; Sales</span></div>
              <a href="#apply" class="job-arrow" aria-label="Apply for Marketing and Sales position">→</a>
            </div>
            <div class="job-item" style="--i:4" role="listitem">
              <div><div class="job-title">Quality Control (QC) Engineer</div><span class="job-dept">Civil / Architecture</span></div>
              <a href="#apply" class="job-arrow" aria-label="Apply for QC Engineer position">→</a>
            </div>
            <div class="job-item" style="--i:5" role="listitem">
              <div><div class="job-title">Tender Executive (Tenderer)</div><span class="job-dept">Business Development</span></div>
              <a href="#apply" class="job-arrow" aria-label="Apply for Tender Executive position">→</a>
            </div>
            <div class="job-item" style="--i:6" role="listitem">
              <div><div class="job-title">Site Engineer</div><span class="job-dept">Civil Engineering</span></div>
              <a href="#apply" class="job-arrow" aria-label="Apply for Site Engineer position">→</a>
            </div>
            <div class="job-item" style="--i:7" role="listitem">
              <div><div class="job-title">Foreman (Civil Construction)</div><span class="job-dept">Site Operations</span></div>
              <a href="#apply" class="job-arrow" aria-label="Apply for Foreman position">→</a>
            </div>
          </div>

          <div class="contact-form-wrap reveal-right" id="apply">
            <div class="section-label">Apply Now</div>
            <h2 class="form-title" style="margin-bottom:var(--space-2)">How can you Submit Your Application?</h2>
            <p class="form-subtitle" style="color:var(--grey-600);margin-bottom:var(--space-6)">Fill in the form below and attach your CV. Our HR team will review your application and contact you within 3–5 business days.</p>

            <form id="careerForm" novalidate aria-label="Job application form" enctype="multipart/form-data" data-mcp-action="submit_application">
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" for="c-fname">First Name *</label>
                  <input type="text" id="c-fname" name="fname" class="form-control" placeholder="First name" required autocomplete="given-name" data-mcp-param="first_name" />
                </div>
                <div class="form-group">
                  <label class="form-label" for="c-lname">Last Name *</label>
                  <input type="text" id="c-lname" name="lname" class="form-control" placeholder="Last name" required autocomplete="family-name" data-mcp-param="last_name" />
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="c-email">Email Address *</label>
                <input type="email" id="c-email" name="email" class="form-control" placeholder="your@email.com" required autocomplete="email" data-mcp-param="email" />
              </div>
              <div class="form-group">
                <label class="form-label" for="c-phone">Phone / WhatsApp *</label>
                <input type="tel" id="c-phone" name="phone" class="form-control" placeholder="01XXXXXXXXX" required autocomplete="tel" data-mcp-param="phone" />
              </div>
              <div class="form-group">
                <label class="form-label" for="c-position">Position Applied For *</label>
                <select id="c-position" name="position" class="form-control" required data-mcp-param="position">
                  <option value="">Select a position…</option>
                  <option value="dgm">Deputy General Manager (DGM)</option>
                  <option value="pm">Project Manager</option>
                  <option value="architect">Architect</option>
                  <option value="marketing">Executive – Marketing &amp; Sales</option>
                  <option value="qc">Quality Control (QC) Engineer</option>
                  <option value="tender">Tender Executive</option>
                  <option value="site-eng">Site Engineer</option>
                  <option value="foreman">Foreman (Civil Construction)</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" for="c-experience">Years of Experience *</label>
                <select id="c-experience" name="experience" class="form-control" required data-mcp-param="experience">
                  <option value="">Select experience…</option>
                  <option value="0-2">0–2 Years (Fresh Graduate)</option>
                  <option value="2-5">2–5 Years</option>
                  <option value="5-10">5–10 Years</option>
                  <option value="10+">10+ Years</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" for="c-cover">Cover Letter / Why Join Us?</label>
                <textarea id="c-cover" name="cover" class="form-control" placeholder="Tell us about your experience, skills, and why you want to join Bongshai Housing…" rows="4" data-mcp-param="cover_letter"></textarea>
              </div>
              <div class="form-group">
                <label class="form-label" for="c-cv">Upload CV (PDF Only) *</label>
                <input type="file" id="c-cv" name="cv" class="form-control" accept="application/pdf" required style="padding: 10px;" data-mcp-param="cv_file" />
              </div>
              <button type="submit" class="btn btn-primary btn-lg" style="width:100%;justify-content:center;" id="career-submit-btn">
                Submit Application
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </button>
              <div id="careerSuccess" style="display:none;margin-top:var(--space-4);padding:var(--space-4);background:rgba(5,150,105,0.1);border:1px solid var(--success);border-radius:var(--radius-xl);color:var(--success);font-weight:600;text-align:center" role="alert">
                ✅ Application submitted! Our HR team will contact you within 3–5 business days.
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <section class="section cta-section" aria-labelledby="career-cta-title">
      <div class="container cta-inner">
        <h2 class="cta-title" id="career-cta-title">Don't See the Right Role?</h2>
        <p class="cta-text">We're always open to exceptional talent. Send us your CV and tell us how you can contribute to Bongshai Housing's mission.</p>
        <div class="cta-actions">
          <a href="mailto:sales@bongshai.com?subject=Career Inquiry" class="btn btn-white btn-lg" id="career-email-btn">✉️ Email Your CV</a>
          <a href="https://wa.me/8801781636613?text=Hello%2C%20I%20am%20interested%20in%20joining%20Bongshai%20Housing%20team." class="btn btn-outline btn-lg" target="_blank" rel="noopener noreferrer">💬 WhatsApp HR</a>
        </div>
      </div>
    </section>
{% endblock %}

{% block scripts_extra %}
<script>
  document.getElementById('careerForm').addEventListener('submit', function(e) {
    e.preventDefault();
    if (!this.checkValidity()) { this.reportValidity(); return; }

    const btn = document.getElementById('career-submit-btn');
    const originalText = btn.innerHTML;
    btn.textContent = 'Submitting…';
    btn.disabled = true;

    const formData = new FormData(this);
    fetch('apply_career.php', { method: 'POST', body: formData })
      .then(response => response.ok ? response.json() : response.json().then(err => { throw err; }))
      .then(data => {
        const successDiv = document.getElementById('careerSuccess');
        successDiv.style.display = 'block';
        if (data.status === 'success') {
          successDiv.textContent = '✅ Application submitted successfully! Our HR team will contact you within 3–5 business days.';
          successDiv.style.color = 'var(--success)';
          successDiv.style.borderColor = 'var(--success)';
          successDiv.style.backgroundColor = 'rgba(5,150,105,0.1)';
          this.reset();
        } else {
          successDiv.textContent = '❌ Error: ' + (data.message || 'Submission failed.');
          successDiv.style.color = '#ef4444';
          successDiv.style.borderColor = '#ef4444';
          successDiv.style.backgroundColor = 'rgba(239,68,68,0.1)';
        }
      })
      .catch(err => {
        const successDiv = document.getElementById('careerSuccess');
        successDiv.style.display = 'block';
        successDiv.textContent = '❌ Error: ' + (err.message || 'Submission failed.');
        successDiv.style.color = '#ef4444';
        successDiv.style.borderColor = '#ef4444';
        successDiv.style.backgroundColor = 'rgba(239,68,68,0.1)';
      })
      .finally(() => { btn.innerHTML = originalText; btn.disabled = false; });
  });
</script>
{% endblock %}
