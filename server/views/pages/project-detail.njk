{% extends "layout.njk" %}
{% block head_extra %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Bongshai Housing Project: {{ project.title }}",
  "description": "Completed steel building construction project by Bongshai Housing Ltd. Founded 2008.",
  "dateModified": "{{ project.updated_at }}",
  "author": {
    "@type": "Organization",
    "@id": "https://bongshaihousing.com/#organization",
    "name": "Bongshai Housing Ltd.",
    "foundingDate": "2008"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Bongshai Housing Ltd.",
    "logo": {"@type": "ImageObject", "url": "https://bongshaihousing.com/images/logo.png"}
  },
  "mainEntityOfPage": {"@type": "WebPage", "@id": "{{ canonical }}"}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://bongshaihousing.com/"},
    {"@type": "ListItem", "position": 2, "name": "Our Projects", "item": "https://bongshaihousing.com/projects.html"},
    {"@type": "ListItem", "position": 3, "name": "{{ project.title }}", "item": "{{ canonical }}"}
  ]
}
</script>
{% endblock %}

{% block content %}
<section class="page-hero" aria-labelledby="page-title">
      <div class="container page-hero-content">
        <h1 class="page-hero-title" data-aos="fade-up" id="page-title">{{ project.title }}</h1>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <a href="projects.html">Projects</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ project.title }}</span>
        </nav>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div style="display: flex; flex-wrap: wrap; gap: var(--space-6); align-items: flex-start;">
            <div style="flex: 1 1 500px; background: white; border-radius: 16px; overflow: hidden; box-shadow: var(--shadow-md); border: 1px solid var(--grey-100);">
                <img src="{{ project.image or 'images/logo-icon-512.webp' }}" alt="Completed {{ project.title }} project" title="{{ project.title }}" style="width: 100%; height: auto; display: block;" loading="lazy" width="1000" height="750">
            </div>
            <div style="flex: 1 1 400px; background: white; padding: var(--space-6); border-radius: 16px; box-shadow: var(--shadow-sm); border: 1px solid var(--grey-100);">
                <span class="property-type" style="display: inline-block; background: rgba(212, 175, 55, 0.15); color: var(--accent-dark); padding: 4px 12px; border-radius: 20px; font-weight: 700; font-size: 0.8rem; margin-bottom: 16px;">{{ project.status_label or "Completed Project" }}</span>
                <h2 style="font-family: var(--font-heading); font-size: 2rem; color: var(--primary); margin-bottom: var(--space-4);">{{ project.title }}</h2>
                {% if project.location %}
                <p style="color: var(--grey-500); font-size: 0.9rem; margin-bottom: var(--space-4);">📍 {{ project.location }}</p>
                {% endif %}
                <div style="color: var(--grey-700); font-size: 1rem; line-height: 1.6; margin-bottom: var(--space-6);">
                    <p>{{ project.description }}</p>
                </div>
                <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--grey-100);">
                    <a href="contact.html" class="btn btn-primary btn-lg" style="width: 100%; justify-content: center;">Request Similar Project</a>
                    <a href="https://wa.me/8801781636613" target="_blank" rel="noopener noreferrer" class="btn btn-lg" style="width: 100%; justify-content: center; background: #25D366; color: white; border: none; font-weight: 700;">💬 Discuss on WhatsApp</a>
                </div>
            </div>
        </div>
      </div>
    </section>
{% endblock %}

{% block scripts_extra %}
{% endblock %}
