{% block content %}
<section class="page-hero" style="background: linear-gradient(135deg, #2c3e50, #3498db);" aria-labelledby="page-title">
      <div class="container page-hero-content">
        <div style="font-size:4rem; margin-bottom:10px;">🧪</div>
        <h1 class="page-hero-title" data-aos="fade-up" id="page-title">Advanced Material Testing Laboratory</h1>
        <p class="page-hero-text">Scientific Validation for Ultimate Structural Integrity</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <a href="certifications.html">Certifications &amp; Quality</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Advanced Material Testing Laboratory</span>
        </nav>
      </div>
    </section>

    <section class="section" aria-labelledby="content-title">
      <div class="container">
        
            <div class="about-grid">
              <div class="reveal-left" style="display:flex; flex-direction:column; gap:20px;">
                <div style="width:100%; height:400px; border-radius:12px; box-shadow:var(--shadow-xl); background:linear-gradient(135deg, #2c3e50, #bdc3c7); display:flex; align-items:center; justify-content:center; flex-direction:column;">
                  <span style="font-size:6rem; margin-bottom:20px;">🔬</span>
                  <div style="color:white; font-size:1.8rem; font-weight:700;">Lab-Tested Integrity</div>
                </div>
              </div>
              <div class="about-content reveal-right">
                <h2 id="content-title">Rigorous Material Validation</h2>
                <p style="margin-bottom:var(--space-4)">We do not rely on supplier promises. Bongshai Housing mandates a rigorous <strong>3-Stage Material Testing Protocol</strong> for every single project. From the tensile strength of our pre-engineered steel to the compressive strength of our concrete foundations, everything is scientifically validated.</p>
                <p style="margin-bottom:var(--space-4)">Our testing includes: <em>Yield Strength Testing, Non-Destructive Testing (NDT) on welds, Ultrasonic Testing, and Environmental Weather Resistance simulations.</em></p>
                
                <h3 style="font-size:1.5rem; color:var(--primary); margin-top:var(--space-6); margin-bottom:var(--space-3)">Direct Benefits to Our Clients:</h3>
                <ul style="list-style-type: disc; margin-left:var(--space-4); color:var(--grey-800); font-size:1.05rem; line-height:1.8; margin-bottom:var(--space-6);">
                    <li><strong>Absolute Structural Integrity:</strong> 100% confidence that your building can withstand earthquakes, cyclones, and heavy loads.</li>
                    <li><strong>Lifetime Durability:</strong> Lab-tested anti-corrosion treatments ensure your steel structures last for generations without degradation.</li>
                    <li><strong>Peace of Mind:</strong> We provide full Material Test Certificates (MTC) for all structural components upon project completion.</li>
                </ul>

                <a href="contact.html" class="btn btn-primary">View Technical Specifications</a>
              </div>
            </div>
        
      </div>
    </section>
{% endblock %}
