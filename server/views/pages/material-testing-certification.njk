{% block content %}
<section class="page-hero" style="background: linear-gradient(135deg, #2c3e50, #3498db);" aria-labelledby="page-title">
      <div class="container page-hero-content">
        <div style="font-size:4rem; margin-bottom:10px;">🧪</div>
        <h1 class="page-hero-title" data-aos="fade-up" id="page-title">Material Quality Standards</h1>
        <p class="page-hero-text">Component Quality for Structural Integrity</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <a href="certifications.html">Certifications &amp; Quality</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Material Quality Standards</span>
        </nav>
      </div>
    </section>

    <section class="section" aria-labelledby="content-title">
      <div class="container">
        
            <div class="about-grid">
              <div class="reveal-left" style="display:flex; flex-direction:column; gap:20px;">
                <div style="width:100%; height:400px; border-radius:12px; box-shadow:var(--shadow-xl); background:linear-gradient(135deg, #2c3e50, #bdc3c7); display:flex; align-items:center; justify-content:center; flex-direction:column;">
                  <span style="font-size:6rem; margin-bottom:20px;">🔬</span>
                  <div style="color:white; font-size:1.8rem; font-weight:700;">Built to Spec</div>
                </div>
              </div>
              <div class="about-content reveal-right">
                <h2 id="content-title">Material Quality Standards</h2>
                <p style="margin-bottom:var(--space-4)">Bongshai Housing selects structural steel, concrete, and panel components to meet BNBC 2020 (Bangladesh National Building Code) and AISC material specifications for every project — covering the tensile strength of pre-engineered steel and the compressive strength of concrete foundations.</p>
                <p style="margin-bottom:var(--space-4)">Component specifications are checked against BNBC 2020 and AISC standards, including weld quality and weather-resistance requirements for the local climate.</p>

                <h3 style="font-size:1.5rem; color:var(--primary); margin-top:var(--space-6); margin-bottom:var(--space-3)">Direct Benefits to Our Clients:</h3>
                <ul style="list-style-type: disc; margin-left:var(--space-4); color:var(--grey-800); font-size:1.05rem; line-height:1.8; margin-bottom:var(--space-6);">
                    <li><strong>Structural Integrity:</strong> Built to withstand earthquakes, cyclones, and heavy loads per BNBC 2020 seismic and wind-load standards.</li>
                    <li><strong>Durability:</strong> Anti-corrosion treatments help steel structures resist degradation over time.</li>
                    <li><strong>Documentation:</strong> Material specifications and sourcing details are available on request for structural components.</li>
                </ul>

                <a href="contact.html" class="btn btn-primary">View Technical Specifications</a>
              </div>
            </div>
        
      </div>
    </section>
{% endblock %}

