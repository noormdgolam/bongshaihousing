    {
      "@type": "Question",
      "name": "Does Bongshai Housing hold ISO 9001 certification?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Bongshai Housing does not hold ISO 9001 or OHSAS 18001 certification. Construction practices follow BNBC 2020 (Bangladesh National Building Code) and AISC structural design codes, with quality-control checks applied at every stage of the build."
      }
    },
    {
      "@type": "Question",
      "name": "What quality standards does Bongshai Housing follow?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bongshai Housing follows BNBC 2020 (Bangladesh National Building Code) for seismic and wind-load structural compliance, and AISC structural design codes for steel framing, with quality-control checks applied at every stage of construction."
      }
    },
    {
      "@type": "Question",
      "name": "Does Bongshai Housing check materials before using them in construction?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bongshai Housing applies quality checks to structural steel, concrete, and panel components before they are used in construction."
      }
    }
  ]
}
