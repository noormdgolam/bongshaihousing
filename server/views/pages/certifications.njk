{% block content %}
<section class="page-hero" aria-labelledby="page-title">
      <div class="container page-hero-content">
        <h1 class="page-hero-title" data-aos="fade-up" id="page-title">Certifications &amp; Quality</h1>
        <p class="page-hero-text">International standards for safety, reliability, and material quality.</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Certifications &amp; Quality</span>
        </nav>
      </div>
    </section>
    
    <!-- AEO: Answer-First Opening & Explicit Trust Signal -->
    <section class="section" style="padding: 2rem 0; background: var(--off-white);">
      <div class="container">
        <p><strong>Bongshai Housing strictly adheres to BNBC 2020 and AISC structural design codes for all construction and quality control. We guarantee the structural integrity and quality of every steel and prefab building we deliver.</strong></p>
        <div class="trust-signals" style="font-size: 0.9rem; color: var(--grey-600); margin-top: 1rem;">
          By <strong>Bongshai Housing Quality Control Team</strong> | Expert EPC Contractors | Last Updated: <time datetime="2026-08-08">August 8, 2026</time>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="content-title">
      <div class="container">
        
        <div class="about-grid" style="grid-template-columns: 1fr;">
          <div class="about-content reveal visible">
            <div class="section-label">Quality First</div>
            <h2 id="content-title">Our Commitment to Excellence</h2>
            <p style="margin-bottom:var(--space-4)">At Bongshai Housing, quality control is rigorous. We are committed to adhering to BNBC 2020 and AISC structural design codes for all our pre-engineered steel buildings, ensuring maximum safety, durability, and compliance.</p>

            <div class="why-grid stagger">
              <div class="why-card reveal visible" style="--i:0">
                <div class="why-icon" aria-hidden="true">🏆</div>
                <h3 class="why-title">What structural design codes do we follow?</h3>
                <p class="why-text">Our manufacturing and construction processes follow BNBC 2020 and AISC structural design standards.</p>
                <a href="iso-9001-certification.html" class="btn btn-secondary" style="margin-top:var(--space-3); width:100%; justify-content:center;">Read Full Details</a>
              </div>
              <div class="why-card reveal visible" style="--i:1">
                <div class="why-icon" aria-hidden="true">🛡️</div>
                <h3 class="why-title">How do we prioritize site safety?</h3>
                <p class="why-text">Occupational health and safety practices are enforced on every construction site.</p>
                <a href="ohsas-safety-certification.html" class="btn btn-secondary" style="margin-top:var(--space-3); width:100%; justify-content:center;">Read Full Details</a>
              </div>
              <div class="why-card reveal visible" style="--i:2">
                <div class="why-icon" aria-hidden="true">🧪</div>
                <h3 class="why-title">How do we check material quality?</h3>
                <p class="why-text">Steel, concrete, and panel materials are quality-checked before use in construction.</p>
                <a href="material-testing-certification.html" class="btn btn-secondary" style="margin-top:var(--space-3); width:100%; justify-content:center;">Read Full Details</a>
              </div>
            </div>

          </div>
        </div>
        </div>

    </section>
{% endblock %}

