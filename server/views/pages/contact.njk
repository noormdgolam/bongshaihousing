{% block content %}
<!-- PAGE HERO -->
    <section class="page-hero" aria-labelledby="contact-page-title">
      <div class="container page-hero-content">
        <span class="page-hero-label">Get In Touch</span>
        <h1 class="page-hero-title" data-aos="fade-up" id="contact-page-title">Contact Bongshai Housing</h1>
        <p class="page-hero-text">Ready to start your housing project? Reach out for a free consultation. Our team is ready to help Saturday to Thursday, 9 AM – 7 PM.</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Contact Us</span>
        </nav>
      </div>
    </section>

    <!-- AEO: Answer-First Opening & Explicit Trust Signal -->
    <section class="section" style="padding: 2rem 0; background: var(--off-white);">
      <div class="container">
        <p><strong>Bongshai Housing provides dedicated support and consultation for all your prefab and steel building needs across Bangladesh. Contact us today for a free quote, structural assessment, or general inquiries.</strong></p>
        <div class="trust-signals" style="font-size: 0.9rem; color: var(--grey-600); margin-top: 1rem;">
          By <strong>Bongshai Housing Client Service Team</strong> | Expert EPC Contractors | Last Updated: <time datetime="2026-08-08">August 8, 2026</time>
        </div>
      </div>
    </section>

