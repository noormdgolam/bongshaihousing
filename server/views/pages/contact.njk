  <script src="js/division-districts.js?v=1"></script>
  <script>
    initDivisionCascade('division', 'district');

    // Floor-area tiers verified against each model's own product page
    const areaMapping = {
      'DEFAULT': ['Select Floor Area'],
      'TH': ['250-350 Sq.Ft'],
      'WH': ['400 Sq.Ft', '600 Sq.Ft', '750 Sq.Ft', '900 Sq.Ft', '1050 Sq.Ft', '1200 Sq.Ft'],
      'TSB': ['600 Sq.Ft', '850 Sq.Ft'],
      'DV': ['600 Sq.Ft', '850 Sq.Ft'],
      'DVP': ['650x2 Sq.Ft', '750x2 Sq.Ft', '950x2 Sq.Ft', '1200x2 Sq.Ft'],
      'LCV': ['440 Sq.Ft', '550 Sq.Ft', '750 Sq.Ft', '950 Sq.Ft', '1200 Sq.Ft', '1500 Sq.Ft'],
      'SB': ['400 Sq.Ft', '600 Sq.Ft', '750 Sq.Ft', '900 Sq.Ft', '1050 Sq.Ft', '1200 Sq.Ft'],
      'CH': ['400 Sq.Ft', '600 Sq.Ft', '750 Sq.Ft', '900 Sq.Ft', '1050 Sq.Ft', '1200 Sq.Ft'],
      'SH': ['650x2 Sq.Ft', '750x2 Sq.Ft', '950x2 Sq.Ft', '1200x2 Sq.Ft'],
      'CB': ['400 Sq.Ft', '600 Sq.Ft', '750 Sq.Ft', '900 Sq.Ft', '1050 Sq.Ft', '1200 Sq.Ft'],
      'IS': ['2000 Sq.Ft', '3000 Sq.Ft', '4000 Sq.Ft', 'Custom'],
      'WA': ['400 Sq.Ft', '600 Sq.Ft', '750 Sq.Ft', '900 Sq.Ft', '1050 Sq.Ft', '1200 Sq.Ft']
    };

    function updateAreaOptions(modelValue) {
      const areaSelect = document.getElementById('floor_area');
      if (!areaSelect) return;

      let key = 'DEFAULT';
      if (modelValue.includes('BH-TH')) key = 'TH';
      else if (modelValue.includes('BH-WH')) key = 'WH';
      else if (modelValue.includes('BH-TSB')) key = 'TSB';
      else if (/^DV-\d+$/.test(modelValue)) key = 'DVP';
      else if (modelValue.includes('BH-DV')) key = 'DV';
      else if (modelValue.includes('LCV')) key = 'LCV';
      else if (modelValue.includes('BH-SB')) key = 'SB';
      else if (modelValue.includes('BH-CH')) key = 'CH';
      else if (modelValue.includes('BH-SH')) key = 'SH';
      else if (modelValue.includes('BH-CB')) key = 'CB';
      else if (modelValue.includes('BH-IS')) key = 'IS';
      else if (modelValue.includes('BH-WA')) key = 'WA';

      const optionsList = areaMapping[key] || areaMapping['DEFAULT'];
      areaSelect.innerHTML = '';
      optionsList.forEach(optVal => {
        const opt = document.createElement('option');
        opt.value = optVal;
        opt.textContent = optVal;
        areaSelect.appendChild(opt);
      });

      updateRateNote(modelValue);
    }

    // Per-sqft construction rates (Tk), matching the rates shown on each model's product page
    function rateForModel(modelValue) {
      if (modelValue === 'General Inquiry') return null;
      if (modelValue.startsWith('LCV')) return 1950;
      if (/^DV-\d+$/.test(modelValue)) return 2500; // Duplex Premium (dv-110 to dv-113)
      const m = modelValue.match(/BH-([A-Z]+)-(\d+)/);
      if (!m) return null;
      const prefix = m[1], num = parseInt(m[2], 10);
      if (prefix === 'CB') return 2750;
      if (prefix === 'CH') return (num >= 500) ? 3000 : 2200; // 5xx = Container House, 4xx = Cottage House
      if (prefix === 'SB') return 2500;
      if (prefix === 'SH') return 2500;
      if (prefix === 'TH') return 1500;
      if (prefix === 'WH') return 1500;
      if (prefix === 'DV') return 2500;
      if (prefix === 'TSB') return 2500;
      if (prefix === 'IS') return 950;
      if (prefix === 'WA') return 900;
      return null;
    }

    function updateRateNote(modelValue) {
      const note = document.getElementById('model-rate-note');
      if (!note) return;
      const rate = rateForModel(modelValue);
      note.textContent = '';
    }

    document.addEventListener('DOMContentLoaded', () => {
      const modelSelect = document.getElementById('model');
      if (modelSelect) {
        updateAreaOptions(modelSelect.value);
        modelSelect.addEventListener('change', function() {
          updateAreaOptions(this.value);
        });
      }
    });
  </script>
