{% block scripts_extra %}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contactForm');
    if (!form) return;
    
    // Time-based anti-spam
    const formLoadTime = Date.now();
    
    form.addEventListener('submit', (e) => {
        // 1. Honeypot check
        const honeypot = document.getElementById('website_url');
        if (honeypot && honeypot.value !== '') {
            e.preventDefault();
            console.warn('Spam bot detected (Honeypot filled).');
            alert('Form submission blocked due to spam detection.');
            return false;
        }
        
        // 2. Time check (must take at least 3 seconds to fill out)
        const submitTime = Date.now();
        const timeDiff = submitTime - formLoadTime;
        if (timeDiff < 3000) {
            e.preventDefault();
            console.warn('Spam bot detected (Form submitted too quickly).');
            alert('Form submission blocked due to spam detection.');
            return false;
        }
        
        // If passing both checks, allow submission
    });
});
</script>
{% endblock %}
