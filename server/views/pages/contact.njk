                  <span class="contact-detail-value">House #18, Road #18, Sector #10<br>Uttara C/A, Dhaka – 1230</span>
                </div>
              </div>
              <div class="contact-detail-item">
                <div class="contact-detail-icon" aria-hidden="true">📞</div>
                <div>
