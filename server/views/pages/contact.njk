{% block scripts_extra %}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contactForm');
    if (!form) return;
    const submitBtn = document.getElementById('contact-submit-btn');
    const feedback = document.getElementById('contactFormFeedback');
    const submitBtnLabel = submitBtn ? submitBtn.innerHTML : '';

    // Time-based anti-spam
    const formLoadTime = Date.now();

    function showFeedback(kind, html) {
        if (!feedback) return;
        feedback.style.display = 'block';
        feedback.innerHTML = html;
        if (kind === 'success') {
            feedback.style.background = 'rgba(240,253,244,0.9)';
            feedback.style.border = '1px solid rgba(22,163,74,0.35)';
            feedback.style.color = '#166534';
        } else {
            feedback.style.background = 'rgba(254,242,242,0.9)';
            feedback.style.border = '1px solid rgba(220,38,38,0.3)';
            feedback.style.color = '#991b1b';
        }
        feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // 1. Honeypot check - legitimate visitors never see/fill this field.
        // Bots that do get a fake success (see send_email.php) so they don't
        // learn to look elsewhere; here it's simplest to just no-op.
        const honeypot = document.getElementById('website_url');
        if (honeypot && honeypot.value !== '') {
            console.warn('Spam bot detected (Honeypot filled).');
            return;
        }

        // 2. Time check (must take at least 3 seconds to fill out)
        if (Date.now() - formLoadTime < 3000) {
            showFeedback('error', 'Please take a moment to review your details before sending.');
            return;
        }

        const fd = new FormData(form);
        const payload = Object.fromEntries(fd.entries());
        payload.utm_source = (window.BHUtm ? window.BHUtm.source() : null) || 'direct';

        if (submitBtn) { submitBtn.disabled = true; submitBtn.innerHTML = 'Sending…'; }
        if (feedback) feedback.style.display = 'none';

        try {
            const res = await fetch('/send_email.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
            const data = await res.json().catch(() => ({}));

            if (res.ok && data.status === 'success') {
                form.reset();
                let html = '✓ Your inquiry has been sent — our team will get back to you within 24 hours.';
                if (data.dashboardUrl) {
                    html += '<br><a href="' + data.dashboardUrl + '" style="font-weight:700;">View My Inquiry Dashboard →</a>';
                    if (data.hasPassword === false) {
                        html += '<br><span style="font-size:0.82rem; opacity:0.85;">Set a password there to check back anytime from another device.</span>';
                    }
                }
                showFeedback('success', html);
            } else {
                showFeedback('error', (data && data.message) || 'Something went wrong sending your message. Please try again or WhatsApp us directly.');
            }
        } catch (err) {
            showFeedback('error', 'Network error — please check your connection and try again.');
        } finally {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = submitBtnLabel; }
        }
    });
});
</script>
{% endblock %}
