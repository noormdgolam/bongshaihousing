{% extends "layout.njk" %}
{% block head_extra %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://bongshaihousing.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Interactive Tools",
      "item": "https://bongshaihousing.com/interactive-tools.html"
    }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Steel Building Calculator - Bongshai Housing Interactive Tools",
  "description": "Free online tools: steel building cost calculator and land registration cost calculator by Bongshai Housing Ltd. Get an instant price estimate.",
  "url": "https://bongshaihousing.com/interactive-tools.html",
  "applicationCategory": "Construction Calculator",
  "offers": {"@type": "Offer", "price": "0", "priceCurrency": "BDT"}
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "বংশাই হাউজিং-এর ইন্টারঅ্যাক্টিভ ক্যালকুলেটর দিয়ে কী কী হিসাব করা যায়?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "বংশাই হাউজিং-এর অনলাইন টুলসের মাধ্যমে বাড়ি নির্মাণের আনুমানিক খরচ (ফ্লোর এরিয়া ও ফিনিশিং ভেদে) এবং জমি রেজিস্ট্রেশনের যাবতীয় সরকারি ফি ও করের নিখুঁত হিসাব পাওয়া যায়।"
      }
    },
    {
      "@type": "Question",
      "name": "ক্যালকুলেটরের খরচের হিসাব কি চূড়ান্ত চুক্তিমূল্য?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ক্যালকুলেটরের ফলাফলটি বর্তমান বাজারদরের ওপর ভিত্তি করে একটি নির্ভরযোগ্য প্রাথমিক প্রাক্কলন। নির্দিষ্ট সাইট পরিমাপ, আর্কিটেকচারাল নকশা ও মাটির রিপোর্ট অনুযায়ী চূড়ান্ত চুক্তিমূল্য নির্ধারিত হয়।"
      }
    }
  ]
}
</script>

{% endblock %}

{% block content %}
<!-- Hero Section -->
  <section class="bg-primary text-white py-16" style="background: linear-gradient(135deg, var(--primary), var(--primary-light));">
    <div class="container text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Interactive Tools</h1>
      <p class="text-lg md:text-xl text-gray-200 max-w-2xl mx-auto">Experience our projects in a whole new dimension with advanced visualization and estimation tools.</p>
    </div>
  </section>

  <!-- Cost Calculators -->
  <section class="py-16" id="cost-calculators" style="background:#f8fafc;">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-primary mb-4">Cost Calculators</h2>
        <p class="text-gray-600 max-w-3xl mx-auto">Work out what a build actually costs before you commit &mdash; in Bangla, with real Bongshai package prices and current government fee ranges.</p>
      </div>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:24px; max-width:900px; margin:0 auto;">
        <a href="construction-cost-calculator.html" style="display:block; background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:26px; text-decoration:none; box-shadow:0 4px 14px rgba(15,23,42,0.06);">
          <div style="font-size:2rem; margin-bottom:10px;">🏗️</div>
          <h3 class="text-xl font-bold text-primary mb-2">বাড়ি নির্মাণ খরচ ক্যালকুলেটর</h3>
          <p class="text-gray-600" style="font-size:0.95rem; margin-bottom:12px;">House Construction Cost Calculator &mdash; estimate by floor area, storeys and finish level, then compare against Bongshai's fixed-price models.</p>
          <span style="color:var(--primary); font-weight:600;">হিসাব করুন →</span>
        </a>
        <a href="land-registration-cost-calculator.html" style="display:block; background:#fff; border:1px solid #e2e8f0; border-radius:12px; padding:26px; text-decoration:none; box-shadow:0 4px 14px rgba(15,23,42,0.06);">
          <div style="font-size:2rem; margin-bottom:10px;">📜</div>
          <h3 class="text-xl font-bold text-primary mb-2">জমি রেজিস্ট্রি খরচ ক্যালকুলেটর</h3>
          <p class="text-gray-600" style="font-size:0.95rem; margin-bottom:12px;">Land Registration Cost Calculator &mdash; registration fee, stamp duty, local government tax and source tax, shown as ranges by area type.</p>
          <span style="color:var(--primary); font-weight:600;">হিসাব করুন →</span>
        </a>
      </div>
    </div>
  </section>
{% endblock %}
{% block scripts_extra %}
{% endblock %}
