{% block content %}
<section class="page-hero" aria-labelledby="page-title">
      <div class="container page-hero-content">
        <h1 class="page-hero-title" data-aos="fade-up" id="page-title">Our Projects</h1>
        <p class="page-hero-text">Discover our completed EPC and turnkey projects across Bangladesh.</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Our Projects</span>
        </nav>
      </div>
    </section>
    
    <!-- AEO: Answer-First Opening & Explicit Trust Signal -->
    <section class="section" style="padding: 2rem 0; background: var(--off-white);">
      <div class="container">
        <p><strong>Bongshai Housing has successfully delivered over 300+ prefab, steel composite, and container building projects across Bangladesh. Browse our portfolio of commercial, residential, and industrial facilities below.</strong></p>
        <div class="trust-signals" style="font-size: 0.9rem; color: var(--grey-600); margin-top: 1rem;">
          By <strong>Bongshai Housing Engineering Team</strong> | Expert EPC Contractors | Last Updated: <time datetime="2026-08-08">August 8, 2026</time>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="content-title">
      <div class="container">
        
        <div class="section-header reveal visible">
          <h2 id="content-title">What are our Featured Projects?</h2>
          <p class="section-subtitle">We have successfully delivered hundreds of residential, commercial, and industrial facilities.</p>
        </div>
        
      <div class="filter-menu reveal">
        <button class="filter-btn active" data-filter="all">All Projects</button>
        <button class="filter-btn" data-filter="ongoing">Ongoing</button>
        <button class="filter-btn" data-filter="completed">Completed</button>
        <button class="filter-btn" data-filter="duplex">Duplex</button>
        <button class="filter-btn" data-filter="low-cost">Low-Cost</button>
      </div>
<div class="properties-grid stagger">
          {# ── DB-driven projects (admin-managed, appear first) ─────────────── #}
          {% if dbProjects and dbProjects.length %}
            {% for project in dbProjects %}
            <article class="property-card filter-item reveal visible" data-tilt="" data-aos="fade-up" style="--i:{{ loop.index0 }}">
              {% if project.image %}
              <div class="property-img-wrap">
                <img src="{{ project.image }}" alt="{{ project.title }}" style="width:100%; height:auto; display:block;" loading="lazy">
              </div>
              {% endif %}
              <div class="property-card-body filter-item-body" data-aos="fade-up">
                <span class="property-type">{{ project.status_label or 'Completed Project' }}</span>
                <h2 class="property-name">{{ project.title }}</h2>
                {% if project.location %}<p class="property-desc" style="font-size:0.85rem; color:var(--grey-500); margin-bottom:8px;">📍 {{ project.location }}</p>{% endif %}
                {% if project.description %}<p class="property-desc">{{ project.description }}</p>{% endif %}
                {% if project.slug %}
                <a href="{{ project.slug }}.html" class="btn-card-link">View Details</a>
                {% endif %}
              </div>
            </article>
            {% endfor %}
          {% else %}
          {# ── Static fallback cards (curated, SEO-rich) - only when the DB has
               nothing yet, otherwise these rendered a second, duplicate copy of
               every project alongside the DB loop above ─────────────────────── #}
