<script>
(function () {
  var row = document.querySelector('.bh301-thumb-row');
  if (!row) return;
  // Capture phase: must win the click before the sitewide image-lightbox
  // listener (attached higher up on .reveal-left in bubble phase) sees it.
  row.addEventListener('click', function (e) {
    var btn = e.target.closest('.bh301-thumb-btn');
    if (!btn) return;
    e.stopPropagation();
    e.preventDefault();
    var thumbImg = btn.querySelector('img');
    var main = document.getElementById('bh301-main-img');
    main.removeAttribute('srcset');
    main.src = thumbImg.src;
    main.alt = thumbImg.alt;
    row.querySelectorAll('.bh301-thumb-btn').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
  }, true);
})();
</script>


