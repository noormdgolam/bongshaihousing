{% extends "layout.njk" %}
{% block head_extra %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Get Quote - Bongshai Housing",
    "url": "https://bongshaihousing.com/solutions.html",
    "description": "Request a custom quote for steel buildings and prefab homes in Bangladesh",
    "mainEntity": {
      "@type": "Organization",
      "name": "Bongshai Housing Ltd.",
      "telephone": "+8801781636613",
      "email": "sales@bongshai.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "House #18, Road #18, Sector #10",
        "addressLocality": "Uttara",
        "addressRegion": "Dhaka",
        "postalCode": "1230",
        "addressCountry": "BD"
      }
    }
  }
  </script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://bongshaihousing.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Get Quote",
      "item": "https://bongshaihousing.com/solutions.html"
    }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Get a Free Custom Quote - Bongshai Housing Steel Building Calculator",
  "description": "Get a free custom quote for your steel building or prefab housing project. Use the online calculator to estimate cost, EMI, and land coverage. Bongshai Housing Ltd., founded 2008.",
  "url": "https://bongshaihousing.com/solutions.html",
  "dateModified": "2026-08-08",
  "potentialAction": {
    "@type": "RequestQuoteAction",
    "name": "Get Custom Steel Building Quote",
    "target": "https://bongshaihousing.com/solutions.html"
  },
  "speakable": {"@type": "SpeakableSpecification", "cssSelector": [".hero-title"]}
}
</script>
{% endblock %}

{% block content %}
{% if pageContent %}
  {{ pageContent | safe }}
{% else %}
<!-- PAGE HERO -->
    <section class="page-hero" aria-labelledby="solutions-page-title">
      <div class="container page-hero-content">
        <span class="page-hero-label">Request a Quote</span>
        <h1 class="page-hero-title" data-aos="fade-up" id="solutions-page-title">Get a Custom Quote</h1>
        <p class="page-hero-text">Request tailored engineering estimates, detailed material specifications, and architectural consultation for your dream steel building or prefab home project in Bangladesh.</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Get Quote</span>
        </nav>
      </div>
    </section>

    <div class="container" style="padding-top: var(--space-12); padding-bottom: var(--space-12);">
      <!-- AEO: Answer-First Opening & Explicit Trust Signal -->
      <p><strong>Bongshai Housing provides tailored engineering estimates and architectural consultation in Bangladesh. Get accurate quotes and premium material specifications for your custom steel building or prefab home project.</strong></p>
      <div class="trust-signals" style="font-size: 0.9rem; color: var(--grey-600); margin-top: 1rem; margin-bottom: 2rem;">
        By <strong>Bongshai Housing Engineering Team</strong> | Expert EPC Contractors | Last Updated: <time datetime="2026-08-08">August 8, 2026</time>
      </div>
    </div>

<!-- PREMIUM QUOTE SECTION -->
    <section class="section" style="padding-top: var(--space-4); background: linear-gradient(135deg, var(--bg-body) 0%, var(--off-white) 100%);">
      <div class="container">
        <div class="quote-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); align-items: stretch; margin-top: var(--space-4);">
          
          <!-- Left Column: Value Prop & Info -->
          <div class="quote-info" data-aos="fade-right">
            <h2 style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 700; color: var(--grey-900); margin-bottom: var(--space-4); line-height: 1.2;">
              Let's Build Your Dream <span style="color: var(--primary);">Together</span>
            </h2>
            <p style="color: var(--grey-600); font-size: 1.1rem; line-height: 1.7; margin-bottom: var(--space-6);">
              Whether you need a multi-story apartment building, an elegant duplex, or a massive industrial shed, our EPC experts are ready to provide a customized engineering quote tailored to your exact specifications.
            </p>
            
            <div style="display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-8);">
              <div style="display: flex; align-items: flex-start; gap: var(--space-3);">
                <div style="background: var(--primary-light); color: var(--primary); width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0;">
                  ⚡
                </div>
                <div>
                  <h4 style="font-size: 1.1rem; font-weight: 600; color: var(--grey-800); margin-bottom: 4px;">Fast Turnaround</h4>
                  <p style="color: var(--grey-500); font-size: 0.95rem; line-height: 1.5; margin: 0;">Receive your detailed engineering estimate within 24-48 hours.</p>
                </div>
              </div>
              
              <div style="display: flex; align-items: flex-start; gap: var(--space-3);">
                <div style="background: var(--primary-light); color: var(--primary); width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0;">
                  📐
                </div>
                <div>
                  <h4 style="font-size: 1.1rem; font-weight: 600; color: var(--grey-800); margin-bottom: 4px;">Accurate Costing</h4>
                  <p style="color: var(--grey-500); font-size: 0.95rem; line-height: 1.5; margin: 0;">We factor in structural loads, material grades, and labor for precise pricing.</p>
                </div>
              </div>

              <div style="display: flex; align-items: flex-start; gap: var(--space-3);">
                <div style="background: var(--primary-light); color: var(--primary); width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0;">
                  🤝
                </div>
                <div>
                  <h4 style="font-size: 1.1rem; font-weight: 600; color: var(--grey-800); margin-bottom: 4px;">Expert Consultation</h4>
                  <p style="color: var(--grey-500); font-size: 0.95rem; line-height: 1.5; margin: 0;">Free initial consultation with our senior civil engineers and architects.</p>
                </div>
              </div>
            </div>

            <!-- Trust Signals -->
            <div style="padding: var(--space-4); background: var(--white); border-radius: var(--radius-lg); border: 1px solid var(--grey-200); box-shadow: var(--shadow-sm);">
              <h4 style="font-size: 1rem; color: var(--grey-800); margin-bottom: var(--space-3); font-weight: 600;">Direct Contact</h4>
              <p style="margin: 0 0 8px 0; display: flex; align-items: center; gap: 8px; color: var(--grey-600);"><span style="font-size: 1.2rem;">📞</span> <a href="tel:+8801781636613" style="color: var(--primary); font-weight: 500; text-decoration: none;">01781-636613</a></p>
              <p style="margin: 0; display: flex; align-items: center; gap: 8px; color: var(--grey-600);"><span style="font-size: 1.2rem;">✉️</span> <a href="mailto:sales@bongshai.com" style="color: var(--primary); font-weight: 500; text-decoration: none;">sales@bongshai.com</a></p>
            </div>
          </div>

          <!-- Right Column: Glassmorphic Form -->
          <div class="quote-form-wrapper" data-aos="fade-left">
            <div style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(12px); border-radius: 24px; padding: var(--space-6) var(--space-6); box-shadow: 0 20px 40px rgba(0,0,0,0.08), inset 0 0 0 1px rgba(255,255,255,0.5); border: 1px solid rgba(0,0,0,0.05); position: relative; overflow: hidden;">
              <!-- Decorative element -->
              <div style="position: absolute; top: -50px; right: -50px; width: 150px; height: 150px; background: var(--primary-light); border-radius: 50%; filter: blur(40px); opacity: 0.6; pointer-events: none;"></div>
              
              <h3 style="font-family: var(--font-heading); font-size: 1.8rem; font-weight: 700; color: var(--grey-900); margin-bottom: 8px; position: relative;">Request a Quote</h3>
              <p style="color: var(--grey-500); font-size: 0.95rem; margin-bottom: var(--space-6); position: relative;">Fill out the details below and our team will get back to you shortly.</p>
              
              <form id="contactForm" style="position: relative;" data-mcp-action="submit_quote_request">
                <!-- Anti-spam Honeypot -->
                <div style="display:none; visibility:hidden;" aria-hidden="true">
                  <label for="cust_website_url">Leave this field blank</label>
                  <input type="text" id="cust_website_url" name="website_url" tabindex="-1" autocomplete="off" data-mcp-param="website_url">
                </div>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-4);">
                  <div>
                    <label for="name" style="display: block; font-size: 0.9rem; font-weight: 600; color: var(--grey-700); margin-bottom: 8px;">Full Name *</label>
                    <input type="text" id="name" name="name" required="" placeholder="John Doe" data-mcp-param="full_name" style="width: 100%; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--grey-200); background: var(--off-white); font-size: 1rem; outline: none; transition: all 0.3s;">
                  </div>
                  <div>
                    <label for="phone" style="display: block; font-size: 0.9rem; font-weight: 600; color: var(--grey-700); margin-bottom: 8px;">Phone Number *</label>
                    <input type="tel" id="phone" name="phone" required="" placeholder="017XX-XXXXXX" data-mcp-param="phone" style="width: 100%; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--grey-200); background: var(--off-white); font-size: 1rem; outline: none; transition: all 0.3s;">
                  </div>
                </div>

                <div style="margin-bottom: var(--space-4);">
                  <label for="email" style="display: block; font-size: 0.9rem; font-weight: 600; color: var(--grey-700); margin-bottom: 8px;">Email Address</label>
                  <input type="email" id="email" name="email" placeholder="john@example.com" data-mcp-param="email" style="width: 100%; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--grey-200); background: var(--off-white); font-size: 1rem; outline: none; transition: all 0.3s;">
                </div>

                <div style="margin-bottom: var(--space-4);">
                  <label for="project_type" style="display: block; font-size: 0.9rem; font-weight: 600; color: var(--grey-700); margin-bottom: 8px;">Project Type *</label>
                  <div style="position: relative;">
                    <select id="project_type" name="project_type" required="" data-mcp-param="project_type" style="width: 100%; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--grey-200); background: var(--off-white); font-size: 1rem; outline: none; transition: all 0.3s; appearance: none; cursor: pointer;">
                      <option value="">Select Building Type</option>
                      <option value="Apartment Building">Apartment Building</option>
                      <option value="Duplex Steel Building">Duplex Steel Building</option>
                      <option value="Simplex Steel Building">Simplex Steel Building</option>
                      <option value="Steel House">Steel House</option>
                      <option value="Industrial Shed">Industrial Shed</option>
                      <option value="Cottage / Container House">Cottage / Container House</option>
                      <option value="Other">Other Custom Project</option>
                    </select>
                    <div style="position: absolute; right: 16px; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--grey-500);">
                      ▼
                    </div>
                  </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-4);">
                  <div>
                    <label for="district" style="display: block; font-size: 0.9rem; font-weight: 600; color: var(--grey-700); margin-bottom: 8px;">District *</label>
                    <div style="position: relative;">
                      <select id="district" name="district" required="" onchange="loadUpazilas(this.value)" data-mcp-param="district" style="width: 100%; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--grey-200); background: var(--off-white); font-size: 1rem; outline: none; transition: all 0.3s; appearance: none; cursor: pointer;">
                        <option value="">Select District</option>
                      </select>
                      <div style="position: absolute; right: 16px; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--grey-500);">▼</div>
                    </div>
                  </div>
                  <div>
                    <label for="upazila" style="display: block; font-size: 0.9rem; font-weight: 600; color: var(--grey-700); margin-bottom: 8px;">Upazila *</label>
                    <div style="position: relative;">
                      <select id="upazila" name="upazila" required="" data-mcp-param="upazila" style="width: 100%; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--grey-200); background: var(--off-white); font-size: 1rem; outline: none; transition: all 0.3s; appearance: none; cursor: pointer;">
                        <option value="">Select Upazila</option>
                      </select>
                      <div style="position: absolute; right: 16px; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--grey-500);">▼</div>
                    </div>
                  </div>
                </div>

                <div style="margin-bottom: var(--space-5);">
                  <label for="message" style="display: block; font-size: 0.9rem; font-weight: 600; color: var(--grey-700); margin-bottom: 8px;">Additional Requirements</label>
                  <textarea id="message" name="message" rows="4" placeholder="Tell us about your estimated floor area, land size, or any specific requirements..." data-mcp-param="message" style="width: 100%; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--grey-200); background: var(--off-white); font-size: 1rem; outline: none; transition: all 0.3s; resize: vertical;"></textarea>
                </div>

                <button type="submit" id="contact-submit-btn" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 16px; font-size: 1.1rem; border-radius: 12px; box-shadow: 0 8px 20px rgba(30, 64, 175, 0.3);">
                  Request Free Quote
                </button>
              </form>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- FAQ SECTION FOR AEO/SEO -->
    <section class="section" style="background: var(--white); padding: var(--space-12) 0;">
      <div class="container" style="max-width: 800px; margin: 0 auto;">
        <div class="section-header reveal">
          <h2 class="section-title">Frequently Asked Questions</h2>
          <p class="section-subtitle">Common questions about pricing and our quotation process.</p>
        </div>
        
        <div class="faq-accordion reveal">
          <details style="margin-bottom: 16px; border: 1px solid var(--grey-200); border-radius: 12px; padding: 16px; background: var(--off-white); cursor: pointer;">
            <summary style="font-weight: 600; font-size: 1.1rem; color: var(--grey-900); list-style: none; display: flex; justify-content: space-between; align-items: center;">
              How long does it take to get a quote? <span style="color: var(--primary);">+</span>
            </summary>
            <p style="margin-top: 12px; color: var(--grey-600); line-height: 1.6; font-size: 0.95rem;">Once we receive your requirements and land details, our engineering team typically provides a preliminary estimate within 24 to 48 hours. For highly customized projects, it may take slightly longer.</p>
          </details>
          
          <details style="margin-bottom: 16px; border: 1px solid var(--grey-200); border-radius: 12px; padding: 16px; background: var(--off-white); cursor: pointer;">
            <summary style="font-weight: 600; font-size: 1.1rem; color: var(--grey-900); list-style: none; display: flex; justify-content: space-between; align-items: center;">
              Is the initial consultation free? <span style="color: var(--primary);">+</span>
            </summary>
            <p style="margin-top: 12px; color: var(--grey-600); line-height: 1.6; font-size: 0.95rem;">Yes, the initial consultation and quotation are completely free of charge. We believe in providing transparent pricing so you can make an informed decision.</p>
          </details>

          <details style="margin-bottom: 16px; border: 1px solid var(--grey-200); border-radius: 12px; padding: 16px; background: var(--off-white); cursor: pointer;">
            <summary style="font-weight: 600; font-size: 1.1rem; color: var(--grey-900); list-style: none; display: flex; justify-content: space-between; align-items: center;">
              What factors affect the total cost of a steel building? <span style="color: var(--primary);">+</span>
            </summary>
            <p style="margin-top: 12px; color: var(--grey-600); line-height: 1.6; font-size: 0.95rem;">The primary cost drivers include the total floor area, the number of stories, material grades (finishing quality), foundation requirements based on your soil type, and location logistics.</p>
          </details>
        </div>
      </div>
    </section>
{% endif %}
{% endblock %}

{% block content_after %}
<style>
  /* Custom responsive grid for quote section */
  @media (max-width: 900px) {
    .quote-grid {
      grid-template-columns: 1fr !important;
    }
    .quote-info {
      text-align: center;
    }
    .quote-info > div {
      align-items: center !important;
      text-align: left;
    }
  }
  
  /* Input focus states */
  .quote-form-wrapper input:focus, 
  .quote-form-wrapper select:focus, 
  .quote-form-wrapper textarea:focus {
    border-color: var(--primary) !important;
    background: var(--white) !important;
    box-shadow: 0 0 0 4px var(--primary-light) !important;
  }
</style>
{% endblock %}
