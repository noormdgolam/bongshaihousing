  font-size: 11px;
  font-weight: 700;
  width: auto;
  padding: 0 8px;
  min-width: 30px;
}
.bh-ai-toggle-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, #1E40AF 0%, #3B82F6 100%);
