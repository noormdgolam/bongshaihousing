<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Get a Free sales inquiry - Bongshai Housing Steel Building Calculator",
  "description": "Get a free sales inquiry for your steel building or prefab housing project. Use the online calculator to estimate cost, EMI, and land coverage. Bongshai Housing Ltd., founded 2008.",
  "url": "https://bongshaihousing.com/solutions.html",
  "dateModified": "2026-08-08",
  "potentialAction": {
    "@type": "RequestQuoteAction",
    "name": "Get Custom Steel Building sales inquiry",
