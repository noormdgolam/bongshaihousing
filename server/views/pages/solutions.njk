    // number here would silently send a customer's WhatsApp message to the
    // wrong contact regardless of what number the AI actually mentioned).
    safe = safe.replace(/(?<!href=")(?<!">)(\+?880\s?1[3-9]\d{2}-?\d{6})/g, (match, num) => {
      const digits = num.replace(/[^0-9]/g, '');
      return `<a href="https://wa.me/${digits}" target="_blank" rel="noopener noreferrer" style="font-weight:600; color:#10B981;">📞 ${match}</a>`;
    });

    // Convert newlines to paragraphs/breaks
    safe = safe.replace(/\n\n/g, '</p><p>').replace(/\n/g, '<br>');

    // Restore table placeholders with their pre-rendered HTML
    tables.forEach((html, idx) => {
      safe = safe.replace(` TBL${idx} `, html);
    });

    return safe;
  }

  function appendMessage(role, text, save = true) {
    const msgDiv = document.createElement('div');
    msgDiv.className = `bh-ai-msg bh-ai-msg-${role === 'user' ? 'user' : 'bot'}`;

    const formatted = formatText(text);
    msgDiv.innerHTML = `
      <div class="bh-ai-bubble">
        <p>${formatted}</p>
      </div>
      <span class="bh-ai-time">${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
    `;

    messagesContainer.appendChild(msgDiv);
    scrollBottom();

    if (save) {
      conversation.push({ role, content: text });
      saveHistory();
    }
  }

  function scrollBottom() {
    setTimeout(() => {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }, 50);
  }

  const BONGSHAI_SYSTEM_PROMPT = `You are Bongshai AI Advisor, the official senior civil engineer and sales consultant at Bongshai Housing (বঙ্গশai হাউজিং) in Bangladesh.

COMPANY PROFILE:
- Name: Bongshai Housing (বঙ্গশাই হাউজিং)
- Industry: Pre-Engineered Steel Buildings (PEB), Steel Composite Buildings, Modular Prefab Housing, Container Homes, and EPC Turnkey Real Estate.
- Headquarters: House #18, Road #18, Sector #10, Uttara, Dhaka-1230, Bangladesh.
- Hotlines / WhatsApp: +880 1781-636613, +880 1714-104940
- Email: sales@bongshai.com
- Experience: 20+ years in Bangladesh (founded 2008), 500+ completed projects nationwide, service coverage across all 64 districts.

CORE ADVANTAGES OVER RCC:
1. Speed: Full construction in 45-60 days (vs 12-18 months for conventional RCC).
2. Safety: High earthquake resistance (BNBC Zone 4 seismic codes).
3. Weather: Wind load tolerance up to 200+ km/h.
