PRICING GUIDELINES (BDT per sq.ft):
- Industrial Steel Sheds & Worker Accommodation: Tk 810-855 / sq.ft.
- Tiny House & Wooden House: Tk 1,500 / sq.ft.
- Cottage House: Tk 2,200 / sq.ft.
- Apartment Building, Duplex Steel Building, Simplex Steel Building, Steel House, Concrete Building: Tk 2,500-2,750 / sq.ft.
- Container House: Tk 3,000 / sq.ft.

RULES FOR RESPONSES:
- Answer-First: Give a clear, direct answer under 45 words first before expanding into technical specs or pricing.
- In Bangla: Follow standard NCTB grammar rules. Use civil engineering terminology (floor = 'তলা', framing = 'ফেব্রিকেশন', 'প্রি-ইঞ্জিনিয়ার্ড স্টিল বিল্ডিং').
- End with a helpful CTA connecting with Bongshai Housing engineers on WhatsApp (+8801781636613).`;

  async function sendMessage() {
    const text = input.value.trim();
    if (!text) return;

    input.value = '';
    appendMessage('user', text);

    if (typeof COST_TRIGGER_RE !== 'undefined' && COST_TRIGGER_RE.test(text) && !estimateState) {
      startEstimateFlow();
      return;
    }

    // Disable input while generating
    input.disabled = true;
    sendBtn.disabled = true;
    typingIndicator.removeAttribute('hidden');
    scrollBottom();

    let responseReceived = false;

    // 1. Try Puter.js Claude 3.5 Sonnet First (Free, Instant, Unlimited)
    if (window.puter && window.puter.ai && typeof window.puter.ai.chat === 'function') {
      try {
        const puterMessages = [
          { role: 'system', content: BONGSHAI_SYSTEM_PROMPT },
          ...conversation.slice(-8).map(m => ({
            role: m.role === 'assistant' ? 'assistant' : 'user',
            content: m.content
          }))
        ];

        const puterRes = await Promise.race([
          window.puter.ai.chat(puterMessages, { model: 'claude-3-5-sonnet' }),
          new Promise((_, reject) => setTimeout(() => reject(new Error('Puter timeout')), 18000))
        ]);

        let replyText = '';
        if (typeof puterRes === 'string') {
          replyText = puterRes;
        } else if (puterRes && puterRes.message && puterRes.message.content) {
          replyText = puterRes.message.content;
        } else if (puterRes && puterRes.text) {
          replyText = puterRes.text;
        }

        if (replyText && replyText.trim()) {
          typingIndicator.setAttribute('hidden', '');
          appendMessage('assistant', replyText.trim());
          responseReceived = true;
        }
      } catch (puterErr) {
        console.warn('Puter.js Claude attempt failed, falling back to server API:', puterErr.message);
      }
    }

    // 2. Server-side API Fallback (/api/ai-chat) if Puter did not respond
    if (!responseReceived) {
      try {
        const res = await fetch('/api/ai-chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages: conversation,
            context: {
              pageUrl: window.location.pathname,
              pageTitle: document.title,
              language: currentLang
            }
          })
        });

        const data = await res.json();
        typingIndicator.setAttribute('hidden', '');

        if (data && data.message) {
          appendMessage('assistant', data.message);
        } else {
          appendMessage('assistant', UI_STRINGS[currentLang].errFallback1);
        }
      } catch (err) {
        typingIndicator.setAttribute('hidden', '');
        appendMessage('assistant', UI_STRINGS[currentLang].errFallback2);
      }
    }

    input.disabled = false;
    sendBtn.disabled = false;
    input.focus();
    scrollBottom();
  }


  // ── Flow A: Instant Cost Estimate (deterministic, code-computed - never
  // routed through the LLM, since a hallucinated price is worse than none) ──

  const ESTIMATE_TYPES = [{"id":"apartment","label":"🏬 Apartment বিল্ডিং","rate":3200,"tiers":[{"min":1050,"max":1500,"label":"১০৫০–১৫০০ বর্গফুট"}]},{"id":"duplex","label":"🏢 ডুপ্লেক্স Steel বিল্ডিং","rate":2250,"tiers":[{"min":600,"max":600,"label":"৬০০ বর্গফুট (৩ বেডরুম)"},{"min":850,"max":850,"label":"৮৫০ বর্গফুট (৪ বেডরুম)"},{"min":1050,"max":1050,"label":"১০৫০ বর্গফুট (৫ বেডরুম)"}]},{"id":"simplex","label":"🏠 সিমপ্লেক্স Steel হাউজ","rate":2500,"tiers":[{"min":750,"max":750,"label":"৭৫০ বর্গফুট (৩ বেডরুম)"},{"min":1050,"max":1050,"label":"১০৫০ বর্গফুট (৪ বেডরুম)"},{"min":1250,"max":1250,"label":"১২৫০ বর্গফুট (৫ বেডরুম)"}]},{"id":"cottage","label":"🏘️ Cottage হাউজ","rate":1900,"tiers":[{"min":320,"max":320,"label":"৩২০ বর্গফুট (১ বেডরুম)"},{"min":440,"max":440,"label":"৪৪০ বর্গফুট (২ বেডরুম)"},{"min":560,"max":560,"label":"৫৬০ বর্গফুট (২ বেডরুম)"},{"min":600,"max":600,"label":"৬০০ বর্গফুট (২ বেডরুম)"},{"min":750,"max":750,"label":"৭৫০ বর্গফুট (৩ বেডরুম)"},{"min":850,"max":850,"label":"৮৫০ বর্গফুট (৩ বেডরুম)"},{"min":1050,"max":1050,"label":"১০৫০ বর্গফুট (৪ বেডরুম)"},{"min":1250,"max":1250,"label":"১২৫০ বর্গফুট (৫ বেডরুম)"}]},{"id":"container","label":"📦 কনটেইনার হাউজ","rate":2500,"tiers":[{"min":300,"max":300,"label":"৩০০ বর্গফুট (১ বেডরুম)"},{"min":400,"max":400,"label":"৪০০ বর্গফুট (২ বেডরুম)"}]},{"id":"steelhouse","label":"🏗️ Steel হাউজ","rate":2000,"tiers":[{"min":600,"max":600,"label":"৬০০ বর্গফুট (৩ বেডরুম)"},{"min":850,"max":850,"label":"৮৫০ বর্গফুট (৪ বেডরুম)"},{"min":1050,"max":1050,"label":"১০৫০ বর্গফুট (৫ বেডরুম)"}]},{"id":"tiny","label":"🏡 Tiny হাউজ","rate":2500,"tiers":[{"min":300,"max":300,"label":"৩০০ বর্গফুট (১ বেডরুম)"},{"min":400,"max":400,"label":"৪০০ বর্গফুট (২ বেডরুম)"}]},{"id":"wooden","label":"🪵 Wooden হাউজ","rate":2500,"tiers":[{"min":750,"max":750,"label":"৭৫০ বর্গফুট (৩ বেডরুম)"},{"min":1050,"max":1050,"label":"১০৫০ বর্গফুট (৪ বেডরুম)"},{"min":1250,"max":1250,"label":"১২৫০ বর্গফুট (৫ বেডরুম)"}]},{"id":"concrete","label":"🧱 Concrete বিল্ডিং","rate":2750,"tiers":[{"min":750,"max":750,"label":"৭৫০ বর্গফুট (৩ বেডরুম)"},{"min":1050,"max":1050,"label":"১০৫০ বর্গফুট (৪ বেডরুম)"},{"min":1250,"max":1250,"label":"১২৫০ বর্গফুট (৫ বেডরুম)"}]}];

  let estimateState = null;

  function bnDigits(str) {
    const map = { '0':'০','1':'১','2':'২','3':'৩','4':'৪','5':'৫','6':'৬','7':'৭','8':'৮','9':'৯' };
    return String(str).replace(/[0-9]/g, (d) => map[d]);
  }

  function formatTaka(n) {
    let s = Math.round(n).toString();
    const last3 = s.slice(-3);
    let rest = s.slice(0, -3);
    if (rest !== '') {
      rest = rest.replace(/\B(?=(\d{2})+(?!\d))/g, ',');
      s = rest + ',' + last3;
    } else {
      s = last3;
    }
    return bnDigits(s) + ' টাকা';
  }

  function setFlowInputMode(active) {
    if (active) {
      form.setAttribute('hidden', '');
      if (quickPrompts) quickPrompts.setAttribute('hidden', '');
    } else {
      form.removeAttribute('hidden');
      if (quickPrompts) quickPrompts.removeAttribute('hidden');
    }
  }

  function appendFlowMessage(bodyHtml) {
    const msgDiv = document.createElement('div');
    msgDiv.className = 'bh-ai-msg bh-ai-msg-bot';
    msgDiv.innerHTML = `
      <div class="bh-ai-bubble">${bodyHtml}</div>
      <span class="bh-ai-time">${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
    `;
    messagesContainer.appendChild(msgDiv);
    scrollBottom();
  }

  function appendFlowUserChoice(label) {
    const msgDiv = document.createElement('div');
    msgDiv.className = 'bh-ai-msg bh-ai-msg-user';
    msgDiv.innerHTML = `
      <div class="bh-ai-bubble"><p>${label}</p></div>
      <span class="bh-ai-time">${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
    `;
    messagesContainer.appendChild(msgDiv);
    scrollBottom();
  }

  function flowOptionsHtml(options) {
    return '<div class="bh-ai-flow-options">' +
      options.map((o) => `<button class="bh-ai-flow-btn" data-value="${o.value}">${o.label}</button>`).join('') +
      '</div><button class="bh-ai-flow-cancel" data-flow-cancel="1">❌ বাতিল করুন</button>';
  }

  function startEstimateFlow() {
    estimateState = { step: 'type' };
    setFlowInputMode(true);
    const options = ESTIMATE_TYPES.map((t) => ({ value: t.id, label: t.label }));
    appendFlowMessage('<p><strong>কোন ধরনের বাড়ির জন্য খরচ জানতে চান?</strong></p>' + flowOptionsHtml(options));
  }

  function handleEstimateTypeChoice(typeId) {
    const type = ESTIMATE_TYPES.find((t) => t.id === typeId);
    if (!type) return;
    estimateState.type = type;
    estimateState.step = 'size';
    appendFlowUserChoice(type.label);
    const options = type.tiers.map((tier, idx) => ({ value: idx, label: tier.label }));
    appendFlowMessage('<p><strong>সাইজ কেমন হবে?</strong></p>' + flowOptionsHtml(options));
  }

  function handleEstimateSizeChoice(idx) {
    const tier = estimateState.type.tiers[idx];
    if (!tier) return;
    estimateState.tier = tier;
    appendFlowUserChoice(tier.label);
    renderEstimateResult();
  }

  function renderEstimateResult() {
    const { type, tier } = estimateState;
    const low = tier.min * type.rate;
    const high = tier.max * type.rate;
    const rangeText = low === high ? formatTaka(low) : (formatTaka(low) + ' – ' + formatTaka(high));
    const waText = encodeURIComponent('Hello Bongshai Housing, I want a sales inquiry for ' + type.label.replace(/[^\x00-\x7F]/g, '').trim() + ' (' + tier.label.replace(/[^\x00-\x7F0-9,.\s]/g, '').trim() + ')');

    appendFlowMessage(`
      <p><strong>${type.label}</strong> (${tier.label}) নির্মাণের আনুমানিক খরচ: <strong>${rangeText}</strong></p>
      <p style="font-size:12px; color:#6B7280;">এটি একটি প্রাথমিক হিসাব — জমির অবস্থান, সেটব্যাক ও ফিনিশিং অনুযায়ী চূড়ান্ত কোটেশন ভিন্ন হতে পারে।</p>
      <div class="bh-ai-bubble-actions">
        <a href="https://wa.me/8801781636613?text=${waText}" target="_blank" rel="noopener noreferrer" class="bh-ai-cta-btn">📞 টিমের সাথে কথা বলুন</a>
        <a href="contact.html" class="bh-ai-cta-btn" style="background:#1E40AF;">🏠 সাইট ভিজিট বুক করুন</a>
      </div>
    `);

    estimateState = null;
    setFlowInputMode(false);
    input.focus();
  }

  function cancelEstimateFlow() {
    estimateState = null;
    setFlowInputMode(false);
    appendFlowMessage('<p>ঠিক আছে। আরও কিছু জানতে চাইলে লিখুন।</p>');
    input.focus();
  }

  messagesContainer.addEventListener('click', (e) => {
    const cancelBtn = e.target.closest('[data-flow-cancel]');
    if (cancelBtn) {
      cancelEstimateFlow();
      return;
    }
    const btn = e.target.closest('.bh-ai-flow-btn');
    if (!btn || !estimateState) return;
    const value = btn.getAttribute('data-value');
    if (estimateState.step === 'type') {
      handleEstimateTypeChoice(value);
    } else if (estimateState.step === 'size') {
      handleEstimateSizeChoice(parseInt(value, 10));
    }
  });

  const COST_TRIGGER_RE = /দাম\s*কত|খরচ\s*কত|কত\s*টাকা|cost\s*koto|koto\s*cost|price\s*koto|koto\s*price|instant\s*estimate|তাৎক্ষণিক[\s\S]{0,4}হিসাব/i;

  if (quickPrompts) {
    quickPrompts.addEventListener('click', (e) => {
      const flowBtn = e.target.closest('.bh-ai-chip[data-flow="estimate"]');
      if (flowBtn) {
        startEstimateFlow();
      }
    }, true);
  }


  form.addEventListener('submit', (e) => {
    e.preventDefault();
    sendMessage();
  });
})();
</script>
