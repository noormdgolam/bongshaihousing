{% extends "layout.njk" %}
{% block head_extra %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About Bongshai Housing",
    "description": "BONGSHAI HOUSING is Bangladesh base Real Estate and Housing Company undertaking EPC projects with international standards.",
    "url": "https://bongshaihousing.com/about-us/",
    "isPartOf": {"@type": "WebSite", "url": "https://bongshaihousing.com"}
  }
  </script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://bongshaihousing.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "About Us",
      "item": "https://bongshaihousing.com/about.html"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Senior Management",
      "item": "https://bongshaihousing.com/team-senior-management.html"
    }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Bongshai Housing Senior Management Team",
  "description": "Senior management leadership at Bongshai Housing Ltd., guiding EPC delivery across Bangladesh since 2008.",
  "url": "https://bongshaihousing.com/team-senior-management.html",
  "dateModified": "2026-08-08",
  "about": {
    "@type": "Organization",
    "@id": "https://bongshaihousing.com/#organization",
    "name": "Bongshai Housing Ltd.",
    "foundingDate": "2008",
    "employee": [
      {"@type": "Person", "name": "SMA AWAL", "jobTitle": "Chief Engineer"},
      {"@type": "Person", "name": "Farjana Maria", "jobTitle": "Architect"},
      {"@type": "Person", "name": "MD Golam Noor", "jobTitle": "IT Lead"}
    ]
  }
}
</script>
{% endblock %}

{% block content %}
<section class="page-hero" aria-labelledby="page-title">
      <div class="container page-hero-content">
        <span class="page-hero-label">Our Team</span>
        <h1 class="page-hero-title" data-aos="fade-up" id="page-title">Senior Management</h1>
        <p class="page-hero-text">Decades of international and domestic construction experience leading every project.</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <a href="about.html">About Us</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Senior Management</span>
        </nav>
      </div>
    </section>

    <section class="section" aria-labelledby="team-detail-title">
      <div class="container">
        <div class="about-grid" style="grid-template-columns: 1fr;">
          <div class="about-content reveal visible">
            <div class="section-label">🏛️ Expertise</div>
            <h2 id="team-detail-title">Senior Management Details</h2>
            <p style="margin-bottom:var(--space-4)">Our Senior Management team at Bongshai Housing consists of seasoned professionals including the Deputy General Manager (DGM), Senior Project Managers, and Principal Architects.</p>
            <p style="margin-bottom:var(--space-4)">With decades of combined experience in both international and domestic markets, they provide strategic direction and strong leadership for all our Engineering, Procurement, Construction, and Commissioning (EPC&amp;C) projects.</p>
            <p style="margin-bottom:var(--space-4)">They are committed to maintaining international standards of quality, safety, and reliability across every project we undertake.</p>

            {% if dbTeamMembers and dbTeamMembers.length %}
            <div class="team-roster-grid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:20px; margin-top:var(--space-6); margin-bottom:var(--space-6);">
              {% for m in dbTeamMembers %}
              <div class="glass-card reveal" style="padding:20px; border-radius:12px; border:1px solid var(--grey-200); background:white; display:flex; flex-direction:column; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
                <div style="display:flex; gap:14px; align-items:center; margin-bottom:12px;">
                  <div style="width:56px; height:56px; border-radius:50%; overflow:hidden; background:var(--grey-100); border:2px solid var(--primary); flex-shrink:0;">
                    <img src="/{{ m.photo or 'images/about-team.webp' }}" alt="{{ m.name }}" loading="lazy" style="width:100%; height:100%; object-fit:cover;" onerror="this.src='/images/about-team.webp';">
                  </div>
                  <div>
                    <h3 style="margin:0; font-size:1.05rem; color:var(--primary-dark); font-family:var(--font-heading);">{{ m.name }}</h3>
                    <div style="font-size:0.85rem; color:var(--primary); font-weight:600; margin-top:2px;">{{ m.role }}</div>
                  </div>
                </div>
                {% if m.bio %}
                <p style="font-size:0.88rem; color:var(--grey-600); line-height:1.5; margin:0; flex:1;">{{ m.bio }}</p>
                {% endif %}
              </div>
              {% endfor %}
            </div>
            {% endif %}

            <div style="margin-top:var(--space-8)">
              <a href="about.html" class="btn btn-outline">← Back to About Us</a>
              <a href="contact.html" class="btn btn-primary" style="margin-left:var(--space-3)">Get a Quote</a>
            </div>
          </div>
        </div>
      </div>
    </section>
{% endblock %}
