<script>
(function() {
  const toggleBtn = document.getElementById('bhAiChatToggle');
  const chatBox = document.getElementById('bhAiChatBox');
  const closeBtn = document.getElementById('bhAiCloseBtn');
  const resetBtn = document.getElementById('bhAiResetBtn');
  const form = document.getElementById('bhAiForm');
  const input = document.getElementById('bhAiInput');
  const sendBtn = document.getElementById('bhAiSendBtn');
  const messagesContainer = document.getElementById('bhAiMessages');
  const typingIndicator = document.getElementById('bhAiTyping');
  const quickPrompts = document.getElementById('bhAiQuickPrompts');

  const STORAGE_KEY = 'bh_ai_chat_history_v1';

  const UI_STRINGS = {"bn":{"chip1Label":"🧮 তাৎক্ষণিক খরচ হিসাব করুন","chip2Prompt":"স্টিল বিল্ডিং তৈরি করতে কত দিন সময় লাগে?","chip2Label":"⚡ কত দিনে তৈরি হয়?","chip3Prompt":"ফ্যাক্টরি বা ইন্ডাস্ট্রিয়াল শেডের রেট কত?","chip3Label":"🏭 ফ্যাক্টরি শেড রেট","chip4Prompt":"BH-SB-302 মডেল সম্পর্কে বিস্তারিত জানান","chip4Label":"📐 BH-SB-302 মডেল","placeholder":"আপনার প্রশ্ন লিখুন (e.g. ২ তলা বাড়ির খরচ)...","welcomeBody":"আমি আপনার এআই সেলস ও ইঞ্জিনিয়ারিং সহকারী। আপনার জমির সাইজ, ডুপ্লেক্স/সিমপ্লেক্স বাড়ির খরচ, কনটেইনার হোম বা ইন্ডাস্ট্রিয়াল ফ্যাক্টরি শেড নিয়ে যেকোনো প্রশ্ন করতে পারেন।","errFallback1":"আমাদের সার্ভারের সাথে সংযোগে সাময়িক ত্রুটি হয়েছে। অনুগ্রহ করে সরাসরি আমাদের হোয়াটসঅ্যাপে নক দিন: +880 1781-636613.","errFallback2":"সংযোগ বিচ্ছিন্ন হয়েছে। আমাদের হটলাইন +8801781636613-এ যোগাযোগ করুন।","welcomeTitle":"স্বাগতম বঙ্গশাই হাউজিং-এ!","cta":"💬 WhatsApp-এ কথা বলুন"},"en":{"chip1Label":"🧮 Instant Cost Estimate","chip2Prompt":"How long does it take to build a steel building?","chip2Label":"⚡ How long does it take?","chip3Prompt":"What are the rates for factory or industrial sheds?","chip3Label":"🏭 Factory shed rates","chip4Prompt":"Tell me details about the BH-SB-302 model","chip4Label":"📐 BH-SB-302 model","placeholder":"Type your question (e.g. cost of a 2-story house)...","welcomeBody":"I'm your AI sales and engineering assistant. Ask me about your land size, duplex/simplex house costs, container homes, or industrial factory sheds.","errFallback1":"We're having a temporary issue connecting to our server. Please reach us directly on WhatsApp: +880 1781-636613.","errFallback2":"Connection lost. Please contact our hotline: +8801781636613.","welcomeTitle":"Welcome to Bongshai Housing!","cta":"Chat on WhatsApp"}};
  const langToggleBtn = document.getElementById('bhAiLangToggle');
  let currentLang = localStorage.getItem('bh_ai_lang') === 'en' ? 'en' : 'bn';

  function applyLanguage(lang) {
    currentLang = lang;
    localStorage.setItem('bh_ai_lang', lang);
    const s = UI_STRINGS[lang];
    if (langToggleBtn) {
      langToggleBtn.textContent = lang === 'bn' ? 'EN' : 'বাং';
      langToggleBtn.title = lang === 'bn' ? 'Switch to English' : 'Switch to Bengali';
    }
    if (input) input.placeholder = s.placeholder;
    var wTitle = document.getElementById('bhAiWelcomeTitle');
    var wBody = document.getElementById('bhAiWelcomeBody');
    var wCta = document.getElementById('bhAiWelcomeCta');
    if (wTitle) wTitle.textContent = s.welcomeTitle;
    if (wBody) wBody.textContent = s.welcomeBody;
    if (wCta) wCta.textContent = s.cta;
    var chipEstimate = document.querySelector('.bh-ai-chip-estimate');
    if (chipEstimate) chipEstimate.textContent = s.chip1Label;
    var promptChips = document.querySelectorAll('.bh-ai-chip:not(.bh-ai-chip-estimate)');
    var chipKeys = ['chip2', 'chip3', 'chip4'];
    promptChips.forEach(function (btn, i) {
      var key = chipKeys[i];
      if (!key) return;
      btn.textContent = s[key + 'Label'];
      btn.setAttribute('data-prompt', s[key + 'Prompt']);
    });
  }

  if (langToggleBtn) {
    langToggleBtn.addEventListener('click', function () {
      applyLanguage(currentLang === 'bn' ? 'en' : 'bn');
    });
  }
  applyLanguage(currentLang);

  let conversation = [];

  // Load from session storage
  try {
    const saved = sessionStorage.getItem(STORAGE_KEY);
    if (saved) {
      conversation = JSON.parse(saved);
      conversation.forEach(msg => appendMessage(msg.role, msg.content, false));
    }
  } catch (e) {
    conversation = [];
  }

  function saveHistory() {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(conversation));
    } catch (e) {}
  }

  function toggleChat(forceOpen) {
    const isHidden = chatBox.hasAttribute('hidden');
    const shouldOpen = forceOpen !== undefined ? forceOpen : isHidden;

    if (shouldOpen) {
      chatBox.removeAttribute('hidden');
      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.setAttribute('hidden', '');
      input.focus();
      scrollBottom();
    } else {
      chatBox.setAttribute('hidden', '');
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.removeAttribute('hidden');
    }
  }

  toggleBtn.addEventListener('click', () => toggleChat());
  closeBtn.addEventListener('click', () => toggleChat(false));

  resetBtn.addEventListener('click', () => {
    if (confirm('Clear chat history? / চ্যাট হিস্টোরি মুছতে চান?')) {
      conversation = [];
      sessionStorage.removeItem(STORAGE_KEY);
      messagesContainer.innerHTML = `
        <div class="bh-ai-msg bh-ai-msg-bot">
          <div class="bh-ai-bubble">
            <p><strong>স্বাগতম বঙ্গশাই হাউজিং-এ!</strong> 👋</p>
            <p>আমি আপনার এআই সহকারী। বাড়ি নির্মাণ বা ইস্পাত কাঠামো সংক্রান্ত যেকোনো প্রশ্ন করুন।</p>
          </div>
          <span class="bh-ai-time">Just now</span>
        </div>
      `;
    }
  });

  // Quick prompts
  if (quickPrompts) {
    quickPrompts.addEventListener('click', (e) => {
      const btn = e.target.closest('.bh-ai-chip');
      if (!btn) return;
      const prompt = btn.getAttribute('data-prompt');
      if (prompt) {
        input.value = prompt;
        sendMessage();
      }
    });
  }

  // Shared inline formatting (bold/links/phone) used both for plain text
  // and for individual markdown-table cells.
  function formatInline(str) {
    str = str.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    str = str.replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>');
    str = str.replace(/(?<!href=")(?<!">)(\+?880\s?1[3-9]\d{2}-?\d{6})/g, (match, num) => {
      const digits = num.replace(/[^0-9]/g, '');
      return `<a href="https://wa.me/${digits}" target="_blank" rel="noopener noreferrer" style="font-weight:600; color:#10B981;">📞 ${match}</a>`;
    });
    return str;
  }

  function splitTableRow(row) {
    let r = row.trim();
    if (r.startsWith('|')) r = r.slice(1);
    if (r.endsWith('|')) r = r.slice(0, -1);
    return r.split('|').map((c) => c.trim());
  }

  // Pulls GFM-style markdown tables (header | header \n --- | --- \n cell | cell)
  // out of the text and replaces each with a placeholder token, so the later
  // bold/link/newline regexes (which run on the whole string) can't mangle
  // table markup. Returns { text, tables } - placeholders get swapped back
  // in as the final step of formatText().
  function extractMarkdownTables(text) {
    const lines = text.split('\n');
    const tables = [];
    const out = [];
    let i = 0;
    const separatorRe = /^\s*\|?\s*:?-{2,}:?\s*(\|\s*:?-{2,}:?\s*)+\|?\s*$/;

    while (i < lines.length) {
      const line = lines[i];
      const next = lines[i + 1];
      if (line && line.includes('|') && next && separatorRe.test(next)) {
        const headerCells = splitTableRow(line);
        i += 2;
        const rows = [];
        while (i < lines.length && lines[i].includes('|') && lines[i].trim() !== '') {
          rows.push(splitTableRow(lines[i]));
          i++;
        }
        let html = '<div class="bh-ai-table-wrap"><table class="bh-ai-table"><thead><tr>';
        headerCells.forEach((c) => (html += `<th>${formatInline(c)}</th>`));
        html += '</tr></thead><tbody>';
        rows.forEach((r) => {
          html += '<tr>';
          r.forEach((c) => (html += `<td>${formatInline(c)}</td>`));
          html += '</tr>';
        });
        html += '</tbody></table></div>';
        const token = ` TBL${tables.length} `;
        tables.push(html);
        out.push(token);
      } else {
        out.push(line);
        i++;
      }
    }
    return { text: out.join('\n'), tables };
  }

  function formatText(text) {
    // Simple sanitizing & markdown-like parsing for bold, links and tables
    let safe = text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    const { text: withoutTables, tables } = extractMarkdownTables(safe);
    safe = withoutTables;

    // Bold **text**
    safe = safe.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

    // URLs first (before adding internal <a> tags)
    safe = safe.replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>');

    // Phone numbers (if not already inside an anchor tag) - link to whichever
    // number actually appears in the text, not a hardcoded one (a wrong
    // number here would silently send a customer's WhatsApp message to the
    // wrong contact regardless of what number the AI actually mentioned).
    safe = safe.replace(/(?<!href=")(?<!">)(\+?880\s?1[3-9]\d{2}-?\d{6})/g, (match, num) => {
      const digits = num.replace(/[^0-9]/g, '');
      return `<a href="https://wa.me/${digits}" target="_blank" rel="noopener noreferrer" style="font-weight:600; color:#10B981;">📞 ${match}</a>`;
    });

    // Convert newlines to paragraphs/breaks
    safe = safe.replace(/\n\n/g, '</p><p>').replace(/\n/g, '<br>');

    // Restore table placeholders with their pre-rendered HTML
    tables.forEach((html, idx) => {
      safe = safe.replace(` TBL${idx} `, html);
    });

    return safe;
  }

  function appendMessage(role, text, save = true) {
    const msgDiv = document.createElement('div');
    msgDiv.className = `bh-ai-msg bh-ai-msg-${role === 'user' ? 'user' : 'bot'}`;

    const formatted = formatText(text);
    msgDiv.innerHTML = `
      <div class="bh-ai-bubble">
        <p>${formatted}</p>
      </div>
      <span class="bh-ai-time">${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
    `;

    messagesContainer.appendChild(msgDiv);
    scrollBottom();

    if (save) {
      conversation.push({ role, content: text });
      saveHistory();
    }
  }

  function scrollBottom() {
    setTimeout(() => {
