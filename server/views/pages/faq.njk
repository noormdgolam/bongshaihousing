    messagesContainer.appendChild(msgDiv);
    scrollBottom();
  }

  function appendFlowUserChoice(label) {
    const msgDiv = document.createElement('div');
    msgDiv.className = 'bh-ai-msg bh-ai-msg-user';
    msgDiv.innerHTML = `
      <div class="bh-ai-bubble"><p>${label}</p></div>
      <span class="bh-ai-time">${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
    `;
    messagesContainer.appendChild(msgDiv);
    scrollBottom();
  }

  function flowOptionsHtml(options) {
    return '<div class="bh-ai-flow-options">' +
      options.map((o) => `<button class="bh-ai-flow-btn" data-value="${o.value}">${o.label}</button>`).join('') +
      '</div><button class="bh-ai-flow-cancel" data-flow-cancel="1">❌ বাতিল করুন</button>';
  }

  function startEstimateFlow() {
    estimateState = { step: 'type' };
    setFlowInputMode(true);
    const options = ESTIMATE_TYPES.map((t) => ({ value: t.id, label: t.label }));
    appendFlowMessage('<p><strong>কোন ধরনের বাড়ির জন্য খরচ জানতে চান?</strong></p>' + flowOptionsHtml(options));
  }

  function handleEstimateTypeChoice(typeId) {
    const type = ESTIMATE_TYPES.find((t) => t.id === typeId);
    if (!type) return;
    estimateState.type = type;
    estimateState.step = 'size';
    appendFlowUserChoice(type.label);
    const options = type.tiers.map((tier, idx) => ({ value: idx, label: tier.label }));
    appendFlowMessage('<p><strong>সাইজ কেমন হবে?</strong></p>' + flowOptionsHtml(options));
  }

  function handleEstimateSizeChoice(idx) {
    const tier = estimateState.type.tiers[idx];
    if (!tier) return;
    estimateState.tier = tier;
    appendFlowUserChoice(tier.label);
    renderEstimateResult();
  }

  function renderEstimateResult() {
    const { type, tier } = estimateState;
    const low = tier.min * type.rate;
    const high = tier.max * type.rate;
    const rangeText = low === high ? formatTaka(low) : (formatTaka(low) + ' – ' + formatTaka(high));
    const waText = encodeURIComponent('Hello Bongshai Housing, I want a sales inquiry for ' + type.label.replace(/[^\x00-\x7F]/g, '').trim() + ' (' + tier.label.replace(/[^\x00-\x7F0-9,.\s]/g, '').trim() + ')');

    appendFlowMessage(`
      <p><strong>${type.label}</strong> (${tier.label}) নির্মাণের আনুমানিক খরচ: <strong>${rangeText}</strong></p>
