{% block content %}
<!-- PAGE HERO -->
    <section class="page-hero" aria-labelledby="page-title">
      <div class="container page-hero-content">
        <span class="page-hero-label">About Us</span>
        <h1 class="page-hero-title" data-aos="fade-up" id="page-title">Bangladesh's Most Trusted<br>Housing Company</h1>
        <p class="page-hero-text">20+ years of building dreams with international quality, innovative prefab technology, and an unwavering commitment to excellence.</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">About Us</span>
        </nav>
      </div>
    </section>

    <!-- AEO: Answer-First Opening & Explicit Trust Signal -->
    <section class="section" style="padding: 2rem 0; background: var(--off-white);">
      <div class="container">
        <p><strong>Bongshai Housing is a trusted pre-engineered steel building and EPC company in Bangladesh. We provide world-class, affordable, and rapid prefab construction solutions for residential, commercial, and industrial clients with over 20 years of excellence.</strong></p>
        <div class="trust-signals" style="font-size: 0.9rem; color: var(--grey-600); margin-top: 1rem;">
          By <strong>Bongshai Housing Engineering Team</strong> | Expert EPC Contractors | Last Updated: <time datetime="2026-08-08">August 8, 2026</time>
        </div>
      </div>
    </section>

    <!-- ABOUT CONTENT -->
    <section class="section" aria-labelledby="about-story-title">
      <div class="container">
        <div class="about-grid">
          <div class="about-img-wrap reveal-left">
            <img src="images/about-team.webp" srcset="images/about-team-400w.webp 400w, images/about-team-700w.webp 700w, images/about-team.webp 1024w" sizes="(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 500px" alt="Bongshai Housing professional engineering team" loading="lazy" title="Bongshai Housing professional engineering team" width="1024" height="1024">
            <div class="about-badge-float">
              <div class="about-badge-icon" aria-hidden="true">🏆</div>
              <div>
                <span class="about-badge-num">20+</span>
                <span class="about-badge-lbl">Years of Excellence</span>
              </div>
            </div>
          </div>
          <div class="about-content reveal-right">
            <div class="section-label" data-aos="fade-up">Our Story</div>
            <h2 id="about-story-title">Who are we?</h2>
            <p style="margin-bottom:var(--space-4)">
              <strong>BONGSHAI HOUSING</strong> is a Bangladesh-based Real Estate and Housing Company. The company undertakes projects on the basis of <strong>Engineering-Procurement-Construction &amp; Commissioning (EPC&amp;C)</strong>.
            </p>
            <p style="margin-bottom:var(--space-4)">
              We have the experience and resources to execute complex projects on time with international standards of quality, safety, and reliability. The company always gears up to excel stakeholders' expectations with its modern technology and sophisticated, experienced professional workforce.
            </p>
            <p>
              BONGSHAI HOUSING will be responsible for the entire process of the project, ranging from design and materials supply to construction/installation and test operation. We maintain a great deal of experience in preparation, co-ordination, implementation, new-build, and maintenance works.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- MISSION & VISION -->
    <section class="section" style="background:var(--off-white)" aria-labelledby="mission-title">
      <div class="container">
        <div class="section-header reveal">
          <div class="section-label" data-aos="fade-up">Our Purpose</div>
          <h2 class="section-title" data-aos="fade-up" id="mission-title">What are our Mission &amp; Vision?</h2>
        </div>
        <div class="stagger product-grid">
          <div class="why-card reveal glass-card" data-aos="fade-up" style="--i:0;text-align:left">
