{% block content %}
<section class="page-hero" aria-labelledby="page-title">
      <div class="container page-hero-content">
        <h1 class="page-hero-title" data-aos="fade-up" id="page-title">Steel vs Concrete: Which Is Right for Your Build?</h1>
        <p class="page-hero-text">A data-backed comparison of steel-composite and traditional RCC construction on cost, speed, earthquake safety, and durability - for builders across Bangladesh.</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="index.html">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Steel vs Concrete Comparison</span>
        </nav>
      </div>
    </section>

    <section class="section" aria-labelledby="content-title">
      <div class="container" style="max-width: 1000px;">
        <h2 id="content-title" class="sr-only" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">Steel vs Concrete Detailed Comparison</h2>

        <div class="section-header reveal" style="margin-bottom: var(--space-6);">
          <h2 class="section-title">Detailed Comparison</h2>
          <p class="section-subtitle">Steel-composite (prefab) vs traditional reinforced concrete (RCC) housing in Bangladesh</p>
        </div>

        <div class="compare-table-wrap reveal">
          <table class="compare-table">
            <thead>
              <tr>
                <th>Aspect</th>
                <th>Steel / Prefab Composite</th>
                <th>Traditional Concrete (RCC)</th>
                <th>Advantage</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="compare-aspect">Construction Speed</td>
                <td>Weeks to a few months - components are largely factory-built off-site and assembled on land</td>
                <td>Typically 6-24+ months, dependent on curing time, weather, and on-site labor availability</td>
                <td class="compare-winner-steel">Steel</td>
              </tr>
              <tr>
                <td class="compare-aspect">Upfront Cost</td>
                <td>Often 10-30% lower for single-story and low-rise homes</td>
                <td>Higher, driven by formwork, extensive on-site labor, and longer project duration</td>
                <td class="compare-winner-steel">Steel (most residential cases)</td>
              </tr>
              <tr>
                <td class="compare-aspect">Foundation &amp; Weight</td>
                <td>Significantly lighter structure - simpler, less expensive foundations</td>
                <td>Heavier structure requiring deeper, more reinforced foundations</td>
                <td class="compare-winner-steel">Steel</td>
              </tr>
              <tr>
                <td class="compare-aspect">Earthquake Performance</td>
                <td>High strength-to-weight ratio and ductility; steel-concrete composite systems are increasingly used for seismic-resilient construction in Bangladesh</td>
                <td>Can perform well when properly engineered, but added mass increases seismic load</td>
                <td class="compare-winner-steel">Steel (with proper engineering)</td>
              </tr>
              <tr>
                <td class="compare-aspect">Fire Resistance</td>
                <td>Loses significant strength above ~400°C; needs fireproof coatings or cladding to meet safety codes</td>
                <td>Naturally fire-resistant; can withstand 2+ hours without added treatment</td>
                <td class="compare-winner-concrete">Concrete</td>
              </tr>
              <tr>
                <td class="compare-aspect">Thermal &amp; Sound Insulation</td>
                <td>Needs added insulation layers for comfort</td>
                <td>Higher natural thermal mass, generally better sound dampening</td>
                <td class="compare-winner-concrete">Concrete</td>
              </tr>
              <tr>
                <td class="compare-aspect">Long-Term Maintenance</td>
                <td>Needs anti-corrosion coating and periodic inspection, especially in humid climates</td>
                <td>Generally lower if built with quality materials, though rebar corrosion can crack concrete over decades</td>
                <td class="compare-winner-neutral">Comparable</td>
              </tr>
              <tr>
                <td class="compare-aspect">Lifespan</td>
                <td>50-100+ years with proper anti-corrosion maintenance</td>
                <td>50-100+ years, though rebar corrosion is a common cause of long-term deterioration</td>
                <td class="compare-winner-neutral">Comparable</td>
              </tr>
              <tr>
                <td class="compare-aspect">Environmental Impact</td>
                <td>Recyclable and generates less on-site waste, though virgin steel still carries a real carbon footprint</td>
                <td>Cement production is one of the largest single industrial sources of CO₂ emissions worldwide</td>
                <td class="compare-winner-steel">Steel</td>
              </tr>
              <tr>
                <td class="compare-aspect">Best Suited For</td>
                <td>Fast-turnaround homes, cottages, industrial sheds, and sites with weaker soil-bearing capacity</td>
                <td>Multi-story apartment towers and high-rises where fire code and mass are priorities</td>
                <td class="compare-winner-neutral">Depends on project</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="compare-cards">
          <div class="compare-card steel">
            <h3>Choose Steel / Prefab When</h3>
            <ul>
              <li>You need fast construction</li>
              <li>Budget is a primary concern</li>
              <li>Soft soil or foundation cost is a concern</li>
              <li>You want an expandable, modern design</li>
              <li>Building outside major cities</li>
              <li>Earthquake resistance is a priority</li>
            </ul>
          </div>
          <div class="compare-card">
            <h3>Choose Concrete (RCC) When</h3>
            <ul>
              <li>Building multi-story apartments or towers</li>
              <li>Fire resistance is the top priority</li>
              <li>You prefer traditional construction methods</li>
              <li>Local skilled concrete labor is abundant</li>
              <li>Dense urban high-rise projects</li>
              <li>Long-term thermal comfort is the focus</li>
            </ul>
          </div>
        </div>

        <div class="section-header reveal" style="margin-bottom: var(--space-6);">
          <h2 class="section-title">Why Bongshai Housing?</h2>
          <p class="section-subtitle">We build both steel-composite and concrete housing, so our recommendation is based on your project - not a single product line</p>
        </div>

        <div class="why-grid stagger" style="margin-bottom: var(--space-10);">
          <div class="why-card reveal glass-card">
