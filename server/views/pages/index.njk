<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["RealEstateAgent", "GeneralContractor", "HomeAndConstructionBusiness"],
        "@id": "https://bongshaihousing.com/#organization",
        "name": "Bongshai Housing Ltd.",
        "alternateName": ["BongshaiHousing", "Bongshai Steel Building Company", "Bongshai Housing Bangladesh"],
        "url": "https://bongshaihousing.com",
        "logo": "https://bongshaihousing.com/images/logo.png",
        "description": "Bangladesh's #1 steel building company and EPC real estate developer. Specializing in steel composite buildings, prefab cottages, luxury villas, and single-story steel structures in Dhaka.",
        "slogan": "Bangladesh's Premier Steel Building Company",
        "foundingDate": "2008",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [".hero-title", ".section-faq .faq-answer", ".cta-title"]
        },
        "telephone": ["+8801781636613", "+8801714104940"],
        "email": "sales@bongshai.com",
        "priceRange": "Contact for Quote",
        "hasMap": "https://share.google/o4qfoSNEk5eRdxzvv",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "House #18, Road #18, Sector #10",
          "addressLocality": "Uttara",
          "addressRegion": "Dhaka",
          "postalCode": "1230",
          "addressCountry": "BD"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "23.8728",
          "longitude": "90.3984"
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Saturday","Sunday","Monday","Tuesday","Wednesday","Thursday"],
          "opens": "09:00",
          "closes": "19:00"
        },
        "sameAs": [
          "https://www.facebook.com/bongshaihousing",
          "https://wa.me/8801781636613",
          "https://share.google/o4qfoSNEk5eRdxzvv"
        ],
        "areaServed": [
          {"@type": "Country", "name": "Bangladesh"},
          {"@type": "City", "name": "Dhaka"},
          {"@type": "AdministrativeArea", "name": "Uttara, Dhaka"}
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Steel Building & Housing Packages",
          "itemListElement": [
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Pre-Engineered Steel Buildings (PEB)", "description": "Custom industrial pre-engineered steel buildings and factory sheds in Bangladesh."}},
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Industrial Steel Shed Construction", "description": "High-quality industrial steel shed construction services in Dhaka and across Bangladesh."}},
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Single Story Steel Composite Building", "description": "Steel-concrete composite single-story buildings – Bangladesh's premier steel building company."}},
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Low-Cost Steel Prefab Cottage", "description": "Affordable steel-frame prefab cottages in Bangladesh."}},
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Luxury Steel Prefab Villa", "description": "Premium steel prefab villas with luxury finishes in Bangladesh."}}
          ]
        },
        "review": [
          {% if dbTestimonials and dbTestimonials.length %}
          {% for t in dbTestimonials %}
          {
            "@type": "Review",
            "reviewRating": {"@type": "Rating", "ratingValue": "{{ t.rating or 5 }}", "bestRating": "5"},
            "author": {"@type": "Person", "name": "{{ t.author_name | replace('\"', '\\\"') }}"},
            "reviewBody": "{{ t.review_text | replace('\"', '\\\"') | replace('\r\n', ' ') | replace('\n', ' ') }}"
          }{% if not loop.last %},{% endif %}
          {% endfor %}
          {% else %}
          {
            "@type": "Review",
            "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5"},
            "author": {"@type": "Person", "name": "Mahmudul Hasan"},
            "reviewBody": "Bongshai Housing delivered our industrial shed in Gazipur ahead of schedule. The quality of the steel structure is phenomenal and the team was highly professional."
          },
          {
            "@type": "Review",
            "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5"},
            "author": {"@type": "Person", "name": "Anwar Sadat"},
            "reviewBody": "We built our eco-friendly resort using their prefab modular units. The finish is indistinguishable from concrete, but it was built in half the time!"
          },
          {
            "@type": "Review",
            "reviewRating": {"@type": "Rating", "ratingValue": "5", "bestRating": "5"},
            "author": {"@type": "Person", "name": "Farhana Rahman"},
            "reviewBody": "From the first 3D mockup to the final handover, the process was seamless. Our two-story steel-framed house looks absolutely gorgeous."
          }
          {% endif %}
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "5",
          "reviewCount": "{{ dbTestimonials.length if dbTestimonials and dbTestimonials.length else 3 }}",
          "bestRating": "5"
        }
      },
      {
        "@type": "WebSite",
        "@id": "https://bongshaihousing.com/#website",
        "url": "https://bongshaihousing.com",
        "name": "Bongshai Housing – Steel Building Company Bangladesh",
        "description": "Bangladesh's #1 steel building company and EPC real estate developer",
        "publisher": {"@id": "https://bongshaihousing.com/#organization"},
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://bongshaihousing.com/?s={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
  </script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
