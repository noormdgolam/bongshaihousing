<script>
    // Packages section: category tab switching + per-item image preview on hover
    document.addEventListener('DOMContentLoaded', () => {
      const wrap = document.querySelector('.pkg-tabs-wrap');
      if (!wrap) return;
      const tabs = wrap.querySelectorAll('.pkg-tab');
      const panels = wrap.querySelectorAll('.pkg-panel');

      const resetImage = (panel) => {
        const img = panel.querySelector('.pkg-panel-image img');
        if (img) {
          img.src = img.getAttribute('data-default-img');
          if (img.hasAttribute('data-default-srcset')) {
            img.setAttribute('srcset', img.getAttribute('data-default-srcset'));
          }
        }
      };

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-panel');
          tabs.forEach(t => {
            const on = t === tab;
            t.classList.toggle('active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          panels.forEach(p => {
            p.classList.toggle('active', p.getAttribute('data-panel') === target);
          });
          // Start each panel on its own default image
          panels.forEach(resetImage);
        });
      });

      // Hovering a product swaps the panel image to that product's photo
      panels.forEach(panel => {
        const img = panel.querySelector('.pkg-panel-image img');
        const links = panel.querySelector('.pkg-panel-links');
        if (!img || !links) return;
        const hoverLinks = links.querySelectorAll('a[data-img]');
        // Preload every photo in this panel up front, so the very first hover
        // swaps instantly instead of waiting on a fresh network fetch (which
        // on a slow mobile connection could look like hovering does nothing).
        hoverLinks.forEach(link => {
          const preload = new Image();
          preload.src = link.getAttribute('data-img');
        });
        // Save initial srcset
        if (img.hasAttribute('srcset')) {
          img.setAttribute('data-default-srcset', img.getAttribute('srcset'));
        }

        hoverLinks.forEach(link => {
          link.addEventListener('mouseenter', () => {
            img.removeAttribute('srcset');
            img.src = link.getAttribute('data-img');
          });
          link.addEventListener('focus', () => {
            img.removeAttribute('srcset');
            img.src = link.getAttribute('data-img');
          });
        });
        links.addEventListener('mouseleave', () => resetImage(panel));
      });
    });
  </script>
