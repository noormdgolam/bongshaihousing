    {
      "@type": "Question",
      "name": "How much does this Bongshai Housing steel house model cost?",
      "acceptedAnswer": {"@type": "Answer", "text": "All Bongshai Housing Steel House models are priced at Tk 2,500-2,750 per sqft. Per-floor sizes range from 650 sqft (4-5 bedrooms) to 1,200 sqft (8 bedrooms)."}
    },
    {
      "@type": "Question",
      "name": "What quality standards does Bongshai Housing's Steel House construction follow?",
      "acceptedAnswer": {
        "@type": "Answer",
