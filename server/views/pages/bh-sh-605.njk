<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "dateModified": "2026-08-08",
  "author": {
    "@type": "Person",
    "name": "SMA AWAL",
    "jobTitle": "Chief Engineer",
    "worksFor": {"@type": "Organization", "name": "Bongshai Housing Ltd.", "@id": "https://bongshaihousing.com/#organization"}
  },
