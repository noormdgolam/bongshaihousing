{% extends "agent-layout.njk" %}
{% block title %}সেটিংস{% endblock %}

{% block body %}
<div class="agent-hero">
  <div class="agent-hero-top">
    <div class="agent-hero-brand">🏗️ বংশাই লিড ড্যাশবোর্ড</div>
    <div style="display:flex; gap:8px; align-items:center;">
      <a href="/agent/today" class="btn btn-ghost">✅ আজকের কাজ</a>
      <a href="/agent/all-leads" class="btn btn-ghost">📋 সব লিড</a>
      <form method="post" action="/agent/logout" style="margin:0;">
        <button type="submit" class="btn btn-ghost">লগ আউট</button>
      </form>
    </div>
  </div>
  <div class="agent-hero-profile">
    <div><div class="agent-hero-name">সেটিংস</div><div class="agent-hero-meta">{{ agentName }}</div></div>
  </div>
</div>

<div class="agent-content">
  {% if error %}<div class="error-box">{{ error }}</div>{% endif %}

  <div class="card">
    <h3 style="margin:0 0 12px;font-size:0.95rem;">💰 বিজ্ঞাপন খরচ</h3>
    <form method="post" action="/agent/settings">
      <div class="form-row">
        <label for="ad_spend">মাসিক Facebook বিজ্ঞাপন খরচ (৳)</label>
        <input type="number" id="ad_spend" name="ad_spend_facebook_monthly" value="{{ settings.adSpendFacebookMonthly }}" min="0">
      </div>
      <p style="font-size:0.78rem;color:var(--grey-500);margin:-8px 0 16px;">"প্রতি লিড খরচ" = এই সংখ্যা ÷ এই মাসে source=facebook হওয়া লিডের সংখ্যা।</p>

      <h3 style="margin:20px 0 12px;font-size:0.95rem;">💬 WhatsApp টেমপ্লেট</h3>
      <p style="font-size:0.78rem;color:var(--grey-500);margin:-8px 0 16px;">ব্যবহার করুন: {{ '{{নাম}}' }}, {{ '{{জেলা}}' }}, {{ '{{তারিখ}}' }}</p>
      {% for t in settings.templates %}
      <div class="form-row">
        <label>টেমপ্লেট {{ loop.index }} - নাম</label>
        <input type="text" name="label_{{ loop.index }}" value="{{ t.label }}" maxlength="50">
      </div>
      <div class="form-row">
        <label>টেমপ্লেট {{ loop.index }} - বার্তা</label>
        <textarea name="text_{{ loop.index }}" maxlength="1000">{{ t.text }}</textarea>
      </div>
      {% endfor %}

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">সেভ করুন</button>
      </div>
    </form>
  </div>

  <div class="card">
    <h3 style="margin:0 0 12px;font-size:0.95rem;">👥 সক্রিয় এজেন্ট / অ্যাডমিন</h3>
    <table>
      <thead><tr><th>নাম</th><th>ফোন</th><th>রোল</th></tr></thead>
      <tbody>
        {% for a in agents %}
        <tr><td data-label="নাম">{{ a.name }}</td><td data-label="ফোন">{{ a.phone }}</td><td data-label="রোল">{{ a.role }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
