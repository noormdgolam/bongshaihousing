<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{% block title %}My Project{% endblock %} — Bongshai Housing</title>
<meta name="robots" content="noindex, nofollow" />
{% if csrfToken %}<meta name="csrf-token" content="{{ csrfToken }}">{% endif %}
<style>
  :root { --primary: #1E40AF; --primary-dark: #1e3a8a; --accent: #D4AF37; --grey-50: #f8fafc; --grey-100: #f1f5f9; --grey-200: #e2e8f0; --grey-500: #64748b; --grey-700: #334155; --grey-900: #0f172a; --danger: #dc2626; --success: #16a34a; --glass: rgba(255,255,255,0.72); --glass-border: rgba(255,255,255,0.55); }
  * { box-sizing: border-box; }
  html, body { min-height: 100%; }
  body {
    margin: 0; font-family: -apple-system, Segoe UI, Roboto, sans-serif; color: var(--grey-900);
    background:
      radial-gradient(circle at 12% 18%, rgba(212,175,55,0.38), transparent 42%),
      radial-gradient(circle at 88% 12%, rgba(110,168,255,0.4), transparent 45%),
      radial-gradient(circle at 50% 95%, rgba(124,58,237,0.28), transparent 55%),
      linear-gradient(165deg, #0b1f4d 0%, #123071 38%, #1E40AF 72%, #2f57d1 100%);
    background-attachment: fixed;
    min-height: 100vh;
  }
  a { color: var(--primary); text-decoration: none; }
  a:hover { text-decoration: underline; }

  .customer-hero {
    padding: 22px 24px 28px;
    background: linear-gradient(135deg, rgba(255,255,255,0.18), rgba(255,255,255,0.05));
    backdrop-filter: blur(22px) saturate(160%);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    border-bottom: 1px solid rgba(255,255,255,0.25);
    box-shadow: 0 8px 32px rgba(0,0,0,0.22);
    color: white;
  }
  .customer-hero-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; max-width: 800px; margin-left: auto; margin-right: auto; }
  .customer-hero-brand { font-weight: 800; font-size: 1.05rem; letter-spacing: 0.01em; }
  .customer-hero-profile { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; max-width: 800px; margin: 0 auto; }
  .customer-hero-name { font-weight: 800; font-size: 1.35rem; text-wrap: balance; }
  .customer-hero-meta { font-size: 0.85rem; opacity: 0.85; margin-top: 4px; }

  .customer-content { padding: 24px; max-width: 800px; margin: 0 auto; }

  .btn { display: inline-block; padding: 9px 16px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.35); background: rgba(255,255,255,0.55); backdrop-filter: blur(8px); color: var(--grey-900); cursor: pointer; font-size: 0.9rem; transition: background 0.15s, transform 0.1s; }
  .btn:hover { background: rgba(255,255,255,0.78); text-decoration: none; }
  .btn-primary { background: var(--primary); border-color: var(--primary); color: white; }
  .btn-primary:hover { background: var(--primary-dark); }
  .btn-ghost { background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.35); color: white; backdrop-filter: blur(6px); }
  .btn-ghost:hover { background: rgba(255,255,255,0.26); }

  .card {
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 22px;
    box-shadow: 0 8px 28px rgba(15,23,42,0.16), inset 0 1px 0 rgba(255,255,255,0.6);
    margin-bottom: 18px;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .card:hover { transform: translateY(-2px); box-shadow: 0 14px 34px rgba(15,23,42,0.2), inset 0 1px 0 rgba(255,255,255,0.6); }

  .form-row { margin-bottom: 14px; }
  .form-row label { display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 4px; color: var(--grey-700); }
  .form-row input[type=text], .form-row input[type=tel], .form-row input[type=password] {
    width: 100%; padding: 9px 12px; border: 1px solid rgba(15,23,42,0.15); border-radius: 8px; font-size: 0.95rem; font-family: inherit; background: rgba(255,255,255,0.6);
  }
  .form-row input:focus { outline: 2px solid var(--primary); outline-offset: 1px; background: rgba(255,255,255,0.9); }
  .error-box { background: rgba(254,242,242,0.85); color: var(--danger); border: 1px solid rgba(220,38,38,0.3); border-radius: 10px; padding: 10px 14px; margin-bottom: 16px; font-size: 0.9rem; backdrop-filter: blur(8px); }

  .progress-track { background: rgba(15,23,42,0.08); border-radius: 20px; height: 10px; overflow: hidden; }
  .progress-fill { background: linear-gradient(90deg, var(--primary), #3b82f6); height: 100%; border-radius: 20px; transition: width 0.4s ease; }

  .milestone-list { display: flex; flex-direction: column; }
  .milestone-item { display: flex; gap: 14px; padding: 4px 0 22px; position: relative; }
  .milestone-item:last-child { padding-bottom: 0; }
  .milestone-item::before {
    content: ''; position: absolute; left: 13px; top: 28px; bottom: 0; width: 2px;
    background: rgba(15,23,42,0.12);
  }
  .milestone-item:last-child::before { display: none; }
  .milestone-dot {
    width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0; z-index: 1;
    display: flex; align-items: center; justify-content: center; font-size: 0.85rem;
    border: 2px solid rgba(15,23,42,0.15); background: rgba(255,255,255,0.6);
  }
  .milestone-item.done .milestone-dot { background: var(--success); border-color: var(--success); color: white; }
  .milestone-item.in_progress .milestone-dot { background: #fbbf24; border-color: #fbbf24; color: #78350f; }
  .milestone-title { font-weight: 700; color: var(--grey-900); font-size: 0.95rem; }
  .milestone-item.pending .milestone-title { color: var(--grey-500); font-weight: 600; }
  .milestone-note { font-size: 0.82rem; color: var(--grey-500); margin-top: 3px; }
  .milestone-date { font-size: 0.75rem; color: var(--grey-500); margin-top: 3px; }

  @media (max-width: 640px) {
    .customer-hero { padding: 16px 16px 20px; }
    .customer-content { padding: 16px; }
  }
</style>
</head>
<body>
{% block body %}{% endblock %}
<script>
(function () {
  var meta = document.querySelector('meta[name="csrf-token"]');
  var token = meta ? meta.content : '';
  if (!token) return;
  document.querySelectorAll('form').forEach(function (form) {
    var method = (form.getAttribute('method') || 'get').toLowerCase();
    if (method !== 'post' || form.querySelector('input[name="_csrf"]')) return;
    var input = document.createElement('input');
    input.type = 'hidden';
    input.name = '_csrf';
    input.value = token;
    form.appendChild(input);
  });
})();
</script>
</body>
</html>
